// Prototype: arbitrary-length HTLC routing via ONE generic forward rule.
// Channels simplified to !ChannelConnect to isolate the generic-chain question.
// Sender -> (Forward)* -> Receiver, unbounded number of hops.
theory generic_multihop
begin

builtins: hashing, signing

rule Register_key:
    [ Fr(~ltk) ]
    --[ KeyGen($A, ~ltk) ]->
    [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)), Out(pk(~ltk)) ]

rule Compromise_Ltk:
    [ !Ltk($A, ltk) ]
    --[ LtkCompromised($A) ]->
    [ Out(ltk) ]

// Simplified channel open: persistent routing link in both directions.
rule Open_Channel:
    [ Fr(~ptr) ]
    --[ ChannelOpen($A, $B, ~ptr) ]->
    [ !ChannelConnect(~ptr, $A, $B),
      !ChannelConnect(~ptr, $B, $A) ]

rule Receiver_Create_Invoice:
    let y = h(~x)
        invoice = <$Receiver, $Sender, y>
        sigR    = sign(invoice, ltkR)
    in
    [ Fr(~x), !Ltk($Receiver, ltkR) ]
    --[ InvoiceCreated($Receiver, $Sender, y),
        SecretPreimage($Receiver, ~x) ]->
    [ ReceiverInv($Receiver, $Sender, ~x),
      Out(<'SecretRS', invoice, sigR>) ]

// Sender makes the first offer on its outgoing channel.
rule Sender_Offer_HTLC:
    let invoice = <$Receiver, $Sender, y>
        offer   = <'htlc', ptrSF, $Sender, $F, y>
        sigS    = sign(offer, ltkS)
    in
    [ In(<'SecretRS', invoice, sigR>),
      !Pk($Receiver, pkR),
      !Ltk($Sender, ltkS),
      !ChannelConnect(ptrSF, $Sender, $F) ]
    --[ HTLCOffered($Sender, $F, ptrSF, y),
        HTLCAdded(ptrSF, y),
        Neq($Sender, $F),
        Eq(verify(sigR, invoice, pkR), true) ]->
    [ SenderPending($Sender, $F, $Receiver, ptrSF, y),
      Out(<'htlc', ptrSF, $Sender, $F, y, sigS>) ]

// GENERIC FORWARD -- one rule, fires once per intermediary hop, any chain length.
// Consumes an incoming 'htlc' message addressed to $Me, re-signs an outgoing one
// to $Next.  Self-chains because input and output have the same 'htlc' shape.
rule Forward_HTLC:
    let offerIn  = <'htlc', ptrIn, $Prev, $Me, y>
        offerOut = <'htlc', ptrOut, $Me, $Next, y>
        sigOut   = sign(offerOut, ltkMe)
    in
    [ In(<'htlc', ptrIn, $Prev, $Me, y, sigIn>),
      !Pk($Prev, pkPrev),
      !Ltk($Me, ltkMe),
      !ChannelConnect(ptrIn,  $Prev, $Me),
      !ChannelConnect(ptrOut, $Me,   $Next) ]
    --[ HTLCForwarded($Me, $Prev, $Next, ptrIn, ptrOut, y),
        HTLCAdded(ptrOut, y),
        ForwardHTLC($Me, ptrIn, ptrOut, y),
        Neq(ptrIn, ptrOut),
        Neq($Prev, $Me),
        Neq($Me, $Next),
        Eq(verify(sigIn, offerIn, pkPrev), true) ]->
    [ IntermediaryPending($Me, $Prev, $Next, ptrIn, ptrOut, y),
      Out(<'htlc', ptrOut, $Me, $Next, y, sigOut>) ]

// Receiver fulfils: only the genuine invoice holder can, and reveals preimage.
rule Receiver_Fulfill_HTLC:
    let y = h(x)
        offerIn = <'htlc', ptrIn, $Prev, $Receiver, y>
    in
    [ ReceiverInv($Receiver, $Sender, x),
      In(<'htlc', ptrIn, $Prev, $Receiver, y, sigIn>),
      !Pk($Prev, pkPrev) ]
    --[ HTLCFulfilled($Receiver, $Prev, ptrIn, y),
        PreimageReleased($Receiver, x),
        Redeemed(ptrIn, y),
        Eq(verify(sigIn, offerIn, pkPrev), true) ]->
    [ Out(<'fulfill', ptrIn, x>) ]

// GENERIC SETTLE -- intermediary claims its incoming HTLC using the preimage
// it learned from its outgoing fulfilment.  One rule, fires once per hop.
rule Intermediary_Settle:
    [ IntermediaryPending($Me, $Prev, $Next, ptrIn, ptrOut, y),
      In(<'fulfill', ptrOut, x>) ]
    --[ IntermediaryClaimed($Me, $Prev, ptrIn, x),
        Redeemed(ptrIn, y),
        Eq(h(x), y) ]->
    [ Out(<'fulfill', ptrIn, x>) ]

rule Sender_Settle:
    [ SenderPending($Sender, $F, $Receiver, ptrSF, y),
      In(<'fulfill', ptrSF, x>) ]
    --[ SenderSettled($Sender, $F, $Receiver, ptrSF, x),
        PaymentComplete($Sender, $Receiver, h(x)),
        Redeemed(ptrSF, y),
        Eq(h(x), y) ]->
    [ ]

restriction Inequality:
    "All x y #i. Neq(x, y) @ #i ==> not(x = y)"

restriction Equality:
    "All x y #i. Eq(x, y) @ #i ==> x = y"

// --- cheap structural lemmas first ---

// Every forward by an honest intermediary was preceded by an offer/forward TO it.
lemma Forward_Requires_Incoming_Honest [use_induction]:
    "All Me Prev Next ptrIn ptrOut y #i.
        HTLCForwarded(Me, Prev, Next, ptrIn, ptrOut, y) @ #i
      & (not Ex P #r. LtkCompromised(P) @ #r)
     ==> (Ex S #j. HTLCOffered(S, Me, ptrIn, y) @ #j & #j < #i)
       | (Ex P0 N0 pin0 #j. HTLCForwarded(Prev, P0, Me, pin0, ptrIn, y) @ #j & #j < #i)"

// A fulfil requires the receiver to have been offered the HTLC (honest world).
lemma Fulfill_Requires_Incoming_Honest [use_induction]:
    "All R Prev ptrIn y #i.
        HTLCFulfilled(R, Prev, ptrIn, y) @ #i
      & (not Ex P #r. LtkCompromised(P) @ #r)
     ==> (Ex S #j. HTLCOffered(S, Prev, ptrIn, y) @ #j & #j < #i)
       | (Ex P0 N0 pin0 #j. HTLCForwarded(Prev, P0, R, pin0, ptrIn, y) @ #j & #j < #i)"

// Non-vacuity: a TWO-intermediary chain (Sender -> F1 -> F2 -> Receiver) settles.
lemma Two_Hop_Payment_Possible:
    exists-trace
    "Ex S F1 F2 R p0 p1 p2 x #o #f1 #f2 #ful.
        HTLCOffered(S, F1, p0, h(x))            @ #o
      & HTLCForwarded(F1, S, F2, p0, p1, h(x))  @ #f1
      & HTLCForwarded(F2, F1, R, p1, p2, h(x))  @ #f2
      & HTLCFulfilled(R, F2, p2, h(x))          @ #ful"

end
