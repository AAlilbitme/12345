// ===========================================================================
// Gap 1: Channel-state / post-close coupling   (state-integrity)
// Gap 5: On-chain enforcement / dispute finality
//
// In multihop.spthy the channel is a PERSISTENT fact (!ChannelConnect) that is
// never revoked, so the model permits an HTLC to be added to a channel that has
// already been closed -- a state-integrity gap.  The "wall" in the earlier
// attempts came from trying to keep the channel persistent while also forbidding
// post-close use; a persistent fact cannot be consumed, so nothing can express
// "this channel is gone".
//
// The fix is to model the channel as a LINEAR fact carrying an explicit
// lifecycle: Open -> (many HTLC adds) -> Close.  Closing CONSUMES the channel
// token, after which no rule that needs it can fire.  This makes the
// post-close-HTLC trace genuinely unreachable, which we prove
// (No_HTLC_After_Close).
//
// On the same linear-channel scaffold we address Gap 5: each pending HTLC can
// be driven to a resolving on-chain outcome -- claimed with the preimage, or
// refunded after timeout -- and the two outcomes are mutually exclusive
// (Outcome_Exclusive).  Both resolutions are reachable (Redeem_Reachable,
// Refund_Reachable), i.e. an honest party is never structurally deprived of a
// dispute path.  (Guaranteed resolution is a liveness property; see the note
// at the bottom and the GAPS write-up.)
// ===========================================================================
theory channel_lifecycle
begin

builtins: hashing

// ---------------------------------------------------------------------------
// Channel lifecycle as a LINEAR resource.
// ---------------------------------------------------------------------------

// Opening mints the linear channel token plus a persistent record of the peers
// (the record may stay around; the spendable channel state is the linear part).
rule Open_Channel:
    [ Fr(~ptr) ]
    --[ ChannelOpen($A, $B, ~ptr) ]->
    [ Channel(~ptr, $A, $B), !ChannelPeers(~ptr, $A, $B) ]

// Closing consumes the channel token.  After this, Channel(~ptr,...) is gone
// and no HTLC can be added on ptr.
rule Close_Channel:
    [ Channel(ptr, A, B) ]
    --[ ChannelClosed(ptr) ]->
    [ ]

// ---------------------------------------------------------------------------
// HTLC lifecycle on an OPEN channel.  Adding an HTLC requires the live channel
// token (consumed and restored), so it is impossible once the channel closed.
// ---------------------------------------------------------------------------
rule Add_HTLC:
    [ Channel(ptr, A, B), Fr(~x) ]
    --[ HTLCAdded(ptr, h(~x)), Locked(ptr, h(~x)), OnChannel(ptr) ]->
    [ Channel(ptr, A, B), Pending(ptr, A, B, ~x, h(~x)) ]

// A second, adversary-driven add: lets a known hash be locked, so we are not
// only reasoning about fresh secrets.  Still requires the live channel token.
rule Add_HTLC_Known:
    [ Channel(ptr, A, B), In(y) ]
    --[ HTLCAdded(ptr, y), Locked(ptr, y), OnChannel(ptr) ]->
    [ Channel(ptr, A, B), PendingKnown(ptr, A, B, y) ]

// --- Gap 5: on-chain dispute outcomes ---------------------------------------

// Outcome 1: claim with the preimage (HTLC-success).
rule Resolve_Claim:
    [ Pending(ptr, A, B, x, y) ]
    --[ Redeemed(ptr, y), Resolved(ptr, y), Eq(h(x), y) ]->
    [ ]

// Outcome 2: refund after timeout (HTLC-timeout).
rule Resolve_Refund:
    [ Pending(ptr, A, B, x, y) ]
    --[ Refunded(ptr, y), Resolved(ptr, y), TimedOut(ptr) ]->
    [ ]

restriction Equality:
    "All a b #i. Eq(a, b) @ #i ==> a = b"

// An HTLC has at most one on-chain outcome.
restriction OneOutcome:
    "All ptr y #i #j. Resolved(ptr, y) @ #i & Resolved(ptr, y) @ #j ==> #i = #j"

// ---------------------------------------------------------------------------
// Lemmas
// ---------------------------------------------------------------------------

// GAP 1 -- the state-integrity fix.  No HTLC can be added to a channel after it
// has been closed: every HTLCAdded on ptr strictly precedes any close of ptr.
lemma No_HTLC_After_Close [use_induction]:
    "All ptr y #h #c.
        HTLCAdded(ptr, y) @ #h
      & ChannelClosed(ptr) @ #c
     ==> #h < #c"

// Supporting: an HTLC is only ever added on a channel that was opened first
// (and the add sees the channel still open).
lemma HTLC_Needs_Open_Channel [reuse, use_induction]:
    "All ptr y #h.
        HTLCAdded(ptr, y) @ #h
     ==> Ex A B #o. ChannelOpen(A, B, ptr) @ #o & #o < #h"

// GAP 5 -- dispute finality.
// (a) Exclusivity: an HTLC cannot be both claimed and refunded.
lemma Outcome_Exclusive:
    "All ptr y #i #j.
        Redeemed(ptr, y) @ #i
      & Refunded(ptr, y) @ #j
     ==> F"

// (b) The claim path is reachable: an honest party CAN sweep with the preimage.
lemma Redeem_Reachable:
    exists-trace
    "Ex ptr y #i. Redeemed(ptr, y) @ #i"

// (c) The refund path is reachable: an honest party CAN recover after timeout.
lemma Refund_Reachable:
    exists-trace
    "Ex ptr y #i. Refunded(ptr, y) @ #i"

// (d) Every resolved HTLC was a genuine HTLC that was locked on its channel
// first -- on-chain resolution corresponds to a real off-chain commitment.
lemma Resolution_Has_Lock:
    "All ptr y #r.
        Resolved(ptr, y) @ #r
     ==> Ex #l. Locked(ptr, y) @ #l & #l < #r"

// NOTE (liveness boundary): "every pending HTLC IS eventually resolved" is a
// liveness property and, like Intermediary_Never_Loses in cltv_blocks.spthy,
// is not a trace-safety lemma -- the trace where the honest party simply never
// submits a transaction always exists.  What IS provable, and proven above, is
// that neither dispute path is ever structurally blocked and the two outcomes
// are mutually exclusive.

end
