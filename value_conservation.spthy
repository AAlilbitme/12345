// ===========================================================================
// Gap 6: Value / balance conservation with fees.
//
// Models the slides' (14/15) fee-at-each-hop structure:
//   Sender locks  vS  =  vR + fee1 + fee2
//   F1 forwards   vMid = vR + fee2          (keeps fee1 = vS - vMid)
//   F2 forwards   vR                        (keeps fee2 = vMid - vR)
//   Receiver claims vR
//
// IMPORTANT: amounts are nat-typed (%vS, %fee1, %fee2, %vOut etc.) throughout.
// Using fresh nonces (~x) with %+ would be ill-sorted: fresh is NOT a subsort
// of nat in Tamarin, so Eq(~a, ~b %+ ~c) can never be satisfied (the term
// ~b %+ ~c is a nat compound, ~a is an atom -- they are always distinct).
// This was a bug in earlier drafts that caused all security lemmas to be
// vacuously true (the forward rules could never fire).
//
// The fix: each forwarder receives its output amount and fee as nat terms
// from the network via In(%vOut) / In(%fee).  The Seed_Amount rule makes %1
// available, so the adversary (and honest parties) can compose any nat value.
// The Eq(%vIn, %vOut %+ %fee) restriction is now well-sorted and solvable,
// e.g. %vIn = 3%1 = 2%1 + 1%1.
//
// Lemmas:
//   Forwarding_Chain_Possible  -- two-hop chain reachable (exists-trace, fast)
//   Fee_Conservation_Per_Hop   -- vIn = vOut + fee per hop  (all-traces, fast)
//   Value_Conserved_End_To_End -- vS = vMid+fee1 & vMid=vR+fee2 (all-traces, fast)
//
// Run:
//   tamarin-prover value_conservation.spthy --prove --heuristic=c
// ===========================================================================
theory value_conservation
begin

builtins: hashing, signing, natural-numbers

rule Register_key:
    [ Fr(~ltk) ]
    --[ KeyGen($A, ~ltk) ]->
    [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)), Out(pk(~ltk)) ]

rule Compromise_Ltk:
    [ !Ltk($A, ltk) ]
    --[ LtkCompromised($A) ]->
    [ Out(ltk) ]

rule Open_Channel:
    [ Fr(~ptr) ]
    --[ ChannelOpen($A, $B, ~ptr) ]->
    [ !Channel(~ptr, $A, $B) ]

// Seed the network with %1 so forwarders can receive any nat via In(%x).
// The adversary deduces %1 %+ %1, %1 %+ %1 %+ %1, etc. by composing.
rule Seed_Amount:
    [ ] --[ ]-> [ Out(%1) ]

// Receiver picks secret preimage ~x and invoice amount %v (nat).
rule Receiver_Create_Invoice:
    let y       = h(~x)
        invoice = <$Receiver, $Sender, y, %v>
        sigR    = sign(invoice, ltkR)
    in
    [ Fr(~x), In(%v), !Ltk($Receiver, ltkR) ]
    --[ InvoiceCreated($Receiver, $Sender, y, %v),
        SecretPreimage($Receiver, ~x) ]->
    [ ReceiverInv($Receiver, $Sender, ~x, %v),
      Out(<'inv', invoice, sigR>) ]

// Sender verifies receiver's signature and locks total amount %vS (nat).
rule Sender_Offer_HTLC:
    let invoice = <$Receiver, $Sender, y, %v>
        offer   = <'htlc1', ptrSF1, $Sender, $F1, y, %vS>
        sigS    = sign(offer, ltkS)
    in
    [ In(<'inv', invoice, sigR>),
      !Pk($Receiver, pkR),
      !Ltk($Sender, ltkS),
      !Channel(ptrSF1, $Sender, $F1),
      In(%vS) ]
    --[ SenderLocked($Sender, $Receiver, ptrSF1, y, %vS),
        Eq(verify(sigR, invoice, pkR), true) ]->
    [ SenderPending($Sender, $F1, $Receiver, ptrSF1, y, %vS, %v),
      Out(<'htlc1', ptrSF1, $Sender, $F1, y, %vS, sigS>) ]

// F1 verifies sender's signature; receives nat amounts %fee1 and %vOut from
// the network; enforces Eq(%vIn, %vOut %+ %fee1).
// Both %fee1 and %vOut are nat-typed so %+ is well-sorted.
rule Forward_F1:
    let offer    = <'htlc1', ptrSF1, $Sender, $F1, y, %vIn>
        offerFwd = <'htlc2', ptrF1F2, $F1, $F2, y, %vOut>
        sigF1    = sign(offerFwd, ltkF1)
    in
    [ In(<'htlc1', ptrSF1, $Sender, $F1, y, %vIn, sigS>),
      !Pk($Sender, pkS), !Ltk($F1, ltkF1),
      !Channel(ptrF1F2, $F1, $F2),
      In(%fee1), In(%vOut) ]
    --[ ValueForwarded($F1, ptrSF1, ptrF1F2, y, %vIn, %vOut),
        FeeCharged($F1, y, %fee1),
        Eq(%vIn, %vOut %+ %fee1),
        Eq(verify(sigS, offer, pkS), true) ]->
    [ IntermediaryPending($F1, $Sender, $F2, ptrSF1, ptrF1F2, y, %vIn, %vOut),
      Out(<'htlc2', ptrF1F2, $F1, $F2, y, %vOut, sigF1>) ]

// F2 verifies F1's signature; similarly enforces Eq(%vIn, %vOut %+ %fee2).
rule Forward_F2:
    let offer    = <'htlc2', ptrF1F2, $F1, $F2, y, %vIn>
        offerFwd = <'htlc3', ptrF2R, $F2, $Receiver, y, %vOut>
        sigF2    = sign(offerFwd, ltkF2)
    in
    [ In(<'htlc2', ptrF1F2, $F1, $F2, y, %vIn, sigF1>),
      !Pk($F1, pkF1), !Ltk($F2, ltkF2),
      !Channel(ptrF2R, $F2, $Receiver),
      In(%fee2), In(%vOut) ]
    --[ ValueForwarded($F2, ptrF1F2, ptrF2R, y, %vIn, %vOut),
        FeeCharged($F2, y, %fee2),
        Eq(%vIn, %vOut %+ %fee2),
        Eq(verify(sigF1, offer, pkF1), true) ]->
    [ IntermediaryPending($F2, $F1, $Receiver, ptrF1F2, ptrF2R, y, %vIn, %vOut),
      Out(<'htlc3', ptrF2R, $F2, $Receiver, y, %vOut, sigF2>) ]

// Receiver checks F2's signature; %v (nat invoice amount) must match %vOut from F2.
// Since both are nat-typed, unification succeeds when F2 forwards exactly %v.
rule Receiver_Accept:
    let y        = h(x)
        offerFwd = <'htlc3', ptrF2R, $F2, $Receiver, y, %v>
    in
    [ ReceiverInv($Receiver, $Sender, x, %v),
      In(<'htlc3', ptrF2R, $F2, $Receiver, y, %v, sigF2>),
      !Pk($F2, pkF2) ]
    --[ ValueClaimed($Receiver, y, %v),
        ReceiverAccepted($Receiver, $F2, ptrF2R, y, %v),
        Eq(verify(sigF2, offerFwd, pkF2), true) ]->
    [ ]

restriction Equality:
    "All a b #i. Eq(a, b) @ #i ==> a = b"

// ---------------------------------------------------------------------------
// Lemmas
// ---------------------------------------------------------------------------

// NON-VACUITY: a two-hop forwarding chain with fees is reachable.
// The adversary provides nat amounts (key compromise allowed here).
// Concrete witness: %vS=3, %fee1=1, %vMid=2, %fee2=1, %vR=1.
lemma Forwarding_Chain_Possible:
    exists-trace
    "Ex F1 F2 p1 p2 p3 y %vS %vMid %vR %fee1 %fee2 #b #c #e1 #e2.
        ValueForwarded(F1, p1, p2, y, %vS,  %vMid) @ #b
      & ValueForwarded(F2, p2, p3, y, %vMid, %vR)  @ #c
      & FeeCharged(F1, y, %fee1)                    @ #e1
      & FeeCharged(F2, y, %fee2)                    @ #e2"

// PER-HOP: the amount into each hop equals the amount out plus the fee.
// Direct from the Eq(%vIn, %vOut %+ %fee) restriction -- proves immediately.
// Both ValueForwarded and FeeCharged fire from the same rule step, so they
// share the same timestamp #i.  Using separate #i/#j would allow cross-pairing
// of actions from different firings (a falsified trace where fee comes from a
// different hop invocation than the amounts), which is not the intended property.
lemma Fee_Conservation_Per_Hop:
    "All F pIn pOut y %vIn %vOut %fee #i.
        ValueForwarded(F, pIn, pOut, y, %vIn, %vOut) @ #i
      & FeeCharged(F, y, %fee)                        @ #i
      & (not Ex A #r. LtkCompromised(A) @ #r)
     ==> %vIn = %vOut %+ %fee"

// END-TO-END: sender's locked amount equals receiver's claimed amount plus
// all hop fees -- vS = vMid + fee1  AND  vMid = vR + fee2.
// Co-temporal pairing: FeeCharged shares timestamp with its ValueForwarded.
// Stated as two equalities to avoid a 3-term AC sum in the conclusion
// (Tamarin 1.8.0 crashes on vS = vR %+ fee1 %+ fee2 in guarded-formula form).
lemma Value_Conserved_End_To_End:
    "All F1 F2 p p1 p2 y %vS %vMid %vR %fee1 %fee2 #b #c.
        ValueForwarded(F1, p,  p1, y, %vS,  %vMid) @ #b
      & FeeCharged(F1, y, %fee1)                    @ #b
      & ValueForwarded(F2, p1, p2, y, %vMid, %vR)  @ #c
      & FeeCharged(F2, y, %fee2)                    @ #c
      & (not Ex A #r. LtkCompromised(A) @ #r)
     ==> (%vS = %vMid %+ %fee1) & (%vMid = %vR %+ %fee2)"

end
