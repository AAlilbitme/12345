// ===========================================================================
// Gap 6: Value / balance conservation.
//
// This theory proves that the amount flowing through a multi-hop HTLC payment
// is conserved end-to-end: the amount the receiver demands in the invoice is
// exactly the amount the sender locks and receives, in any trace where no
// signing key was compromised.
//
// The signing-free model (value as plain nonce) FALSIFIES: the Dolev-Yao
// adversary can modify the value field in-flight because no integrity
// protection covers it.  Signing IS the mechanism that makes conservation
// hold.  The full signed model OOM-kills in 200-300 s because the
// Ltk_Known_Implies_Compromised [reuse] lemma causes exponential variant
// explosion.  We therefore scope the conservation lemma to honest runs
// (no key compromise) which eliminates the reuse-lemma-requiring branch
// and makes the proof tractable.
//
// The falsification with no signing (comment below) is the sanity check:
//   "Value_Conserved_End_To_End: falsified -- found trace (6 steps)"
// The 6-step attack is: adversary intercepts htlc1, substitutes a different
// value v', F1 forwards v', F2 forwards v', but receiver holds ~v in its
// ReceiverInv and the receiver_accept rule unifies against ~v -- so the
// receiver cannot accept v'.  This means the adversary kills the payment,
// but cannot redirect funds -- they can only break the payment, not steal.
// The steal attack would require forging a signature, which is the gap
// captured by the key-compromise escape hatch.
// ===========================================================================
theory value_conservation
begin

builtins: hashing, signing

rule Register_key:
    [ Fr(~ltk) ]
    --[ KeyGen($A, ~ltk) ]->
    [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)), Out(pk(~ltk)) ]

rule Compromise_Ltk:
    [ !Ltk($A, ltk) ]
    --[ LtkCompromised($A) ]->
    [ Out(ltk) ]

rule Open_Channel:
    [ Fr(~ptr) ]
    --[ ChannelOpen($A, $B, ~ptr) ]->
    [ !Channel(~ptr, $A, $B) ]

// Receiver generates payment secret x, amount ~v, and signs both into the
// invoice.  The signature binds v to this invoice instance -- no party can
// substitute a different amount without breaking the receiver's signature.
rule Receiver_Create_Invoice:
    let y       = h(~x)
        invoice = <$Receiver, $Sender, y, ~v>
        sigR    = sign(invoice, ltkR)
    in
    [ Fr(~x), Fr(~v), !Ltk($Receiver, ltkR) ]
    --[ InvoiceCreated($Receiver, $Sender, y, ~v),
        SecretPreimage($Receiver, ~x) ]->
    [ ReceiverInv($Receiver, $Sender, ~x, ~v),
      Out(<'inv', invoice, sigR>) ]

// Sender checks the receiver's signature, extracts v, and locks exactly v.
rule Sender_Offer_HTLC:
    let invoice = <$Receiver, $Sender, y, v>
        offer   = <'htlc1', ptrSF1, $Sender, $F1, y, v>
        sigS    = sign(offer, ltkS)
    in
    [ In(<'inv', invoice, sigR>),
      !Pk($Receiver, pkR),
      !Ltk($Sender, ltkS),
      !Channel(ptrSF1, $Sender, $F1) ]
    --[ SenderLocked($Sender, $Receiver, ptrSF1, y, v),
        ValueOffered(ptrSF1, y, v),
        Eq(verify(sigR, invoice, pkR), true) ]->
    [ SenderPending($Sender, $F1, $Receiver, ptrSF1, y, v),
      Out(<'htlc1', ptrSF1, $Sender, $F1, y, v, sigS>) ]

// F1 checks S's signature and forwards the same v, signed by F1.
rule Forward_F1:
    let offer    = <'htlc1', ptrSF1, $Sender, $F1, y, v>
        offerFwd = <'htlc2', ptrF1F2, $F1, $F2, y, v>
        sigF1    = sign(offerFwd, ltkF1)
    in
    [ In(<'htlc1', ptrSF1, $Sender, $F1, y, v, sigS>),
      !Pk($Sender, pkS), !Ltk($F1, ltkF1),
      !Channel(ptrF1F2, $F1, $F2) ]
    --[ ValueForwarded($F1, ptrSF1, ptrF1F2, y, v),
        ValueOffered(ptrF1F2, y, v),
        Eq(verify(sigS, offer, pkS), true) ]->
    [ IntermediaryPending($F1, $Sender, $F2, ptrSF1, ptrF1F2, y, v),
      Out(<'htlc2', ptrF1F2, $F1, $F2, y, v, sigF1>) ]

// F2 checks F1's signature and forwards the same v.
rule Forward_F2:
    let offer    = <'htlc2', ptrF1F2, $F1, $F2, y, v>
        offerFwd = <'htlc3', ptrF2R, $F2, $Receiver, y, v>
        sigF2    = sign(offerFwd, ltkF2)
    in
    [ In(<'htlc2', ptrF1F2, $F1, $F2, y, v, sigF1>),
      !Pk($F1, pkF1), !Ltk($F2, ltkF2),
      !Channel(ptrF2R, $F2, $Receiver) ]
    --[ ValueForwarded($F2, ptrF1F2, ptrF2R, y, v),
        ValueOffered(ptrF2R, y, v),
        Eq(verify(sigF1, offer, pkF1), true) ]->
    [ IntermediaryPending($F2, $F1, $Receiver, ptrF1F2, ptrF2R, y, v),
      Out(<'htlc3', ptrF2R, $F2, $Receiver, y, v, sigF2>) ]

// Receiver checks F2's signature and confirms the htlc's v matches the
// invoice amount ~v (unification here is the key conservation check).
rule Receiver_Accept:
    let y        = h(x)
        offerFwd = <'htlc3', ptrF2R, $F2, $Receiver, y, ~v>
    in
    [ ReceiverInv($Receiver, $Sender, x, ~v),
      In(<'htlc3', ptrF2R, $F2, $Receiver, y, ~v, sigF2>),
      !Pk($F2, pkF2) ]
    --[ ValueClaimed($Receiver, y, ~v),
        ReceiverAccepted($Receiver, $F2, ptrF2R, y, ~v),
        Eq(verify(sigF2, offerFwd, pkF2), true) ]->
    [ ]

restriction Equality:
    "All a b #i. Eq(a, b) @ #i ==> a = b"

// ---------------------------------------------------------------------------
// Lemmas
// ---------------------------------------------------------------------------

// Sanity: a complete honest flow is reachable.
lemma Payment_With_Amount_Possible:
    exists-trace
    "Ex S F1 F2 R p1 p2 p3 y v #a #b #c #d.
        SenderLocked(S, R, p1, y, v)     @ #a
      & ValueForwarded(F1, p1, p2, y, v) @ #b
      & ValueForwarded(F2, p2, p3, y, v) @ #c
      & ValueClaimed(R, y, v)            @ #d
      & not (Ex A #r. LtkCompromised(A) @ #r)"

// CORE: end-to-end value conservation in honest runs.
// If the sender locked amount v for hash y, and the receiver claimed amount
// vr for the same y, and no key was compromised, then v = vr.
//
// The key-compromise exception is NOT circular: it reflects the real
// attack.  If the sender's key leaks, the adversary can craft a fake
// invoice with a different amount; if F1/F2's key leaks, the adversary can
// re-sign a modified HTLC.  Value conservation is conditional on honest keys.
lemma Value_Conserved_End_To_End:
    "All S R p y v vr #i #j.
        SenderLocked(S, R, p, y, v) @ #i
      & ValueClaimed(R, y, vr)      @ #j
      & (not Ex A #r. LtkCompromised(A) @ #r)
     ==> v = vr"

// Per-hop conservation in honest runs: no intermediary skims value.
lemma Value_Conserved_Per_Hop:
    "All P pIn pOut y vIn vOut #i #j.
        ValueOffered(pIn, y, vIn)               @ #i
      & ValueForwarded(P, pIn, pOut, y, vOut)   @ #j
      & (not Ex A #r. LtkCompromised(A) @ #r)
     ==> vIn = vOut"

end
