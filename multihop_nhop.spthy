// multihop_nhop.spthy -- MERGED, N-hop-generalized variant of multihop.spthy.
// ===========================================================================
// EXPERIMENTAL.  This file keeps the full channel lifecycle from multihop.spthy
// but replaces the fixed 2-hop SIGNED HTLC layer with ONE generic Forward_HTLC
// over a linear Route fact, so the path Sender -> (Forward)* -> Receiver has ANY
// length.  The invoice stays signed (invoice-authentication lemmas survive).
//
// STATUS: 28 / 29 lemmas verified (--heuristic=c --stop-on-trace=seqdfs).
//   Verified: all channel-lifecycle lemmas; the generic causality/atomicity
//   lemmas (Forward_Requires_Incoming 133, Redeem_Requires_Receiver_Release 175,
//   Claim_Requires_Release 157); and the headline safety lemmas
//   (Intermediary_Never_Loses_Under_Liveness, Payment_Atomicity_Under_Liveness,
//   T2b_Counterexample_Blocked).
//   The three exists-trace payment WITNESSES (Multihop_Payment_Possible,
//   Refund_Possible, Forged_Invoice_Requires_Key_Compromise) verify once the
//   network is "frozen" with negative guards -- otherwise the generic Forward
//   rule lets the witness search explore unboundedly many alternative routes.
//   NOT verified (1): Settle_Requires_Receiver_Release -- resolving SenderSettled
//   backward walks the whole generic settle chain and does not terminate.  It
//   DOES verify in the fixed-hop multihop.spthy; it is the single open lemma of
//   the N-hop variant.  All all-traces SAFETY properties generalize.
//
// The canonical, fully-verified model is still multihop.spthy (fixed 3-hop,
// strong signed-message adversary).  This file is the "unbounded length"
// companion; see experiments/README.md for the idealized-channel framing.
// ===========================================================================
//
// full channel lifecycle (handshake, state-update, revocation/punishment,
// on-chain settlement), staggered-CLTV timing model, and the key security
// properties (payment atomicity, intermediary safety).
//
// Run with: tamarin-prover multihop.spthy --prove=<LemmaName>
// Use LANG=C.utf8 LC_ALL=C.utf8 to avoid Unicode encoding crashes.
// For existence lemmas: --stop-on-trace=SEQDFS
//
// --- Modular formalization (NOT a single complete proof) ---
// This file is one part of a four-theory package.  Each theory proves a
// distinct aspect; they do not share rules, so a property proved in one is
// not automatically proved in the system the others describe.
//
//   multihop.spthy          (this file)
//       Main protocol and atomicity under liveness assumption T2b.
//       Does NOT include the zombie-channel enforcement from gaps.spthy
//       (adding ChannelClosed to Honest_Close causes OOM here -- known
//       limitation, not a hidden one).
//
//   gaps.spthy
//       Lifecycle and timing safety properties separated for tractability:
//       no HTLC after close (linear channel token), CLTV claim windows,
//       on-chain redeem/refund reachability, outcome exclusivity.
//
//   value_conservation.spthy
//       Amount and fee conservation in a separate nat-arithmetic abstraction.
//       Separated because combining signing equational theory with nat
//       induction OOM-kills Tamarin.
//
//   cltv_blocks.spthy
//       Pure block-arithmetic derivation of CLTV staggering (the windows
//       EXIST); does not prove parties act within them (that is T2b below).
//
// --- Liveness assumption (T2b / HonestPartiesActBeforeIncomingTimeout) ---
// Intermediary_Never_Loses_Under_Liveness and Payment_Atomicity_Under_Liveness
// are conditional on HonestPartiesActBeforeIncomingTimeout (T2b).
// T2b encodes the assumption that every honest party claims/publishes within
// their CLTV window (i.e. TimedOut(ptrOut) fires before TimedOut(ptrIn)).
// This is a LIVENESS assumption, not a derived fact.  cltv_blocks.spthy
// proves that the claim windows are arithmetically non-empty; it does not
// prove that parties act within them.  T2b is where the unproven "they act
// in time" premise enters the model.  Without T2b, the early-timeout race
// (adversary fires TimedOut(ptrIn) before Redeemed(ptrOut), making T3
// inapplicable) is a genuine counterexample to both lemmas.
theory multihop_nhop
begin

builtins: hashing, signing

// ---------------------------------------------------------------------------
// Key management
// ---------------------------------------------------------------------------

rule Register_key:
    [ Fr(~ltk) ]
    --[ KeyGen($A, ~ltk) ]->
    [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)), Out(pk(~ltk)) ]

rule Compromise_Ltk:
    [ !Ltk($A, ltk) ]
    --[ LtkCompromised($A) ]->
    [ Out(ltk) ]

// ---------------------------------------------------------------------------
// Wallet / funds
// ---------------------------------------------------------------------------

rule Acquire_funds:
    [ Fr(~f) ]
    --[ FundsAcquired($A, ~f) ]->
    [ Wallet($A, ~f) ]

// ---------------------------------------------------------------------------
// Channel handshake
// ---------------------------------------------------------------------------

rule A_Send_Proposal:
    let proposal = <'proposal', $A, $B, ~ptr>
        sigA     = sign(proposal, ltkA)
    in
    [ Fr(~ptr), !Ltk($A, ltkA) ]
    --[ A_ProposalSent($A, $B, ~ptr) ]->
    [ A_WaitAck($A, $B, ~ptr),
      Out(<'proposal', $A, $B, ~ptr, sigA>) ]

rule B_Recv_Proposal:
    let proposal = <'proposal', $A, $B, ptr>
        sigB     = sign(proposal, ltkB)
    in
    [ !Ltk($B, ltkB), !Pk($A, pkA),
      In(<'proposal', $A, $B, ptr, sigA>) ]
    --[ ProposalExchange($A, $B, ptr),
        Eq(verify(sigA, proposal, pkA), true) ]->
    [ !ProposalCommitted($A, $B, ptr),
      Out(<'proposal_ack', $A, $B, ptr, sigB>) ]

rule A_Recv_From_B:
    let proposal = <'proposal', $A, $B, ptr>
    in
    [ A_WaitAck($A, $B, ptr),
      !Pk($B, pkB),
      In(<'proposal_ack', $A, $B, ptr, sigB>) ]
    --[ A_Received($A, $B, ptr),
        Eq(verify(sigB, proposal, pkB), true) ]->
    [ !A_HandshakeDone($A, $B, ptr) ]

// ---------------------------------------------------------------------------
// Initial channel state commitment
// ---------------------------------------------------------------------------

rule Create_State_A:
    let commitA0 = <'commit', ptr, $A, $B, '0', h(~sA0)>
        sigA0    = sign(commitA0, ltkA)
    in
    [ Fr(~sA0), !Ltk($A, ltkA),
      !A_HandshakeDone($A, $B, ptr) ]
    --[ StateCreated($A, '0', commitA0) ]->
    [ CommittedStateA($A, $B, ptr, '0', ~sA0, commitA0, sigA0) ]

rule Create_State_B:
    let commitB0 = <'commit', ptr, $B, $A, '0', h(~sB0)>
        sigB0    = sign(commitB0, ltkB)
    in
    [ Fr(~sB0), !Ltk($B, ltkB),
      !ProposalCommitted($A, $B, ptr) ]
    --[ StateCreated($B, '0', commitB0) ]->
    [ CommittedStateB($A, $B, ptr, '0', ~sB0, commitB0, sigB0) ]

rule Both_States_Committed:
    [ CommittedStateA($A, $B, ptr, '0', sA0, commitA0, sigA0),
      CommittedStateB($A, $B, ptr, '0', sB0, commitB0, sigB0),
      !Pk($A, pkA), !Pk($B, pkB) ]
    --[ Stage1Complete($A, $B, ptr),
        Eq(verify(sigA0, commitA0, pkA), true),
        Eq(verify(sigB0, commitB0, pkB), true) ]->
    [ ReadyToLock($A, $B, ptr, sA0, sB0, commitA0, commitB0) ]

rule Lock_Funds_And_Open:
    [ ReadyToLock($A, $B, ptr, sA0, sB0, commitA0, commitB0),
      Wallet($A, ~fA), Wallet($B, ~fB) ]
    --[ ChannelOpen($A, $B, ptr), FundsLocked($A, $B, ptr),
        NewStateBuilt($A, $B, ptr, '0', ~fA, ~fB) ]->
    [ StateA($A, $B, ptr, '0', sA0, commitA0, ~fA, ~fB),
      StateB($A, $B, ptr, '0', sB0, commitB0, ~fA, ~fB),
      !ValidOnChain(ptr),
      !ChannelRecord(ptr, $A, $B),
      !ChannelConnect(ptr, $A, $B),   // permits HTLC from A to B
      !ChannelConnect(ptr, $B, $A) ]  // permits HTLC from B to A (Neq restriction distinguishes hops)

// ---------------------------------------------------------------------------
// State update & revocation
// ---------------------------------------------------------------------------

rule Update_State:
    let newCommitA = <'commit', ptr, $A, $B, ~n_new, h(~sAnew)>
        newCommitB = <'commit', ptr, $B, $A, ~n_new, h(~sBnew)>
        sigAnew    = sign(newCommitA, ltkA)
        sigBnew    = sign(newCommitB, ltkB)
    in
    [ Fr(~n_new), Fr(~sAnew), Fr(~sBnew),
      !Ltk($A, ltkA), !Ltk($B, ltkB),
      StateA($A, $B, ptr, n_old, sAold, oldCommitA, fA, fB),
      StateB($A, $B, ptr, n_old, sBold, oldCommitB, fA, fB),
      In(<fA_new, fB_new>) ]
    --[ NewStateBuilt($A, $B, ptr, ~n_new, fA_new, fB_new) ]->
    [ PendingA($A, $B, ptr, n_old, sAold, oldCommitA,
               ~n_new, ~sAnew, newCommitA, sigAnew, fA_new, fB_new),
      PendingB($A, $B, ptr, n_old, sBold, oldCommitB,
               ~n_new, ~sBnew, newCommitB, sigBnew, fA_new, fB_new) ]

rule Revoke_Old_Secret:
    [ PendingA($A, $B, ptr, n_old, sAold, oldCommitA,
               n_new, sAnew, newCommitA, sigAnew, fA_new, fB_new),
      PendingB($A, $B, ptr, n_old, sBold, oldCommitB,
               n_new, sBnew, newCommitB, sigBnew, fA_new, fB_new),
      !Pk($A, pkA), !Pk($B, pkB) ]
    --[ StateUpdate($A, $B, ptr, n_new),
        Revoke($A, n_old, sAold),
        Revoke($B, n_old, sBold),
        Eq(verify(sigAnew, newCommitA, pkA), true),
        Eq(verify(sigBnew, newCommitB, pkB), true) ]->
    [ StateA($A, $B, ptr, n_new, sAnew, newCommitA, fA_new, fB_new),
      StateB($A, $B, ptr, n_new, sBnew, newCommitB, fA_new, fB_new),
      !RevokedSecret($A, n_old, sAold, oldCommitA),
      !RevokedSecret($B, n_old, sBold, oldCommitB),
      // linear one-shot revoked-commitment outputs (single-spend); mirrors the
      // multihop.spthy revocation hardening.
      RevokedCommitmentUnspent(ptr, $A, $B, n_old, oldCommitA),
      RevokedCommitmentUnspent(ptr, $B, $A, n_old, oldCommitB) ]

// ---------------------------------------------------------------------------
// On-chain publish paths
// ---------------------------------------------------------------------------

rule Publish_Old_Grace_Period_A:
    [ PendingA($A, $B, ptr, n_old, sAold, oldCommitA,
               n_new, sAnew, newCommitA, sigAnew, fA_new, fB_new),
      !ValidOnChain(ptr) ]
    --[ PublishOldBeforeRevocation($A, n_old),
        PublishState($A, n_old),
        OnChainDelayedProduce($A, n_old),
        OnChainInstantProduce($B, n_old) ]->
    [ OnChainDelayed($A, n_old, oldCommitA),
      OnChainInstant($B, n_old, oldCommitA) ]

rule Publish_Old_Grace_Period_B:
    [ PendingB($A, $B, ptr, n_old, sBold, oldCommitB,
               n_new, sBnew, newCommitB, sigBnew, fA_new, fB_new),
      !ValidOnChain(ptr) ]
    --[ PublishOldBeforeRevocation($B, n_old),
        PublishState($B, n_old),
        OnChainDelayedProduce($B, n_old),
        OnChainInstantProduce($A, n_old) ]->
    [ OnChainDelayed($B, n_old, oldCommitB),
      OnChainInstant($A, n_old, oldCommitB) ]

rule Publish_Current_A:
    [ StateA($A, $B, ptr, n, sA, commitA, fA, fB), !ValidOnChain(ptr) ]
    --[ Publish($A, n, commitA),
        PublishState($A, n),
        OnChainDelayedProduce($A, n),
        OnChainInstantProduce($B, n) ]->
    [ OnChainDelayed($A, n, commitA),
      OnChainInstant($B, n, commitA) ]

rule Publish_Current_B:
    [ StateB($A, $B, ptr, n, sB, commitB, fA, fB), !ValidOnChain(ptr) ]
    --[ Publish($B, n, commitB),
        PublishState($B, n),
        OnChainDelayedProduce($B, n),
        OnChainInstantProduce($A, n) ]->
    [ OnChainDelayed($B, n, commitB),
      OnChainInstant($A, n, commitB) ]

rule Publish_Pending_A:
    [ PendingA($A, $B, ptr, n_old, sAold, oldCommitA,
               n_new, sAnew, newCommitA, sigAnew, fA_new, fB_new),
      !ValidOnChain(ptr) ]
    --[ Publish($A, n_new, newCommitA),
        PublishFromPending($A, n_old, n_new),
        OnChainDelayedProduce($A, n_new),
        OnChainInstantProduce($B, n_new) ]->
    [ OnChainDelayed($A, n_new, newCommitA),
      OnChainInstant($B, n_new, newCommitA) ]

rule Publish_Pending_B:
    [ PendingB($A, $B, ptr, n_old, sBold, oldCommitB,
               n_new, sBnew, newCommitB, sigBnew, fA_new, fB_new),
      !ValidOnChain(ptr) ]
    --[ Publish($B, n_new, newCommitB),
        PublishFromPending($B, n_old, n_new),
        OnChainDelayedProduce($B, n_new),
        OnChainInstantProduce($A, n_new) ]->
    [ OnChainDelayed($B, n_new, newCommitB),
      OnChainInstant($A, n_new, newCommitB) ]

// ---------------------------------------------------------------------------
// Cooperative close
// ---------------------------------------------------------------------------

rule Honest_Close:
    let closetx = <'commit', ptr, $A, $B, n, fA, fB>
        signA   = sign(closetx, ltkA)
        signB   = sign(closetx, ltkB)
    in
    [ StateA($A, $B, ptr, n, sA, commitA, fA, fB),
      StateB($A, $B, ptr, n, sB, commitB, fA, fB),
      !ValidOnChain(ptr),
      !Ltk($A, ltkA), !Ltk($B, ltkB),
      !Pk($A, pkA),   !Pk($B, pkB) ]
    --[ Close($A, $B, ptr, n),
        OnChainInstantProduce($A, n),
        OnChainInstantProduce($B, n),
        Eq(verify(signA, closetx, pkA), true),
        Eq(verify(signB, closetx, pkB), true) ]->
    [ OnChainInstant($A, n, closetx),
      OnChainInstant($B, n, closetx) ]

// ---------------------------------------------------------------------------
// Cheat / punishment
// ---------------------------------------------------------------------------

// Publish_Revoked_A/B consume a linear RevealedSecret fact (not the persistent
// !RevokedSecret) so that Punish_A/B can fire at most once per cheat event.
// In reality the penalty transaction spends the revocation-key output exactly
// once; a persistent read would allow infinite re-punishment (a modelling bug,
// not a protocol bug).  We create the linear fact here from the persistent
// !RevokedSecret so the secret is still remembered for future state-update
// checks, but the punishment path is one-shot.
rule Publish_Revoked_A:
    [ !ChannelRecord(ptr, $A, $B),
      !ValidOnChain(ptr),
      !RevokedSecret($A, n_old, sAold, oldCommitA),
      RevokedCommitmentUnspent(ptr, $A, $B, n_old, oldCommitA) ]
    --[ PublishRevoked($A, n_old, oldCommitA),
        Cheat($A, n_old) ]->
    [ OnChainCheat($A, $B, n_old, oldCommitA),
      RevealedSecret($A, n_old, sAold, oldCommitA) ]

rule Publish_Revoked_B:
    [ !ChannelRecord(ptr, $A, $B),
      !ValidOnChain(ptr),
      !RevokedSecret($B, n_old, sBold, oldCommitB),
      RevokedCommitmentUnspent(ptr, $B, $A, n_old, oldCommitB) ]
    --[ PublishRevoked($B, n_old, oldCommitB),
        Cheat($B, n_old) ]->
    [ OnChainCheat($B, $A, n_old, oldCommitB),
      RevealedSecret($B, n_old, sBold, oldCommitB) ]

// Punish rules consume both OnChainCheat and the linear RevealedSecret,
// making the punishment a one-shot event (mirrors spending the penalty output).
rule Punish_A:
    [ OnChainCheat($A, $B, n_old, oldCommitA),
      RevealedSecret($A, n_old, sAold, oldCommitA) ]
    --[ Punish($B, $A, n_old) ]->
    [ AllFundsTo($B) ]

rule Punish_B:
    [ OnChainCheat($B, $A, n_old, oldCommitB),
      RevealedSecret($B, n_old, sBold, oldCommitB) ]
    --[ Punish($A, $B, n_old) ]->
    [ AllFundsTo($A) ]

// ---------------------------------------------------------------------------
// Settlement rules
// ---------------------------------------------------------------------------

rule Instant_Funds_A:
    [ OnChainInstant($A, n, txContent) ]
    --[ FundsSettled($A, n), SettledTx($A, txContent) ]->
    [ ]

rule Instant_Funds_B:
    [ OnChainInstant($B, n, txContent) ]
    --[ FundsSettled($B, n), SettledTx($B, txContent) ]->
    [ ]

rule Claim_Funds_A:
    [ OnChainDelayed($A, n, txContent) ]
    --[ ClaimFunds($A, n), CSVPassed($A, n), SettledTx($A, txContent) ]->
    [ FundsTo($A, n) ]

rule Claim_Funds_B:
    [ OnChainDelayed($B, n, txContent) ]
    --[ ClaimFunds($B, n), CSVPassed($B, n), SettledTx($B, txContent) ]->
    [ FundsTo($B, n) ]

// ---------------------------------------------------------------------------
// HTLC layer
// ---------------------------------------------------------------------------


// ---------------------------------------------------------------------------
// HTLC layer -- GENERALIZED to N hops via a linear Route fact.
//
// The fixed Forward1/Forward2 rules are replaced by ONE generic Forward_HTLC
// that consumes Route(prev,me,..) and produces Route(me,next,..), so the chain
// Sender -> (Forward)* -> Receiver has ANY length.  The HTLC is passed as a
// linear fact (an idealized channel) rather than a signed message: this is what
// makes Tamarin's source analysis terminate.  The INVOICE stays signed, so the
// invoice-authentication lemmas are unaffected.
// ---------------------------------------------------------------------------

rule Receiver_Create_Invoice:
    let y = h(~x)
        invoice = <$Receiver, $Sender, y>
        sigR    = sign(invoice, ltkR)
    in
    [ Fr(~x), !Ltk($Receiver, ltkR) ]
    --[ InvoiceCreated($Receiver, $Sender, y),
        SecretPreimage($Receiver, ~x) ]->
    [ ReceiverInv($Receiver, $Sender, ~x),
      Out(<'SecretRS', invoice, sigR>) ]

// Sender verifies the signed invoice, locks the HTLC, and STARTS the route chain.
rule Sender_Offer_HTLC:
    let invoice = <$Receiver, $Sender, y>
    in
    [ In(<'SecretRS', invoice, sigR>),
      !Pk($Receiver, pkR),
      !Ltk($Sender, ltkS),
      !ChannelConnect(ptrSF, $Sender, $Forward1) ]
    --[ HTLCOffered($Sender, $Forward1, ptrSF, y),
        HTLCAdded(ptrSF, y),
        Neq($Sender, $Forward1),
        Neq($Sender, $Receiver),
        Neq($Forward1, $Receiver),
        Eq(verify(sigR, invoice, pkR), true) ]->
    [ SenderPending($Sender, $Forward1, $Receiver, ptrSF, y),
      Route($Sender, $Forward1, ptrSF, y) ]

// GENERIC FORWARD -- one rule, any number of hops.
rule Forward_HTLC:
    [ Route($Prev, $Me, ptrIn, y),
      !ChannelConnect(ptrOut, $Me, $Next) ]
    --[ HTLCForwarded($Me, $Prev, $Next, ptrIn, ptrOut, y),
        HTLCAdded(ptrOut, y),
        ForwardHTLC($Me, ptrIn, ptrOut, y),
        Neq(ptrIn, ptrOut), Neq($Prev, $Me), Neq($Me, $Next) ]->
    [ IntermediaryPending($Me, $Prev, $Next, ptrIn, ptrOut, y),
      Route($Me, $Next, ptrOut, y) ]

// Receiver fulfils the final route hop, revealing the preimage backward.
rule Receiver_Fulfill_HTLC:
    [ Route($Prev, $Receiver, ptrIn, y),
      ReceiverInv($Receiver, $Sender, x) ]
    --[ HTLCFulfilled($Receiver, $Prev, ptrIn, y),
        PreimageReleased($Receiver, x),
        Redeemed(ptrIn, y),
        Eq(h(x), y) ]->
    [ Fulfill(ptrIn, x) ]

rule Intermediary_Settle:
    [ IntermediaryPending($Me, $Prev, $Next, ptrIn, ptrOut, y),
      Fulfill(ptrOut, x) ]
    --[ IntermediaryClaimed($Me, $Prev, ptrIn, x),
        Redeemed(ptrIn, y),
        Eq(h(x), y) ]->
    [ Fulfill(ptrIn, x) ]

rule Sender_Settle:
    [ SenderPending($Sender, $Forward1, $Receiver, ptrSF, y),
      Fulfill(ptrSF, x) ]
    --[ SenderSettled($Sender, $Forward1, $Receiver, ptrSF, x),
        PaymentComplete($Sender, $Receiver, h(x)),
        Redeemed(ptrSF, y),
        Eq(h(x), y) ]->
    [ ]

rule Open_Timeout:
    [ !ChannelConnect(ptr, A, B) ] --[ TimedOut(ptr) ]-> [ !Timeout(ptr) ]

rule Sender_Timeout_Refund:
    [ SenderPending($Sender, $Forward1, $Receiver, ptrSF, y), !Timeout(ptrSF) ]
    --[ HTLCRefunded($Sender, ptrSF, y), Refunded(ptrSF, y) ]->
    [ ]

rule Intermediary_Timeout_Refund:
    [ IntermediaryPending($Me, $Prev, $Next, ptrIn, ptrOut, y), !Timeout(ptrOut) ]
    --[ HTLCRefunded($Me, ptrOut, y), Refunded(ptrOut, y) ]->
    [ ]


restriction OneOutcomePerHTLC:
    "All ptr y #i #j.
       Redeemed(ptr, y) @ #i & Refunded(ptr, y) @ #j ==> F"

restriction Inequality:
    "All x y #i. Neq(x, y) @ #i ==> not(x = y)"

restriction Equality:
    "All x y #i. Eq(x, y) @ #i ==> x = y"

restriction OneTimeoutPerPtr:
    "All ptr #i #j. TimedOut(ptr) @ #i & TimedOut(ptr) @ #j ==> #i = #j"

restriction OneChannelPerPtr:
    "All A B C D ptr #i #j.
       ChannelOpen(A, B, ptr) @ #i
     & ChannelOpen(C, D, ptr) @ #j
     ==> #i = #j"


// ---------------------------------------------------------------------------
// Timing model (T1-T3): the CLTV-delta invariant for Intermediary_Never_Loses.
// See cltv_blocks.spthy for the assumption-free block-number derivation of
// why this is the right set of restrictions (and what their limits are).
// ---------------------------------------------------------------------------

// T1: redemption is valid only before a channel times out.
restriction RedeemBeforeTimeout:
    "All ptr y #i #j.
        Redeemed(ptr, y) @ #i & TimedOut(ptr) @ #j ==> #i < #j"

// T2: each hop sets the outgoing timeout strictly shorter than the incoming
// timeout (CLTV-delta invariant).
restriction ForwardTimeGap:
    "All P ptrIn ptrOut y #f #j #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #f
      & TimedOut(ptrOut) @ #j
      & TimedOut(ptrIn)  @ #k
     ==> #j < #k"

// LIVENESS ASSUMPTION (T2b): honest parties claim within their CLTV window.
// If ForwardHTLC connects two channels and the incoming channel times out,
// then the outgoing channel must have already timed out.  This encodes the
// assumption that every honest intermediary acts before their incoming
// deadline — it is NOT derived from the protocol rules.  The arithmetic that
// makes the window non-empty is proved in cltv_blocks.spthy, but whether
// the node actually sweeps in time is assumed here.  Without this restriction
// the early-timeout race (TimedOut(ptrIn) before Redeemed(ptrOut)) leaves T3
// inapplicable and Intermediary_Never_Loses is genuinely falsifiable.
// See t2b_attack.spthy for the machine-checked exists-trace witness.
restriction HonestPartiesActBeforeIncomingTimeout:
    "All P ptrIn ptrOut y #f #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #f
      & TimedOut(ptrIn) @ #k
     ==> Ex #m. TimedOut(ptrOut) @ #m & #m < #k"

// T3: if an honest intermediary's outgoing HTLC is redeemed before the
// incoming timeout, the node sweeps the incoming HTLC.
restriction IntermediaryMustClaim:
    "All P ptrIn ptrOut y #f #i #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #f
      & Redeemed(ptrOut, y) @ #i
      & TimedOut(ptrIn)  @ #k
      & #i < #k
     ==> Ex #l. Redeemed(ptrIn, y) @ #l"

// ---------------------------------------------------------------------------
// Lemmas -- payment channel layer
// ---------------------------------------------------------------------------

lemma state_update [use_induction]:
    "All A B ptr n #i.
       StateUpdate(A, B, ptr, n) @ #i
     ==> Ex #j. ChannelOpen(A, B, ptr) @ #j & #j < #i"

lemma delayed_funds:
    "All A n #i.
       ClaimFunds(A, n) @ #i
     ==> Ex #j. OnChainDelayedProduce(A, n) @ #j & #j < #i"

lemma instant_funds:
    "All A n #i.
       FundsSettled(A, n) @ #i
     ==> Ex #j. OnChainInstantProduce(A, n) @ #j & #j < #i"

lemma settlement_is_traceable:
    "All A n #i.
       FundsSettled(A, n) @ #i
     ==> Ex tx #j. SettledTx(A, tx) @ #j & #j = #i"

lemma Protocol_execution:
    exists-trace
    "Ex A B ptr n fA fB #i #j #k #l.
        ChannelOpen(A, B, ptr) @ #i
      & NewStateBuilt(A, B, ptr, n, fA, fB) @ #j
      & StateUpdate(A, B, ptr, n) @ #k
      & Close(A, B, ptr, n) @ #l
      & #i < #j & #j < #k & #k < #l"

lemma No_Punishment_Without_Cheating:
    "All A B n #i.
        Punish(B, A, n) @ #i
     ==> (Ex #k. Cheat(A, n) @ #k & #k < #i)
       | (Ex #j. LtkCompromised(A) @ #j & #j < #i)"

lemma Cooperative_Close_Execution:
    exists-trace
    "Ex A B ptr n #k #i.
        ChannelOpen(A, B, ptr) @ #k
      & Close(A, B, ptr, n) @ #i
      & #k < #i
      & not (Ex A2 B2 ptr2 n2 #j. StateUpdate(A2, B2, ptr2, n2) @ #j)"

lemma Funds_Locked_Before_Update [use_induction]:
    "All A B ptr n #i.
       StateUpdate(A, B, ptr, n) @ #i
     ==> Ex #j. FundsLocked(A, B, ptr) @ #j & #j < #i"

lemma Update_Requires_Negotiation [use_induction]:
    "All A B ptr n #i.
         StateUpdate(A, B, ptr, n) @ #i
     ==> Ex fA fB #j. NewStateBuilt(A, B, ptr, n, fA, fB) @ #j & #j < #i"

// ---------------------------------------------------------------------------
// Lemmas -- HTLC / payment layer
// ---------------------------------------------------------------------------

lemma Ltk_Known_Implies_Compromised [reuse]:
    "All A ltk #i #j.
        KeyGen(A, ltk) @ #i
      & !KU(ltk) @ #j
     ==> Ex #r. LtkCompromised(A) @ #r"

// Gap 2: Replay / freshness.
// ReceiverInv is linear and consumed on fulfillment; ~x is fresh per invoice.
// Therefore a given preimage is released by the receiver at most once.
// Even if the adversary replays the public 'fulfill' message, it cannot force
// a second release from the receiver -- the linear fact is gone.
lemma Invoice_Released_Once [reuse]:
    "All R x #i #j.
        PreimageReleased(R, x) @ #i
      & PreimageReleased(R, x) @ #j
     ==> #i = #j"

lemma Distinct_Parties_Configuration:
    exists-trace
    "Ex S F1 F2 R ptrSF1 ptrF1F2 ptrF2R #c1 #c2 #c3.
        ChannelOpen(S, F1, ptrSF1)   @ #c1
      & ChannelOpen(F1, F2, ptrF1F2) @ #c2
      & ChannelOpen(F2, R, ptrF2R)   @ #c3
      & not (S = F1) & not (S = F2) & not (S = R)
      & not (F1 = F2) & not (F1 = R) & not (F2 = R)
      & not (Ex P #r. LtkCompromised(P) @ #r)
      & not (Ex P Q p n #u. StateUpdate(P, Q, p, n) @ #u)
      & not (Ex P n #u. PublishState(P, n) @ #u)
      & not (Ex P Q p n #u. Close(P, Q, p, n) @ #u)
      & not (Ex P n #u. Cheat(P, n) @ #u)"

lemma Refund_Possible:
    exists-trace
    "Ex S F1 R p y #i #j #k.
        InvoiceCreated(R, S, y) @ #j
      & HTLCOffered(S, F1, p, y) @ #k
      & HTLCRefunded(S, p, y) @ #i
      & #j < #k & #k < #i
      & not (Ex A MidP B p2 x #u. SenderSettled(A, MidP, B, p2, x) @ #u)
      & not (Ex P #r. LtkCompromised(P) @ #r)
      & not (Ex Me Prev Next pi po y2 #u. HTLCForwarded(Me, Prev, Next, pi, po, y2) @ #u)"

lemma Preimage_Secret_Until_Released:
    "All R x #i #j.
        SecretPreimage(R, x) @ #i
      & K(x) @ #j
      & #i < #j
     ==> Ex #k. PreimageReleased(R, x) @ #k & #k < #j"

lemma Invoice_Has_Secret_Preimage [reuse]:
    "All R S x #i.
        InvoiceCreated(R, S, h(x)) @ #i
     ==> SecretPreimage(R, x) @ #i"

lemma HTLC_On_Opened_Channel [reuse, use_induction]:
    "All ptr y #i.
        HTLCAdded(ptr, y) @ #i
     ==> Ex X Y #j. ChannelOpen(X, Y, ptr) @ #j & #j < #i"

// NOTE: verifies in the fixed-hop multihop.spthy; in this generic model the
// backward resolution of SenderSettled walks the whole generic settle chain
// and does not terminate.  Left as the single open lemma of the N-hop variant.
lemma Settle_Requires_Receiver_Release:
    "All S F1 R ptr x #i #j.
        SenderSettled(S, F1, R, ptr, x) @ #i
      & InvoiceCreated(R, S, h(x)) @ #j
     ==> Ex #k. PreimageReleased(R, x) @ #k & #k < #i"

lemma Claim_Requires_Release [use_induction]:
    "All MidP InP ptrIn R x #i #j.
        IntermediaryClaimed(MidP, InP, ptrIn, x) @ #i
      & SecretPreimage(R, x) @ #j
     ==> Ex #k. PreimageReleased(R, x) @ #k & #k < #i"

lemma Settle_Excludes_Sender_Refund:
    "All S F1 R ptr x #i.
        SenderSettled(S, F1, R, ptr, x) @ #i
     ==> not (Ex #j. HTLCRefunded(S, ptr, h(x)) @ #j)"

lemma Invoice_Authenticates_Settlement:
    "All S F1 R ptr x #i.
        SenderSettled(S, F1, R, ptr, x) @ #i
     ==> (Ex #j. InvoiceCreated(R, S, h(x)) @ #j & #j < #i)
       | (Ex #r. LtkCompromised(R) @ #r & #r < #i)"

lemma Forged_Invoice_Requires_Key_Compromise:
    exists-trace
    "Ex S F1 R ptr x #i #r.
        SenderSettled(S, F1, R, ptr, x) @ #i
      & LtkCompromised(R) @ #r
      & not (Ex #j. InvoiceCreated(R, S, h(x)) @ #j)
      & not (Ex Me Prev Next pi po y #u. HTLCForwarded(Me, Prev, Next, pi, po, y) @ #u)"

lemma Loss_Requires_Inaction:
    "All P ptrIn ptrOut y #i #j #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #i
      & Redeemed(ptrOut, y) @ #j
      & Refunded(ptrIn, y) @ #k
     ==> not (Ex #l. Redeemed(ptrIn, y) @ #l)"

// Helper for Intermediary_Never_Loses: pre-computes Refunded -> TimedOut chain.
lemma Refund_Requires_Timeout [reuse]:
    "All ptr y #i.
        Refunded(ptr, y) @ #i
     ==> Ex #j. TimedOut(ptr) @ #j & #j < #i"

// Gap 4: conditional on HonestPartiesActBeforeIncomingTimeout (T2b liveness).
// An honest routing node whose outgoing HTLC is redeemed cannot have its
// incoming HTLC refunded unless its key was compromised.
// The proof is 2 steps because T2b hands Tamarin the ordering it needs; the
// interesting content is in the restriction, not the lemma.  An unconditional
// version would require watchtower-liveness as an explicit hypothesis.
lemma Intermediary_Never_Loses_Under_Liveness:
    "All P ptrIn ptrOut y #f #i #j.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #f
      & Redeemed(ptrOut, y) @ #i
      & Refunded(ptrIn, y) @ #j
     ==> Ex #r. LtkCompromised(P) @ #r"

// Slide 14's "should happen atomically" (red box) — CONDITIONAL on T2b.
// This proves that once the receiver fulfills the final HTLC, the sender's
// HTLC on the same payment hash cannot be refunded in the honest model.
// The proof is 2 steps because HonestPartiesActBeforeIncomingTimeout (T2b)
// asserts the liveness ordering that makes T3 applicable; the content of the
// property is mostly in the restriction, not the lemma.  This does NOT prove
// unconditional atomicity — cltv_blocks.spthy shows the claim windows exist
// arithmetically, and T2b assumes honest parties use them.
lemma Payment_Atomicity_Under_Liveness:
    "All F1 F2 ptrSF1 ptrF1F2 ptrF2R y #f1 #f2 #i.
        ForwardHTLC(F1, ptrSF1, ptrF1F2, y) @ #f1
      & ForwardHTLC(F2, ptrF1F2, ptrF2R, y) @ #f2
      & Redeemed(ptrF2R, y) @ #i
      & (not Ex P #r. LtkCompromised(P) @ #r)
     ==> not (Ex #u. Refunded(ptrSF1, y) @ #u)"

// T2b is load-bearing: the early-timeout race IS reachable without it.
// See t2b_attack.spthy for the machine-checked exists-trace that demonstrates
// this.  That file strips HonestPartiesActBeforeIncomingTimeout and proves the race as an
// exists-trace; Tamarin finds a concrete witness.  The pair (race reachable
// in t2b_attack.spthy; race blocked by T2b here) is the two-sided certificate
// that T2b earns its place — neither half alone is sufficient.
//
// This lemma only proves the race is blocked WITH the liveness restriction active.
// The companion t2b_attack.spthy is needed to show the race is reachable WITHOUT it.
lemma T2b_Counterexample_Blocked:
    "not (Ex P ptrIn ptrOut y #f #i #j #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #f
      & TimedOut(ptrIn)     @ #k
      & Refunded(ptrIn, y)  @ #j
      & Redeemed(ptrOut, y) @ #i
      & #k < #i)"

// --- GENERALIZED routing lemmas (any chain length) ---------------------------

// Non-vacuity: a two-intermediary chain settles (uses the generic Forward).
// Non-vacuity: a two-intermediary chain settles.  The negative guards "freeze
// the network" -- without them the generic Forward rule lets Tamarin explore
// unboundedly many alternative routes and the witness search never terminates.
lemma Multihop_Payment_Possible:
    exists-trace
    "Ex S F1 F2 R p0 p1 p2 x #t2 #t3 #t4 #t5.
        HTLCOffered(S, F1, p0, h(x))              @ #t2
      & HTLCForwarded(F1, S, F2, p0, p1, h(x))    @ #t3
      & HTLCForwarded(F2, F1, R, p1, p2, h(x))    @ #t4
      & HTLCFulfilled(R, F2, p2, h(x))            @ #t5
      & #t2 < #t3 & #t3 < #t4 & #t4 < #t5
      & not (Ex A B p y #u. HTLCOffered(A, B, p, y) @ #u & not(A=S & B=F1))
      & not (Ex Me Prev Next pi po y #u. HTLCForwarded(Me, Prev, Next, pi, po, y) @ #u
             & not(Me=F1 & Prev=S & Next=F2)
             & not(Me=F2 & Prev=F1 & Next=R))"

// Causality (any hop): a forward is preceded by the offer or the previous forward.
lemma Forward_Requires_Incoming [use_induction]:
    "All Me Prev Next ptrIn ptrOut y #i.
        HTLCForwarded(Me, Prev, Next, ptrIn, ptrOut, y) @ #i
     ==> (Ex S #j. HTLCOffered(S, Me, ptrIn, y) @ #j & #j < #i)
       | (Ex P0 pin0 #j. HTLCForwarded(Prev, P0, Me, pin0, ptrIn, y) @ #j & #j < #i)"

// Authentication/atomicity (any length): nothing is redeemed unless the genuine
// receiver released the matching preimage.
lemma Redeem_Requires_Receiver_Release [use_induction]:
    "All ptr y #i.
        Redeemed(ptr, y) @ #i
     ==> Ex R x #k. PreimageReleased(R, x) @ #k & h(x) = y"

end
