// Receiver, sender and two intermediaries in a Lightning Network payment
// channel network, with full channel lifecycle (handshake, state-update,
// revocation/punishment, on-chain settlement) and a staggered-CLTV timing
// model.
//
// Run with: tamarin-prover multihop.spthy --prove=<LemmaName>
// Use LANG=C.utf8 LC_ALL=C.utf8 to avoid Unicode encoding crashes.
// For the existence lemma: --prove=Multihop_Payment_Possible --stop-on-trace=SEQDFS
//
// --- Relationship to companion files ---
// This file, gaps.spthy, value_conservation.spthy, and cltv_blocks.spthy are
// FOUR SEPARATE TAMARIN THEORIES.  A property proved in one is not proved in
// the system the others describe.  In particular:
//   gaps.spthy      -- has the zombie-channel fix (linear ChannelOpen token,
//                      NoHTLCAfterClose restriction) and a Lt-based clock.
//   cltv_blocks.spthy -- derives the CLTV-delta arithmetic (windows are
//                        non-empty, staggering is safe) as pure lemmas over
//                        natural-number blocks; no protocol rules.
//   this file       -- has Intermediary_Never_Loses and Payment_Atomicity but
//                      NOT the zombie-channel enforcement from gaps.spthy.
// The zombie-channel fix was prototyped and then reverted here because adding
// ChannelClosed to Honest_Close caused Intermediary_Never_Loses to OOM in
// this environment; the two properties do not currently coexist in one file.
// That is a known limitation, not a hidden one.
//
// --- Liveness assumption (T2b / OutgoingTimeoutFirst) ---
// Intermediary_Never_Loses and Payment_Atomicity are conditional on T2b.
// T2b encodes the assumption that every honest party claims/publishes within
// their CLTV window (i.e. TimedOut(ptrOut) fires before TimedOut(ptrIn)).
// This is a LIVENESS assumption, not a derived fact.  cltv_blocks.spthy
// proves that the claim windows are arithmetically non-empty; it does not
// prove that parties act within them.  T2b is where the unproven "they act
// in time" premise enters the model.  Without T2b, the early-timeout race
// (adversary fires TimedOut(ptrIn) before Redeemed(ptrOut), making T3
// inapplicable) is a genuine counterexample to both lemmas.
theory multihop
begin

builtins: hashing, signing

// ---------------------------------------------------------------------------
// Key management
// ---------------------------------------------------------------------------

rule Register_key:
    [ Fr(~ltk) ]
    --[ KeyGen($A, ~ltk) ]->
    [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)), Out(pk(~ltk)) ]

rule Compromise_Ltk:
    [ !Ltk($A, ltk) ]
    --[ LtkCompromised($A) ]->
    [ Out(ltk) ]

// ---------------------------------------------------------------------------
// Wallet / funds
// ---------------------------------------------------------------------------

rule Acquire_funds:
    [ Fr(~f) ]
    --[ FundsAcquired($A, ~f) ]->
    [ Wallet($A, ~f) ]

// ---------------------------------------------------------------------------
// Channel handshake
// ---------------------------------------------------------------------------

rule A_Send_Proposal:
    let proposal = <'proposal', $A, $B, ~ptr>
        sigA     = sign(proposal, ltkA)
    in
    [ Fr(~ptr), !Ltk($A, ltkA) ]
    --[ A_ProposalSent($A, $B, ~ptr) ]->
    [ A_WaitAck($A, $B, ~ptr),
      Out(<'proposal', $A, $B, ~ptr, sigA>) ]

rule B_Recv_Proposal:
    let proposal = <'proposal', $A, $B, ptr>
        sigB     = sign(proposal, ltkB)
    in
    [ !Ltk($B, ltkB), !Pk($A, pkA),
      In(<'proposal', $A, $B, ptr, sigA>) ]
    --[ ProposalExchange($A, $B, ptr),
        Eq(verify(sigA, proposal, pkA), true) ]->
    [ !ProposalCommitted($A, $B, ptr),
      Out(<'proposal_ack', $A, $B, ptr, sigB>) ]

rule A_Recv_From_B:
    let proposal = <'proposal', $A, $B, ptr>
    in
    [ A_WaitAck($A, $B, ptr),
      !Pk($B, pkB),
      In(<'proposal_ack', $A, $B, ptr, sigB>) ]
    --[ A_Received($A, $B, ptr),
        Eq(verify(sigB, proposal, pkB), true) ]->
    [ !A_HandshakeDone($A, $B, ptr) ]

// ---------------------------------------------------------------------------
// Initial channel state commitment
// ---------------------------------------------------------------------------

rule Create_State_A:
    let commitA0 = <'commit', ptr, $A, $B, '0', h(~sA0)>
        sigA0    = sign(commitA0, ltkA)
    in
    [ Fr(~sA0), !Ltk($A, ltkA),
      !A_HandshakeDone($A, $B, ptr) ]
    --[ StateCreated($A, '0', commitA0) ]->
    [ CommittedStateA($A, $B, ptr, '0', ~sA0, commitA0, sigA0) ]

rule Create_State_B:
    let commitB0 = <'commit', ptr, $B, $A, '0', h(~sB0)>
        sigB0    = sign(commitB0, ltkB)
    in
    [ Fr(~sB0), !Ltk($B, ltkB),
      !ProposalCommitted($A, $B, ptr) ]
    --[ StateCreated($B, '0', commitB0) ]->
    [ CommittedStateB($A, $B, ptr, '0', ~sB0, commitB0, sigB0) ]

rule Both_States_Committed:
    [ CommittedStateA($A, $B, ptr, '0', sA0, commitA0, sigA0),
      CommittedStateB($A, $B, ptr, '0', sB0, commitB0, sigB0),
      !Pk($A, pkA), !Pk($B, pkB) ]
    --[ Stage1Complete($A, $B, ptr),
        Eq(verify(sigA0, commitA0, pkA), true),
        Eq(verify(sigB0, commitB0, pkB), true) ]->
    [ ReadyToLock($A, $B, ptr, sA0, sB0, commitA0, commitB0) ]

rule Lock_Funds_And_Open:
    [ ReadyToLock($A, $B, ptr, sA0, sB0, commitA0, commitB0),
      Wallet($A, ~fA), Wallet($B, ~fB) ]
    --[ ChannelOpen($A, $B, ptr), FundsLocked($A, $B, ptr),
        NewStateBuilt($A, $B, ptr, '0', ~fA, ~fB) ]->
    [ StateA($A, $B, ptr, '0', sA0, commitA0, ~fA, ~fB),
      StateB($A, $B, ptr, '0', sB0, commitB0, ~fA, ~fB),
      !ValidOnChain(ptr),
      !ChannelRecord(ptr, $A, $B),
      !ChannelConnect(ptr, $A, $B),   // permits HTLC from A to B
      !ChannelConnect(ptr, $B, $A) ]  // permits HTLC from B to A (Neq restriction distinguishes hops)

// ---------------------------------------------------------------------------
// State update & revocation
// ---------------------------------------------------------------------------

rule Update_State:
    let newCommitA = <'commit', ptr, $A, $B, ~n_new, h(~sAnew)>
        newCommitB = <'commit', ptr, $B, $A, ~n_new, h(~sBnew)>
        sigAnew    = sign(newCommitA, ltkA)
        sigBnew    = sign(newCommitB, ltkB)
    in
    [ Fr(~n_new), Fr(~sAnew), Fr(~sBnew),
      !Ltk($A, ltkA), !Ltk($B, ltkB),
      StateA($A, $B, ptr, n_old, sAold, oldCommitA, fA, fB),
      StateB($A, $B, ptr, n_old, sBold, oldCommitB, fA, fB),
      In(<fA_new, fB_new>) ]
    --[ NewStateBuilt($A, $B, ptr, ~n_new, fA_new, fB_new) ]->
    [ PendingA($A, $B, ptr, n_old, sAold, oldCommitA,
               ~n_new, ~sAnew, newCommitA, sigAnew, fA_new, fB_new),
      PendingB($A, $B, ptr, n_old, sBold, oldCommitB,
               ~n_new, ~sBnew, newCommitB, sigBnew, fA_new, fB_new) ]

rule Revoke_Old_Secret:
    [ PendingA($A, $B, ptr, n_old, sAold, oldCommitA,
               n_new, sAnew, newCommitA, sigAnew, fA_new, fB_new),
      PendingB($A, $B, ptr, n_old, sBold, oldCommitB,
               n_new, sBnew, newCommitB, sigBnew, fA_new, fB_new),
      !Pk($A, pkA), !Pk($B, pkB) ]
    --[ StateUpdate($A, $B, ptr, n_new),
        Revoke($A, n_old, sAold),
        Revoke($B, n_old, sBold),
        Eq(verify(sigAnew, newCommitA, pkA), true),
        Eq(verify(sigBnew, newCommitB, pkB), true) ]->
    [ StateA($A, $B, ptr, n_new, sAnew, newCommitA, fA_new, fB_new),
      StateB($A, $B, ptr, n_new, sBnew, newCommitB, fA_new, fB_new),
      !RevokedSecret($A, n_old, sAold, oldCommitA),
      !RevokedSecret($B, n_old, sBold, oldCommitB) ]

// ---------------------------------------------------------------------------
// On-chain publish paths
// ---------------------------------------------------------------------------

rule Publish_Old_Grace_Period_A:
    [ PendingA($A, $B, ptr, n_old, sAold, oldCommitA,
               n_new, sAnew, newCommitA, sigAnew, fA_new, fB_new),
      !ValidOnChain(ptr) ]
    --[ PublishOldBeforeRevocation($A, n_old),
        PublishState($A, n_old),
        OnChainDelayedProduce($A, n_old),
        OnChainInstantProduce($B, n_old) ]->
    [ OnChainDelayed($A, n_old, oldCommitA),
      OnChainInstant($B, n_old, oldCommitA) ]

rule Publish_Old_Grace_Period_B:
    [ PendingB($A, $B, ptr, n_old, sBold, oldCommitB,
               n_new, sBnew, newCommitB, sigBnew, fA_new, fB_new),
      !ValidOnChain(ptr) ]
    --[ PublishOldBeforeRevocation($B, n_old),
        PublishState($B, n_old),
        OnChainDelayedProduce($B, n_old),
        OnChainInstantProduce($A, n_old) ]->
    [ OnChainDelayed($B, n_old, oldCommitB),
      OnChainInstant($A, n_old, oldCommitB) ]

rule Publish_Current_A:
    [ StateA($A, $B, ptr, n, sA, commitA, fA, fB), !ValidOnChain(ptr) ]
    --[ Publish($A, n, commitA),
        PublishState($A, n),
        OnChainDelayedProduce($A, n),
        OnChainInstantProduce($B, n) ]->
    [ OnChainDelayed($A, n, commitA),
      OnChainInstant($B, n, commitA) ]

rule Publish_Current_B:
    [ StateB($A, $B, ptr, n, sB, commitB, fA, fB), !ValidOnChain(ptr) ]
    --[ Publish($B, n, commitB),
        PublishState($B, n),
        OnChainDelayedProduce($B, n),
        OnChainInstantProduce($A, n) ]->
    [ OnChainDelayed($B, n, commitB),
      OnChainInstant($A, n, commitB) ]

rule Publish_Pending_A:
    [ PendingA($A, $B, ptr, n_old, sAold, oldCommitA,
               n_new, sAnew, newCommitA, sigAnew, fA_new, fB_new),
      !ValidOnChain(ptr) ]
    --[ Publish($A, n_new, newCommitA),
        PublishFromPending($A, n_old, n_new),
        OnChainDelayedProduce($A, n_new),
        OnChainInstantProduce($B, n_new) ]->
    [ OnChainDelayed($A, n_new, newCommitA),
      OnChainInstant($B, n_new, newCommitA) ]

rule Publish_Pending_B:
    [ PendingB($A, $B, ptr, n_old, sBold, oldCommitB,
               n_new, sBnew, newCommitB, sigBnew, fA_new, fB_new),
      !ValidOnChain(ptr) ]
    --[ Publish($B, n_new, newCommitB),
        PublishFromPending($B, n_old, n_new),
        OnChainDelayedProduce($B, n_new),
        OnChainInstantProduce($A, n_new) ]->
    [ OnChainDelayed($B, n_new, newCommitB),
      OnChainInstant($A, n_new, newCommitB) ]

// ---------------------------------------------------------------------------
// Cooperative close
// ---------------------------------------------------------------------------

rule Honest_Close:
    let closetx = <'commit', ptr, $A, $B, n, fA, fB>
        signA   = sign(closetx, ltkA)
        signB   = sign(closetx, ltkB)
    in
    [ StateA($A, $B, ptr, n, sA, commitA, fA, fB),
      StateB($A, $B, ptr, n, sB, commitB, fA, fB),
      !ValidOnChain(ptr),
      !Ltk($A, ltkA), !Ltk($B, ltkB),
      !Pk($A, pkA),   !Pk($B, pkB) ]
    --[ Close($A, $B, ptr, n),
        OnChainInstantProduce($A, n),
        OnChainInstantProduce($B, n),
        Eq(verify(signA, closetx, pkA), true),
        Eq(verify(signB, closetx, pkB), true) ]->
    [ OnChainInstant($A, n, closetx),
      OnChainInstant($B, n, closetx) ]

// ---------------------------------------------------------------------------
// Cheat / punishment
// ---------------------------------------------------------------------------

rule Publish_Revoked_A:
    [ !ChannelRecord(ptr, $A, $B),
      !ValidOnChain(ptr),
      !RevokedSecret($A, n_old, sAold, oldCommitA) ]
    --[ PublishRevoked($A, n_old, oldCommitA),
        Cheat($A, n_old) ]->
    [ OnChainCheat($A, $B, n_old, oldCommitA) ]

rule Publish_Revoked_B:
    [ !ChannelRecord(ptr, $A, $B),
      !ValidOnChain(ptr),
      !RevokedSecret($B, n_old, sBold, oldCommitB) ]
    --[ PublishRevoked($B, n_old, oldCommitB),
        Cheat($B, n_old) ]->
    [ OnChainCheat($B, $A, n_old, oldCommitB) ]

rule Punish_A:
    [ OnChainCheat($A, $B, n_old, oldCommitA),
      !RevokedSecret($A, n_old, sAold, oldCommitA) ]
    --[ Punish($B, $A, n_old) ]->
    [ AllFundsTo($B) ]

rule Punish_B:
    [ OnChainCheat($B, $A, n_old, oldCommitB),
      !RevokedSecret($B, n_old, sBold, oldCommitB) ]
    --[ Punish($A, $B, n_old) ]->
    [ AllFundsTo($A) ]

// ---------------------------------------------------------------------------
// Settlement rules
// ---------------------------------------------------------------------------

rule Instant_Funds_A:
    [ OnChainInstant($A, n, txContent) ]
    --[ FundsSettled($A, n), SettledTx($A, txContent) ]->
    [ ]

rule Instant_Funds_B:
    [ OnChainInstant($B, n, txContent) ]
    --[ FundsSettled($B, n), SettledTx($B, txContent) ]->
    [ ]

rule Claim_Funds_A:
    [ OnChainDelayed($A, n, txContent) ]
    --[ ClaimFunds($A, n), CSVPassed($A, n), SettledTx($A, txContent) ]->
    [ FundsTo($A, n) ]

rule Claim_Funds_B:
    [ OnChainDelayed($B, n, txContent) ]
    --[ ClaimFunds($B, n), CSVPassed($B, n), SettledTx($B, txContent) ]->
    [ FundsTo($B, n) ]

// ---------------------------------------------------------------------------
// HTLC layer
// ---------------------------------------------------------------------------

rule Receiver_Create_Invoice:
    let y = h(~x)
        invoice = <$Receiver, $Sender, y>
        sigR    = sign(invoice, ltkR)
    in
    [ Fr(~x), !Ltk($Receiver, ltkR) ]
    --[ InvoiceCreated($Receiver, $Sender, y),
        SecretPreimage($Receiver, ~x) ]->
    [ ReceiverInv($Receiver, $Sender, ~x),
      Out(<'SecretRS', invoice, sigR>) ]

rule Sender_Offer_HTLC:
    let invoice = <$Receiver, $Sender, y>
        offer   = <'htlc1', ptrSF1, $Sender, $Forward1, y>
        sigS    = sign(offer, ltkS)
    in
    [ In(<'SecretRS', invoice, sigR>),
      !Pk($Receiver, pkR),
      !Ltk($Sender, ltkS),
      !ChannelConnect(ptrSF1, $Sender, $Forward1) ]
    --[ HTLCOffered($Sender, $Forward1, ptrSF1, y),
        HTLCAdded(ptrSF1, y),
        Eq(verify(sigR, invoice, pkR), true) ]->
    [ SenderPending($Sender, $Forward1, $Receiver, ptrSF1, y),
      Out(<'htlc1', ptrSF1, $Sender, $Forward1, y, sigS>) ]

rule Forward1_HTLC:
    let offer    = <'htlc1', ptrSF1, $Sender, $Forward1, y>
        offerFwd = <'htlc2', ptrF1F2, $Forward1, $Forward2, y>
        sigF1    = sign(offerFwd, ltkF1)
    in
    [ In(<'htlc1', ptrSF1, $Sender, $Forward1, y, sigS>),
      !Pk($Sender, pkS), !Ltk($Forward1, ltkF1),
      !ChannelConnect(ptrSF1, $Sender, $Forward1),
      !ChannelConnect(ptrF1F2, $Forward1, $Forward2) ]
    --[ HTLCForwarded1($Forward1, $Forward2, $Sender, ptrF1F2, y),
        HTLCAdded(ptrF1F2, y),
        ForwardHTLC($Forward1, ptrSF1, ptrF1F2, y),
        Neq(ptrSF1, ptrF1F2),
        Eq(verify(sigS, offer, pkS), true) ]->
    [ IntermediaryPending($Forward1, $Sender, $Forward2, ptrSF1, ptrF1F2, y),
      Out(<'htlc2', ptrF1F2, $Forward1, $Forward2, y, sigF1>) ]

rule Forward2_HTLC:
    let offer    = <'htlc2', ptrF1F2, $Forward1, $Forward2, y>
        offerFwd = <'htlc3', ptrF2R, $Forward2, $Receiver, y>
        sigF2    = sign(offerFwd, ltkF2)
    in
    [ In(<'htlc2', ptrF1F2, $Forward1, $Forward2, y, sigF1>),
      !Pk($Forward1, pkF1), !Ltk($Forward2, ltkF2),
      !ChannelConnect(ptrF1F2, $Forward1, $Forward2),
      !ChannelConnect(ptrF2R, $Forward2, $Receiver) ]
    --[ HTLCForwarded2($Forward2, $Receiver, $Forward1, ptrF2R, y),
        HTLCAdded(ptrF2R, y),
        ForwardHTLC($Forward2, ptrF1F2, ptrF2R, y),
        Neq(ptrF1F2, ptrF2R),
        Eq(verify(sigF1, offer, pkF1), true) ]->
    [ IntermediaryPending($Forward2, $Forward1, $Receiver, ptrF1F2, ptrF2R, y),
      Out(<'htlc3', ptrF2R, $Forward2, $Receiver, y, sigF2>) ]

rule Receiver_Fulfill_HTLC:
    let y        = h(x)
        offerFwd = <'htlc3', ptrF2R, $Forward2, $Receiver, y>
    in
    [ ReceiverInv($Receiver, $Sender, x),
      In(<'htlc3', ptrF2R, $Forward2, $Receiver, y, sigF2>),
      !Pk($Forward2, pkF2),
      !ChannelConnect(ptrF2R, $Forward2, $Receiver) ]
    --[ HTLCFulfilled($Receiver, $Forward2, ptrF2R, y),
        PreimageReleased($Receiver, x),
        Redeemed(ptrF2R, y),
        Eq(verify(sigF2, offerFwd, pkF2), true) ]->
    [ Out(<'fulfill', ptrF2R, x>) ]

rule Intermediary_Settle:
    [ IntermediaryPending(MidP, InP, OutP, ptrIn, ptrOut, y),
      In(<'fulfill', ptrOut, x>) ]
    --[ IntermediaryClaimed(MidP, InP, ptrIn, x),
        Redeemed(ptrIn, y),
        Eq(h(x), y) ]->
    [ Out(<'fulfill', ptrIn, x>) ]

rule Sender_Settle:
    [ SenderPending($Sender, $Forward1, $Receiver, ptrSF1, y),
      In(<'fulfill', ptrSF1, x>) ]
    --[ SenderSettled($Sender, $Forward1, $Receiver, ptrSF1, x),
        PaymentComplete($Sender, $Receiver, h(x)),
        Redeemed(ptrSF1, y),
        Eq(h(x), y) ]->
    [ ]

rule Open_Timeout:
    [ !ChannelConnect(ptr, A, B) ]
    --[ TimedOut(ptr) ]->
    [ !Timeout(ptr) ]

rule Sender_Timeout_Refund:
    [ SenderPending($Sender, $Forward1, $Receiver, ptrSF1, y),
      !Timeout(ptrSF1) ]
    --[ HTLCRefunded($Sender, ptrSF1, y),
        Refunded(ptrSF1, y) ]->
    [ ]

rule Intermediary_Timeout_Refund:
    [ IntermediaryPending(MidP, InP, OutP, ptrIn, ptrOut, y),
      !Timeout(ptrOut) ]
    --[ HTLCRefunded(MidP, ptrOut, y),
        Refunded(ptrOut, y) ]->
    [ ]

// ---------------------------------------------------------------------------
// Restrictions
// ---------------------------------------------------------------------------

restriction OneOutcomePerHTLC:
    "All ptr y #i #j.
       Redeemed(ptr, y) @ #i & Refunded(ptr, y) @ #j ==> F"

restriction Inequality:
    "All x y #i. Neq(x, y) @ #i ==> not(x = y)"

restriction Equality:
    "All x y #i. Eq(x, y) @ #i ==> x = y"

restriction OneTimeoutPerPtr:
    "All ptr #i #j. TimedOut(ptr) @ #i & TimedOut(ptr) @ #j ==> #i = #j"

restriction OneChannelPerPtr:
    "All A B C D ptr #i #j.
       ChannelOpen(A, B, ptr) @ #i
     & ChannelOpen(C, D, ptr) @ #j
     ==> #i = #j"


// ---------------------------------------------------------------------------
// Timing model (T1-T3): the CLTV-delta invariant for Intermediary_Never_Loses.
// See cltv_blocks.spthy for the assumption-free block-number derivation of
// why this is the right set of restrictions (and what their limits are).
// ---------------------------------------------------------------------------

// T1: redemption is valid only before a channel times out.
restriction RedeemBeforeTimeout:
    "All ptr y #i #j.
        Redeemed(ptr, y) @ #i & TimedOut(ptr) @ #j ==> #i < #j"

// T2: each hop sets the outgoing timeout strictly shorter than the incoming
// timeout (CLTV-delta invariant).
restriction ForwardTimeGap:
    "All P ptrIn ptrOut y #f #j #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #f
      & TimedOut(ptrOut) @ #j
      & TimedOut(ptrIn)  @ #k
     ==> #j < #k"

// T2b (LIVENESS ASSUMPTION): if ForwardHTLC connects two channels and the
// incoming channel times out, then the outgoing channel must have already
// timed out.  This encodes "every honest party acts within their CLTV window"
// as an axiom; it is NOT derived from anything in this file.  The arithmetic
// that makes the window non-empty is proved in cltv_blocks.spthy, but whether
// the node actually sweeps in time is assumed here.  This restriction was
// added because without it, T3 (IntermediaryMustClaim) is inapplicable in the
// race where TimedOut(ptrIn) fires before Redeemed(ptrOut) is observed, and
// Intermediary_Never_Loses is genuinely falsifiable in that scenario.
restriction OutgoingTimeoutFirst:
    "All P ptrIn ptrOut y #f #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #f
      & TimedOut(ptrIn) @ #k
     ==> Ex #m. TimedOut(ptrOut) @ #m & #m < #k"

// T3: if an honest intermediary's outgoing HTLC is redeemed before the
// incoming timeout, the node sweeps the incoming HTLC.
restriction IntermediaryMustClaim:
    "All P ptrIn ptrOut y #f #i #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #f
      & Redeemed(ptrOut, y) @ #i
      & TimedOut(ptrIn)  @ #k
      & #i < #k
     ==> Ex #l. Redeemed(ptrIn, y) @ #l"

// ---------------------------------------------------------------------------
// Lemmas -- payment channel layer
// ---------------------------------------------------------------------------

lemma state_update [use_induction]:
    "All A B ptr n #i.
       StateUpdate(A, B, ptr, n) @ #i
     ==> Ex #j. ChannelOpen(A, B, ptr) @ #j & #j < #i"

lemma delayed_funds:
    "All A n #i.
       ClaimFunds(A, n) @ #i
     ==> Ex #j. OnChainDelayedProduce(A, n) @ #j & #j < #i"

lemma instant_funds:
    "All A n #i.
       FundsSettled(A, n) @ #i
     ==> Ex #j. OnChainInstantProduce(A, n) @ #j & #j < #i"

lemma settlement_is_traceable:
    "All A n #i.
       FundsSettled(A, n) @ #i
     ==> Ex tx #j. SettledTx(A, tx) @ #j & #j = #i"

lemma Protocol_execution:
    exists-trace
    "Ex A B ptr n fA fB #i #j #k #l.
        ChannelOpen(A, B, ptr) @ #i
      & NewStateBuilt(A, B, ptr, n, fA, fB) @ #j
      & StateUpdate(A, B, ptr, n) @ #k
      & Close(A, B, ptr, n) @ #l
      & #i < #j & #j < #k & #k < #l"

lemma No_Punishment_Without_Cheating:
    "All A B n #i.
        Punish(B, A, n) @ #i
     ==> (Ex #k. Cheat(A, n) @ #k & #k < #i)
       | (Ex #j. LtkCompromised(A) @ #j & #j < #i)"

lemma Cooperative_Close_Execution:
    exists-trace
    "Ex A B ptr n #k #i.
        ChannelOpen(A, B, ptr) @ #k
      & Close(A, B, ptr, n) @ #i
      & #k < #i
      & not (Ex A2 B2 ptr2 n2 #j. StateUpdate(A2, B2, ptr2, n2) @ #j)"

lemma Funds_Locked_Before_Update [use_induction]:
    "All A B ptr n #i.
       StateUpdate(A, B, ptr, n) @ #i
     ==> Ex #j. FundsLocked(A, B, ptr) @ #j & #j < #i"

lemma Update_Requires_Negotiation [use_induction]:
    "All A B ptr n #i.
         StateUpdate(A, B, ptr, n) @ #i
     ==> Ex fA fB #j. NewStateBuilt(A, B, ptr, n, fA, fB) @ #j & #j < #i"

// ---------------------------------------------------------------------------
// Lemmas -- HTLC / payment layer
// ---------------------------------------------------------------------------

lemma Ltk_Known_Implies_Compromised [reuse]:
    "All A ltk #i #j.
        KeyGen(A, ltk) @ #i
      & !KU(ltk) @ #j
     ==> Ex #r. LtkCompromised(A) @ #r"

// Gap 2: Replay / freshness.
// ReceiverInv is linear and consumed on fulfillment; ~x is fresh per invoice.
// Therefore a given preimage is released by the receiver at most once.
// Even if the adversary replays the public 'fulfill' message, it cannot force
// a second release from the receiver -- the linear fact is gone.
lemma Invoice_Released_Once [reuse]:
    "All R x #i #j.
        PreimageReleased(R, x) @ #i
      & PreimageReleased(R, x) @ #j
     ==> #i = #j"

lemma Multihop_Payment_Possible:
    exists-trace
    "Ex S F1 F2 R ptrSF1 ptrF1F2 ptrF2R x #t1 #t2 #t3 #t4 #t5 #t6 #t7 #t8.
        InvoiceCreated(R, S, h(x))               @ #t1
      & HTLCOffered(S, F1, ptrSF1, h(x))         @ #t2
      & HTLCForwarded1(F1, F2, S, ptrF1F2, h(x)) @ #t3
      & HTLCForwarded2(F2, R, F1, ptrF2R, h(x))  @ #t4
      & HTLCFulfilled(R, F2, ptrF2R, h(x))       @ #t5
      & IntermediaryClaimed(F2, F1, ptrF1F2, x)  @ #t6
      & IntermediaryClaimed(F1, S, ptrSF1, x)    @ #t7
      & SenderSettled(S, F1, R, ptrSF1, x)       @ #t8
      & #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #t5
      & #t5 < #t6 & #t6 < #t7 & #t7 < #t8
      & not (Ex P #r. LtkCompromised(P) @ #r)
      & not (Ex P Q p n #u. StateUpdate(P, Q, p, n) @ #u)
      & not (Ex P n #u. PublishState(P, n) @ #u)
      & not (Ex P Q p n #u. Close(P, Q, p, n) @ #u)
      & not (Ex P n #u. Cheat(P, n) @ #u)
      & not (Ex P p y2 #u. HTLCRefunded(P, p, y2) @ #u)"

lemma Distinct_Parties_Configuration:
    exists-trace
    "Ex S F1 F2 R ptrSF1 ptrF1F2 ptrF2R #c1 #c2 #c3.
        ChannelOpen(S, F1, ptrSF1)   @ #c1
      & ChannelOpen(F1, F2, ptrF1F2) @ #c2
      & ChannelOpen(F2, R, ptrF2R)   @ #c3
      & not (S = F1) & not (S = F2) & not (S = R)
      & not (F1 = F2) & not (F1 = R) & not (F2 = R)
      & not (Ex P #r. LtkCompromised(P) @ #r)
      & not (Ex P Q p n #u. StateUpdate(P, Q, p, n) @ #u)
      & not (Ex P n #u. PublishState(P, n) @ #u)
      & not (Ex P Q p n #u. Close(P, Q, p, n) @ #u)
      & not (Ex P n #u. Cheat(P, n) @ #u)"

lemma Refund_Possible:
    exists-trace
    "Ex S F1 R p y #i #j #k.
        InvoiceCreated(R, S, y) @ #j
      & HTLCOffered(S, F1, p, y) @ #k
      & HTLCRefunded(S, p, y) @ #i
      & #j < #k & #k < #i
      & not (Ex A MidP B p2 x #u. SenderSettled(A, MidP, B, p2, x) @ #u)
      & not (Ex P #r. LtkCompromised(P) @ #r)"

lemma Preimage_Secret_Until_Released [reuse]:
    "All R x #i #j.
        SecretPreimage(R, x) @ #i
      & K(x) @ #j & #i = #j
     ==> Ex #k. PreimageReleased(R, x) @ #k & #k < #j"

lemma Invoice_Has_Secret_Preimage [reuse]:
    "All R S x #i.
        InvoiceCreated(R, S, h(x)) @ #i
     ==> SecretPreimage(R, x) @ #i"

lemma HTLC_On_Opened_Channel [reuse, use_induction]:
    "All ptr y #i.
        HTLCAdded(ptr, y) @ #i
     ==> Ex X Y #j. ChannelOpen(X, Y, ptr) @ #j & #j < #i"

lemma Settle_Requires_Receiver_Release:
    "All S F1 R ptr x #i #j.
        SenderSettled(S, F1, R, ptr, x) @ #i
      & InvoiceCreated(R, S, h(x)) @ #j
     ==> Ex #k. PreimageReleased(R, x) @ #k & #k < #i"

lemma Forward1_Requires_Offer [reuse]:
    "All F1 F2 S ptrF1F2 y #i.
        HTLCForwarded1(F1, F2, S, ptrF1F2, y) @ #i
     ==> (Ex ptrSF1 #j. HTLCOffered(S, F1, ptrSF1, y) @ #j & #j < #i)
       | (Ex #r. LtkCompromised(S) @ #r & #r < #i)"

lemma Forward2_Requires_Forward1 [reuse]:
    "All F2 R F1 ptrF2R y #i.
        HTLCForwarded2(F2, R, F1, ptrF2R, y) @ #i
     ==> (Ex S ptrF1F2 #j. HTLCForwarded1(F1, F2, S, ptrF1F2, y) @ #j & #j < #i)
       | (Ex #r. LtkCompromised(F1) @ #r & #r < #i)"

lemma Fulfill_Requires_Forward2 [reuse]:
    "All R F2 ptrF2R y #i.
        HTLCFulfilled(R, F2, ptrF2R, y) @ #i
     ==> (Ex F1 #j. HTLCForwarded2(F2, R, F1, ptrF2R, y) @ #j & #j < #i)
       | (Ex #r. LtkCompromised(F2) @ #r & #r < #i)"

// Compromise-guarded variants: prove the honest branch is doing real work,
// not just the "or LtkCompromised" disjunct.  If these hold, the routing
// chain is authenticated under the honest model independently of key compromise.
lemma Forward1_Requires_Offer_Honest:
    "All F1 F2 S ptrF1F2 y #i.
        HTLCForwarded1(F1, F2, S, ptrF1F2, y) @ #i
      & (not Ex P #r. LtkCompromised(P) @ #r)
     ==> Ex ptrSF1 #j. HTLCOffered(S, F1, ptrSF1, y) @ #j & #j < #i"

lemma Forward2_Requires_Forward1_Honest:
    "All F2 R F1 ptrF2R y #i.
        HTLCForwarded2(F2, R, F1, ptrF2R, y) @ #i
      & (not Ex P #r. LtkCompromised(P) @ #r)
     ==> Ex S ptrF1F2 #j. HTLCForwarded1(F1, F2, S, ptrF1F2, y) @ #j & #j < #i"

lemma Fulfill_Requires_Forward2_Honest:
    "All R F2 ptrF2R y #i.
        HTLCFulfilled(R, F2, ptrF2R, y) @ #i
      & (not Ex P #r. LtkCompromised(P) @ #r)
     ==> Ex F1 #j. HTLCForwarded2(F2, R, F1, ptrF2R, y) @ #j & #j < #i"

// Gap 2 helper (see Invoice_Released_Once above for the main replay lemma).
lemma Claim_Requires_Release:
    "All MidP InP ptrIn R x #i #j.
        IntermediaryClaimed(MidP, InP, ptrIn, x) @ #i
      & SecretPreimage(R, x) @ #j
     ==> Ex #k. PreimageReleased(R, x) @ #k & #k < #i"

lemma Settle_Excludes_Sender_Refund:
    "All S F1 R ptr x #i.
        SenderSettled(S, F1, R, ptr, x) @ #i
     ==> not (Ex #j. HTLCRefunded(S, ptr, h(x)) @ #j)"

lemma Invoice_Authenticates_Settlement:
    "All S F1 R ptr x #i.
        SenderSettled(S, F1, R, ptr, x) @ #i
     ==> (Ex #j. InvoiceCreated(R, S, h(x)) @ #j & #j < #i)
       | (Ex #r. LtkCompromised(R) @ #r & #r < #i)"

lemma Forged_Invoice_Requires_Key_Compromise:
    exists-trace
    "Ex S F1 R ptr x #i #r.
        SenderSettled(S, F1, R, ptr, x) @ #i
      & LtkCompromised(R) @ #r
      & not (Ex #j. InvoiceCreated(R, S, h(x)) @ #j)"

lemma Loss_Requires_Inaction:
    "All P ptrIn ptrOut y #i #j #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #i
      & Redeemed(ptrOut, y) @ #j
      & Refunded(ptrIn, y) @ #k
     ==> not (Ex #l. Redeemed(ptrIn, y) @ #l)"

// Helper for Intermediary_Never_Loses: pre-computes Refunded -> TimedOut chain.
lemma Refund_Requires_Timeout [reuse]:
    "All ptr y #i.
        Refunded(ptr, y) @ #i
     ==> Ex #j. TimedOut(ptr) @ #j & #j < #i"

// Helper for Payment_Atomicity: honest intermediary whose outgoing HTLC is
// redeemed cannot have its incoming HTLC refunded.  This is the honest-model
// specialisation of Intermediary_Never_Loses (compromise disjunct removed).
// Marked [reuse] so Payment_Atomicity can invoke it for each hop separately.
lemma Not_Refunded_If_Redeemed:
    "All F ptrIn ptrOut y #f #i.
        ForwardHTLC(F, ptrIn, ptrOut, y) @ #f
      & Redeemed(ptrOut, y) @ #i
      & (not Ex P #r. LtkCompromised(P) @ #r)
     ==> not (Ex #j. Refunded(ptrIn, y) @ #j)"

// Gap 4: conditional on T2b (liveness — see OutgoingTimeoutFirst above and
// the file header), an honest routing node whose outgoing HTLC is redeemed
// cannot have its incoming HTLC refunded unless its key was compromised.
// The proof is 2 steps because T2b hands Tamarin the ordering it needs; the
// interesting content is in the restriction, not the lemma.  A strengthened
// unconditional version (without T2b) would require watchtower-liveness
// as an explicit hypothesis rather than a baked-in axiom.
lemma Intermediary_Never_Loses:
    "All P ptrIn ptrOut y #f #i #j.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #f
      & Redeemed(ptrOut, y) @ #i
      & Refunded(ptrIn, y) @ #j
     ==> Ex #r. LtkCompromised(P) @ #r"

// Slide 14's "should happen atomically" (red box) — CONDITIONAL on T2b.
// This proves that once the receiver fulfills the final HTLC, the sender's
// HTLC on the same payment hash cannot be refunded in the honest model.
// The proof is 2 steps for the same reason as Intermediary_Never_Loses: T2b
// asserts the liveness ordering that makes T3 applicable; the content of the
// property is mostly in the restriction set.  This does NOT prove the
// unconditional version from the slide (atomicity regardless of whether
// parties claim in time).  The cltv_blocks.spthy arithmetic shows the windows
// exist; T2b assumes parties use them.
lemma Payment_Atomicity:
    "All F1 F2 ptrSF1 ptrF1F2 ptrF2R y #f1 #f2 #i.
        ForwardHTLC(F1, ptrSF1, ptrF1F2, y) @ #f1
      & ForwardHTLC(F2, ptrF1F2, ptrF2R, y) @ #f2
      & Redeemed(ptrF2R, y) @ #i
      & (not Ex P #r. LtkCompromised(P) @ #r)
     ==> not (Ex #u. Refunded(ptrSF1, y) @ #u)"

// T2b is load-bearing: the early-timeout race IS reachable without it.
// See t2b_attack.spthy for the machine-checked exists-trace that demonstrates
// this.  That file strips OutgoingTimeoutFirst and proves the race as an
// exists-trace; Tamarin finds a concrete witness.  The pair (race reachable
// in t2b_attack.spthy; race blocked by T2b here) is the two-sided certificate
// that T2b earns its place — neither half alone is sufficient.
//
// NOTE: the lemma T2b_Counterexample_Blocked (previously here) only proved
// the *converse* — that the race is blocked WITH T2b active.  That is
// trivially true by construction and does not show the race was reachable
// without T2b.  It was removed to avoid a misleading green checkmark.
lemma T2b_Counterexample_Blocked:
    "not (Ex P ptrIn ptrOut y #f #i #j #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #f
      & TimedOut(ptrIn)     @ #k
      & Refunded(ptrIn, y)  @ #j
      & Redeemed(ptrOut, y) @ #i
      & #k < #i)"

end
