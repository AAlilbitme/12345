theory HopProgressReliable begin

// Function signature and definition of the equational theory E

functions: fst/1, h/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2



heuristic: p













lemma Redeem_Possible:
  exists-trace "∃ #i. RedeemIn( ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (RedeemIn( ) @ #i)"
*/
by sorry

lemma Refund_Possible:
  exists-trace "∃ #i. RefundIn( ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (RefundIn( ) @ #i)"
*/
by sorry

lemma Intermediary_Safe:
  all-traces "∀ #i. (RedeemOut( ) @ #i) ⇒ (¬(∃ #j. RefundIn( ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ #i. (RedeemOut( ) @ #i) ∧ ∃ #j. (RefundIn( ) @ #j)"
*/
by sorry

lemma Intermediary_Claims:
  all-traces "∀ #i. (RedeemOut( ) @ #i) ⇒ (∃ #j. RedeemIn( ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ #i. (RedeemOut( ) @ #i) ∧ ∀ #j. (RedeemIn( ) @ #j) ⇒ ⊥"
*/
simplify
solve( State_111111211( ~prog_, lock, ~x ) ▶₀ #i )
  case outrx_0_11111121
  solve( State_12( ~prog_, ~x.1 ) ▶₀ #t.1 )
    case p_0_1
    solve( State_12( ~prog_, ~x.1 ) ▶₀ #t.2 )
      case p_0_1
      solve( (∃ #t. (ProgressTo_11111111( ~prog_ ) @ #t))  ∥
             (∃ #t. (ProgressTo_11111121111( ~prog_ ) @ #t)) )
        case case_2
        solve( State_1111112111( ~prog_, lock, ~x.1 ) ▶₀ #t.2 )
          case eventRedeemOut_0_111111211
          solve( (∃ #t. (ProgressTo_11121111( ~prog_ ) @ #t))  ∥
                 (∃ #t. (ProgressTo_1112112111( ~prog_ ) @ #t)) )
            case case_1
            solve( State_1112111( ~prog_, ~x.1, lock, r ) ▶₀ #t.3 )
              case lookupoutresasr_0_111211
              solve( ((#vr.3 < #vr.10) ∧
                      (∃ #t2.
                        (Unlock_0( '0', ~n, 'out' ) @ #t2)
                       ∧
                        (#vr.3 < #t2) ∧
                        (#t2 < #vr.10) ∧
                        (∀ #t0 pp. (Unlock( pp, ~n, 'out' ) @ #t0) ⇒ #t0 = #t2) ∧
                        (∀ pp lpp #t0.
                          (Lock( pp, lpp, 'out' ) @ #t0)
                         ⇒
                          ((#t0 < #vr.3) ∨ (#t0 = #vr.3) ∨ (#t2 < #t0))) ∧
                        (∀ pp lpp #t0.
                          (Unlock( pp, lpp, 'out' ) @ #t0)
                         ⇒
                          ((#t0 < #vr.3) ∨ (#t2 < #t0) ∨ (#t2 = #t0)))))  ∥
                     (#vr.10 < #vr.3) )
                case case_1
                solve( (#vr.1 < #t2)  ∥ (#vr.1 = #t2) )
                  case case_2
                  solve( Unlock_0( '0', ~n, 'out' ) @ #t.2 )
                    case unlockout_0_1111112111
                    solve( (∃ #t. (ProgressTo_112111111( ~prog_ ) @ #t))  ∥
                           (∃ #t. (ProgressTo_11211112111( ~prog_ ) @ #t))  ∥
                           (∃ #t. (ProgressTo_112112( ~prog_ ) @ #t))  ∥
                           (∃ #t. (ProgressTo_11212( ~prog_ ) @ #t)) )
                      case case_4
                      solve( State_1121( ~prog_, ~x.1 ) ▶₀ #t.4 )
                        case InTimeout_0_112
                        solve( Insert( 'out_res', r ) @ #t2 )
                          case insertoutresredeemed_0_1111112
                          SOLVED // trace found
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed









