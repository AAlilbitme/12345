theory multihop_nhop
begin

builtins: hashing, signing, natural-numbers

// ---------------------------------------------------------------------------
// Key management
// ---------------------------------------------------------------------------

rule Register_key:
    [ Fr(~ltk) ]
    --[ KeyGen($A, ~ltk) ]->
    [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)), Out(pk(~ltk)) ]

rule Compromise_Ltk:
    [ !Ltk($A, ltk) ]
    --[ LtkCompromised($A) ]->
    [ Out(ltk), !Compromised($A) ]   // CHANGED: marks A as compromised

// ---------------------------------------------------------------------------
// Wallet / funds
// ---------------------------------------------------------------------------

rule Acquire_funds:
    [ Fr(~f) ]
    --[ FundsAcquired($A, ~f) ]->
    [ Wallet($A, ~f) ]

// ---------------------------------------------------------------------------
// Channel handshake
// ---------------------------------------------------------------------------

rule A_Send_Proposal:
    let proposal = <'proposal', $A, $B, ~ptr>
        sigA     = sign(proposal, ltkA)
    in
    [ Fr(~ptr), !Ltk($A, ltkA) ]
    --[ A_ProposalSent($A, $B, ~ptr) ]->
    [ A_WaitAck($A, $B, ~ptr),
      Out(<'proposal', $A, $B, ~ptr, sigA>) ]

rule B_Recv_Proposal:
    let proposal = <'proposal', $A, $B, ptr>
        sigB     = sign(proposal, ltkB)
    in
    [ !Ltk($B, ltkB), !Pk($A, pkA),
      In(<'proposal', $A, $B, ptr, sigA>) ]
    --[ ProposalExchange($A, $B, ptr),
        Eq(verify(sigA, proposal, pkA), true) ]->
    [ !ProposalCommitted($A, $B, ptr),
      Out(<'proposal_ack', $A, $B, ptr, sigB>) ]

rule A_Recv_From_B:
    let proposal = <'proposal', $A, $B, ptr>
    in
    [ A_WaitAck($A, $B, ptr),
      !Pk($B, pkB),
      In(<'proposal_ack', $A, $B, ptr, sigB>) ]
    --[ A_Received($A, $B, ptr),
        Eq(verify(sigB, proposal, pkB), true) ]->
    [ !A_HandshakeDone($A, $B, ptr) ]

// ---------------------------------------------------------------------------
// Initial channel state commitment
// ---------------------------------------------------------------------------

rule Create_State_A:
    let commitA0 = <'commit', ptr, $A, $B, '0', h(~sA0)>
        sigA0    = sign(commitA0, ltkA)
    in
    [ Fr(~sA0), !Ltk($A, ltkA),
      !A_HandshakeDone($A, $B, ptr) ]
    --[ StateCreated($A, '0', commitA0) ]->
    [ CommittedStateA($A, $B, ptr, '0', ~sA0, commitA0, sigA0) ]

rule Create_State_B:
    let commitB0 = <'commit', ptr, $B, $A, '0', h(~sB0)>
        sigB0    = sign(commitB0, ltkB)
    in
    [ Fr(~sB0), !Ltk($B, ltkB),
      !ProposalCommitted($A, $B, ptr) ]
    --[ StateCreated($B, '0', commitB0) ]->
    [ CommittedStateB($A, $B, ptr, '0', ~sB0, commitB0, sigB0) ]

rule Both_States_Committed:
    [ CommittedStateA($A, $B, ptr, '0', sA0, commitA0, sigA0),
      CommittedStateB($A, $B, ptr, '0', sB0, commitB0, sigB0),
      !Pk($A, pkA), !Pk($B, pkB) ]
    --[ Stage1Complete($A, $B, ptr),
        Eq(verify(sigA0, commitA0, pkA), true),
        Eq(verify(sigB0, commitB0, pkB), true) ]->
    [ ReadyToLock($A, $B, ptr, sA0, sB0, commitA0, commitB0) ]

rule Lock_Funds_And_Open:
    [ ReadyToLock($A, $B, ptr, sA0, sB0, commitA0, commitB0),
      Wallet($A, ~fA), Wallet($B, ~fB) ]
    --[ ChannelOpen($A, $B, ptr), FundsLocked($A, $B, ptr),
        NewStateBuilt($A, $B, ptr, '0', ~fA, ~fB) ]->
    [ StateA($A, $B, ptr, '0', sA0, commitA0, ~fA, ~fB),
      StateB($A, $B, ptr, '0', sB0, commitB0, ~fA, ~fB),
      !ValidOnChain(ptr),
      !ChannelRecord(ptr, $A, $B),
      !ChannelConnect(ptr, $A, $B),   
      !ChannelConnect(ptr, $B, $A),
      Free(ptr) ]  // one-shot HTLC slot per channel

// ---------------------------------------------------------------------------
// State update & revocation
// ---------------------------------------------------------------------------

rule Update_State:
    let newCommitA = <'commit', ptr, $A, $B, ~n_new, h(~sAnew)>
        newCommitB = <'commit', ptr, $B, $A, ~n_new, h(~sBnew)>
        sigAnew    = sign(newCommitA, ltkA)
        sigBnew    = sign(newCommitB, ltkB)
    in
    [ Fr(~n_new), Fr(~sAnew), Fr(~sBnew),
      !Ltk($A, ltkA), !Ltk($B, ltkB),
      StateA($A, $B, ptr, n_old, sAold, oldCommitA, fA, fB),
      StateB($A, $B, ptr, n_old, sBold, oldCommitB, fA, fB),
      In(<fA_new, fB_new>) ]
    --[ NewStateBuilt($A, $B, ptr, ~n_new, fA_new, fB_new) ]->
    [ PendingA($A, $B, ptr, n_old, sAold, oldCommitA,
               ~n_new, ~sAnew, newCommitA, sigAnew, fA_new, fB_new),
      PendingB($A, $B, ptr, n_old, sBold, oldCommitB,
               ~n_new, ~sBnew, newCommitB, sigBnew, fA_new, fB_new) ]

rule Revoke_Old_Secret:
    [ PendingA($A, $B, ptr, n_old, sAold, oldCommitA,
               n_new, sAnew, newCommitA, sigAnew, fA_new, fB_new),
      PendingB($A, $B, ptr, n_old, sBold, oldCommitB,
               n_new, sBnew, newCommitB, sigBnew, fA_new, fB_new),
      !Pk($A, pkA), !Pk($B, pkB) ]
    --[ StateUpdate($A, $B, ptr, n_new),
        Revoke($A, n_old, sAold),
        Revoke($B, n_old, sBold),
        Eq(verify(sigAnew, newCommitA, pkA), true),
        Eq(verify(sigBnew, newCommitB, pkB), true) ]->
    [ StateA($A, $B, ptr, n_new, sAnew, newCommitA, fA_new, fB_new),
      StateB($A, $B, ptr, n_new, sBnew, newCommitB, fA_new, fB_new),
      !RevokedSecret($A, n_old, sAold, oldCommitA),
      !RevokedSecret($B, n_old, sBold, oldCommitB),
      RevokedCommitmentUnspent(ptr, $A, $B, n_old, oldCommitA),
      RevokedCommitmentUnspent(ptr, $B, $A, n_old, oldCommitB) ]

// ---------------------------------------------------------------------------
// On-chain publish paths
// ---------------------------------------------------------------------------

rule Publish_Old_Grace_Period_A:
    [ PendingA($A, $B, ptr, n_old, sAold, oldCommitA,
               n_new, sAnew, newCommitA, sigAnew, fA_new, fB_new),
      !ValidOnChain(ptr) ]
    --[ PublishOldBeforeRevocation($A, n_old),
        PublishState($A, n_old),
        OnChainDelayedProduce($A, n_old),
        OnChainInstantProduce($B, n_old) ]->
    [ OnChainDelayed($A, n_old, oldCommitA),
      OnChainInstant($B, n_old, oldCommitA) ]

rule Publish_Old_Grace_Period_B:
    [ PendingB($A, $B, ptr, n_old, sBold, oldCommitB,
               n_new, sBnew, newCommitB, sigBnew, fA_new, fB_new),
      !ValidOnChain(ptr) ]
    --[ PublishOldBeforeRevocation($B, n_old),
        PublishState($B, n_old),
        OnChainDelayedProduce($B, n_old),
        OnChainInstantProduce($A, n_old) ]->
    [ OnChainDelayed($B, n_old, oldCommitB),
      OnChainInstant($A, n_old, oldCommitB) ]

rule Publish_Current_A:
    [ StateA($A, $B, ptr, n, sA, commitA, fA, fB), !ValidOnChain(ptr) ]
    --[ Publish($A, n, commitA),
        PublishState($A, n),
        OnChainDelayedProduce($A, n),
        OnChainInstantProduce($B, n) ]->
    [ OnChainDelayed($A, n, commitA),
      OnChainInstant($B, n, commitA) ]

rule Publish_Current_B:
    [ StateB($A, $B, ptr, n, sB, commitB, fA, fB), !ValidOnChain(ptr) ]
    --[ Publish($B, n, commitB),
        PublishState($B, n),
        OnChainDelayedProduce($B, n),
        OnChainInstantProduce($A, n) ]->
    [ OnChainDelayed($B, n, commitB),
      OnChainInstant($A, n, commitB) ]

rule Publish_Pending_A:
    [ PendingA($A, $B, ptr, n_old, sAold, oldCommitA,
               n_new, sAnew, newCommitA, sigAnew, fA_new, fB_new),
      !ValidOnChain(ptr) ]
    --[ Publish($A, n_new, newCommitA),
        PublishFromPending($A, n_old, n_new),
        OnChainDelayedProduce($A, n_new),
        OnChainInstantProduce($B, n_new) ]->
    [ OnChainDelayed($A, n_new, newCommitA),
      OnChainInstant($B, n_new, newCommitA) ]

rule Publish_Pending_B:
    [ PendingB($A, $B, ptr, n_old, sBold, oldCommitB,
               n_new, sBnew, newCommitB, sigBnew, fA_new, fB_new),
      !ValidOnChain(ptr) ]
    --[ Publish($B, n_new, newCommitB),
        PublishFromPending($B, n_old, n_new),
        OnChainDelayedProduce($B, n_new),
        OnChainInstantProduce($A, n_new) ]->
    [ OnChainDelayed($B, n_new, newCommitB),
      OnChainInstant($A, n_new, newCommitB) ]

// ---------------------------------------------------------------------------
// Cooperative close
// ---------------------------------------------------------------------------

rule Honest_Close:
    let closetx = <'commit', ptr, $A, $B, n, fA, fB>
        signA   = sign(closetx, ltkA)
        signB   = sign(closetx, ltkB)
    in
    [ StateA($A, $B, ptr, n, sA, commitA, fA, fB),
      StateB($A, $B, ptr, n, sB, commitB, fA, fB),
      !ValidOnChain(ptr),
      !Ltk($A, ltkA), !Ltk($B, ltkB),
      !Pk($A, pkA),   !Pk($B, pkB) ]
    --[ Close($A, $B, ptr, n),
        OnChainInstantProduce($A, n),
        OnChainInstantProduce($B, n),
        Eq(verify(signA, closetx, pkA), true),
        Eq(verify(signB, closetx, pkB), true) ]->
    [ OnChainInstant($A, n, closetx),
      OnChainInstant($B, n, closetx) ]

// ---------------------------------------------------------------------------
// Cheat / punishment
// ---------------------------------------------------------------------------

rule Publish_Revoked_A:
    [ !ChannelRecord(ptr, $A, $B),
      !ValidOnChain(ptr),
      !RevokedSecret($A, n_old, sAold, oldCommitA),
      RevokedCommitmentUnspent(ptr, $A, $B, n_old, oldCommitA) ]
    --[ PublishRevoked($A, n_old, oldCommitA),
        Cheat($A, n_old) ]->
    [ OnChainCheat($A, $B, n_old, oldCommitA),
      RevealedSecret($A, n_old, sAold, oldCommitA) ]

rule Publish_Revoked_B:
    [ !ChannelRecord(ptr, $A, $B),
      !ValidOnChain(ptr),
      !RevokedSecret($B, n_old, sBold, oldCommitB),
      RevokedCommitmentUnspent(ptr, $B, $A, n_old, oldCommitB) ]
    --[ PublishRevoked($B, n_old, oldCommitB),
        Cheat($B, n_old) ]->
    [ OnChainCheat($B, $A, n_old, oldCommitB),
      RevealedSecret($B, n_old, sBold, oldCommitB) ]

rule Punish_A:
    [ OnChainCheat($A, $B, n_old, oldCommitA),
      RevealedSecret($A, n_old, sAold, oldCommitA) ]
    --[ Punish($B, $A, n_old) ]->
    [ AllFundsTo($B) ]

rule Punish_B:
    [ OnChainCheat($B, $A, n_old, oldCommitB),
      RevealedSecret($B, n_old, sBold, oldCommitB) ]
    --[ Punish($A, $B, n_old) ]->
    [ AllFundsTo($A) ]

// ---------------------------------------------------------------------------
// Settlement rules
// ---------------------------------------------------------------------------

rule Instant_Funds_A:
    [ OnChainInstant($A, n, txContent) ]
    --[ FundsSettled($A, n), SettledTx($A, txContent) ]->
    [ ]

rule Instant_Funds_B:
    [ OnChainInstant($B, n, txContent) ]
    --[ FundsSettled($B, n), SettledTx($B, txContent) ]->
    [ ]

rule Claim_Funds_A:
    [ OnChainDelayed($A, n, txContent) ]
    --[ ClaimFunds($A, n), CSVPassed($A, n), SettledTx($A, txContent) ]->
    [ FundsTo($A, n) ]

rule Claim_Funds_B:
    [ OnChainDelayed($B, n, txContent) ]
    --[ ClaimFunds($B, n), CSVPassed($B, n), SettledTx($B, txContent) ]->
    [ FundsTo($B, n) ]

// ---------------------------------------------------------------------------
// HTLC layer GENERALIZED to N hops
// ---------------------------------------------------------------------------

rule Receiver_Create_Invoice:
    let y = h(~x)
        invoice = <'invoice', $Receiver, $Sender, y>   // CHANGED: tagged (domain separation)
        sigR    = sign(invoice, ltkR)
    in
    [ Fr(~x), !Ltk($Receiver, ltkR) ]
    --[ InvoiceCreated($Receiver, $Sender, y),
        SecretPreimage($Receiver, ~x) ]->
    [ ReceiverInv($Receiver, $Sender, ~x),
      Out(<'SecretRS', invoice, sigR>) ]

rule Sender_Offer_HTLC:
    let invoice = <'invoice', $Receiver, $Sender, y>   // CHANGED: tagged (domain separation)
    in
    [ In(<'SecretRS', invoice, sigR>),
      !Pk($Receiver, pkR),
      !Ltk($Sender, ltkS),
      !ChannelConnect(ptrSF, $Sender, $Forward1),
      Free(ptrSF) ] 
    --[ HTLCOffered($Sender, $Forward1, ptrSF, y),
        OfferFor($Sender, $Receiver, ptrSF, y),
        HTLCAdded(ptrSF, y),
        Neq($Sender, $Forward1),
        Neq($Sender, $Receiver),
        Neq($Forward1, $Receiver),
        Eq(verify(sigR, invoice, pkR), true) ]->
    [ SenderPending($Sender, $Forward1, $Receiver, ptrSF, y),
      Route($Sender, $Forward1, ptrSF, y) ]

// GENERIC FORWARD -- one rule, any number of hops.
rule Forward_HTLC:
    [ Route($Prev, $Me, ptrIn, y),
      !ChannelConnect(ptrOut, $Me, $Next),
      Free(ptrOut),             
      In(%vIn), In(%fee), In(%vOut) ]
    --[ HTLCForwarded($Me, $Prev, $Next, ptrIn, ptrOut, y),
        HTLCAdded(ptrOut, y),
        ForwardHTLC($Me, ptrIn, ptrOut, y),
        FeeCharged($Me, y, %fee), 
        Eq(%vIn,  %vOut %+ %fee), 
        Neq(ptrIn, ptrOut), Neq($Prev, $Me), Neq($Me, $Next) ]->
    [ IntermediaryPending($Me, $Prev, $Next, ptrIn, ptrOut, y, %vIn, %vOut, %fee),
      Route($Me, $Next, ptrOut, y) ]

rule Receiver_Fulfill_HTLC:
    [ Route($Prev, $Receiver, ptrIn, y),
      ReceiverInv($Receiver, $Sender, x) ]
    --[ HTLCFulfilled($Receiver, $Prev, ptrIn, y),
        PreimageReleased($Receiver, x),
        Redeemed(ptrIn, y),
        Eq(h(x), y) ]->
    [ Fulfill(ptrIn, x) ] // no free ?

rule Intermediary_Settle:
    [ IntermediaryPending($Me, $Prev, $Next, ptrIn, ptrOut, y, %vIn, %vOut, %fee),
      Fulfill(ptrOut, x) ]
    --[ IntermediaryClaimed($Me, $Prev, ptrIn, x),
        FeeEarned($Me, ptrIn, ptrOut, y, %fee),
        Redeemed(ptrIn, y),
        Eq(h(x), y) ]->
    [ Fulfill(ptrIn, x), Free(ptrIn) ]

rule Sender_Settle:
    [ SenderPending($Sender, $Forward1, $Receiver, ptrSF, y),
      Fulfill(ptrSF, x) ]
    --[ SenderSettled($Sender, $Forward1, $Receiver, ptrSF, x),
        PaymentComplete($Sender, $Receiver, h(x)),
        Redeemed(ptrSF, y),
        Eq(h(x), y) ]->
    [ Free(ptrSF) ]

rule Open_Timeout:
    [ !ChannelConnect(ptr, A, B) ] --[ TimedOut(ptr) ]-> [ !Timeout(ptr) ]

rule Sender_Timeout_Refund:
    [ SenderPending($Sender, $Forward1, $Receiver, ptrSF, y), !Timeout(ptrSF) ]
    --[ HTLCRefunded($Sender, ptrSF, y), Refunded(ptrSF, y) ]->
    [ ]

rule Intermediary_Timeout_Refund:
    [ IntermediaryPending($Me, $Prev, $Next, ptrIn, ptrOut, y, %vIn, %vOut, %fee),
      !Timeout(ptrOut) ]
    --[ HTLCRefunded($Me, ptrOut, y),
        Refunded(ptrOut, y) ]->
    [ ]

// ---- Attacker influence -----
// CHANGED: AttackerKnowsRoute / AttackerSkip replaced by the secure-channel
// pattern with compromised endpoints (Tamarin manual, compromised_in / _out),
// applied to the fulfil channel. The attacker can read or inject a preimage
// only at a compromised endpoint of a channel.

// A compromised endpoint of ptr takes the fulfil message off the channel and
// publishes the preimage.
rule Fulfill_Compromised_Out:
    [ Fulfill(ptr, x), !ChannelConnect(ptr, $A, $B), !Compromised($A) ]
    --[ Rev($A, 'fulfill'), Leaked(ptr, x) ]->
    [ Out(<ptr, x>) ]

// A compromised endpoint of ptr injects a fulfil message it knows.
rule Fulfill_Compromised_In:
    [ In(<ptr, x>), !ChannelConnect(ptr, $A, $B), !Compromised($A) ]
    --[ Rev($A, 'fulfill'), Injected(ptr, x) ]->
    [ Fulfill(ptr, x) ]

// ---------------------------------------------------------------------------
// Restrictions
// ---------------------------------------------------------------------------

restriction OneOutcomePerHTLC:
    "All ptr y #i #j.
       Redeemed(ptr, y) @ #i & Refunded(ptr, y) @ #j ==> F"

restriction Inequality:
    "All x y #i. Neq(x, y) @ #i ==> not(x = y)"

restriction Equality:
    "All x y #i. Eq(x, y) @ #i ==> x = y"

restriction OneTimeoutPerPtr:
    "All ptr #i #j. TimedOut(ptr) @ #i & TimedOut(ptr) @ #j ==> #i = #j"

restriction OneChannelPerPtr:
    "All A B C D ptr #i #j.
       ChannelOpen(A, B, ptr) @ #i
     & ChannelOpen(C, D, ptr) @ #j
     ==> #i = #j"

restriction RedeemBeforeTimeout:
    "All ptr y #i #j.
        Redeemed(ptr, y) @ #i & TimedOut(ptr) @ #j ==> #i < #j"

// CHANGED: ForwardTimeGap (T2a) removed -- implied by T2 + OneTimeoutPerPtr
// for honest parties, and it must not constrain compromised ones.

restriction HonestPartiesActBeforeIncomingTimeout:
    "All P ptrIn ptrOut y #f #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #f
      & TimedOut(ptrIn) @ #k
      & not (Ex #r. LtkCompromised(P) @ #r & #r < #k)   // CHANGED: honest (not compromised before #k)
     ==> Ex #m. TimedOut(ptrOut) @ #m & #m < #k"

restriction IntermediaryMustClaim:
    "All P ptrIn ptrOut y #f #i #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #f
      & Redeemed(ptrOut, y) @ #i
      & TimedOut(ptrIn)  @ #k
      & #i < #k
      & not (Ex #r. LtkCompromised(P) @ #r & #r < #k)   // CHANGED: honest (not compromised before #k)
     ==> Ex #l. Redeemed(ptrIn, y) @ #l"

// ---------------------------------------------------------------------------
// Lemmas -- payment channel layer
// ---------------------------------------------------------------------------

// SOURCES (by induction): every preimage that travels in a Fulfill fact and is
// either leaked by a compromised endpoint or claimed by an intermediary was
// released by a receiver, or injected by the attacker, earlier. Covers the
// unbounded Intermediary_Settle chain that otherwise blocks backward search.
lemma Fulfill_Origin [sources]:
    "(All ptr x #i.
        Leaked(ptr, x) @ #i
      ==> (Ex R #j. PreimageReleased(R, x) @ #j & #j < #i)
        | (Ex q #j. Injected(q, x) @ #j & #j < #i))
   & (All Me Prev ptr x #i.
        IntermediaryClaimed(Me, Prev, ptr, x) @ #i
      ==> (Ex R #j. PreimageReleased(R, x) @ #j & #j < #i)
        | (Ex q #j. Injected(q, x) @ #j & #j < #i))"

lemma state_update [use_induction]:
  all-traces
  "∀ A B ptr n #i.
    (StateUpdate( A, B, ptr, n ) @ #i) ⇒
    (∃ #j. (ChannelOpen( A, B, ptr ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ A B ptr n #i.
  (StateUpdate( A, B, ptr, n ) @ #i)
 ∧
  ∀ #j. (ChannelOpen( A, B, ptr ) @ #j) ⇒ ¬(#j < #i)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ A B ptr n #i.
           (StateUpdate( A, B, ptr, n ) @ #i)
          ⇒
           ((last(#i)) ∨
            (∃ #j. (ChannelOpen( A, B, ptr ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i))))  ∥
         (∃ P ptrIn ptrOut y #f #k.
           (ForwardHTLC( P, ptrIn, ptrOut, y ) @ #f) ∧ (TimedOut( ptrIn ) @ #k)
          ∧
           (¬(last(#k))) ∧
           (¬(last(#f))) ∧
           (∀ #r.
             (LtkCompromised( P ) @ #r) ⇒ ((last(#r)) ∨ (#r = #k) ∨ (#k < #r))) ∧
           (∀ #m.
             (TimedOut( ptrOut ) @ #m) ⇒ ((last(#m)) ∨ (#m = #k) ∨ (#k < #m))))  ∥
         (∃ P ptrIn ptrOut y #f #i #k.
           (ForwardHTLC( P, ptrIn, ptrOut, y ) @ #f) ∧
           (Redeemed( ptrOut, y ) @ #i) ∧
           (TimedOut( ptrIn ) @ #k)
          ∧
           (¬(last(#k))) ∧
           (¬(last(#i))) ∧
           (¬(last(#f))) ∧
           (#i < #k) ∧
           (∀ #r.
             (LtkCompromised( P ) @ #r) ⇒ ((last(#r)) ∨ (#r = #k) ∨ (#k < #r))) ∧
           (∀ #l. (Redeemed( ptrIn, y ) @ #l) ⇒ last(#l))) )
    case case_1
    solve( (last(#i))  ∥
           (∃ #j. (ChannelOpen( $A, $B, ptr ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) )
      case case_1
      solve( !Pk( $A, pk(x) ) ▶₂ #i )
        case Register_key
        solve( !Pk( $B, pk(x) ) ▶₃ #i )
          case Register_key
          solve( PendingA( $A, $B, ptr, n_old, sAold, oldCommitA, n, sAnew,
                           newCommitA, sign(newCommitA, ~ltk), fA_new, fB_new
                 ) ▶₀ #i )
            case Update_State_case_1
            by contradiction /* from formulas */
          next
            case Update_State_case_2
            by contradiction /* from formulas */
          next
            case Update_State_case_3
            by contradiction /* from formulas */
          next
            case Update_State_case_4
            by contradiction /* from formulas */
          qed
        qed
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case case_2
    solve( (∃ #r. (LtkCompromised( $Me ) @ #r) ∧ #r < #k)  ∥
           (∃ #m. (TimedOut( ptrOut ) @ #m) ∧ #m < #k) )
      case case_1
      by contradiction /* from formulas */
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case case_3
    solve( (∃ #r. (LtkCompromised( $Me ) @ #r) ∧ #r < #k)  ∥
           (∃ #m. (TimedOut( ptrOut ) @ #m) ∧ #m < #k) )
      case case_1
      by contradiction /* from formulas */
    next
      case case_2
      solve( (∃ #r. (LtkCompromised( $Me ) @ #r) ∧ #r < #k)  ∥
             (∃ #l. (Redeemed( ptrIn, y ) @ #l)) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        by contradiction /* cyclic */
      qed
    qed
  qed
qed

lemma delayed_funds:
    "All A n #i.
       ClaimFunds(A, n) @ #i
     ==> Ex #j. OnChainDelayedProduce(A, n) @ #j & #j < #i"

lemma instant_funds:
    "All A n #i.
       FundsSettled(A, n) @ #i
     ==> Ex #j. OnChainInstantProduce(A, n) @ #j & #j < #i"

lemma settlement_is_traceable:
    "All A n #i.
       FundsSettled(A, n) @ #i
     ==> Ex tx #j. SettledTx(A, tx) @ #j & #j = #i"

lemma Protocol_execution:
    exists-trace
      "∃ A B ptr n fA fB #i #j #k #l.
    ((((((ChannelOpen( A, B, ptr ) @ #i) ∧
         (NewStateBuilt( A, B, ptr, n, fA, fB ) @ #j)) ∧
        (StateUpdate( A, B, ptr, n ) @ #k)) ∧
       (Close( A, B, ptr, n ) @ #l)) ∧
      (#i < #j)) ∧
     (#j < #k)) ∧
    (#k < #l)
      & not (Ex ptr y1 y2 #m #n. HTLCAdded(ptr, y1) @ #m & HTLCAdded(ptr, y2) @ #n & not (#m = #n))"
simplify
solve( ReadyToLock( $A, $B, ptr, sA0, sB0, commitA0, commitB0 ) ▶₀ #i )
  case Both_States_Committed
  solve( Wallet( $A, ~fA ) ▶₁ #i )
    case Acquire_funds
    solve( Wallet( $B, ~fB ) ▶₂ #i )
      case Acquire_funds
      solve( !Pk( $A, pk(x) ) ▶₂ #k )
        case Register_key
        solve( !Pk( $B, pk(x) ) ▶₃ #k )
          case Register_key
          solve( StateA( $A, $B, ~ptr, n, sA, commitA, fA.1, fB.1 ) ▶₀ #l )
            case Revoke_Old_Secret
            solve( StateB( $A, $B, ~ptr, n, sB, commitB, fA.1, fB.1 ) ▶₁ #l )
              case Revoke_Old_Secret
              solve( !ValidOnChain( ~ptr ) ▶₂ #l )
                case Lock_Funds_And_Open
                solve( !Ltk( $A, ltkA ) ▶₃ #l )
                  case Register_key
                  solve( !Ltk( $B, ltkB ) ▶₄ #l )
                    case Register_key
                    solve( !Pk( $A, pk(~ltk.2) ) ▶₅ #l )
                      case Register_key
                      solve( !Pk( $B, pk(~ltk.3) ) ▶₆ #l )
                        case Register_key
                        solve( NewStateBuilt( $A, $B, ~ptr, n, fA.2, fB.2 ) @ #j )
                          case Update_State
                          solve( !Ltk( $A, ltkA ) ▶₃ #j )
                            case Register_key
                            solve( !Ltk( $B, ltkB ) ▶₄ #j )
                              case Register_key
                              solve( StateA( $A, $B, ~ptr, n_old, sAold, oldCommitA, fA.1, fB.1
                                     ) ▶₅ #j )
                                case Lock_Funds_And_Open
                                solve( StateB( $A, $B, ~ptr, '0', sBold, oldCommitB, ~fA, ~fB ) ▶₆ #j )
                                  case Lock_Funds_And_Open
                                  solve( !KU( sign(<'proposal', $A, $B, ~ptr>, ~ltk.8) ) @ #vk.12 )
                                    case A_Send_Proposal
                                    solve( !KU( sign(<'proposal', $A, $A, ~ptr>, ~ltk.9) ) @ #vk.13 )
                                      case A_Send_Proposal
                                      solve( PendingA( $A, $A, ~ptr, n_old, sAold, oldCommitA, ~n_new,
                                                       sAnew.1, newCommitA, sign(newCommitA, ~ltk.2), fA_new,
                                                       fB_new
                                             ) ▶₀ #k )
                                        case Update_State
                                        solve( PendingB( $A, $A, ~ptr, '0', sBold, oldCommitB, ~n_new,
                                                         sBnew.1, newCommitB, sign(newCommitB, ~ltk.2),
                                                         fA_new, fB_new
                                               ) ▶₁ #k )
                                          case Update_State
                                          solve( PendingA( $A, $A, ~ptr, n_old, sAold, oldCommitA, ~n_new, sA,
                                                           commitA, sign(commitA, ~ltk.8), fA.1, fB.1
                                                 ) ▶₀ #vr.14 )
                                            case Update_State
                                            solve( PendingA( $A, $A, ~ptr, n_old, sAold, oldCommitA, ~n_new,
                                                             sAnew.1, newCommitA, sign(newCommitA, ~ltk.8),
                                                             fA_new, fB_new
                                                   ) ▶₀ #vr.14 )
                                              case Update_State
                                              solve( !KU( ~ptr ) @ #vk.8 )
                                                case A_Send_Proposal
                                                SOLVED // trace found
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma No_Punishment_Without_Cheating:
    "All A B n #i.
        Punish(B, A, n) @ #i
     ==> (Ex #k. Cheat(A, n) @ #k & #k < #i)
       | (Ex #j. LtkCompromised(A) @ #j & #j < #i)"

lemma Cooperative_Close_Execution:
    exists-trace
      "∃ A B ptr n #k #i.
    (((ChannelOpen( A, B, ptr ) @ #k) ∧ (Close( A, B, ptr, n ) @ #i)) ∧
     (#k < #i)) ∧
    (¬(∃ A2 B2 ptr2 n2 #j. StateUpdate( A2, B2, ptr2, n2 ) @ #j))
      & not (Ex ptr y1 y2 #m #n. HTLCAdded(ptr, y1) @ #m & HTLCAdded(ptr, y2) @ #n & not (#m = #n))"
simplify
solve( ReadyToLock( $A, $B, ptr, sA0, sB0, commitA0, commitB0 ) ▶₀ #k )
  case Both_States_Committed
  solve( Wallet( $A, ~fA.1 ) ▶₁ #k )
    case Acquire_funds
    solve( Wallet( $B, ~fB.1 ) ▶₂ #k )
      case Acquire_funds
      solve( StateA( $A, $B, ~ptr, n, sA, commitA, fA, fB ) ▶₀ #i )
        case Lock_Funds_And_Open
        solve( StateB( $A, $B, ~ptr, '0', sB, commitB, ~fA, ~fB ) ▶₁ #i )
          case Lock_Funds_And_Open
          solve( !ValidOnChain( ~ptr ) ▶₂ #i )
            case Lock_Funds_And_Open
            solve( !Ltk( $A, ltkA ) ▶₃ #i )
              case Register_key
              solve( !Ltk( $B, ltkB ) ▶₄ #i )
                case Register_key
                solve( !Pk( $A, pk(~ltk) ) ▶₅ #i )
                  case Register_key
                  solve( !Pk( $B, pk(~ltk.1) ) ▶₆ #i )
                    case Register_key
                    solve( !KU( sign(<'proposal', $A, $B, ~ptr>, ~ltk.4) ) @ #vk.12 )
                      case A_Send_Proposal
                      solve( !KU( sign(<'proposal', $A, $A, ~ptr>, ~ltk.5) ) @ #vk.13 )
                        case A_Send_Proposal
                        solve( !KU( ~ptr ) @ #vk.8 )
                          case A_Send_Proposal
                          SOLVED // trace found
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma Funds_Locked_Before_Update [use_induction]:
  all-traces
  "∀ A B ptr n #i.
    (StateUpdate( A, B, ptr, n ) @ #i) ⇒
    (∃ #j. (FundsLocked( A, B, ptr ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ A B ptr n #i.
  (StateUpdate( A, B, ptr, n ) @ #i)
 ∧
  ∀ #j. (FundsLocked( A, B, ptr ) @ #j) ⇒ ¬(#j < #i)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ A B ptr n #i.
           (StateUpdate( A, B, ptr, n ) @ #i)
          ⇒
           ((last(#i)) ∨
            (∃ #j. (FundsLocked( A, B, ptr ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i))))  ∥
         (∃ P ptrIn ptrOut y #f #k.
           (ForwardHTLC( P, ptrIn, ptrOut, y ) @ #f) ∧ (TimedOut( ptrIn ) @ #k)
          ∧
           (¬(last(#k))) ∧
           (¬(last(#f))) ∧
           (∀ #r.
             (LtkCompromised( P ) @ #r) ⇒ ((last(#r)) ∨ (#r = #k) ∨ (#k < #r))) ∧
           (∀ #m.
             (TimedOut( ptrOut ) @ #m) ⇒ ((last(#m)) ∨ (#m = #k) ∨ (#k < #m))))  ∥
         (∃ P ptrIn ptrOut y #f #i #k.
           (ForwardHTLC( P, ptrIn, ptrOut, y ) @ #f) ∧
           (Redeemed( ptrOut, y ) @ #i) ∧
           (TimedOut( ptrIn ) @ #k)
          ∧
           (¬(last(#k))) ∧
           (¬(last(#i))) ∧
           (¬(last(#f))) ∧
           (#i < #k) ∧
           (∀ #r.
             (LtkCompromised( P ) @ #r) ⇒ ((last(#r)) ∨ (#r = #k) ∨ (#k < #r))) ∧
           (∀ #l. (Redeemed( ptrIn, y ) @ #l) ⇒ last(#l))) )
    case case_1
    solve( (last(#i))  ∥
           (∃ #j. (FundsLocked( $A, $B, ptr ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) )
      case case_1
      solve( !Pk( $A, pk(x) ) ▶₂ #i )
        case Register_key
        solve( !Pk( $B, pk(x) ) ▶₃ #i )
          case Register_key
          solve( PendingA( $A, $B, ptr, n_old, sAold, oldCommitA, n, sAnew,
                           newCommitA, sign(newCommitA, ~ltk), fA_new, fB_new
                 ) ▶₀ #i )
            case Update_State_case_1
            by contradiction /* from formulas */
          next
            case Update_State_case_2
            by contradiction /* from formulas */
          next
            case Update_State_case_3
            by contradiction /* from formulas */
          next
            case Update_State_case_4
            by contradiction /* from formulas */
          qed
        qed
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case case_2
    solve( (∃ #r. (LtkCompromised( $Me ) @ #r) ∧ #r < #k)  ∥
           (∃ #m. (TimedOut( ptrOut ) @ #m) ∧ #m < #k) )
      case case_1
      by contradiction /* from formulas */
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case case_3
    solve( (∃ #r. (LtkCompromised( $Me ) @ #r) ∧ #r < #k)  ∥
           (∃ #m. (TimedOut( ptrOut ) @ #m) ∧ #m < #k) )
      case case_1
      by contradiction /* from formulas */
    next
      case case_2
      solve( (∃ #r. (LtkCompromised( $Me ) @ #r) ∧ #r < #k)  ∥
             (∃ #l. (Redeemed( ptrIn, y ) @ #l)) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        by contradiction /* cyclic */
      qed
    qed
  qed
qed

lemma Update_Requires_Negotiation [use_induction]:
  all-traces
  "∀ A B ptr n #i.
    (StateUpdate( A, B, ptr, n ) @ #i) ⇒
    (∃ fA fB #j. (NewStateBuilt( A, B, ptr, n, fA, fB ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ A B ptr n #i.
  (StateUpdate( A, B, ptr, n ) @ #i)
 ∧
  ∀ fA fB #j. (NewStateBuilt( A, B, ptr, n, fA, fB ) @ #j) ⇒ ¬(#j < #i)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ A B ptr n #i.
           (StateUpdate( A, B, ptr, n ) @ #i)
          ⇒
           ((last(#i)) ∨
            (∃ fA fB #j.
              (NewStateBuilt( A, B, ptr, n, fA, fB ) @ #j)
             ∧
              (¬(last(#j))) ∧ (#j < #i))))  ∥
         (∃ P ptrIn ptrOut y #f #k.
           (ForwardHTLC( P, ptrIn, ptrOut, y ) @ #f) ∧ (TimedOut( ptrIn ) @ #k)
          ∧
           (¬(last(#k))) ∧
           (¬(last(#f))) ∧
           (∀ #r.
             (LtkCompromised( P ) @ #r) ⇒ ((last(#r)) ∨ (#r = #k) ∨ (#k < #r))) ∧
           (∀ #m.
             (TimedOut( ptrOut ) @ #m) ⇒ ((last(#m)) ∨ (#m = #k) ∨ (#k < #m))))  ∥
         (∃ P ptrIn ptrOut y #f #i #k.
           (ForwardHTLC( P, ptrIn, ptrOut, y ) @ #f) ∧
           (Redeemed( ptrOut, y ) @ #i) ∧
           (TimedOut( ptrIn ) @ #k)
          ∧
           (¬(last(#k))) ∧
           (¬(last(#i))) ∧
           (¬(last(#f))) ∧
           (#i < #k) ∧
           (∀ #r.
             (LtkCompromised( P ) @ #r) ⇒ ((last(#r)) ∨ (#r = #k) ∨ (#k < #r))) ∧
           (∀ #l. (Redeemed( ptrIn, y ) @ #l) ⇒ last(#l))) )
    case case_1
    solve( (last(#i))  ∥
           (∃ fA fB #j.
             (NewStateBuilt( $A, $B, ptr, n, fA, fB ) @ #j)
            ∧
             (¬(last(#j))) ∧ (#j < #i)) )
      case case_1
      solve( !Pk( $A, pk(x) ) ▶₂ #i )
        case Register_key
        solve( !Pk( $B, pk(x) ) ▶₃ #i )
          case Register_key
          solve( PendingA( $A, $B, ptr, n_old, sAold, oldCommitA, n, sAnew,
                           newCommitA, sign(newCommitA, ~ltk), fA_new, fB_new
                 ) ▶₀ #i )
            case Update_State_case_1
            by contradiction /* from formulas */
          next
            case Update_State_case_2
            by contradiction /* from formulas */
          next
            case Update_State_case_3
            by contradiction /* from formulas */
          next
            case Update_State_case_4
            by contradiction /* from formulas */
          qed
        qed
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case case_2
    solve( (∃ #r. (LtkCompromised( $Me ) @ #r) ∧ #r < #k)  ∥
           (∃ #m. (TimedOut( ptrOut ) @ #m) ∧ #m < #k) )
      case case_1
      by contradiction /* from formulas */
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case case_3
    solve( (∃ #r. (LtkCompromised( $Me ) @ #r) ∧ #r < #k)  ∥
           (∃ #m. (TimedOut( ptrOut ) @ #m) ∧ #m < #k) )
      case case_1
      by contradiction /* from formulas */
    next
      case case_2
      solve( (∃ #r. (LtkCompromised( $Me ) @ #r) ∧ #r < #k)  ∥
             (∃ #l. (Redeemed( ptrIn, y ) @ #l)) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        by contradiction /* cyclic */
      qed
    qed
  qed
qed

// ---------------------------------------------------------------------------
// Lemmas -- HTLC / payment layer
// ---------------------------------------------------------------------------

lemma Ltk_Known_Implies_Compromised [reuse]:
    "All A ltk #i #j.
        KeyGen(A, ltk) @ #i
      & !KU(ltk) @ #j
     ==> Ex #k. LtkCompromised(A) @ #k & #k < #j"

lemma Invoice_Released_Once [reuse]:
    "All R x #i #j.
        PreimageReleased(R, x) @ #i
      & PreimageReleased(R, x) @ #j
     ==> #i = #j"

lemma Distinct_Parties_Configuration:
    exists-trace
      "∃ S F1 F2 R ptrSF1 ptrF1F2 ptrF2R #t1 #t2 #t3.
    ((((((((((((((ChannelOpen( S, F1, ptrSF1 ) @ #t1) ∧
                 (ChannelOpen( F1, F2, ptrF1F2 ) @ #t2)) ∧
                (ChannelOpen( F2, R, ptrF2R ) @ #t3)) ∧
               (¬(S = F1))) ∧
              (¬(S = F2))) ∧
             (¬(S = R))) ∧
            (¬(F1 = F2))) ∧
           (¬(F1 = R))) ∧
          (¬(F2 = R))) ∧
         (¬(∃ P #i. LtkCompromised( P ) @ #i))) ∧
        (¬(∃ P Q p n #j. StateUpdate( P, Q, p, n ) @ #j))) ∧
       (¬(∃ P n #k. PublishState( P, n ) @ #k))) ∧
      (¬(∃ P Q p n #l. Close( P, Q, p, n ) @ #l))) ∧
     (¬(∃ P n #m. Cheat( P, n ) @ #m))) ∧
    (¬(∃ Me Prev Next pi po y #n.
        HTLCForwarded( Me, Prev, Next, pi, po, y ) @ #n))
      & not (Ex ptr y1 y2 #m #n. HTLCAdded(ptr, y1) @ #m & HTLCAdded(ptr, y2) @ #n & not (#m = #n))"
simplify
solve( ReadyToLock( $A, $B, ptrSF1, sA0, sB0, commitA0, commitB0
       ) ▶₀ #t1 )
  case Both_States_Committed
  solve( Wallet( $A, ~fA ) ▶₁ #t1 )
    case Acquire_funds
    solve( Wallet( $B, ~fB ) ▶₂ #t1 )
      case Acquire_funds
      solve( ReadyToLock( $B, $B.1, ptrF1F2, sA0.1, sB0.1, commitA0, commitB0
             ) ▶₀ #t2 )
        case Both_States_Committed
        solve( Wallet( $B, ~fA.1 ) ▶₁ #t2 )
          case Acquire_funds
          solve( Wallet( $B.1, ~fB.1 ) ▶₂ #t2 )
            case Acquire_funds
            solve( ReadyToLock( $B.1, $B.2, ptrF2R, sA0.2, sB0.2, commitA0, commitB0
                   ) ▶₀ #t3 )
              case Both_States_Committed
              solve( Wallet( $B.1, ~fA.2 ) ▶₁ #t3 )
                case Acquire_funds
                solve( Wallet( $B.2, ~fB.2 ) ▶₂ #t3 )
                  case Acquire_funds
                  solve( !KU( sign(<'proposal', $A, $B, ~ptr>, ~ltk.2) ) @ #vk.17 )
                    case B_Recv_Proposal
                    solve( !KU( sign(<'proposal', $A, $B, ~ptr>, ~ltk.3) ) @ #vk.24 )
                      case A_Send_Proposal
                      solve( !KU( sign(<'proposal', $B, $B.1, ~ptr.1>, ~ltk.7) ) @ #vk.33 )
                        case B_Recv_Proposal
                        solve( !KU( sign(<'proposal', $B, $B.1, ~ptr.1>, ~ltk.8) ) @ #vk.38 )
                          case A_Send_Proposal
                          solve( !KU( sign(<'proposal', $B.1, $B.2, ~ptr.2>, ~ltk.12) ) @ #vk.45 )
                            case B_Recv_Proposal
                            solve( !KU( sign(<'proposal', $B.1, $B.2, ~ptr.2>, ~ltk.13) ) @ #vk.50 )
                              case A_Send_Proposal
                              solve( !KU( sign(<'proposal', $A, $B, ~ptr>, ~ltk.15) ) @ #vk.51 )
                                case A_Send_Proposal
                                solve( !KU( sign(<'proposal', $B, $B.1, ~ptr.1>, ~ltk.15) ) @ #vk.47 )
                                  case A_Send_Proposal
                                  solve( !KU( sign(<'proposal', $B.1, $B.2, ~ptr.2>, ~ltk.15) ) @ #vk.43 )
                                    case A_Send_Proposal
                                    solve( !KU( ~ptr ) @ #vk.33 )
                                      case A_Send_Proposal
                                      solve( !KU( ~ptr.1 ) @ #vk.36 )
                                        case A_Send_Proposal
                                        solve( !KU( ~ptr.2 ) @ #vk.38 )
                                          case A_Send_Proposal
                                          SOLVED // trace found
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma Refund_Possible:
  exists-trace
  "∃ S F1 R p y #i #j #k.
    ((((((((InvoiceCreated( R, S, y ) @ #j) ∧
           (HTLCOffered( S, F1, p, y ) @ #k)) ∧
          (HTLCRefunded( S, p, y ) @ #i)) ∧
         (#j < #k)) ∧
        (#k < #i)) ∧
       (¬(∃ A MidP B p2 x #l. SenderSettled( A, MidP, B, p2, x ) @ #l))) ∧
      (¬(∃ P #r. LtkCompromised( P ) @ #r))) ∧
     (¬(∃ Me Prev Next pi po y.1 #t1.
         HTLCForwarded( Me, Prev, Next, pi, po, y.1 ) @ #t1))) ∧
    (¬(∃ ptr y1 y2 #m #n.
        ((HTLCAdded( ptr, y1 ) @ #m) ∧ (HTLCAdded( ptr, y2 ) @ #n)) ∧
        (¬(#m = #n))))"
/*
guarded formula characterizing all satisfying traces:
"∃ S F1 R p y #i #j #k.
  (InvoiceCreated( R, S, y ) @ #j) ∧
  (HTLCOffered( S, F1, p, y ) @ #k) ∧
  (HTLCRefunded( S, p, y ) @ #i)
 ∧
  (#j < #k) ∧
  (#k < #i) ∧
  (∀ A MidP B p2 x #l. (SenderSettled( A, MidP, B, p2, x ) @ #l) ⇒ ⊥) ∧
  (∀ P #r. (LtkCompromised( P ) @ #r) ⇒ ⊥) ∧
  (∀ Me Prev Next pi po y.1 #t1.
    (HTLCForwarded( Me, Prev, Next, pi, po, y.1 ) @ #t1) ⇒ ⊥) ∧
  (∀ ptr y1 y2 #m #n.
    (HTLCAdded( ptr, y1 ) @ #m) ∧ (HTLCAdded( ptr, y2 ) @ #n) ⇒ #m = #n)"
*/
simplify
solve( !Ltk( $Receiver, ltkR ) ▶₁ #j )
  case Register_key
  solve( !Pk( $Receiver.1, pk(x.1) ) ▶₁ #k )
    case Register_key
    solve( !Ltk( $Sender, ltkS ) ▶₂ #k )
      case Register_key
      solve( !ChannelConnect( p, $Sender, $Forward1 ) ▶₃ #k )
        case Lock_Funds_And_Open_case_1
        solve( Free( ~ptr ) ▶₄ #k )
          case Lock_Funds_And_Open
          solve( HTLCRefunded( $Sender, ~ptr, h(~x) ) @ #i )
            case Sender_Timeout_Refund
            solve( SenderPending( $Sender, $Forward1, $Receiver, ~ptr, h(~x)
                   ) ▶₀ #i )
              case Sender_Offer_HTLC
              solve( !Timeout( ~ptr ) ▶₁ #i )
                case Open_Timeout_case_1
                solve( !KU( sign(<'invoice', $Receiver, $Sender, h(~x)>, ~ltk.1)
                       ) @ #vk.14 )
                  case Receiver_Create_Invoice
                  solve( !KU( sign(<'proposal', $Sender, $Forward1, ~ptr>, ~ltk.4)
                         ) @ #vk.22 )
                    case B_Recv_Proposal
                    solve( !KU( sign(<'proposal', $Sender, $Forward1, ~ptr>, ~ltk.5)
                           ) @ #vk.28 )
                      case A_Send_Proposal
                      solve( !KU( sign(<'proposal', $Sender, $Forward1, ~ptr>, ~ltk.7)
                             ) @ #vk.29 )
                        case A_Send_Proposal
                        solve( !KU( ~ptr ) @ #vk.23 )
                          case A_Send_Proposal
                          solve( !KU( h(~x) ) @ #vk.21 )
                            case Receiver_Create_Invoice
                            SOLVED // trace found
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma Preimage_Secret_Until_Released:
    "All R x #i #j.
        SecretPreimage(R, x) @ #i
      & K(x) @ #j
      & #i < #j
     ==> Ex #k. PreimageReleased(R, x) @ #k & #k < #j"

lemma Invoice_Has_Secret_Preimage [reuse]:
    "All R S x #i.
        InvoiceCreated(R, S, h(x)) @ #i
     ==> SecretPreimage(R, x) @ #i"

lemma HTLC_On_Opened_Channel [reuse, use_induction]:
    "All ptr y #i.
        HTLCAdded(ptr, y) @ #i
     ==> Ex X Y #j. ChannelOpen(X, Y, ptr) @ #j & #j < #i"


// 1. Settle_Requires_Receiver_Release: backward tracing loops infinitely.
// 2. use_induction lemmas: combining [use_induction] with 'signing' + 
//    'natural-numbers' in the merged theory causes severe slowdown. 
//    These verify perfectly in the isolated 3-hop multihop.spthy.

