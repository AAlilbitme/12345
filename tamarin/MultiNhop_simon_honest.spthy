// Pinned wormhole witness (as Simon's witnesses): one HTLC per channel; F1 and F3
// are the colluders, F3 compromised before its incoming HTLC p23 times out (so
// the honest-only T3 does not bind it); honest F2 is paid on neither hop.
lemma Wormhole_Honest_F2_Robbed_Pinned:
  exists-trace
  "∃ S F1 F2 F3 R pSF p12 p23 p3R x #o #a #b #d #r #l #u #i #s #c1
     #c3 #t.
    (((((((((((((((HTLCOffered( S, F1, pSF, h(x) ) @ #o) ∧
                  (HTLCForwarded( F1, S, F2, pSF, p12, h(x) ) @ #a)) ∧
                 (HTLCForwarded( F2, F1, F3, p12, p23, h(x) ) @ #b)) ∧
                (HTLCForwarded( F3, F2, R, p23, p3R, h(x) ) @ #d)) ∧
               (HTLCFulfilled( R, F3, p3R, h(x) ) @ #r)) ∧
              (Leaked( p3R, x ) @ #l)) ∧
             (Refunded( p23, h(x) ) @ #u)) ∧
            (Injected( pSF, x ) @ #i)) ∧
           (SenderSettled( S, F1, R, pSF, x ) @ #s)) ∧
          (LtkCompromised( F1 ) @ #c1)) ∧
         (LtkCompromised( F3 ) @ #c3)) ∧
        (TimedOut( p23 ) @ #t)) ∧
       (#c3 < #t)) ∧
      (¬(∃ #k. LtkCompromised( F2 ) @ #k))) ∧
     (¬(∃ #k. Redeemed( p12, h(x) ) @ #k))) ∧
    (¬(∃ ptr y1 y2 #m #n.
        ((HTLCAdded( ptr, y1 ) @ #m) ∧ (HTLCAdded( ptr, y2 ) @ #n)) ∧
        (¬(#m = #n))))"
