lemma Settle_Excludes_Sender_Refund:
    "All S F1 R ptr x #i.
        SenderSettled(S, F1, R, ptr, x) @ #i
     ==> not (Ex #j. HTLCRefunded(S, ptr, h(x)) @ #j)"

tactic: settle_first
presort: s
prio:
    regex "SenderPending"
prio:
    regex "OfferFor"
deprio:
    regex "Fulfill"

tactic: sig_first
presort: s
prio:
    regex "sign.<.invoice"
prio:
    regex "KU. ~ltk"
deprio:
    regex "Fulfill"

tactic: formulas_first
presort: s
prio:
    regex "OfferFor"
prio:
    regex "InvoiceCreated"
prio:
    regex "LtkCompromised"
deprio:
    regex "Fulfill"
deprio:
    regex "KU"

// Helpers for Invoice_Authenticates_Settlement.
lemma Settle_Requires_Offer [reuse, heuristic={settle_first}]:
    "All S F1 R ptr x #i.
        SenderSettled(S, F1, R, ptr, x) @ #i
     ==> Ex #o. OfferFor(S, R, ptr, h(x)) @ #o & #o < #i"

lemma Offer_Requires_Invoice [reuse, heuristic={sig_first}]:
    "All S R ptr y #o.
        OfferFor(S, R, ptr, y) @ #o
     ==> (Ex #j. InvoiceCreated(R, S, y) @ #j & #j < #o)
       | (Ex #r. LtkCompromised(R) @ #r & #r < #o)"

lemma Invoice_Authenticates_Settlement [heuristic={formulas_first}]:
    "All S F1 R ptr x #i.
        SenderSettled(S, F1, R, ptr, x) @ #i
     ==> (Ex #j. InvoiceCreated(R, S, h(x)) @ #j & #j < #i)
       | (Ex #r. LtkCompromised(R) @ #r & #r < #i)"

lemma Forged_Invoice_Requires_Key_Compromise:
    exists-trace
    "Ex S F1 R ptr x #i #r.
        SenderSettled(S, F1, R, ptr, x) @ #i
      & LtkCompromised(R) @ #r
      & not (Ex #j. InvoiceCreated(R, S, h(x)) @ #j)
      & not (Ex Me Prev Next pi po y #u. HTLCForwarded(Me, Prev, Next, pi, po, y) @ #u)"

lemma Loss_Requires_Inaction:
    "All P ptrIn ptrOut y #i #j #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #i
      & Redeemed(ptrOut, y) @ #j
      & Refunded(ptrIn, y) @ #k
     ==> not (Ex #l. Redeemed(ptrIn, y) @ #l)"

lemma Refund_Requires_Timeout [reuse]:
    "All ptr y #i.
        Refunded(ptr, y) @ #i
     ==> Ex #j. TimedOut(ptr) @ #j & #j < #i"

lemma Intermediary_Never_Loses_Under_Liveness:
    "All P ptrIn ptrOut y #i #j #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #i
      & Redeemed(ptrOut, y) @ #j
      & Refunded(ptrIn, y) @ #k
      & not (Ex #r. LtkCompromised(P) @ #r)   // CHANGED: honest P
     ==> F"

lemma Payment_Atomicity_Under_Liveness:
    "All F1 F2 ptrSF1 ptrF1F2 ptrF2R y #i #j #k.
        ForwardHTLC(F1, ptrSF1, ptrF1F2, y) @ #i
      & ForwardHTLC(F2, ptrF1F2, ptrF2R, y) @ #j
      & Redeemed(ptrF2R, y) @ #k
      & (not Ex P #l. LtkCompromised(P) @ #l)
     ==> not (Ex #m. Refunded(ptrSF1, y) @ #m)"

lemma Timeout_race_Blocked:
    "not (Ex P ptrIn ptrOut y #l #i #j #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #l
      & TimedOut(ptrIn)     @ #k
      & Refunded(ptrIn, y)  @ #j
      & Redeemed(ptrOut, y) @ #i
      & #k < #i
      & not (Ex #r. LtkCompromised(P) @ #r))"   // CHANGED: honest P

// --- GENERALIZED routing witness (any chain length) ---------------------------

lemma Multihop_Payment_Possible:
  exists-trace
  "∃ S F1 F2 R p0 p1 p2 x #t2 #t3 #t4 #t5.
    (((((((((HTLCOffered( S, F1, p0, h(x) ) @ #t2) ∧
            (HTLCForwarded( F1, S, F2, p0, p1, h(x) ) @ #t3)) ∧
           (HTLCForwarded( F2, F1, R, p1, p2, h(x) ) @ #t4)) ∧
          (HTLCFulfilled( R, F2, p2, h(x) ) @ #t5)) ∧
         (#t2 < #t3)) ∧
        (#t3 < #t4)) ∧
       (#t4 < #t5)) ∧
      (¬(∃ A B p y #u.
          (HTLCOffered( A, B, p, y ) @ #u) ∧ (¬((A = S) ∧ (B = F1)))))) ∧
     (¬(∃ Me Prev Next pi po y #u.
         ((HTLCForwarded( Me, Prev, Next, pi, po, y ) @ #u) ∧
          (¬(((Me = F1) ∧ (Prev = S)) ∧ (Next = F2)))) ∧
         (¬(((Me = F2) ∧ (Prev = F1)) ∧ (Next = R)))))) ∧
    (¬(∃ ptr y1 y2 #m #n.
        ((HTLCAdded( ptr, y1 ) @ #m) ∧ (HTLCAdded( ptr, y2 ) @ #n)) ∧
        (¬(#m = #n))))"
/*
guarded formula characterizing all satisfying traces:
"∃ S F1 F2 R p0 p1 p2 x #t2 #t3 #t4 #t5.
  (HTLCOffered( S, F1, p0, h(x) ) @ #t2) ∧
  (HTLCForwarded( F1, S, F2, p0, p1, h(x) ) @ #t3) ∧
  (HTLCForwarded( F2, F1, R, p1, p2, h(x) ) @ #t4) ∧
  (HTLCFulfilled( R, F2, p2, h(x) ) @ #t5)
 ∧
  (#t2 < #t3) ∧
  (#t3 < #t4) ∧
  (#t4 < #t5) ∧
  (∀ A B p y #u.
    (HTLCOffered( A, B, p, y ) @ #u) ⇒ (A = S) ∧ (B = F1)) ∧
  (∀ Me Prev Next pi po y #u.
    (HTLCForwarded( Me, Prev, Next, pi, po, y ) @ #u)
   ⇒
    (((Me = F1) ∧ (Prev = S) ∧ (Next = F2)) ∨
     ((Me = F2) ∧ (Prev = F1) ∧ (Next = R)))) ∧
  (∀ ptr y1 y2 #m #n.
    (HTLCAdded( ptr, y1 ) @ #m) ∧ (HTLCAdded( ptr, y2 ) @ #n)
   ⇒
    #m = #n)"
*/
simplify
solve( !Pk( $Receiver, pk(x.1) ) ▶₁ #t2 )
  case Register_key
  solve( !Ltk( $Sender, ltkS ) ▶₂ #t2 )
    case Register_key
    solve( !ChannelConnect( p0, $Sender, $Forward1 ) ▶₃ #t2 )
      case Lock_Funds_And_Open_case_1
      solve( Free( ~ptr ) ▶₄ #t2 )
        case Intermediary_Settle_case_1
        by sorry
      next
        case Intermediary_Settle_case_2
        by sorry
      next
        case Lock_Funds_And_Open
        solve( !ChannelConnect( p1, $B, $Next ) ▶₁ #t3 )
          case Lock_Funds_And_Open_case_1
          solve( Free( ~ptr.1 ) ▶₂ #t3 )
            case Intermediary_Settle_case_1
            by sorry
          next
            case Intermediary_Settle_case_2
            by sorry
          next
            case Lock_Funds_And_Open
            solve( !ChannelConnect( p2, $Next, $Next.1 ) ▶₁ #t4 )
              case Lock_Funds_And_Open_case_1
              solve( Free( ~ptr.2 ) ▶₂ #t4 )
                case Intermediary_Settle_case_1
                by sorry
              next
                case Intermediary_Settle_case_2
                by sorry
              next
                case Lock_Funds_And_Open
                solve( Route( $Next, $B.1, ~ptr.2, h(x) ) ▶₀ #t5 )
                  case Forward_HTLC
                  solve( ReceiverInv( $B.1, $Sender, x ) ▶₁ #t5 )
                    case Receiver_Create_Invoice
                    solve( (∃ #j.
                             (InvoiceCreated( $Receiver, $A, h(~x) ) @ #j) ∧ #j < #t2)  ∥
                           (∃ #r. (LtkCompromised( $Receiver ) @ #r) ∧ #r < #t2) )
                      case case_1
                      solve( !KU( sign(<'invoice', $Receiver, $A, h(~x)>, ~ltk)
                             ) @ #vk.16 )
                        case Receiver_Create_Invoice
                        solve( !KU( sign(<'proposal', $A, $B, ~ptr>, ~ltk.4) ) @ #vk.37 )
                          case A_Send_Proposal
                          by contradiction /* from formulas */
                        next
                          case B_Recv_Proposal
                          solve( !KU( sign(<'proposal', $A, $B, ~ptr>, ~ltk.6) ) @ #vk.44 )
                            case A_Send_Proposal
                            solve( !KU( sign(<'proposal', $B, $Next, ~ptr.1>, ~ltk.9)
                                   ) @ #vk.51 )
                              case A_Send_Proposal
                              by contradiction /* from formulas */
                            next
                              case B_Recv_Proposal
                              solve( !KU( sign(<'proposal', $B, $Next, ~ptr.1>, ~ltk.11)
                                     ) @ #vk.56 )
                                case A_Send_Proposal
                                solve( !KU( sign(<'proposal', $Next, $Receiver, ~ptr.2>, ~ltk.14)
                                       ) @ #vk.60 )
                                  case A_Send_Proposal
                                  by contradiction /* from formulas */
                                next
                                  case B_Recv_Proposal
                                  solve( !KU( sign(<'proposal', $Next, $Receiver, ~ptr.2>, ~ltk.16)
                                         ) @ #vk.65 )
                                    case A_Send_Proposal
                                    solve( !KU( sign(<'proposal', $A, $B, ~ptr>, ~ltk.17)
                                           ) @ #vk.66 )
                                      case A_Send_Proposal
                                      solve( !KU( sign(<'proposal', $B, $Next, ~ptr.1>, ~ltk.17)
                                             ) @ #vk.62 )
                                        case A_Send_Proposal
                                        solve( !KU( sign(<'proposal', $Next, $Receiver, ~ptr.2>,
                                                         ~ltk.17)
                                               ) @ #vk.58 )
                                          case A_Send_Proposal
                                          solve( Route( $A, $B, ~ptr, h(~x) ) ▶₀ #t3 )
                                            case Sender_Offer_HTLC
                                            solve( Route( $B, $Next, ~ptr.1, h(~x) ) ▶₀ #t4 )
                                              case Forward_HTLC
                                              solve( !KU( ~ptr ) @ #vk.49 )
                                                case A_Send_Proposal
                                                solve( !KU( ~ptr.1 ) @ #vk.52 )
                                                  case A_Send_Proposal
                                                  solve( !KU( ~ptr.2 ) @ #vk.53 )
                                                    case A_Send_Proposal
                                                    solve( !KU( h(~x) ) @ #vk.43 )
                                                      case Receiver_Create_Invoice
                                                      SOLVED // trace found
                                                    next
                                                      case c_h
                                                      by sorry
                                                    qed
                                                  qed
                                                qed
                                              qed
                                            qed
                                          qed
                                        next
                                          case B_Recv_Proposal
                                          by contradiction /* from formulas */
                                        next
                                          case c_sign
                                          by sorry
                                        qed
                                      next
                                        case B_Recv_Proposal
                                        by contradiction /* from formulas */
                                      next
                                        case c_sign
                                        by sorry
                                      qed
                                    next
                                      case B_Recv_Proposal
                                      by contradiction /* from formulas */
                                    next
                                      case c_sign
                                      by sorry
                                    qed
                                  next
                                    case B_Recv_Proposal
                                    by contradiction /* from formulas */
                                  next
                                    case c_sign
                                    by sorry
                                  qed
                                next
                                  case c_sign
                                  by sorry
                                qed
                              next
                                case B_Recv_Proposal
                                by contradiction /* from formulas */
                              next
                                case c_sign
                                by sorry
                              qed
                            next
                              case c_sign
                              by sorry
                            qed
                          next
                            case B_Recv_Proposal
                            by contradiction /* from formulas */
                          next
                            case c_sign
                            by sorry
                          qed
                        next
                          case c_sign
                          by sorry
                        qed
                      next
                        case c_sign
                        by sorry
                      qed
                    next
                      case case_2
                      by sorry
                    qed
                  qed
                qed
              qed
            next
              case Lock_Funds_And_Open_case_2
              by sorry
            qed
          qed
        next
          case Lock_Funds_And_Open_case_2
          by sorry
        qed
      next
        case Sender_Settle_case_1
        by sorry
      next
        case Sender_Settle_case_2
        by sorry
      next
        case Sender_Settle_case_3
        by sorry
      next
        case Sender_Settle_case_4
        by sorry
      next
        case Sender_Settle_case_5
        by sorry
      qed
    next
      case Lock_Funds_And_Open_case_2
      by sorry
    qed
  qed
qed

lemma Wormhole_Honest_F2_Robbed:
    exists-trace
    "Ex S F1 F2 F3 R pSF p12 p23 p3R x #o #a #b #d #r #l #u #i #s.
        HTLCOffered(S, F1, pSF, h(x)) @ #o
      & HTLCForwarded(F1, S, F2, pSF, p12, h(x)) @ #a
      & HTLCForwarded(F2, F1, F3, p12, p23, h(x)) @ #b
      & HTLCForwarded(F3, F2, R, p23, p3R, h(x)) @ #d
      & HTLCFulfilled(R, F3, p3R, h(x)) @ #r
      & Leaked(p3R, x) @ #l
      & Refunded(p23, h(x)) @ #u
      & Injected(pSF, x) @ #i
      & SenderSettled(S, F1, R, pSF, x) @ #s
      & not (Ex #k. LtkCompromised(F2) @ #k)
      & not (Ex #k. Redeemed(p12, h(x)) @ #k)"

// Quantified wormhole: both intermediaries charge a fee but NEITHER earns it.
// (This generalized model does not track amounts in the HTLC facts, so the
// "stolen value == exactly the path fees" equality from the value-tracking
// model cannot be expressed here; the fee-charged-but-not-earned witness is
// the closest equivalent.)
/* I can't prove this one. */
