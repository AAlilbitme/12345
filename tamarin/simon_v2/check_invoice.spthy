theory CheckInvoice
begin

#include "model.spthy"

// Simon's tactic for this lemma (copied from his tactics.spthy).
tactic: invoice_signature
presort: s
prio:
    regex "^\s*SenderPending[(].*▶₀ #i\s*$"
prio:
    regex "^\s*!KU[(] sign[(]<[$]Receiver"
prio:
    regex "^\s*!KU[(] ~ltk"
prio:
    regex "^\s*!Ltk[(]"
prio:
    regex "^\s*InvoiceCreated[(]"
prio:
    regex "LtkCompromised"
deprio:
    regex "RouteInfo"
    regex "∥"
    regex "ChannelConnect"
    regex "ReadyToLock"
    regex "Wallet"
    regex "Mutex"
    regex "^\s*Route[(]"
    regex "SenderPending"
    regex "IntermediaryPending"
    regex "Fulfilled"
    regex "KU[(]"

// Simon's lemma, unchanged.
lemma Invoice_Authenticates_Settlement [heuristic={invoice_signature}]:
    "All S F1 R ptr x #i.
        SenderSettled(S, F1, R, ptr, x) @ #i
     ==> (Ex #j. InvoiceCreated(R, S, h(x)) @ #j & #j < #i)
       | (Ex #r. LtkCompromised(R) @ #r & #r < #i)"

end
