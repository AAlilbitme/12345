theory CheckReach
begin

#include "modelupd.spthy"

tactic: chain
presort: s
prio:
    regex "^\s*InFlight[(]" | regex "^\s*!UpdateDone[(]" | regex "^\s*UpdateFor[(]"
prio:
    regex "^\s*Pending[AB][(]" | regex "^\s*State[AB][(]"
prio:
    regex "^\s*ReadyToLock[(]" | regex "^\s*Mutex[(]" | regex "ChannelConnect"
prio:
    regex "∀" | regex "∥"
deprio:
    regex "KU[(]"

lemma Open_Reachable:
  exists-trace
  "Ex A B ptr #i. ChannelOpen(A, B, ptr) @ #i & not (Ex X #k. LtkCompromised(X) @ #k)"

lemma Update_Reachable:
  exists-trace
  "Ex A B ptr n #i. StateUpdate(A, B, ptr, n) @ #i & not (Ex X #k. LtkCompromised(X) @ #k)"

lemma Offer_Reachable:
  exists-trace
  "Ex S F ptr y #i. HTLCOffered(S, F, ptr, y) @ #i & not (Ex X #k. LtkCompromised(X) @ #k)"

lemma Plain_Update_Reachable:
  exists-trace
  "Ex A B ptr n #i. StateUpdate(A, B, ptr, n) @ #i
    & not (Ex X #k. LtkCompromised(X) @ #k)
    & not (Ex p op m #u. ChannelUpdateFor(p, op, m) @ #u)"

lemma Add_Commit_Reachable [heuristic={chain}]:
  exists-trace
  "Ex ptr y n #c. HTLCCommitted(ptr, <'add', y>, n) @ #c
    & not (Ex X #k. LtkCompromised(X) @ #k)
    & (All a b p m m2 #u #v. StateUpdate(a, b, p, m) @ #u
         & StateUpdate(a, b, p, m2) @ #v ==> #u = #v)
    & (All p op m #u. ChannelUpdateFor(p, op, m) @ #u ==> op = <'add', y>)"

lemma Offer_Reachable_Upd:
  exists-trace
  "Ex S F ptr y #i. HTLCOffered(S, F, ptr, y) @ #i
    & not (Ex X #k. LtkCompromised(X) @ #k)
    & not (Ex p op m #u. ChannelUpdateFor(p, op, m) @ #u)"

lemma HTLC_Update_Reachable [heuristic={chain}]:
  exists-trace
  "Ex ptr op n #c. ChannelUpdateFor(ptr, op, n) @ #c
    & not (Ex X #k. LtkCompromised(X) @ #k)
    & not (Ex a b p m #u. StateUpdate(a, b, p, m) @ #u)"

lemma HTLC_Update_Completed_Reachable [heuristic={chain}]:
  exists-trace
  "Ex A B ptr op n #c #r. ChannelUpdateFor(ptr, op, n) @ #c & StateUpdate(A, B, ptr, n) @ #r
    & not (Ex X #k. LtkCompromised(X) @ #k)
    & (All a b p m #u. StateUpdate(a, b, p, m) @ #u ==> #u = #r)"

lemma HTLC_Add_Committed_Reachable [heuristic={chain}]:
  exists-trace
  "Ex A B ptr y n #c #r. HTLCCommitted(ptr, <'add', y>, n) @ #c & StateUpdate(A, B, ptr, n) @ #r
    & not (Ex X #k. LtkCompromised(X) @ #k)
    & (All a b p m #u. StateUpdate(a, b, p, m) @ #u ==> #u = #r)"

lemma Payment_Reachable [heuristic={chain}]:
  exists-trace
  "Ex S F R p0 p1 x #o #f #s.
      HTLCOffered(S, F, p0, h(x)) @ #o
    & HTLCForwarded(F, S, R, p0, p1, h(x)) @ #f
    & SenderSettled(S, F, R, p0, x) @ #s
    & not (Ex X #k. LtkCompromised(X) @ #k)
    & (All a b p m #u. StateUpdate(a, b, p, m) @ #u ==> Ex op #w. ChannelUpdateFor(p, op, m) @ #w)
    & (All p op m #u. ChannelUpdateFor(p, op, m) @ #u ==> (op = <'add', h(x)>) | (op = <'settle', h(x)>))
    & (All p op m m2 #u #v. ChannelUpdateFor(p, op, m) @ #u & ChannelUpdateFor(p, op, m2) @ #v ==> #u = #v)"

lemma Forward_Reachable2 [heuristic={chain}]:
  exists-trace
  "Ex S F R p0 p1 y #f.
      HTLCForwarded(F, S, R, p0, p1, y) @ #f
    & not (Ex X #k. LtkCompromised(X) @ #k)
    & (All a b p m #u. StateUpdate(a, b, p, m) @ #u ==> Ex op #w. ChannelUpdateFor(p, op, m) @ #w)
    & (All p op m m2 #u #v. ChannelUpdateFor(p, op, m) @ #u & ChannelUpdateFor(p, op, m2) @ #v ==> #u = #v)
    & (All p op m #u. ChannelUpdateFor(p, op, m) @ #u ==> op = <'add', y>)"

lemma Fulfill_Reachable [heuristic={chain}]:
  exists-trace
  "Ex S F R p0 p1 x #f #r.
      HTLCForwarded(F, S, R, p0, p1, h(x)) @ #f
    & HTLCFulfilled(R, F, p1, h(x)) @ #r
    & not (Ex X #k. LtkCompromised(X) @ #k)
    & (All a b p m #u. StateUpdate(a, b, p, m) @ #u ==> Ex op #w. ChannelUpdateFor(p, op, m) @ #w)
    & (All p op m m2 #u #v. ChannelUpdateFor(p, op, m) @ #u & ChannelUpdateFor(p, op, m2) @ #v ==> #u = #v)
    & (All p op m #u. ChannelUpdateFor(p, op, m) @ #u ==> op = <'add', h(x)>)"

lemma Payment_Upd [heuristic={chain}]:
  exists-trace
  "Ex S F R p0 p1 x #o #f #s.
      HTLCOffered(S, F, p0, h(x)) @ #o
    & HTLCForwarded(F, S, R, p0, p1, h(x)) @ #f
    & SenderSettled(S, F, R, p0, x) @ #s
    & not (Ex X #k. LtkCompromised(X) @ #k)
    & (All p z #u. Old(p, z) @ #u ==> z = h(x))
    & not (Ex P p z #u. Refunded(P, p, z) @ #u)
    & not (Ex t #u. Tick(t) @ #u)
    & (All a b p m #u. StateUpdate(a, b, p, m) @ #u ==> Ex op #w. ChannelUpdateFor(p, op, m) @ #w)
    & (All p op m #u. ChannelUpdateFor(p, op, m) @ #u ==> (op = <'add', h(x)>) | (op = <'settle', h(x)>))
    & (All p op m m2 #u #v. ChannelUpdateFor(p, op, m) @ #u & ChannelUpdateFor(p, op, m2) @ #v ==> #u = #v)"

lemma Payment_Upd2:
  exists-trace
  "Ex S F R p0 p1 x #o #f #s.
      HTLCOffered(S, F, p0, h(x)) @ #o
    & HTLCForwarded(F, S, R, p0, p1, h(x)) @ #f
    & SenderSettled(S, F, R, p0, x) @ #s
    & not (Ex X #k. LtkCompromised(X) @ #k)
    & (All p z #u. Old(p, z) @ #u ==> z = h(x))
    & not (Ex P p z #u. Refunded(P, p, z) @ #u)
    & not (Ex t #u. Tick(t) @ #u)
    & (All p #u. MutexReleased(p) @ #u ==> #f < #u)
    & (All a b p m #u. StateUpdate(a, b, p, m) @ #u ==> Ex op #w. ChannelUpdateFor(p, op, m) @ #w)
    & (All p op m #u. ChannelUpdateFor(p, op, m) @ #u ==> (op = <'add', h(x)>) | (op = <'settle', h(x)>))
    & (All p op m m2 #u #v. ChannelUpdateFor(p, op, m) @ #u & ChannelUpdateFor(p, op, m2) @ #v ==> #u = #v)"

end
