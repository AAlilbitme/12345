theory CheckTagFix
begin

// Simon's model with only the 'invoice' tag added (modeltagged.spthy).
#include "modeltagged.spthy"

tactic: offer_invoice
presort: s
prio:
    regex "^\s*!KU[(] sign[(]<'invoice'"
prio:
    regex "^\s*!KU[(] ~ltk"
prio:
    regex "^\s*!Ltk[(]"
prio:
    regex "InvoiceCreated"
prio:
    regex "LtkCompromised"
deprio:
    regex "RouteInfo"
    regex "∥"
    regex "ChannelConnect"
    regex "ReadyToLock"
    regex "Wallet"
    regex "Mutex"
    regex "^\s*Route[(]"
    regex "SenderPending"
    regex "IntermediaryPending"
    regex "Fulfilled"
    regex "KU[(]"

// Helper: a tagged invoice signed with R's key exists only if R created it or
// R's key leaked.
lemma Invoice_Signature_Origin [reuse, heuristic={offer_invoice}]:
    "All R S y a ltk #i #k.
        !KU(sign(<'invoice', R, S, y, a>, ltk)) @ #i
      & KeyGen(R, ltk) @ #k
     ==> (Ex #j. InvoiceCreated(R, S, y) @ #j & #j < #i)
       | (Ex #r. LtkCompromised(R) @ #r)"

// The sender only offers on an invoice the receiver created (or the receiver
// was compromised).  Falsified in Simon's untagged model (14 steps).
lemma Offer_Requires_Invoice [heuristic={offer_invoice}]:
    "All S R ptr y #o.
        OfferFor(S, R, ptr, y) @ #o
     ==> (Ex #j. InvoiceCreated(R, S, y) @ #j & #j < #o)
       | (Ex #r. LtkCompromised(R) @ #r)"

end
