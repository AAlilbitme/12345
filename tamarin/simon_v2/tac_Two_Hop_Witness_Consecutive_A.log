lemma Two_Hop_Witness_Concrete:
  exists-trace
  "∃ p0 p1 p2 y r0 r1 r2 #k0 #e #i2 #i1 #i0 #k1 #k2 #k.
    (((((((((((((((Tick( %1 ) @ #k0) ∧
                  (ForwardExpiries( p0, p1, y, (%1%+%1%+%1%+%1%+%1), (%1%+%1%+%1)
                   ) @ #e)) ∧
                 (ForwardExpiries( p1, p2, y, (%1%+%1%+%1), %1 ) @ #e)) ∧
                (#k0 < #e)) ∧
               (HTLCCommittedAt( p2, <'settle', y, r2>, %1 ) @ #i2)) ∧
              (HTLCCommittedAt( p1, <'settle', y, r1>, %1 ) @ #i1)) ∧
             (HTLCCommittedAt( p0, <'settle', y, r0>, %1 ) @ #i0)) ∧
            (Tick( (%1%+%1%+%1) ) @ #k1)) ∧
           (Tick( (%1%+%1%+%1%+%1%+%1) ) @ #k2)) ∧
          (Tick( (%1%+%1%+%1%+%1%+%1%+%1) ) @ #k)) ∧
         (#i2 < #i1)) ∧
        (#i1 < #i0)) ∧
       (#i0 < #k1)) ∧
      (#k1 < #k2)) ∧
     (#k2 < #k)) ∧
    (∀ %t #j.
      (Tick( %t ) @ #j) ⇒
      ((((#j = #k0) ∨ (#j = #k1)) ∨ (#j = #k2)) ∨ (#j = #k)))"
/*
guarded formula characterizing all satisfying traces:
"∃ p0 p1 p2 y r0 r1 r2 #k0 #e #i2 #i1 #i0 #k1 #k2 #k.
  (Tick( %1 ) @ #k0) ∧
  (ForwardExpiries( p0, p1, y, (%1%+%1%+%1%+%1%+%1), (%1%+%1%+%1) ) @ #e) ∧
  (ForwardExpiries( p1, p2, y, (%1%+%1%+%1), %1 ) @ #e) ∧
  (HTLCCommittedAt( p2, <'settle', y, r2>, %1 ) @ #i2) ∧
  (HTLCCommittedAt( p1, <'settle', y, r1>, %1 ) @ #i1) ∧
  (HTLCCommittedAt( p0, <'settle', y, r0>, %1 ) @ #i0) ∧
  (Tick( (%1%+%1%+%1) ) @ #k1) ∧
  (Tick( (%1%+%1%+%1%+%1%+%1) ) @ #k2) ∧
  (Tick( (%1%+%1%+%1%+%1%+%1%+%1) ) @ #k)
 ∧
  (#k0 < #e) ∧
  (#i2 < #i1) ∧
  (#i1 < #i0) ∧
  (#i0 < #k1) ∧
  (#k1 < #k2) ∧
  (#k2 < #k) ∧
  (∀ %t #j.
    (Tick( %t ) @ #j) ⇒ ((#j = #k0) ∨ (#j = #k1) ∨ (#j = #k2) ∨ (#j = #k)))"
*/
by sorry

lemma Two_Hop_Gap_Counterexample:
  exists-trace
  "∃ p0 p1 p2 y r2 r0 n0 %c %cx #k0 #e #i2 #k #l.
    ((((((((((Tick( %1 ) @ #k0) ∧
             (ForwardExpiries( p0, p1, y, (%1%+%1%+%1), (%1%+%1) ) @ #e)) ∧
