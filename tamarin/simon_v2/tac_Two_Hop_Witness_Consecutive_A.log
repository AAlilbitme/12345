  all-traces
  "∀ Q Q2 ptr y rid rid2 %b %d #q #q2.
    ((SettleRequested( Q, ptr, y, rid, %b ) @ #q) ∧
     (SettleRequested( Q2, ptr, y, rid2, %d ) @ #q2)) ⇒
    (#q = #q2)"
/*
guarded formula characterizing all counter-examples:
"∃ Q Q2 ptr y rid rid2 %b %d #q #q2.
  (SettleRequested( Q, ptr, y, rid, %b ) @ #q) ∧
  (SettleRequested( Q2, ptr, y, rid2, %d ) @ #q2)
 ∧
  ¬(#q = #q2)"
*/
by sorry

lemma Commit_Unique_Channel [reuse]:
  all-traces
  "∀ ptr y rid rid2 n n2 #c #c2.
    ((HTLCCommitted( ptr, <'settle', y, rid>, n ) @ #c) ∧
     (HTLCCommitted( ptr, <'settle', y, rid2>, n2 ) @ #c2)) ⇒
    (#c = #c2)"
/*
guarded formula characterizing all counter-examples:
"∃ ptr y rid rid2 n n2 #c #c2.
  (HTLCCommitted( ptr, <'settle', y, rid>, n ) @ #c) ∧
  (HTLCCommitted( ptr, <'settle', y, rid2>, n2 ) @ #c2)
 ∧
  ¬(#c = #c2)"
*/
