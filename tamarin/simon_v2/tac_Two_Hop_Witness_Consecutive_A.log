lemma Stamp_Between_Ticks:
  all-traces
  "∀ %b #q.
    (Now( %b ) @ #q) ⇒
    ((∃ #t. (Tick( %b ) @ #t) ∧ (#t < #q)) ∧
     (¬(∃ %c #t2. ((Tick( %c ) @ #t2) ∧ (%b ⊏ %c)) ∧ (#t2 < #q))))"
