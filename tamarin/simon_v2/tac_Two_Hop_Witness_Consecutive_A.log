lemma Two_Hop_Witness_Pinned:
  exists-trace
  "∃ p0 p1 p2 y r0 r1 r2 n0 n1 n2 #k0 #e #q2 #u2 #s2 #i2 #a2 #q1 #u1 #s1
     #i1 #a1 #q0 #u0 #s0 #i0 #a0 #k1 #k2 #k.
    ((((((((((((((((((((((((((((((((((((((((Tick( %1 ) @ #k0) ∧
                                           (ForwardExpiries( p0, p1, y, (%1%+%1%+%1%+%1%+%1), (%1%+%1%+%1)
                                            ) @ #e)) ∧
                                          (ForwardExpiries( p1, p2, y, (%1%+%1%+%1), %1 ) @ #e)) ∧
                                         (SettleRequested( 'R', p2, y, r2, %1 ) @ #q2)) ∧
                                        (ChannelUpdateFor( p2, <'settle', y, r2>, n2 ) @ #u2)) ∧
                                       (StateUpdate( p2, n2 ) @ #s2)) ∧
                                      (HTLCCommittedAt( p2, <'settle', y, r2>, %1 ) @ #i2)) ∧
                                     (PreimageAvailable( p2, y, %1 ) @ #a2)) ∧
                                    (SettleRequested( 'F2', p1, y, r1, %1 ) @ #q1)) ∧
                                   (ChannelUpdateFor( p1, <'settle', y, r1>, n1 ) @ #u1)) ∧
                                  (StateUpdate( p1, n1 ) @ #s1)) ∧
                                 (HTLCCommittedAt( p1, <'settle', y, r1>, %1 ) @ #i1)) ∧
                                (PreimageAvailable( p1, y, %1 ) @ #a1)) ∧
                               (SettleRequested( 'F1', p0, y, r0, %1 ) @ #q0)) ∧
                              (ChannelUpdateFor( p0, <'settle', y, r0>, n0 ) @ #u0)) ∧
                             (StateUpdate( p0, n0 ) @ #s0)) ∧
                            (HTLCCommittedAt( p0, <'settle', y, r0>, %1 ) @ #i0)) ∧
                           (PreimageAvailable( p0, y, %1 ) @ #a0)) ∧
                          (Tick( (%1%+%1%+%1) ) @ #k1)) ∧
                         (Tick( (%1%+%1%+%1%+%1%+%1) ) @ #k2)) ∧
                        (Tick( (%1%+%1%+%1%+%1%+%1%+%1) ) @ #k)) ∧
                       (#k0 < #e)) ∧
                      (#e < #q2)) ∧
