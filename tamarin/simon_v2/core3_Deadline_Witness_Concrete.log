solve( (¬(%c2 ⊏ (%1%+%1%+%1)))  ∥
       (∃ #a.
         (PreimageAvailable( ~p0, h(~x), %c2 ) @ #a) ∧ (#l < #a) ∧ (#a < #k1)) )
  case case_2
  solve( (¬(%c2 ⊏ (%1%+%1%+%1%+%1)))  ∥
         (∃ #a.
           (PreimageAvailable( ~p0, h(~x), %c2 ) @ #a) ∧ (#l < #a) ∧ (#a < #k)) )
    case case_2
