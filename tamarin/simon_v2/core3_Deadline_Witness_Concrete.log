theory DeadlineCore begin

// Function signature and definition of the equational theory E

builtins: natural-numbers
functions: fst/1, h/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2









rule (modulo E) Clock_Tick:
   [ In( %t ) ] --[ Tick( %t ) ]-> [ !Block( %t ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Setup_Route:
   [ Fr( ~x ), Fr( ~p0 ), Fr( ~p1 ), In( %tIn ), In( %tOut ) ]
  --[
  SetupOnce( ), HTLCForwarded( 'F', 'S', 'R', ~p0, ~p1, h(~x) ),
  ForwardExpiries( ~p0, ~p1, h(~x), %tIn, %tOut )
  ]->
   [ ReceiverHas( ~p1, ~x ), FwdPending( ~p0, ~p1 ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Receiver_Request_Settle:
   [ ReceiverHas( p1, x ), !Block( %b ), Fr( ~rid ) ]
  --[ SettleRequested( 'R', p1, h(x), ~rid, %b ), Now( %b ) ]->
   [ UpdateFor( p1, <'settle', h(x), ~rid> ), AwaitFulfilled( p1, x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Update_For_Op:
   [ UpdateFor( ptr, op ), Fr( ~n ) ]
  --[ ChannelUpdateFor( ptr, op, ~n ) ]->
   [ InFlight( ptr, ~n, op ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Revoke_Old_State:
   [ InFlight( ptr, n, op ) ]
  --[ StateUpdate( ptr, n ) ]->
   [ UpdateDone( ptr, n, op ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Commit_Op:
   [ UpdateDone( ptr, n, op ), !Block( %b ) ]
  --[
  HTLCCommitted( ptr, op, n ), HTLCCommittedAt( ptr, op, %b ), Now( %b )
  ]->
   [ Committed( ptr, op ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Deliver_Preimage:
   [
   AwaitFulfilled( ptr, x ), Committed( ptr, <'settle', h(x), rid> ),
   !Block( %b )
   ]
  --[ PreimageAvailable( ptr, h(x), %b ), Now( %b ) ]->
   [ Fulfilled( ptr, x ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Forwarder_Request_Settle:
   [ Fulfilled( p1, x ), FwdPending( p0, p1 ), !Block( %b ), Fr( ~rid ) ]
  --[ SettleRequested( 'F', p0, h(x), ~rid, %b ), Now( %b ) ]->
   [ UpdateFor( p0, <'settle', h(x), ~rid> ), AwaitFulfilled( p0, x ) ]

  /* has exactly the trivial AC variant */

restriction SetupOnce:
  "∀ #i #j. ((SetupOnce( ) @ #i) ∧ (SetupOnce( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction TickOnce:
  "∀ %t #i #j. ((Tick( %t ) @ #i) ∧ (Tick( %t ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction TicksInOrder:
  "∀ %s %t #i #j.
    (((Tick( %s ) @ #i) ∧ (Tick( %t ) @ #j)) ∧ (%s ⊏ %t)) ⇒ (#i < #j)"
  // safety formula

restriction NowIsLatest:
  "∀ %b %c #q #t.
    (((Now( %b ) @ #q) ∧ (Tick( %c ) @ #t)) ∧ (%b ⊏ %c)) ⇒ (#q < #t)"
  // safety formula

restriction ReceiptPromptness:
  "∀ ptr y rid %b %c #i #t.
    ((((HTLCCommittedAt( ptr, <'settle', y, rid>, %b ) @ #i) ∧
       (Tick( %c ) @ #t)) ∧
      (%b ⊏ %c)) ∧
     (#i < #t)) ⇒
    (∃ #a. ((PreimageAvailable( ptr, y, %b ) @ #a) ∧ (#i < #a)) ∧ (#a < #t))"

restriction ForwarderPromptness:
  "∀ P Prev Next pin pout y %b %c #f #a #t.
    (((((HTLCForwarded( P, Prev, Next, pin, pout, y ) @ #f) ∧
        (PreimageAvailable( pout, y, %b ) @ #a)) ∧
       (Tick( %c ) @ #t)) ∧
      (%b ⊏ %c)) ∧
     (#a < #t)) ⇒
    (∃ rid2 #q.
      ((SettleRequested( P, pin, y, rid2, %b ) @ #q) ∧ (#a < #q)) ∧ (#q < #t))"

restriction BoundedResponsiveness:
  "∀ Q ptr y rid %b %c #r #k.
    ((((SettleRequested( Q, ptr, y, rid, %b ) @ #r) ∧ (Tick( %c ) @ #k)) ∧
      (#r < #k)) ∧
     ((%b%+%1%+%1) ⊏ %c)) ⇒
    (∃ n #l.
      ((HTLCCommitted( ptr, <'settle', y, rid>, n ) @ #l) ∧ (#r < #l)) ∧
      (#l < #k))"

restriction CLTVGap:
  "∀ pin pout y %tIn %tOut #e.
    (ForwardExpiries( pin, pout, y, %tIn, %tOut ) @ #e) ⇒
    (((%tOut%+%1%+%1) = %tIn) ∨ ((%tOut%+%1%+%1) ⊏ %tIn))"
