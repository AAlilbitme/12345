                case case_2
                solve( (¬(%b.1 ⊏ (%1%+%1%+%1%+%1)))  ∥
                       (∃ #a.
                         (PreimageAvailable( ~p0, h(~x), %b.1 ) @ #a) ∧ (#l.3 < #a) ∧ (#a < #k)) )
                  case case_2
                  solve( (¬(%b.1 ⊏ (%1%+%1%+%1%+%1)))  ∥
                         (∃ #a.
