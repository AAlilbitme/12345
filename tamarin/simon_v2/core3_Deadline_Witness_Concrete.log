                     (ChannelUpdateFor( pin, <'settle', y, rid2>, n2 ) @ #u2)) ∧
                    (StateUpdate( pin, n2 ) @ #s2)) ∧
                   (HTLCCommittedAt( pin, <'settle', y, rid2>, %c2 ) @ #l)) ∧
                  (Tick( (%1%+%1%+%1) ) @ #k1)) ∧
                 (Tick( (%1%+%1%+%1%+%1) ) @ #k)) ∧
                (#k0 < #f)) ∧
               (#f < #q1)) ∧
              (#q1 < #u1)) ∧
