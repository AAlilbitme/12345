lemma Offer_Precedes_Forwards [reuse, use_induction,
                               heuristic={chain_walk}]:
  all-traces
  "∀ D Pv Nx pin pout y #f.
    (HTLCForwarded( D, Pv, Nx, pin, pout, y ) @ #f) ⇒
    (∃ S F1 p1 #o. (HTLCOffered( S, F1, p1, y ) @ #o) ∧ (#o < #f))"
/*
guarded formula characterizing all counter-examples:
"∃ D Pv Nx pin pout y #f.
  (HTLCForwarded( D, Pv, Nx, pin, pout, y ) @ #f)
 ∧
  ∀ S F1 p1 #o. (HTLCOffered( S, F1, p1, y ) @ #o) ⇒ ¬(#o < #f)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ D Pv Nx pin pout y #f.
           (HTLCForwarded( D, Pv, Nx, pin, pout, y ) @ #f)
          ⇒
           ((last(#f)) ∨
            (∃ S F1 p1 #o.
              (HTLCOffered( S, F1, p1, y ) @ #o) ∧ (¬(last(#o))) ∧ (#o < #f))))  ∥
         (∃ ptr y %s %b #a #k.
           (HTLCExpiry( ptr, y, %s ) @ #a) ∧ (Tick( %b ) @ #k)
          ∧
           (¬(last(#k))) ∧
           (¬(last(#a))) ∧
           (%s ⊏ %b) ∧
           (∀ #i. (Tick( %s ) @ #i) ⇒ ((last(#i)) ∨ (#i = #k) ∨ (#k < #i))))  ∥
         (∃ P Prev Next pin pout y %tIn %tOut %b #f #e #k.
           (HTLCForwarded( P, Prev, Next, pin, pout, y ) @ #f) ∧
           (ForwardExpiries( pin, pout, y, %tIn, %tOut ) @ #e) ∧
           (Tick( %b ) @ #k)
          ∧
           (¬(last(#k))) ∧
           (¬(last(#e))) ∧
           (¬(last(#f))) ∧
           (%tIn ⊏ %b) ∧
           (#k < #f) ∧
           (∀ #c.
             (LtkCompromised( P ) @ #c) ⇒ ((last(#c)) ∨ (#c = #f) ∨ (#f < #c)))) )
    case case_1
    solve( (last(#f))  ∥
           (∃ S F1 p1 #o.
             (HTLCOffered( S, F1, p1, y ) @ #o) ∧ (¬(last(#o))) ∧ (#o < #f)) )
      case case_1
      solve( HTLCExpiry( pin, y, %tIn )[-] @ #a )
        case Forward_HTLC
        by contradiction /* from formulas */
      next
        case Sender_Offer_HTLC
        by contradiction /* from formulas */
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case case_2
    by contradiction /* from formulas */
  next
    case case_3
    by contradiction /* from formulas */
  qed
qed

lemma Expiry_Below_First_Hop [use_induction, heuristic={chain_walk}]:
  all-traces
  "∀ S F1 p1 y %t1 pin pout %tin %tout #o #e #f.
    ((((HTLCOffered( S, F1, p1, y ) @ #o) ∧
       (HTLCExpiry( p1, y, %t1 ) @ #e)) ∧
      (ForwardExpiries( pin, pout, y, %tin, %tout ) @ #f)) ∧
     (¬(∃ S2 F2 p2 #o2.
         (HTLCOffered( S2, F2, p2, y ) @ #o2) ∧ (¬(#o2 = #o))))) ⇒
    (%tout ⊏ %t1)"
/*
guarded formula characterizing all counter-examples:
"∃ S F1 p1 y %t1 pin pout %tin %tout #o #e #f.
  (HTLCOffered( S, F1, p1, y ) @ #o) ∧
  (HTLCExpiry( p1, y, %t1 ) @ #e) ∧
  (ForwardExpiries( pin, pout, y, %tin, %tout ) @ #f)
 ∧
  (∀ S2 F2 p2 #o2. (HTLCOffered( S2, F2, p2, y ) @ #o2) ⇒ #o2 = #o) ∧
  (¬(%tout ⊏ %t1))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  simplify
  solve( (∀ S F1 p1 y %t1 pin pout %tin %tout #o #e #f.
           (HTLCOffered( S, F1, p1, y ) @ #o) ∧
           (HTLCExpiry( p1, y, %t1 ) @ #e) ∧
           (ForwardExpiries( pin, pout, y, %tin, %tout ) @ #f)
          ⇒
           ((last(#f)) ∨
            (last(#e)) ∨
            (last(#o)) ∨
            (∃ S2 F2 p2 #o2.
              (HTLCOffered( S2, F2, p2, y ) @ #o2) ∧ (¬(last(#o2))) ∧ (¬(#o2 = #o))) ∨
            (%tout ⊏ %t1)))  ∥
         (∃ ptr y %s %b #a #k.
           (HTLCExpiry( ptr, y, %s ) @ #a) ∧ (Tick( %b ) @ #k)
          ∧
           (¬(last(#k))) ∧
           (¬(last(#a))) ∧
           (%s ⊏ %b) ∧
           (∀ #i. (Tick( %s ) @ #i) ⇒ ((last(#i)) ∨ (#i = #k) ∨ (#k < #i))))  ∥
         (∃ P Prev Next pin pout y %tIn %tOut %b #f #e #k.
           (HTLCForwarded( P, Prev, Next, pin, pout, y ) @ #f) ∧
           (ForwardExpiries( pin, pout, y, %tIn, %tOut ) @ #e) ∧
           (Tick( %b ) @ #k)
          ∧
           (¬(last(#k))) ∧
           (¬(last(#e))) ∧
           (¬(last(#f))) ∧
           (%tIn ⊏ %b) ∧
           (#k < #f) ∧
           (∀ #c.
             (LtkCompromised( P ) @ #c) ⇒ ((last(#c)) ∨ (#c = #f) ∨ (#f < #c)))) )
    case case_1
    solve( (last(#f))  ∥ (last(#e))  ∥
           (∃ S2 F2 p2 #o2.
             (HTLCOffered( S2, F2, p2, y ) @ #o2) ∧ (¬(last(#o2))) ∧ (¬(#o2 = #o))) )
      case case_1
      solve( HTLCExpiry( p1, y, %t1 ) @ #e )
        case Sender_Offer_HTLC
        solve( HTLCExpiry( pin, y, %tin )[-] @ #a )
          case Forward_HTLC
          by contradiction /* from formulas */
        next
          case Sender_Offer_HTLC
          by contradiction /* contradictory subterm store */
        qed
      qed
    next
      case case_2
      solve( (last(#f))  ∥
             (∃ S2 F2 p2 #o2.
               (HTLCOffered( S2, F2, p2, y ) @ #o2) ∧ (¬(last(#o2))) ∧ (¬(#o2 = #o))) )
        case case_1
        by solve( HTLCExpiry( p1, y, %t1 ) @ #e )
      next
        case case_2
        by contradiction /* from formulas */
      qed
    next
      case case_3
      by contradiction /* from formulas */
    qed
  next
    case case_2
    by contradiction /* from formulas */
  next
    case case_3
    by contradiction /* from formulas */
  qed
qed

lemma Redeem_Reveals [reuse]:
  all-traces
  "∀ ptr y #i.
    (Redeemed( ptr, y ) @ #i) ⇒
    (∃ x. (FulfilledMade( ptr, x ) @ #i) ∧ (h(x) = y))"
/*
guarded formula characterizing all counter-examples:
"∃ ptr y #i.
  (Redeemed( ptr, y ) @ #i)
 ∧
  ∀ x. (FulfilledMade( ptr, x ) @ #i) ∧ (h(x) = y) ⇒ ⊥"
*/
simplify
solve( Redeemed( ptr, y ) @ #i )
  case Intermediary_Settle
  by contradiction /* from formulas */
next
  case Receiver_Fulfill_HTLC
  by contradiction /* from formulas */
qed

lemma Outgoing_Preimage_Kept [reuse, heuristic={preimage_user}]:
  all-traces
  "∀ P Prev Next pin pout y x #f #u.
    (((HTLCForwarded( P, Prev, Next, pin, pout, y ) @ #f) ∧
      (FulfilledUsed( pout, x ) @ #u)) ∧
     (h(x) = y)) ⇒
    ((∃ #l. (Redeemed( pin, y ) @ #l) ∧ (#l = #u)) ∨
     (∃ #c. (LtkCompromised( P ) @ #c) ∧ (#c < #u)))"
/*
guarded formula characterizing all counter-examples:
"∃ P Prev Next pin pout y x #f #u.
  (HTLCForwarded( P, Prev, Next, pin, pout, y ) @ #f) ∧
  (FulfilledUsed( pout, x ) @ #u) ∧
  (h(x) = y)
 ∧
  (∀ #l. (Redeemed( pin, y ) @ #l) ∧ (#l = #u) ⇒ ⊥) ∧
  (∀ #c. (LtkCompromised( P ) @ #c) ⇒ ¬(#c < #u))"
*/
simplify
solve( FulfilledUsed( pout, x ) @ #u )
  case AttackerSkip
  solve( !Compromised( ExitAtt ) ▶₃ #u )
    case Compromise_Ltk
    solve( !Compromised( EntryAtt ) ▶₄ #u )
      case Compromise_Ltk
      solve( !RouteInfo( $A.1, Next.1, pout, h(x) )[-, no_precomp] ▶₁ #u )
        case Forward_HTLC_case_1
        by contradiction /* from formulas */
      next
        case Forward_HTLC_case_2
        by contradiction /* from formulas */
      qed
    qed
  qed
next
  case Intermediary_Settle
  by contradiction /* from formulas */
next
  case Sender_Settle
  by solve( SenderPending( $Sender.1, $Forward1.1, $Receiver.1, pout, h(x),
                           %t.1
            ) ▶₀ #u )
qed

lemma Incoming_Resolved_By_Claim_Or_Timeout [reuse,
                                             heuristic={incoming_resolution}]:
  all-traces
  "∀ P Prev Next pin pout y %tIn %tOut #f #e #o.
    (((HTLCForwarded( P, Prev, Next, pin, pout, y ) @ #f) ∧
      (ForwardExpiries( pin, pout, y, %tIn, %tOut ) @ #e)) ∧
     (Old( pin, y ) @ #o)) ⇒
    ((∃ #l. (Redeemed( pin, y ) @ #l) ∧ (#l = #o)) ∨
     (∃ %b #k. ((Tick( %b ) @ #k) ∧ (%tIn ⊏ %b)) ∧ (#k < #o)))"
/*
guarded formula characterizing all counter-examples:
"∃ P Prev Next pin pout y %tIn %tOut #f #e #o.
  (HTLCForwarded( P, Prev, Next, pin, pout, y ) @ #f) ∧
  (ForwardExpiries( pin, pout, y, %tIn, %tOut ) @ #e) ∧
  (Old( pin, y ) @ #o)
 ∧
  (∀ #l. (Redeemed( pin, y ) @ #l) ∧ (#l = #o) ⇒ ⊥) ∧
  (∀ %b #k. (Tick( %b ) @ #k) ⇒ ((¬(%tIn ⊏ %b)) ∨ (¬(#k < #o))))"
*/
simplify
solve( Old( pin, y ) @ #o.3 )
  case Intermediary_Settle
  by contradiction /* from formulas */
next
  case Intermediary_Timeout_Refund
  by contradiction /* from formulas */
next
  case Receiver_Fulfill_HTLC
  by contradiction /* from formulas */
next
  case Sender_Timeout_Refund
  by contradiction /* from formulas */
qed

lemma Refund_Enabled [heuristic={enabledness}]:
  all-traces
  "∀ P Prev Next pin pout y %tIn %tOut %b #f #e #k.
    ((((((((HTLCForwarded( P, Prev, Next, pin, pout, y ) @ #f) ∧
           (ForwardExpiries( pin, pout, y, %tIn, %tOut ) @ #e)) ∧
          (Tick( %b ) @ #k)) ∧
         (%tIn ⊏ %b)) ∧
        (#f < #k)) ∧
       (¬(∃ #c. (LtkCompromised( P ) @ #c) ∧ (#c < #k)))) ∧
      (¬(∃ #i. (Redeemed( pout, y ) @ #i) ∧ (#i < #k)))) ∧
     (¬(∃ #r. (Refunded( P, pout, y ) @ #r) ∧ (#r < #k)))) ⇒
    (((¬(∃ #u. (PendingUsed( P, pin, pout, y ) @ #u) ∧ (#u < #k))) ∧
      (∃ %b2 #t. ((Tick( %b2 ) @ #t) ∧ (#t < #k)) ∧ (%tOut ⊏ %b2))) ∧
     (¬(∃ #o. (Old( pout, y ) @ #o) ∧ (#o < #k))))"
/*
guarded formula characterizing all counter-examples:
"∃ P Prev Next pin pout y %tIn %tOut %b #f #e #k.
  (HTLCForwarded( P, Prev, Next, pin, pout, y ) @ #f) ∧
  (ForwardExpiries( pin, pout, y, %tIn, %tOut ) @ #e) ∧
  (Tick( %b ) @ #k)
 ∧
  (%tIn ⊏ %b) ∧
  (#f < #k) ∧
  (∀ #c. (LtkCompromised( P ) @ #c) ⇒ ¬(#c < #k)) ∧
  (∀ #i. (Redeemed( pout, y ) @ #i) ⇒ ¬(#i < #k)) ∧
  (∀ #r. (Refunded( P, pout, y ) @ #r) ⇒ ¬(#r < #k)) ∧
  (((∃ #u. (PendingUsed( P, pin, pout, y ) @ #u) ∧ #u < #k) ∨
    (∀ %b2 #t. (Tick( %b2 ) @ #t) ⇒ ((¬(#t < #k)) ∨ (¬(%tOut ⊏ %b2)))) ∨
    (∃ #o. (Old( pout, y ) @ #o) ∧ #o < #k)))"
*/
simplify
solve( (∃ #u. (PendingUsed( $Me, pin, pout, y ) @ #u) ∧ #u < #k)  ∥
       (∀ %b2 #t. (Tick( %b2 ) @ #t) ⇒ ((¬(#t < #k)) ∨ (¬(%tOut ⊏ %b2))))  ∥
       (∃ #o. (Old( pout, y ) @ #o) ∧ #o < #k) )
  case case_1
  solve( PendingUsed( $Me, pin, pout, y ) @ #u )
    case Intermediary_Settle
    solve( (∃ #c. (LtkCompromised( $Me ) @ #c) ∧ #c < #u)  ∥
           (∃ #j. (Redeemed( pout, h(x) ) @ #j) ∧ #j < #u) )
      case case_1
      by contradiction /* from formulas */
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case Intermediary_Timeout_Refund
    by contradiction /* from formulas */
  qed
next
  case case_2
  by contradiction /* from formulas */
next
  case case_3
  solve( Old( pout, y ) @ #o.3 )
    case Intermediary_Settle
    by contradiction /* from formulas */
  next
    case Intermediary_Timeout_Refund
    simplify
    simplify
    solve( IntermediaryPending( $Me.1, $Prev.1, $Next.1, ptrIn, pout, y,
                                %vIn.1, %vOut.1, %tOut.1
           ) ▶₀ #o.3 )
      case Forward_HTLC_case_1
      by contradiction /* from formulas */
    next
      case Forward_HTLC_case_2
      by contradiction /* from formulas */
    qed
  next
    case Receiver_Fulfill_HTLC
    by contradiction /* from formulas */
  next
    case Sender_Timeout_Refund
    simplify
    simplify
    by solve( SenderPending( $Sender.3, $Forward1.3, $Receiver.3, pout, y,
                             %t.3
              ) ▶₀ #o.3 )
  qed
qed

lemma Collect_Enabled [heuristic={collect_enabled}]:
  all-traces
  "∀ P Prev Next pin pout y %tIn %tOut %b #f #e #i #k.
    ((((((((((HTLCForwarded( P, Prev, Next, pin, pout, y ) @ #f) ∧
             (ForwardExpiries( pin, pout, y, %tIn, %tOut ) @ #e)) ∧
            (Redeemed( pout, y ) @ #i)) ∧
           (#i < #k)) ∧
          (Tick( %b ) @ #k)) ∧
         (%tIn ⊏ %b)) ∧
        (#f < #k)) ∧
       (¬(∃ %b0 #k0. ((Tick( %b0 ) @ #k0) ∧ (%tIn ⊏ %b0)) ∧ (#k0 < #k)))) ∧
      (¬(∃ #c. (LtkCompromised( P ) @ #c) ∧ (#c < #k)))) ∧
     (¬(∃ #l. (Redeemed( pin, y ) @ #l) ∧ (#l < #k)))) ⇒
    (((¬(∃ #u. (PendingUsed( P, pin, pout, y ) @ #u) ∧ (#u < #k))) ∧
      (∃ x #m.
        (((FulfilledMade( pout, x ) @ #m) ∧ (#m < #k)) ∧ (h(x) = y)) ∧
        (¬(∃ #u. (FulfilledUsed( pout, x ) @ #u) ∧ (#u < #k))))) ∧
     (¬(∃ #o. (Old( pin, y ) @ #o) ∧ (#o < #k))))"
/*
guarded formula characterizing all counter-examples:
"∃ P Prev Next pin pout y %tIn %tOut %b #f #e #i #k.
  (HTLCForwarded( P, Prev, Next, pin, pout, y ) @ #f) ∧
  (ForwardExpiries( pin, pout, y, %tIn, %tOut ) @ #e) ∧
  (Redeemed( pout, y ) @ #i) ∧
  (Tick( %b ) @ #k)
 ∧
  (#i < #k) ∧
  (%tIn ⊏ %b) ∧
  (#f < #k) ∧
  (∀ %b0 #k0. (Tick( %b0 ) @ #k0) ⇒ ((¬(%tIn ⊏ %b0)) ∨ (¬(#k0 < #k)))) ∧
  (∀ #c. (LtkCompromised( P ) @ #c) ⇒ ¬(#c < #k)) ∧
  (∀ #l. (Redeemed( pin, y ) @ #l) ⇒ ¬(#l < #k)) ∧
  (((∃ #u. (PendingUsed( P, pin, pout, y ) @ #u) ∧ #u < #k) ∨
    (∀ x #m.
      (FulfilledMade( pout, x ) @ #m) ∧ (h(x) = y)
     ⇒
      ((¬(#m < #k)) ∨ (∃ #u. (FulfilledUsed( pout, x ) @ #u) ∧ #u < #k))) ∨
    (∃ #o. (Old( pin, y ) @ #o) ∧ #o < #k)))"
*/
simplify
solve( (∃ #u. (PendingUsed( $Me, pin, pout, h(x) ) @ #u) ∧ #u < #k)  ∥
       (∀ x.1 #m.
         (FulfilledMade( pout, x.1 ) @ #m) ∧ (h(x.1) = h(x))
        ⇒
         ((¬(#m < #k)) ∨ (∃ #u. (FulfilledUsed( pout, x.1 ) @ #u) ∧ #u < #k)))  ∥
       (∃ #o. (Old( pin, h(x) ) @ #o) ∧ #o < #k) )
  case case_1
  solve( PendingUsed( $Me, pin, pout, h(x) ) @ #u )
    case Intermediary_Settle
    by contradiction /* from formulas */
  next
    case Intermediary_Timeout_Refund
    by contradiction /* from formulas */
  qed
next
  case case_2
  solve( FulfilledUsed( pout, x ) @ #u )
    case AttackerSkip
    solve( Redeemed( pout, h(x) ) @ #i.2 )
      case Intermediary_Settle
      solve( (∃ #l. (Redeemed( pin, h(x) ) @ #l) ∧ (#l = #u))  ∥
             (∃ #c. (LtkCompromised( $Me ) @ #c) ∧ #c < #u) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        by contradiction /* from formulas */
      qed
    next
      case Receiver_Fulfill_HTLC
      solve( (∃ #l. (Redeemed( pin, h(x) ) @ #l) ∧ (#l = #u))  ∥
             (∃ #c. (LtkCompromised( $Me ) @ #c) ∧ #c < #u) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        by contradiction /* from formulas */
      qed
    qed
  next
    case Intermediary_Settle
    by contradiction /* from formulas */
  next
    case Sender_Settle
    solve( Redeemed( pout, h(x) ) @ #i.2 )
      case Intermediary_Settle
      solve( (∃ #l. (Redeemed( pin, h(x) ) @ #l) ∧ (#l = #u))  ∥
             (∃ #c. (LtkCompromised( $Me ) @ #c) ∧ #c < #u) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        by contradiction /* from formulas */
      qed
    next
      case Receiver_Fulfill_HTLC
      solve( (∃ #l. (Redeemed( pin, h(x) ) @ #l) ∧ (#l = #u))  ∥
             (∃ #c. (LtkCompromised( $Me ) @ #c) ∧ #c < #u) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        by contradiction /* from formulas */
      qed
    qed
  qed
next
  case case_3
  solve( Old( pin, h(x) ) @ #o.3 )
    case Intermediary_Settle
    by contradiction /* from formulas */
  next
    case Intermediary_Timeout_Refund
    by contradiction /* from formulas */
  next
    case Receiver_Fulfill_HTLC
    by contradiction /* from formulas */
  next
    case Sender_Timeout_Refund
    by contradiction /* from formulas */
  qed
qed

lemma Punish_Enabled [heuristic={enabledness}]:
  all-traces
  "∀ P Q tx %m %b #c #k.
    ((((((CheatMaturity( P, Q, tx, %m ) @ #c) ∧ (Tick( %b ) @ #k)) ∧
        (%m ⊏ %b)) ∧
       (¬(∃ %b0 #k0. ((Tick( %b0 ) @ #k0) ∧ (%m ⊏ %b0)) ∧ (#k0 < #k)))) ∧
      (¬(∃ #x. (LtkCompromised( Q ) @ #x) ∧ (#x < #k)))) ∧
     (¬(∃ #l. (PunishRevoked( Q, P, tx ) @ #l) ∧ (#l < #k)))) ⇒
    ((#c < #k) ∧ (¬(∃ #j. (RevokedClaimed( P, tx ) @ #j) ∧ (#j < #k))))"
/*
guarded formula characterizing all counter-examples:
"∃ P Q tx %m %b #c #k.
  (CheatMaturity( P, Q, tx, %m ) @ #c) ∧ (Tick( %b ) @ #k)
 ∧
  (%m ⊏ %b) ∧
  (∀ %b0 #k0. (Tick( %b0 ) @ #k0) ⇒ ((¬(%m ⊏ %b0)) ∨ (¬(#k0 < #k)))) ∧
  (∀ #x. (LtkCompromised( Q ) @ #x) ⇒ ¬(#x < #k)) ∧
  (∀ #l. (PunishRevoked( Q, P, tx ) @ #l) ⇒ ¬(#l < #k)) ∧
  (((¬(#c < #k)) ∨ (∃ #j. (RevokedClaimed( P, tx ) @ #j) ∧ #j < #k)))"
*/
simplify
solve( RevokedDelayed( P, n, c, tx, %m )[no_precomp] ▶₀ #j )
  case Publish_Revoked_A
  solve( !Block( %b ) ▶₁ #j )
    case Clock_Tick
    solve( (¬(%b = %m.1))  ∥ (#c.1 < #vr.16) )
      case case_1
      solve( !RevokedSecret( $A, n, sAold, c )[no_precomp] ▶₃ #vr )
        case Revoke_Old_Secret_case_1
        solve( RevokedCommitmentUnspent( ~ptr, $A, $B, n, c
               )[no_precomp] ▶₄ #vr )
          case Revoke_Old_Secret_case_1
          solve( CheatMaturity( $A, Q, ~tx, %m.1 ) @ #c.1 )
            case Publish_Revoked_A
            by contradiction /* contradictory subterm store */
          qed
        next
          case Revoke_Old_Secret_case_2
          solve( CheatMaturity( $A, Q, ~tx, %m.1 ) @ #c.1 )
            case Publish_Revoked_A
            by contradiction /* contradictory subterm store */
          qed
        qed
      next
        case Revoke_Old_Secret_case_2
        solve( RevokedCommitmentUnspent( ~ptr, $A, $B, n, c
               )[no_precomp] ▶₄ #vr )
          case Revoke_Old_Secret_case_1
          solve( CheatMaturity( $A, Q, ~tx, %m.1 ) @ #c.1 )
            case Publish_Revoked_A
            by contradiction /* contradictory subterm store */
          qed
        next
          case Revoke_Old_Secret_case_2
          solve( CheatMaturity( $A, Q, ~tx, %m.1 ) @ #c.1 )
            case Publish_Revoked_A
            by contradiction /* contradictory subterm store */
          qed
        qed
      qed
    next
      case case_2
      solve( !RevokedSecret( $A, n, sAold, c )[no_precomp] ▶₃ #vr )
        case Revoke_Old_Secret_case_1
        solve( RevokedCommitmentUnspent( ~ptr, $A, $B, n, c
               )[no_precomp] ▶₄ #vr )
          case Revoke_Old_Secret_case_1
          solve( CheatMaturity( $A, Q, ~tx, %m.1 ) @ #c.1 )
            case Publish_Revoked_A
            by contradiction /* contradictory subterm store */
          qed
        next
          case Revoke_Old_Secret_case_2
          solve( CheatMaturity( $A, Q, ~tx, %m.1 ) @ #c.1 )
            case Publish_Revoked_A
            by contradiction /* contradictory subterm store */
          qed
        qed
      next
        case Revoke_Old_Secret_case_2
        solve( RevokedCommitmentUnspent( ~ptr, $A, $B, n, c
               )[no_precomp] ▶₄ #vr )
          case Revoke_Old_Secret_case_1
          solve( CheatMaturity( $A, Q, ~tx, %m.1 ) @ #c.1 )
            case Publish_Revoked_A
            by contradiction /* contradictory subterm store */
          qed
        next
          case Revoke_Old_Secret_case_2
          solve( CheatMaturity( $A, Q, ~tx, %m.1 ) @ #c.1 )
            case Publish_Revoked_A
            by contradiction /* contradictory subterm store */
          qed
        qed
      qed
    qed
  qed
next
  case Publish_Revoked_B
  solve( !Block( %b ) ▶₁ #j )
    case Clock_Tick
    solve( (¬(%b = %m.1))  ∥ (#c.1 < #vr.16) )
      case case_1
      solve( !RevokedSecret( $B, n, sBold, c )[no_precomp] ▶₃ #vr )
        case Revoke_Old_Secret_case_1
        solve( RevokedCommitmentUnspent( ~ptr, $B, $A, n, c
               )[no_precomp] ▶₄ #vr )
          case Revoke_Old_Secret_case_1
          solve( CheatMaturity( $B, Q, ~tx, %m.1 ) @ #c.1 )
            case Publish_Revoked_B
            by contradiction /* contradictory subterm store */
          qed
        next
          case Revoke_Old_Secret_case_2
          solve( CheatMaturity( $B, Q, ~tx, %m.1 ) @ #c.1 )
            case Publish_Revoked_B
            by contradiction /* contradictory subterm store */
          qed
        qed
      next
        case Revoke_Old_Secret_case_2
        solve( RevokedCommitmentUnspent( ~ptr, $B, $A, n, c
               )[no_precomp] ▶₄ #vr )
          case Revoke_Old_Secret_case_1
          solve( CheatMaturity( $B, Q, ~tx, %m.1 ) @ #c.1 )
            case Publish_Revoked_B
            by contradiction /* contradictory subterm store */
          qed
        next
          case Revoke_Old_Secret_case_2
          solve( CheatMaturity( $B, Q, ~tx, %m.1 ) @ #c.1 )
            case Publish_Revoked_B
            by contradiction /* contradictory subterm store */
          qed
        qed
      qed
    next
      case case_2
      solve( !RevokedSecret( $B, n, sBold, c )[no_precomp] ▶₃ #vr )
        case Revoke_Old_Secret_case_1
        solve( RevokedCommitmentUnspent( ~ptr, $B, $A, n, c
               )[no_precomp] ▶₄ #vr )
          case Revoke_Old_Secret_case_1
          solve( CheatMaturity( $B, Q, ~tx, %m.1 ) @ #c.1 )
            case Publish_Revoked_B
            by contradiction /* contradictory subterm store */
          qed
        next
          case Revoke_Old_Secret_case_2
          solve( CheatMaturity( $B, Q, ~tx, %m.1 ) @ #c.1 )
            case Publish_Revoked_B
            by contradiction /* contradictory subterm store */
          qed
        qed
      next
        case Revoke_Old_Secret_case_2
        solve( RevokedCommitmentUnspent( ~ptr, $B, $A, n, c
               )[no_precomp] ▶₄ #vr )
          case Revoke_Old_Secret_case_1
          solve( CheatMaturity( $B, Q, ~tx, %m.1 ) @ #c.1 )
            case Publish_Revoked_B
            by contradiction /* contradictory subterm store */
          qed
        next
          case Revoke_Old_Secret_case_2
          solve( CheatMaturity( $B, Q, ~tx, %m.1 ) @ #c.1 )
            case Publish_Revoked_B
            by contradiction /* contradictory subterm store */
          qed
        qed
      qed
    qed
  qed
qed

lemma Invoice_Signature_Origin [reuse, heuristic={offer_invoice}]:
  all-traces
  "∀ R S y a ltk #i #k.
    ((!KU( sign(<'invoice', R, S, y, a>, ltk) ) @ #i) ∧
     (KeyGen( R, ltk ) @ #k)) ⇒
    ((∃ #j. (InvoiceCreated( R, S, y ) @ #j) ∧ (#j < #i)) ∨
     (∃ #r. LtkCompromised( R ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ R S y a ltk #i #k.
  (!KU( sign(<'invoice', R, S, y, a>, ltk) ) @ #i) ∧
  (KeyGen( R, ltk ) @ #k)
 ∧
  (∀ #j. (InvoiceCreated( R, S, y ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #r. (LtkCompromised( R ) @ #r) ⇒ ⊥)"
*/
simplify
solve( !KU( sign(<'invoice', $A, S, y, a>, ~ltk) ) @ #i )
  case Receiver_Create_Invoice
  by contradiction /* from formulas */
next
  case c_sign
  by contradiction /* from formulas */
qed

lemma Offer_Requires_Invoice [heuristic={offer_invoice}]:
  all-traces
  "∀ S R ptr y #o.
    (OfferFor( S, R, ptr, y ) @ #o) ⇒
    ((∃ #j. (InvoiceCreated( R, S, y ) @ #j) ∧ (#j < #o)) ∨
     (∃ #r. LtkCompromised( R ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ S R ptr y #o.
  (OfferFor( S, R, ptr, y ) @ #o)
 ∧
  (∀ #j. (InvoiceCreated( R, S, y ) @ #j) ⇒ ¬(#j < #o)) ∧
  (∀ #r. (LtkCompromised( R ) @ #r) ⇒ ⊥)"
*/
simplify
solve( !KU( sign(<'invoice', $Receiver, $Sender, y, %amt>, x)
       ) @ #vk.12 )
  case Receiver_Create_Invoice
  by contradiction /* from formulas */
next
  case c_sign
  solve( !Ltk( $Sender, ltkS ) ▶₄ #o )
    case Register_key
    solve( !Pk( $Receiver, pk(x) ) ▶₃ #o )
      case Register_key
      by contradiction /* from formulas */
    qed
  qed
qed

lemma Funding_Spent_Once [reuse]:
  all-traces
  "∀ ptr #i #j.
    ((FundingSpent( ptr ) @ #i) ∧ (FundingSpent( ptr ) @ #j)) ⇒ (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ ptr #i #j.
  (FundingSpent( ptr ) @ #i) ∧ (FundingSpent( ptr ) @ #j) ∧ ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( FundingSpent( ptr ) @ #i )
    case Honest_Close
    solve( StateA( $A, $B, ptr, n, sA, commitA, fA, fB ) ▶₀ #i )
      case Lock_Funds_And_Open
      solve( StateB( $A, $B, ~ptr, '0', sB, commitB, ~fA, ~fB ) ▶₁ #i )
        case Lock_Funds_And_Open
        solve( !ValidOnChain( ~ptr ) ▶₂ #i )
          case Lock_Funds_And_Open
          solve( FundingUnspent( ~ptr ) ▶₃ #i )
            case Lock_Funds_And_Open
            solve( !Ltk( $A, ltkA ) ▶₄ #i )
              case Register_key
              solve( !Ltk( $B, ltkB ) ▶₅ #i )
                case Register_key
                solve( !Pk( $A, pk(~ltk) ) ▶₆ #i )
                  case Register_key
                  solve( !Pk( $B, pk(~ltk.1) ) ▶₇ #i )
                    case Register_key
                    solve( FundingSpent( ~ptr ) @ #j )
                      case Honest_Close
                      solve( StateA( $A.1, $B.1, ~ptr, n, sA, commitA, fA.1, fB.1 ) ▶₀ #j )
                        case Lock_Funds_And_Open
                        by contradiction /* cyclic */
                      next
                        case Revoke_Old_Secret
                        solve( StateB( $A.1, $B.1, ~ptr, n, sB, commitB, fA.1, fB.1 ) ▶₁ #j )
                          case Revoke_Old_Secret
                          solve( !ValidOnChain( ~ptr ) ▶₂ #j )
