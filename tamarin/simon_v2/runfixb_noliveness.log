lemma Expiry_Unique [reuse, heuristic={expiry_first}]:
  all-traces
  "∀ ptr y %t1 %t2 #i #j.
    ((HTLCExpiry( ptr, y, %t1 ) @ #i) ∧ (HTLCExpiry( ptr, y, %t2 ) @ #j)) ⇒
    (%t1 = %t2)"
/*
guarded formula characterizing all counter-examples:
"∃ ptr y %t1 %t2 #i #j.
  (HTLCExpiry( ptr, y, %t1 ) @ #i) ∧ (HTLCExpiry( ptr, y, %t2 ) @ #j)
 ∧
  ¬(%t1 = %t2)"
*/
simplify
solve( HTLCExpiry( ptr, y, %t1 ) @ #i )
  case Forward_HTLC
  solve( HTLCExpiry( ptr, y, %t2 ) @ #j.1 )
    case Forward_HTLC
    by contradiction /* from formulas */
  qed
next
  case Sender_Offer_HTLC
  solve( HTLCExpiry( ptr, y, %t2 ) @ #j.1 )
    case Sender_Offer_HTLC
    by contradiction /* from formulas */
  qed
qed

