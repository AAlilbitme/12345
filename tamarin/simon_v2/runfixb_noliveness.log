lemma Amount_Decreases_Along_Route [reuse, use_induction]:
  all-traces
  "∀ b y %vb #i.
    (HTLCAmount( b, y, %vb ) @ #i) ⇒
    ((∃ S F1 #o. (HTLCOffered( S, F1, b, y ) @ #o) ∧ (#o = #i)) ∨
     (∃ S F1 p1 %v1 #o.
       (((HTLCOffered( S, F1, p1, y ) @ #o) ∧ (HTLCAmount( p1, y, %v1 ) @ #o)) ∧
        (%vb ⊏ %v1)) ∧
       (#o < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ b y %vb #i.
  (HTLCAmount( b, y, %vb ) @ #i)
 ∧
  (∀ S F1 #o. (HTLCOffered( S, F1, b, y ) @ #o) ∧ (#o = #i) ⇒ ⊥) ∧
  (∀ S F1 p1 %v1 #o.
    (HTLCOffered( S, F1, p1, y ) @ #o) ∧ (HTLCAmount( p1, y, %v1 ) @ #o)
   ⇒
    ((¬(%vb ⊏ %v1)) ∨ (¬(#o < #i))))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ b y %vb #i.
           (HTLCAmount( b, y, %vb ) @ #i)
          ⇒
           ((last(#i)) ∨
            (∃ S F1 #o.
              (HTLCOffered( S, F1, b, y ) @ #o) ∧ (#o = #i) ∧ ¬(last(#o))) ∨
            (∃ S F1 p1 %v1 #o.
              (HTLCOffered( S, F1, p1, y ) @ #o) ∧ (HTLCAmount( p1, y, %v1 ) @ #o)
             ∧
              (¬(last(#o))) ∧ (%vb ⊏ %v1) ∧ (#o < #i))))  ∥
         (∃ ptr y %s %b #a #k.
           (HTLCExpiry( ptr, y, %s ) @ #a) ∧ (Tick( %b ) @ #k)
          ∧
           (¬(last(#k))) ∧
           (¬(last(#a))) ∧
           (%s ⊏ %b) ∧
           (∀ #i. (Tick( %s ) @ #i) ⇒ ((last(#i)) ∨ (#i = #k) ∨ (#k < #i))))  ∥
         (∃ P Prev Next pin pout y %tIn %tOut %b #f #e #k.
           (HTLCForwarded( P, Prev, Next, pin, pout, y ) @ #f) ∧
           (ForwardExpiries( pin, pout, y, %tIn, %tOut ) @ #e) ∧
           (Tick( %b ) @ #k)
          ∧
           (¬(last(#k))) ∧
           (¬(last(#e))) ∧
           (¬(last(#f))) ∧
           (%tIn ⊏ %b) ∧
           (#k < #f) ∧
           (∀ #c.
             (LtkCompromised( P ) @ #c) ⇒ ((last(#c)) ∨ (#c = #f) ∨ (#f < #c)))) )
    case case_1
    solve( (last(#i))  ∥
           (∃ S F1 #o.
             (HTLCOffered( S, F1, b, y ) @ #o) ∧ (#o = #i) ∧ ¬(last(#o)))  ∥
           (∃ S F1 p1 %v1 #o.
             (HTLCOffered( S, F1, p1, y ) @ #o) ∧ (HTLCAmount( p1, y, %v1 ) @ #o)
            ∧
             (¬(last(#o))) ∧ (%vb ⊏ %v1) ∧ (#o < #i)) )
      case case_1
      solve( HTLCAmount( b, y, %vb ) @ #i )
        case Forward_HTLC
        solve( (∃ S F1 #o.
                 (HTLCOffered( S, F1, ptrIn, y ) @ #o) ∧ (#o = #a.1) ∧ ¬(last(#o)))  ∥
               (∃ S F1 p1 %v1 #o.
                 (HTLCOffered( S, F1, p1, y ) @ #o) ∧ (HTLCAmount( p1, y, %v1 ) @ #o)
                ∧
                 (¬(last(#o))) ∧ (%vIn ⊏ %v1) ∧ (#o < #a.1)) )
          case case_1
          by contradiction /* from formulas */
        next
          case case_2
          by contradiction /* contradictory subterm store */
        qed
      next
        case Sender_Offer_HTLC
        by contradiction /* from formulas */
      qed
    next
      case case_2
      by contradiction /* from formulas */
    next
      case case_3
      by contradiction /* from formulas */
    qed
  next
    case case_2
    by contradiction /* from formulas */
  next
    case case_3
    by contradiction /* from formulas */
  qed
qed

