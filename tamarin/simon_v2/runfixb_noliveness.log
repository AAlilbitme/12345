lemma Claim_Requires_Release [use_induction]:
  all-traces
  "∀ MidP InP ptrIn R x #i #j.
    ((IntermediaryClaimed( MidP, InP, ptrIn, x ) @ #i) ∧
     (SecretPreimage( R, x ) @ #j)) ⇒
    (∃ #k. (PreimageReleased( R, x ) @ #k) ∧ (#k < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ MidP InP ptrIn R x #i #j.
  (IntermediaryClaimed( MidP, InP, ptrIn, x ) @ #i) ∧
  (SecretPreimage( R, x ) @ #j)
 ∧
  ∀ #k. (PreimageReleased( R, x ) @ #k) ⇒ ¬(#k < #i)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ MidP InP ptrIn R x #i #j.
           (IntermediaryClaimed( MidP, InP, ptrIn, x ) @ #i) ∧
           (SecretPreimage( R, x ) @ #j)
          ⇒
           ((last(#j)) ∨
            (last(#i)) ∨
            (∃ #k. (PreimageReleased( R, x ) @ #k) ∧ (¬(last(#k))) ∧ (#k < #i))))  ∥
         (∃ ptr y %s %b #a #k.
           (HTLCExpiry( ptr, y, %s ) @ #a) ∧ (Tick( %b ) @ #k)
          ∧
           (¬(last(#k))) ∧
           (¬(last(#a))) ∧
           (%s ⊏ %b) ∧
           (∀ #i. (Tick( %s ) @ #i) ⇒ ((last(#i)) ∨ (#i = #k) ∨ (#k < #i))))  ∥
         (∃ P Prev Next pin pout y %tIn %tOut %b #f #e #k.
           (HTLCForwarded( P, Prev, Next, pin, pout, y ) @ #f) ∧
           (ForwardExpiries( pin, pout, y, %tIn, %tOut ) @ #e) ∧
           (Tick( %b ) @ #k)
          ∧
           (¬(last(#k))) ∧
           (¬(last(#e))) ∧
           (¬(last(#f))) ∧
           (%tIn ⊏ %b) ∧
           (#k < #f) ∧
           (∀ #c.
             (LtkCompromised( P ) @ #c) ⇒ ((last(#c)) ∨ (#c = #f) ∨ (#f < #c)))) )
    case case_1
    solve( (last(#i))  ∥
           (∃ #k.
             (PreimageReleased( $Receiver, ~x ) @ #k) ∧ (¬(last(#k))) ∧ (#k < #i)) )
      case case_1
      solve( IntermediaryPending( $Me, $Prev, $Next, ptrIn, ptrOut, h(~x),
                                  %vIn, %vOut, %tOut
             ) ▶₀ #i )
        case Forward_HTLC_case_1
        solve( !Ltk( $Receiver, ltkR ) ▶₁ #j )
          case Register_key
          solve( ReceiverInv( $Receiver.1, $Sender.1, ~x, %amt.1 ) ▶₁ #k )
            case Receiver_Create_Invoice
            by contradiction /* from formulas */
          qed
        qed
      next
        case Forward_HTLC_case_2
        solve( !Ltk( $Receiver, ltkR ) ▶₁ #j )
          case Register_key
          solve( ReceiverInv( $Receiver.1, $Sender.1, ~x, %amt.1 ) ▶₁ #k )
            case Receiver_Create_Invoice
            by contradiction /* from formulas */
          qed
        qed
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case case_2
    by contradiction /* from formulas */
  next
    case case_3
    by contradiction /* from formulas */
  qed
qed

