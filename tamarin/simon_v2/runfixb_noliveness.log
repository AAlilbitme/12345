    by solve( IntermediaryPending( $Sender, $Prev, $Next, ptrIn, ~ptr, h(x),
                                   %vIn, %vOut, %tOut
              ) ▶₀ #j )
  next
    case Sender_Timeout_Refund
    by solve( SenderPending( $Sender, $Forward1.1, $Receiver.1, ~ptr, h(x),
                             %t.1
              ) ▶₀ #j )
  qed
next
  case Sender_Offer_HTLC_case_14
  solve( Refunded( $Sender, ~ptr, h(x) ) @ #j )
    case Intermediary_Timeout_Refund
    by solve( IntermediaryPending( $Sender, $Prev, $Next, ptrIn, ~ptr, h(x),
                                   %vIn, %vOut, %tOut
              ) ▶₀ #j )
  next
    case Sender_Timeout_Refund
    by solve( SenderPending( $Sender, $Forward1.1, $Receiver.1, ~ptr, h(x),
                             %t.1
              ) ▶₀ #j )
  qed
qed

