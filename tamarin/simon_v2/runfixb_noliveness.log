lemma HTLC_On_Opened_Channel [reuse, use_induction]:
  all-traces
  "∀ ptr y #i.
    (HTLCAdded( ptr, y ) @ #i) ⇒
    (∃ X Y #j. (ChannelOpen( X, Y, ptr ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ ptr y #i.
  (HTLCAdded( ptr, y ) @ #i)
 ∧
  ∀ X Y #j. (ChannelOpen( X, Y, ptr ) @ #j) ⇒ ¬(#j < #i)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ ptr y #i.
           (HTLCAdded( ptr, y ) @ #i)
          ⇒
           ((last(#i)) ∨
            (∃ X Y #j.
              (ChannelOpen( X, Y, ptr ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i))))  ∥
         (∃ ptr y %s %b #a #k.
           (HTLCExpiry( ptr, y, %s ) @ #a) ∧ (Tick( %b ) @ #k)
          ∧
           (¬(last(#k))) ∧
           (¬(last(#a))) ∧
           (%s ⊏ %b) ∧
           (∀ #i. (Tick( %s ) @ #i) ⇒ ((last(#i)) ∨ (#i = #k) ∨ (#k < #i))))  ∥
         (∃ P Prev Next pin pout y %tIn %tOut %b #f #e #k.
           (HTLCForwarded( P, Prev, Next, pin, pout, y ) @ #f) ∧
           (ForwardExpiries( pin, pout, y, %tIn, %tOut ) @ #e) ∧
           (Tick( %b ) @ #k)
          ∧
           (¬(last(#k))) ∧
           (¬(last(#e))) ∧
           (¬(last(#f))) ∧
           (%tIn ⊏ %b) ∧
           (#k < #f) ∧
           (∀ #c.
             (LtkCompromised( P ) @ #c) ⇒ ((last(#c)) ∨ (#c = #f) ∨ (#f < #c)))) )
    case case_1
    solve( (last(#i))  ∥
           (∃ X Y #j. (ChannelOpen( X, Y, ptr ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) )
      case case_1
      solve( HTLCAdded( ptr, y ) @ #i )
        case Forward_HTLC
        solve( !ChannelConnect( ptr, $Me, $Next ) ▶₁ #i )
          case Lock_Funds_And_Open_case_1
          by contradiction /* from formulas */
        next
          case Lock_Funds_And_Open_case_2
          by contradiction /* from formulas */
        qed
      next
        case Sender_Offer_HTLC
        solve( !Pk( $Receiver, pk(x) ) ▶₃ #i )
          case Register_key
          solve( !Ltk( $Sender, ltkS ) ▶₄ #i )
            case Register_key
            solve( !ChannelConnect( ptr, $Sender, $Forward1 ) ▶₅ #i )
              case Lock_Funds_And_Open_case_1
              by contradiction /* from formulas */
            next
              case Lock_Funds_And_Open_case_2
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case case_2
    by contradiction /* from formulas */
  next
    case case_3
    by contradiction /* from formulas */
  qed
qed

lemma Fulfilled_Requires_Release [reuse, use_induction, heuristic=S]:
  all-traces
  "∀ ptr x #i.
    (FulfilledProduced( ptr, x ) @ #i) ⇒
    (∃ R #k. (PreimageReleased( R, x ) @ #k) ∧ (#k < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ ptr x #i.
  (FulfilledProduced( ptr, x ) @ #i)
 ∧
  ∀ R #k. (PreimageReleased( R, x ) @ #k) ⇒ ¬(#k < #i)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ ptr x #i.
           (FulfilledProduced( ptr, x ) @ #i)
          ⇒
           ((last(#i)) ∨
            (∃ R #k.
              (PreimageReleased( R, x ) @ #k) ∧ (¬(last(#k))) ∧ (#k < #i))))  ∥
         (∃ ptr y %s %b #a #k.
           (HTLCExpiry( ptr, y, %s ) @ #a) ∧ (Tick( %b ) @ #k)
          ∧
           (¬(last(#k))) ∧
           (¬(last(#a))) ∧
           (%s ⊏ %b) ∧
           (∀ #i. (Tick( %s ) @ #i) ⇒ ((last(#i)) ∨ (#i = #k) ∨ (#k < #i))))  ∥
         (∃ P Prev Next pin pout y %tIn %tOut %b #f #e #k.
           (HTLCForwarded( P, Prev, Next, pin, pout, y ) @ #f) ∧
           (ForwardExpiries( pin, pout, y, %tIn, %tOut ) @ #e) ∧
           (Tick( %b ) @ #k)
          ∧
           (¬(last(#k))) ∧
           (¬(last(#e))) ∧
           (¬(last(#f))) ∧
           (%tIn ⊏ %b) ∧
           (#k < #f) ∧
           (∀ #c.
             (LtkCompromised( P ) @ #c) ⇒ ((last(#c)) ∨ (#c = #f) ∨ (#f < #c)))) )
    case case_1
    solve( (last(#i))  ∥
           (∃ R #k. (PreimageReleased( R, x ) @ #k) ∧ (¬(last(#k))) ∧ (#k < #i)) )
      case case_1
      solve( FulfilledProduced( ptr, x ) @ #i )
        case AttackerSkip
        solve( !Compromised( ExitAtt ) ▶₃ #i )
          case Compromise_Ltk
          solve( !Compromised( EntryAtt ) ▶₄ #i )
            case Compromise_Ltk
            solve( Fulfilled( ptrExit, x ) ▶₀ #i )
              case AttackerSkip
              by contradiction /* from formulas */
            next
              case Intermediary_Settle_case_1
              by contradiction /* from formulas */
            next
              case Intermediary_Settle_case_2
              by contradiction /* from formulas */
            next
              case Receiver_Fulfill_HTLC
              by contradiction /* from formulas */
            qed
          qed
        qed
      next
        case Intermediary_Settle
        solve( IntermediaryPending( $Me, $Prev, $Next, ptr, ptrOut, h(x), %vIn,
                                    %vOut, %tOut
               ) ▶₀ #i )
          case Forward_HTLC_case_1
          solve( Fulfilled( ~ptr.1, x ) ▶₁ #i )
            case AttackerSkip
            by contradiction /* from formulas */
          next
            case Intermediary_Settle_case_1
            by contradiction /* from formulas */
          next
            case Intermediary_Settle_case_2
            by contradiction /* from formulas */
          next
            case Receiver_Fulfill_HTLC
            by contradiction /* from formulas */
          qed
        next
          case Forward_HTLC_case_2
          solve( Fulfilled( ~ptr.1, x ) ▶₁ #i )
            case AttackerSkip
            by contradiction /* from formulas */
          next
            case Intermediary_Settle_case_1
            by contradiction /* from formulas */
          next
            case Intermediary_Settle_case_2
            by contradiction /* from formulas */
          next
            case Receiver_Fulfill_HTLC
            by contradiction /* from formulas */
          qed
        qed
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case case_2
    by contradiction /* from formulas */
  next
    case case_3
    by contradiction /* from formulas */
  qed
qed

