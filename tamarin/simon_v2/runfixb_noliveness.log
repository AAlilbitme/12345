lemma Loss_Requires_Inaction:
  all-traces
  "∀ P Prev Next Up ptrIn ptrOut y #i #j #k.
    (((HTLCForwarded( P, Prev, Next, ptrIn, ptrOut, y ) @ #i) ∧
      (Redeemed( ptrOut, y ) @ #j)) ∧
     (Refunded( Up, ptrIn, y ) @ #k)) ⇒
    (¬(∃ #l. Redeemed( ptrIn, y ) @ #l))"
/*
guarded formula characterizing all counter-examples:
"∃ P Prev Next Up ptrIn ptrOut y #i #j #k.
  (HTLCForwarded( P, Prev, Next, ptrIn, ptrOut, y ) @ #i) ∧
  (Redeemed( ptrOut, y ) @ #j) ∧
  (Refunded( Up, ptrIn, y ) @ #k)
 ∧
  ∃ #l. (Redeemed( ptrIn, y ) @ #l)"
*/
simplify
by contradiction /* from formulas */

lemma Refund_Requires_Timeout [reuse]:
  all-traces
  "∀ Up ptr y #i.
    (Refunded( Up, ptr, y ) @ #i) ⇒
    (∃ %t %b #a #k.
      (((HTLCExpiry( ptr, y, %t ) @ #a) ∧ (Tick( %b ) @ #k)) ∧ (%t ⊏ %b)) ∧
      (#k < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ Up ptr y #i.
  (Refunded( Up, ptr, y ) @ #i)
 ∧
  ∀ %t %b #a #k.
   (HTLCExpiry( ptr, y, %t ) @ #a) ∧ (Tick( %b ) @ #k)
  ⇒
   ((¬(%t ⊏ %b)) ∨ (¬(#k < #i)))"
*/
simplify
solve( Refunded( Up, ptr, y ) @ #i )
  case Intermediary_Timeout_Refund
  solve( IntermediaryPending( $Me, $Prev, $Next, ptrIn, ptr, y, %vIn,
                              %vOut, %tOut
         ) ▶₀ #i )
    case Forward_HTLC_case_1
    solve( !Block( %b ) ▶₁ #i )
      case Clock_Tick
      by contradiction /* from formulas */
    qed
  next
    case Forward_HTLC_case_2
    solve( !Block( %b ) ▶₁ #i )
      case Clock_Tick
      by contradiction /* from formulas */
    qed
  qed
next
  case Sender_Timeout_Refund
  solve( !Block( %b ) ▶₁ #i )
    case Clock_Tick
    solve( SenderPending( $Sender, $Forward1, $Receiver, ptr, y, %t ) ▶₀ #i )
      case Sender_Offer_HTLC_case_01
      by contradiction /* from formulas */
    next
      case Sender_Offer_HTLC_case_02
      by contradiction /* from formulas */
    next
      case Sender_Offer_HTLC_case_03
      by contradiction /* from formulas */
    next
      case Sender_Offer_HTLC_case_04
      by contradiction /* from formulas */
    next
      case Sender_Offer_HTLC_case_05
      by contradiction /* from formulas */
    next
      case Sender_Offer_HTLC_case_06
      by contradiction /* from formulas */
    next
      case Sender_Offer_HTLC_case_07
      by contradiction /* from formulas */
    next
      case Sender_Offer_HTLC_case_08
      by contradiction /* from formulas */
    next
      case Sender_Offer_HTLC_case_09
      by contradiction /* from formulas */
    next
      case Sender_Offer_HTLC_case_10
      by contradiction /* from formulas */
    next
      case Sender_Offer_HTLC_case_11
      by contradiction /* from formulas */
    next
      case Sender_Offer_HTLC_case_12
      by contradiction /* from formulas */
    next
      case Sender_Offer_HTLC_case_13
      by contradiction /* from formulas */
    next
      case Sender_Offer_HTLC_case_14
      by contradiction /* from formulas */
    qed
  qed
