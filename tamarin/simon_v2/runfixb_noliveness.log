lemma Redeem_Requires_Receiver_Release [use_induction]:
  all-traces
  "∀ ptr y #i.
    (Redeemed( ptr, y ) @ #i) ⇒
    (∃ R x #k. (PreimageReleased( R, x ) @ #k) ∧ (h(x) = y))"
/*
guarded formula characterizing all counter-examples:
"∃ ptr y #i.
  (Redeemed( ptr, y ) @ #i)
 ∧
  ∀ R x #k. (PreimageReleased( R, x ) @ #k) ∧ (h(x) = y) ⇒ ⊥"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ ptr y #i.
           (Redeemed( ptr, y ) @ #i)
          ⇒
           ((last(#i)) ∨
            (∃ R x #k.
              (PreimageReleased( R, x ) @ #k) ∧ (h(x) = y) ∧ ¬(last(#k)))))  ∥
         (∃ ptr y %s %b #a #k.
           (HTLCExpiry( ptr, y, %s ) @ #a) ∧ (Tick( %b ) @ #k)
          ∧
           (¬(last(#k))) ∧
           (¬(last(#a))) ∧
           (%s ⊏ %b) ∧
           (∀ #i. (Tick( %s ) @ #i) ⇒ ((last(#i)) ∨ (#i = #k) ∨ (#k < #i))))  ∥
         (∃ P Prev Next pin pout y %tIn %tOut %b #f #e #k.
           (HTLCForwarded( P, Prev, Next, pin, pout, y ) @ #f) ∧
           (ForwardExpiries( pin, pout, y, %tIn, %tOut ) @ #e) ∧
           (Tick( %b ) @ #k)
          ∧
           (¬(last(#k))) ∧
           (¬(last(#e))) ∧
           (¬(last(#f))) ∧
           (%tIn ⊏ %b) ∧
           (#k < #f) ∧
           (∀ #c.
             (LtkCompromised( P ) @ #c) ⇒ ((last(#c)) ∨ (#c = #f) ∨ (#f < #c)))) )
    case case_1
    solve( (last(#i))  ∥
           (∃ R x #k. (PreimageReleased( R, x ) @ #k) ∧ (h(x) = y) ∧ ¬(last(#k))) )
      case case_1
      solve( Redeemed( ptr, y ) @ #i )
        case Intermediary_Settle
        by contradiction /* from formulas */
      next
        case Receiver_Fulfill_HTLC
        by contradiction /* from formulas */
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case case_2
    by contradiction /* from formulas */
  next
    case case_3
    by contradiction /* from formulas */
  qed
qed

