lemma No_Double_Publish:
  all-traces
  "∀ A B C D ptr n1 n2 s1 s2 #i #j.
    ((Publish( A, n1, <'commit', ptr, A, B, n1, s1> ) @ #i) ∧
     (Publish( C, n2, <'commit', ptr, C, D, n2, s2> ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ A B C D ptr n1 n2 s1 s2 #i #j.
  (Publish( A, n1, <'commit', ptr, A, B, n1, s1> ) @ #i) ∧
  (Publish( C, n2, <'commit', ptr, C, D, n2, s2> ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( Publish( A, n1, <'commit', ptr, A, B, n1, s1> ) @ #i )
    case Publish_Current_A
    solve( StateA( $A, $B, ptr, n1, sA, <'commit', ptr, $A, $B, n1, s1>, fA,
                   fB
           ) ▶₀ #i )
      case Lock_Funds_And_Open
      solve( !ValidOnChain( ~ptr ) ▶₁ #i )
        case Lock_Funds_And_Open
        solve( FundingUnspent( ~ptr ) ▶₂ #i )
          case Lock_Funds_And_Open
          solve( Publish( C, n2, <'commit', ~ptr, C, D, n2, s2> ) @ #j )
            case Publish_Current_A
            by contradiction /* cyclic */
          qed
        qed
      qed
    next
      case Revoke_Old_Secret
      solve( !ValidOnChain( ptr ) ▶₁ #i )
        case Lock_Funds_And_Open
        solve( FundingUnspent( ~ptr ) ▶₂ #i )
          case Lock_Funds_And_Open
          solve( Publish( C, n2, <'commit', ~ptr, C, D, n2, s2> ) @ #j )
            case Publish_Current_A
            by contradiction /* cyclic */
          qed
        qed
      qed
    qed
  next
    case Publish_Current_B
    solve( StateB( $A, $B, ptr, n1, sB, <'commit', ptr, $B, $A, n1, s1>, fA,
                   fB
           ) ▶₀ #i )
      case Lock_Funds_And_Open
      solve( !ValidOnChain( ~ptr ) ▶₁ #i )
        case Lock_Funds_And_Open
        solve( FundingUnspent( ~ptr ) ▶₂ #i )
          case Lock_Funds_And_Open
          solve( Publish( C, n2, <'commit', ~ptr, C, D, n2, s2> ) @ #j )
            case Publish_Current_B
            by contradiction /* cyclic */
          qed
        qed
      qed
    next
      case Revoke_Old_Secret
      solve( !ValidOnChain( ptr ) ▶₁ #i )
        case Lock_Funds_And_Open
        solve( FundingUnspent( ~ptr ) ▶₂ #i )
          case Lock_Funds_And_Open
          solve( Publish( C, n2, <'commit', ~ptr, C, D, n2, s2> ) @ #j )
            case Publish_Current_B
            by contradiction /* cyclic */
          qed
        qed
      qed
    qed
  next
    case Publish_Pending_A
    solve( PendingA( $A, $B, ptr, n_old, sAold, oldCommitA, n1, sAnew,
                     <'commit', ptr, $A, $B, n1, s1>, sigAnew, fA_new, fB_new
           ) ▶₀ #i )
      case Update_State_case_1
      solve( !ValidOnChain( ~ptr ) ▶₁ #i )
        case Lock_Funds_And_Open
        solve( FundingUnspent( ~ptr ) ▶₂ #i )
          case Lock_Funds_And_Open
          solve( Publish( C, n2, <'commit', ~ptr, C, D, n2, s2> ) @ #j )
            case Publish_Pending_A
            by contradiction /* cyclic */
          qed
        qed
      qed
    next
      case Update_State_case_2
      solve( !ValidOnChain( ~ptr ) ▶₁ #i )
        case Lock_Funds_And_Open
        solve( FundingUnspent( ~ptr ) ▶₂ #i )
          case Lock_Funds_And_Open
          solve( Publish( C, n2, <'commit', ~ptr, C, D, n2, s2> ) @ #j )
            case Publish_Pending_A
            by contradiction /* cyclic */
          qed
        qed
      qed
    next
      case Update_State_case_3
      solve( !ValidOnChain( ~ptr ) ▶₁ #i )
        case Lock_Funds_And_Open
        solve( FundingUnspent( ~ptr ) ▶₂ #i )
          case Lock_Funds_And_Open
          solve( Publish( C, n2, <'commit', ~ptr, C, D, n2, s2> ) @ #j )
            case Publish_Pending_A
            by contradiction /* cyclic */
          qed
        qed
      qed
    next
      case Update_State_case_4
      solve( !ValidOnChain( ptr ) ▶₁ #i )
        case Lock_Funds_And_Open
        solve( FundingUnspent( ~ptr ) ▶₂ #i )
          case Lock_Funds_And_Open
          solve( Publish( C, n2, <'commit', ~ptr, C, D, n2, s2> ) @ #j )
            case Publish_Pending_A
            by contradiction /* cyclic */
          qed
        qed
      qed
    qed
  next
    case Publish_Pending_B
    solve( PendingB( $A, $B, ptr, n_old, sBold, oldCommitB, n1, sBnew,
                     <'commit', ptr, $B, $A, n1, s1>, sigBnew, fA_new, fB_new
           ) ▶₀ #i )
      case Update_State_case_1
      solve( !ValidOnChain( ~ptr ) ▶₁ #i )
        case Lock_Funds_And_Open
        solve( FundingUnspent( ~ptr ) ▶₂ #i )
          case Lock_Funds_And_Open
          solve( Publish( C, n2, <'commit', ~ptr, C, D, n2, s2> ) @ #j )
            case Publish_Pending_B
            by contradiction /* cyclic */
          qed
        qed
      qed
