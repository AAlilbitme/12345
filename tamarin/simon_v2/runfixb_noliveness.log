     (¬(∃ #c. (LtkCompromised( Me ) @ #c) ∧ (#c < #i)))) ⇒
    (∃ #j. (Redeemed( pout, y ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ Me pin pout y %vin %vout #i.
  (FeeEarned( Me, pin, pout, y, %vin, %vout ) @ #i)
 ∧
  (∀ #c. (LtkCompromised( Me ) @ #c) ⇒ ¬(#c < #i)) ∧
  (∀ #j. (Redeemed( pout, y ) @ #j) ⇒ ¬(#j < #i))"
*/
simplify
solve( IntermediaryPending( $Me, $Prev, $Next, pin, pout, h(x), %vin,
                            %vout, %tOut
       ) ▶₀ #i )
  case Forward_HTLC_case_1
  solve( Fulfilled( ~ptr, x ) ▶₁ #i )
    case AttackerSkip
    solve( !RouteInfo( $A.2, Skipped, ~ptr, h(x) )[-, no_precomp] ▶₂ #vr.14 )
      case Forward_HTLC
      by contradiction /* from formulas */
    qed
  next
    case Intermediary_Settle_case_1
    by contradiction /* from formulas */
  next
    case Intermediary_Settle_case_2
    by contradiction /* from formulas */
  next
    case Receiver_Fulfill_HTLC
    by contradiction /* from formulas */
  qed
next
  case Forward_HTLC_case_2
  solve( Fulfilled( ~ptr, x ) ▶₁ #i )
    case AttackerSkip
    solve( !RouteInfo( $A.2, Skipped, ~ptr, h(x) )[-, no_precomp] ▶₂ #vr.14 )
      case Forward_HTLC
      by contradiction /* from formulas */
    qed
  next
    case Intermediary_Settle_case_1
    by contradiction /* from formulas */
  next
    case Intermediary_Settle_case_2
    by contradiction /* from formulas */
  next
    case Receiver_Fulfill_HTLC
    by contradiction /* from formulas */
  qed
qed

lemma Fee_Only_On_Successful_Forward:
  all-traces
  "∀ Me ptrIn ptrOut y %vin %vout #i.
    ((FeeEarned( Me, ptrIn, ptrOut, y, %vin, %vout ) @ #i) ∧
     (¬(∃ #c. LtkCompromised( Me ) @ #c))) ⇒
    ((∃ #j. (Redeemed( ptrOut, y ) @ #j) ∧ (#j < #i)) ∧
     (∃ Prev Next #f.
       (HTLCForwarded( Me, Prev, Next, ptrIn, ptrOut, y ) @ #f) ∧ (#f < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ Me ptrIn ptrOut y %vin %vout #i.
  (FeeEarned( Me, ptrIn, ptrOut, y, %vin, %vout ) @ #i)
 ∧
  (∀ #c. (LtkCompromised( Me ) @ #c) ⇒ ⊥) ∧
  (((∀ #j. (Redeemed( ptrOut, y ) @ #j) ⇒ ¬(#j < #i)) ∨
    (∀ Prev Next #f.
      (HTLCForwarded( Me, Prev, Next, ptrIn, ptrOut, y ) @ #f) ⇒ ¬(#f < #i))))"
*/
simplify
solve( (∀ #j. (Redeemed( ptrOut, h(x) ) @ #j) ⇒ ¬(#j < #i))  ∥
       (∀ Prev Next #f.
         (HTLCForwarded( $Me, Prev, Next, ptrIn, ptrOut, h(x) ) @ #f)
        ⇒
         ¬(#f < #i)) )
  case case_1
  solve( (∃ #c. (LtkCompromised( $Me ) @ #c) ∧ #c < #i)  ∥
         (∃ #j. (Redeemed( ptrOut, h(x) ) @ #j) ∧ #j < #i) )
    case case_1
    by contradiction /* from formulas */
  next
    case case_2
    by contradiction /* from formulas */
  qed
next
  case case_2
  by contradiction /* from formulas */
qed

lemma Claim_Excludes_Refund [reuse, heuristic={pending_once}]:
  all-traces
  "∀ P Prev Next pin pout y #f #r #u.
    (((HTLCForwarded( P, Prev, Next, pin, pout, y ) @ #f) ∧
      (Redeemed( pin, y ) @ #r)) ∧
     (Refunded( P, pout, y ) @ #u)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ P Prev Next pin pout y #f #r #u.
  (HTLCForwarded( P, Prev, Next, pin, pout, y ) @ #f) ∧
  (Redeemed( pin, y ) @ #r) ∧
  (Refunded( P, pout, y ) @ #u)"
*/
simplify
solve( Redeemed( pin, y ) @ #r )
  case Intermediary_Settle
  solve( Refunded( $Me, pout, h(x) ) @ #u )
    case Intermediary_Timeout_Refund
    solve( IntermediaryPending( $Me, $Prev.1, $Next.1, pin, pout, h(x),
                                %vIn.1, %vOut.1, %tOut
           ) ▶₀ #r )
      case Forward_HTLC_case_1
      by solve( IntermediaryPending( $A, $Prev.1, $Next, ptrIn, ~ptr, h(x),
                                     %vIn.1, %vOut.1, %tOut
                ) ▶₀ #u )
    next
      case Forward_HTLC_case_2
      by solve( IntermediaryPending( $B, $Prev.1, $Next, ptrIn, ~ptr, h(x),
                                     %vIn.1, %vOut.1, %tOut
                ) ▶₀ #u )
    qed
  next
    case Sender_Timeout_Refund
    solve( IntermediaryPending( $Me, $Prev.1, $Next.1, pin, pout, h(x),
                                %vIn.1, %vOut.1, %tOut
           ) ▶₀ #r )
      case Forward_HTLC_case_1
      by solve( SenderPending( $A, $Forward1, $Receiver, ~ptr, h(x), %t.1
                ) ▶₀ #u )
    next
      case Forward_HTLC_case_2
      by solve( SenderPending( $B, $Forward1, $Receiver, ~ptr, h(x), %t.1
                ) ▶₀ #u )
    qed
  qed
next
  case Receiver_Fulfill_HTLC
  by contradiction /* from formulas */
qed

