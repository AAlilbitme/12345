lemma Hand_Payment:
  exists-trace
  "∃ S F R p0 p1 x n0 n1 n2 n3 a0 b0 a1 b1 s0 t0 s1 t1 s2 t2 s3 t3 #o0 #o1
     #o #u0 #r0 #c0 #f #u1 #r1 #c1 #fu #u2 #r2 #c2 #cl #u3 #r3 #c3 #s.
    (((((((((((((((((((((((((((((((((((((((((((((ChannelOpen( a0, b0, p0
                                                 ) @ #o0) ∧
                                                (ChannelOpen( a1, b1, p1 ) @ #o1)) ∧
                                               (HTLCOffered( S, F, p0, h(x) ) @ #o)) ∧
                                              (ChannelUpdateFor( p0, <'add', h(x)>, n0 ) @ #u0)) ∧
                                             (StateUpdate( s0, t0, p0, n0 ) @ #r0)) ∧
                                            (HTLCCommitted( p0, <'add', h(x)>, n0 ) @ #c0)) ∧
                                           (HTLCForwarded( F, S, R, p0, p1, h(x) ) @ #f)) ∧
                                          (ChannelUpdateFor( p1, <'add', h(x)>, n1 ) @ #u1)) ∧
                                         (StateUpdate( s1, t1, p1, n1 ) @ #r1)) ∧
                                        (HTLCCommitted( p1, <'add', h(x)>, n1 ) @ #c1)) ∧
                                       (HTLCFulfilled( R, F, p1, h(x) ) @ #fu)) ∧
                                      (ChannelUpdateFor( p1, <'settle', h(x)>, n2 ) @ #u2)) ∧
                                     (StateUpdate( s2, t2, p1, n2 ) @ #r2)) ∧
                                    (HTLCCommitted( p1, <'settle', h(x)>, n2 ) @ #c2)) ∧
                                   (IntermediaryClaimed( F, S, p0, x ) @ #cl)) ∧
                                  (ChannelUpdateFor( p0, <'settle', h(x)>, n3 ) @ #u3)) ∧
                                 (StateUpdate( s3, t3, p0, n3 ) @ #r3)) ∧
                                (HTLCCommitted( p0, <'settle', h(x)>, n3 ) @ #c3)) ∧
                               (SenderSettled( S, F, R, p0, x ) @ #s)) ∧
                              (#o0 < #o)) ∧
                             (#o1 < #o)) ∧
                            (#o < #u0)) ∧
                           (#u0 < #r0)) ∧
                          (#r0 < #c0)) ∧
                         (#c0 < #f)) ∧
                        (#f < #u1)) ∧
                       (#u1 < #r1)) ∧
                      (#r1 < #c1)) ∧
                     (#c1 < #fu)) ∧
                    (#fu < #u2)) ∧
                   (#u2 < #r2)) ∧
                  (#r2 < #c2)) ∧
                 (#c2 < #cl)) ∧
                (#cl < #u3)) ∧
               (#u3 < #r3)) ∧
              (#r3 < #c3)) ∧
             (#c3 < #s)) ∧
            (∀ a b p #i.
              (ChannelOpen( a, b, p ) @ #i) ⇒ ((#i = #o0) ∨ (#i = #o1)))) ∧
           (∀ a b p m #i.
             (StateUpdate( a, b, p, m ) @ #i) ⇒
             ((((#i = #r0) ∨ (#i = #r1)) ∨ (#i = #r2)) ∨ (#i = #r3)))) ∧
          (∀ p op m #i.
            (ChannelUpdateFor( p, op, m ) @ #i) ⇒
            ((((#i = #u0) ∨ (#i = #u1)) ∨ (#i = #u2)) ∨ (#i = #u3)))) ∧
         (∀ p op m #i.
           (HTLCCommitted( p, op, m ) @ #i) ⇒
           ((((#i = #c0) ∨ (#i = #c1)) ∨ (#i = #c2)) ∨ (#i = #c3)))) ∧
        (∀ p #i. (MutexReleased( p ) @ #i) ⇒ (#c2 < #i))) ∧
       (∀ p z #i. (Old( p, z ) @ #i) ⇒ (z = h(x)))) ∧
      (¬(∃ X #k. LtkCompromised( X ) @ #k))) ∧
     (¬(∃ P p z #i. Refunded( P, p, z ) @ #i))) ∧
    (¬(∃ t #i. Tick( t ) @ #i))"
/*
guarded formula characterizing all satisfying traces:
"∃ S F R p0 p1 x n0 n1 n2 n3 a0 b0 a1 b1 s0 t0 s1 t1 s2 t2 s3 t3 #o0 #o1
   #o #u0 #r0 #c0 #f #u1 #r1 #c1 #fu #u2 #r2 #c2 #cl #u3 #r3 #c3 #s.
  (ChannelOpen( a0, b0, p0 ) @ #o0) ∧
  (ChannelOpen( a1, b1, p1 ) @ #o1) ∧
  (HTLCOffered( S, F, p0, h(x) ) @ #o) ∧
  (ChannelUpdateFor( p0, <'add', h(x)>, n0 ) @ #u0) ∧
  (StateUpdate( s0, t0, p0, n0 ) @ #r0) ∧
  (HTLCCommitted( p0, <'add', h(x)>, n0 ) @ #c0) ∧
  (HTLCForwarded( F, S, R, p0, p1, h(x) ) @ #f) ∧
  (ChannelUpdateFor( p1, <'add', h(x)>, n1 ) @ #u1) ∧
  (StateUpdate( s1, t1, p1, n1 ) @ #r1) ∧
  (HTLCCommitted( p1, <'add', h(x)>, n1 ) @ #c1) ∧
  (HTLCFulfilled( R, F, p1, h(x) ) @ #fu) ∧
  (ChannelUpdateFor( p1, <'settle', h(x)>, n2 ) @ #u2) ∧
  (StateUpdate( s2, t2, p1, n2 ) @ #r2) ∧
  (HTLCCommitted( p1, <'settle', h(x)>, n2 ) @ #c2) ∧
  (IntermediaryClaimed( F, S, p0, x ) @ #cl) ∧
  (ChannelUpdateFor( p0, <'settle', h(x)>, n3 ) @ #u3) ∧
  (StateUpdate( s3, t3, p0, n3 ) @ #r3) ∧
  (HTLCCommitted( p0, <'settle', h(x)>, n3 ) @ #c3) ∧
  (SenderSettled( S, F, R, p0, x ) @ #s)
 ∧
  (#o0 < #o) ∧
  (#o1 < #o) ∧
  (#o < #u0) ∧
  (#u0 < #r0) ∧
  (#r0 < #c0) ∧
  (#c0 < #f) ∧
  (#f < #u1) ∧
  (#u1 < #r1) ∧
  (#r1 < #c1) ∧
  (#c1 < #fu) ∧
  (#fu < #u2) ∧
  (#u2 < #r2) ∧
  (#r2 < #c2) ∧
  (#c2 < #cl) ∧
  (#cl < #u3) ∧
  (#u3 < #r3) ∧
  (#r3 < #c3) ∧
  (#c3 < #s) ∧
  (∀ a b p #i. (ChannelOpen( a, b, p ) @ #i) ⇒ ((#i = #o0) ∨ (#i = #o1))) ∧
  (∀ a b p m #i.
    (StateUpdate( a, b, p, m ) @ #i)
   ⇒
    ((#i = #r0) ∨ (#i = #r1) ∨ (#i = #r2) ∨ (#i = #r3))) ∧
  (∀ p op m #i.
    (ChannelUpdateFor( p, op, m ) @ #i)
   ⇒
    ((#i = #u0) ∨ (#i = #u1) ∨ (#i = #u2) ∨ (#i = #u3))) ∧
  (∀ p op m #i.
    (HTLCCommitted( p, op, m ) @ #i)
   ⇒
    ((#i = #c0) ∨ (#i = #c1) ∨ (#i = #c2) ∨ (#i = #c3))) ∧
  (∀ p #i. (MutexReleased( p ) @ #i) ⇒ #c2 < #i) ∧
  (∀ p z #i. (Old( p, z ) @ #i) ⇒ z = h(x)) ∧
  (∀ X #k. (LtkCompromised( X ) @ #k) ⇒ ⊥) ∧
  (∀ P p z #i. (Refunded( P, p, z ) @ #i) ⇒ ⊥) ∧
  (∀ t #i. (Tick( t ) @ #i) ⇒ ⊥)"
*/
simplify
solve( ReadyToLock( $A, $B, p0, sA0, sB0, commitA0, commitB0 ) ▶₀ #o0 )
  case Both_States_Committed
  solve( Wallet( $A, ~fA ) ▶₁ #o0 )
    case Acquire_funds
    solve( Wallet( $B, ~fB ) ▶₂ #o0 )
      case Acquire_funds
      solve( ReadyToLock( $A.1, $B.1, p1, sA0.1, sB0.1, commitA0, commitB0
             ) ▶₀ #o1 )
        case Both_States_Committed
        solve( Wallet( $A.1, ~fA.1 ) ▶₁ #o1 )
          case Acquire_funds
          solve( Wallet( $B.1, ~fB.1 ) ▶₂ #o1 )
            case Acquire_funds
            solve( !Pk( $Receiver, pk(x.1) ) ▶₃ #o )
              case Register_key
              solve( !Ltk( $Sender, ltkS ) ▶₄ #o )
                case Register_key
                solve( !ChannelConnect( ~ptr, $Sender, $Forward1 ) ▶₅ #o )
                  case Lock_Funds_And_Open_case_1
                  solve( Mutex( ~ptr ) ▶₆ #o )
                    case Lock_Funds_And_Open
                    solve( !Ltk( $A.6, ltkA ) ▶₃ #u0 )
                      case Register_key
                      solve( !Ltk( $B.6, ltkB ) ▶₄ #u0 )
                        case Register_key
                        solve( StateA( $A.6, $B.6, ~ptr, n_old.4, sAold.4, oldCommitA.4, fA.2,
                                       fB.2
                               ) ▶₅ #u0 )
                          case Lock_Funds_And_Open
                          solve( StateB( $A, $B, ~ptr, '0', sBold.4, oldCommitB.4, ~fA, ~fB
                                 ) ▶₆ #u0 )
                            case Lock_Funds_And_Open
                            solve( !Pk( $A.2, pk(x.1) ) ▶₂ #r0 )
                              case Register_key
                              solve( !Pk( $B.2, pk(x.1) ) ▶₃ #r0 )
                                case Register_key
                                solve( InFlight( ~ptr, ~n_new, <'add', h(x)> ) ▶₀ #c0 )
                                  case Update_State_HTLC
                                  solve( !UpdateDone( ~ptr, ~n_new ) ▶₁ #c0 )
                                    case Revoke_Old_Secret
                                    solve( Route( $A, $B, ~ptr, h(x), %vIn.1, %tIn ) ▶₀ #f )
                                      case Add_Committed
                                      solve( !ChannelConnect( ~ptr.1, $B, $Next.1 ) ▶₁ #f )
                                        case Lock_Funds_And_Open_case_1
                                        solve( !Ltk( $A.5, ltkA ) ▶₃ #u1 )
                                          case Register_key
                                          solve( !Ltk( $B.6, ltkB ) ▶₄ #u1 )
                                            case Register_key
                                            solve( StateA( $A.5, $B.6, ~ptr.1, n_old.4, sAold.4, oldCommitA.4,
                                                           fA.2, fB.2
                                                   ) ▶₅ #u1 )
                                              case Lock_Funds_And_Open
                                              solve( StateB( $B, $B.1, ~ptr.1, '0', sBold.4, oldCommitB.4,
                                                             ~fA.1, ~fB.1
                                                     ) ▶₆ #u1 )
                                                case Lock_Funds_And_Open
                                                solve( !Pk( $A.2, pk(x.1) ) ▶₂ #r1 )
                                                  case Register_key
                                                  solve( !Pk( $B.3, pk(x.1) ) ▶₃ #r1 )
                                                    case Register_key
                                                    solve( InFlight( ~ptr.1, ~n_new.1, <'add', h(x)>
                                                           ) ▶₀ #c1 )
                                                      case Update_State_HTLC
                                                      solve( !UpdateDone( ~ptr.1, ~n_new.1 ) ▶₁ #c1 )
                                                        case Revoke_Old_Secret
                                                        solve( Route( $B, $B.1, ~ptr.1, h(x), %amt, %t
                                                               ) ▶₀ #fu )
                                                          case Add_Committed_case_1
                                                          solve( ReceiverInv( $B.1, $Sender, x, %amt
                                                                 ) ▶₁ #fu )
                                                            case Receiver_Create_Invoice
                                                            solve( !Ltk( $A.5, ltkA ) ▶₃ #u2 )
                                                              case Register_key
