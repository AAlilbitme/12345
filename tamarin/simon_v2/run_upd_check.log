lemma ForwardTimeGap [reuse]:
  all-traces
  "∀ pin pout y %tin %tout #f.
    (ForwardExpiries( pin, pout, y, %tin, %tout ) @ #f) ⇒ (%tout ⊏ %tin)"
/*
guarded formula characterizing all counter-examples:
"∃ pin pout y %tin %tout #f.
  (ForwardExpiries( pin, pout, y, %tin, %tout ) @ #f) ∧ ¬(%tout ⊏ %tin)"
*/
by sorry

lemma state_update [use_induction]:
  all-traces
  "∀ A B ptr n #i.
    (StateUpdate( A, B, ptr, n ) @ #i) ⇒
    (∃ #j. (ChannelOpen( A, B, ptr ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ A B ptr n #i.
  (StateUpdate( A, B, ptr, n ) @ #i)
 ∧
  ∀ #j. (ChannelOpen( A, B, ptr ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

