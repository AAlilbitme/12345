       sigA0 = sigA0.26
       sigB0 = sign(commitB0.20, x.33)
       z     = verify(sigA0.26, commitA0.19, pkA.21)
       z.1   = true
    
    3. commitA0
             = commitA0.19
       commitB0
             = commitB0.20
       pkA   = pk(x.33)
       pkB   = pkB.22
       sigA0 = sign(commitA0.19, x.33)
       sigB0 = sigB0.27
       z     = true
       z.1   = verify(sigB0.27, commitB0.20, pkB.22)
    
    4. commitA0
             = commitA0.19
       commitB0
             = commitB0.20
       pkA   = pk(x.33)
       pkB   = pk(x.34)
       sigA0 = sign(commitA0.19, x.33)
       sigB0 = sign(commitB0.20, x.34)
       z     = true
       z.1   = true
  */

rule (modulo E) Lock_Funds_And_Open:
   [
   ReadyToLock( $A, $B, ptr, sA0, sB0, commitA0, commitB0 ),
   Wallet( $A, ~fA ), Wallet( $B, ~fB )
   ]
  --[
  ChannelOpen( $A, $B, ptr ), FundsLocked( $A, $B, ptr ),
  NewStateBuilt( $A, $B, ptr, '0', ~fA, ~fB )
  ]->
   [
   StateA( $A, $B, ptr, '0', sA0, commitA0, ~fA, ~fB ),
   StateB( $A, $B, ptr, '0', sB0, commitB0, ~fA, ~fB ),
   !ValidOnChain( ptr ), !ChannelRecord( ptr, $A, $B ),
   !ChannelConnect( ptr, $A, $B ), !ChannelConnect( ptr, $B, $A ),
   Mutex( ptr ), FundingUnspent( ptr )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Update_State:
   [
   Fr( ~n_new ), Fr( ~sAnew ), Fr( ~sBnew ), !Ltk( $A, ltkA ),
   !Ltk( $B, ltkB ),
   StateA( $A, $B, ptr, n_old, sAold, oldCommitA, fA, fB ),
   StateB( $A, $B, ptr, n_old, sBold, oldCommitB, fA, fB ),
   In( <fA_new, fB_new> )
   ]
  --[ NewStateBuilt( $A, $B, ptr, ~n_new, fA_new, fB_new ) ]->
   [
   PendingA( $A, $B, ptr, n_old, sAold, oldCommitA, ~n_new, ~sAnew,
             <'commit', ptr, $A, $B, ~n_new, h(~sAnew)>,
             sign(<'commit', ptr, $A, $B, ~n_new, h(~sAnew)>, ltkA), fA_new, fB_new
   ),
   PendingB( $A, $B, ptr, n_old, sBold, oldCommitB, ~n_new, ~sBnew,
             <'commit', ptr, $B, $A, ~n_new, h(~sBnew)>,
             sign(<'commit', ptr, $B, $A, ~n_new, h(~sBnew)>, ltkB), fA_new, fB_new
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Update_State_HTLC:
   [
   Fr( ~n_new ), Fr( ~sAnew ), Fr( ~sBnew ), !Ltk( $A, ltkA ),
   !Ltk( $B, ltkB ),
   StateA( $A, $B, ptr, n_old, sAold, oldCommitA, fA, fB ),
   StateB( $A, $B, ptr, n_old, sBold, oldCommitB, fA, fB ),
   In( <fA_new, fB_new> ), UpdateFor( ptr, op )
   ]
  --[
  NewStateBuilt( $A, $B, ptr, ~n_new, fA_new, fB_new ),
  ChannelUpdateFor( ptr, op, ~n_new )
  ]->
   [
   PendingA( $A, $B, ptr, n_old, sAold, oldCommitA, ~n_new, ~sAnew,
             <'commit', ptr, $A, $B, ~n_new, h(~sAnew)>,
             sign(<'commit', ptr, $A, $B, ~n_new, h(~sAnew)>, ltkA), fA_new, fB_new
   ),
   PendingB( $A, $B, ptr, n_old, sBold, oldCommitB, ~n_new, ~sBnew,
             <'commit', ptr, $B, $A, ~n_new, h(~sBnew)>,
             sign(<'commit', ptr, $B, $A, ~n_new, h(~sBnew)>, ltkB), fA_new, fB_new
   ),
   InFlight( ptr, ~n_new, op )
   ]

  // loop breaker: [8]
  /* has exactly the trivial AC variant */

rule (modulo E) Revoke_Old_Secret:
   [
   PendingA( $A, $B, ptr, n_old, sAold, oldCommitA, n_new, sAnew,
             newCommitA, sigAnew, fA_new, fB_new
   ),
   PendingB( $A, $B, ptr, n_old, sBold, oldCommitB, n_new, sBnew,
             newCommitB, sigBnew, fA_new, fB_new
   ),
   !Pk( $A, pkA ), !Pk( $B, pkB )
   ]
  --[
  StateUpdate( $A, $B, ptr, n_new ), Revoke( $A, n_old, sAold ),
  Revoke( $B, n_old, sBold ), Eq( verify(sigAnew, newCommitA, pkA), true ),
  Eq( verify(sigBnew, newCommitB, pkB), true )
  ]->
   [
   StateA( $A, $B, ptr, n_new, sAnew, newCommitA, fA_new, fB_new ),
   StateB( $A, $B, ptr, n_new, sBnew, newCommitB, fA_new, fB_new ),
   !RevokedSecret( $A, n_old, sAold, oldCommitA ),
   !RevokedSecret( $B, n_old, sBold, oldCommitB ),
   RevokedCommitmentUnspent( ptr, $A, $B, n_old, oldCommitA ),
   RevokedCommitmentUnspent( ptr, $B, $A, n_old, oldCommitB ),
   !UpdateDone( ptr, n_new )
   ]

  // loop breakers: [0,1]
  /*
  rule (modulo AC) Revoke_Old_Secret:
     [
     PendingA( $A, $B, ptr, n_old, sAold, oldCommitA, n_new, sAnew,
               newCommitA, sigAnew, fA_new, fB_new
     ),
     PendingB( $A, $B, ptr, n_old, sBold, oldCommitB, n_new, sBnew,
               newCommitB, sigBnew, fA_new, fB_new
     ),
     !Pk( $A, pkA ), !Pk( $B, pkB )
     ]
    --[
    StateUpdate( $A, $B, ptr, n_new ), Revoke( $A, n_old, sAold ),
    Revoke( $B, n_old, sBold ), Eq( z, true ), Eq( z.1, true )
    ]->
     [
     StateA( $A, $B, ptr, n_new, sAnew, newCommitA, fA_new, fB_new ),
     StateB( $A, $B, ptr, n_new, sBnew, newCommitB, fA_new, fB_new ),
     !RevokedSecret( $A, n_old, sAold, oldCommitA ),
     !RevokedSecret( $B, n_old, sBold, oldCommitB ),
     RevokedCommitmentUnspent( ptr, $A, $B, n_old, oldCommitA ),
     RevokedCommitmentUnspent( ptr, $B, $A, n_old, oldCommitB ),
     !UpdateDone( ptr, n_new )
     ]
    variants (modulo AC)
    1. newCommitA
             = newCommitA.22
       newCommitB
             = newCommitB.22
       pkA   = pkA.22
       pkB   = pkB.22
       sigAnew
             = sigAnew.22
       sigBnew
             = sigBnew.22
       z     = verify(sigAnew.22, newCommitA.22, pkA.22)
       z.1   = verify(sigBnew.22, newCommitB.22, pkB.22)
    
    2. newCommitA
             = x.22
       newCommitB
             = x.23
       pkA   = pk(x.26)
       pkB   = pk(x.27)
       sigAnew
             = sign(x.22, x.26)
       sigBnew
             = sign(x.23, x.27)
       z     = true
       z.1   = true
    
    3. newCommitA
             = x.22
       newCommitB
             = newCommitB.27
       pkA   = pk(x.26)
       pkB   = pkB.27
       sigAnew
             = sign(x.22, x.26)
       sigBnew
             = sigBnew.27
       z     = true
       z.1   = verify(sigBnew.27, newCommitB.27, pkB.27)
    
    4. newCommitA
             = newCommitA.27
       newCommitB
             = x.22
       pkA   = pkA.27
       pkB   = pk(x.26)
       sigAnew
             = sigAnew.27
       sigBnew
             = sign(x.22, x.26)
       z     = verify(sigAnew.27, newCommitA.27, pkA.27)
       z.1   = true
    // loop breakers: [0,1]
  */

rule (modulo E) Publish_Old_Grace_Period_A:
   [
   PendingA( $A, $B, ptr, n_old, sAold, oldCommitA, n_new, sAnew,
             newCommitA, sigAnew, fA_new, fB_new
   ),
   !ValidOnChain( ptr ), FundingUnspent( ptr )
   ]
  --[
  FundingSpent( ptr ), PublishOldBeforeRevocation( $A, n_old ),
  PublishState( $A, n_old ), OnChainDelayedProduce( $A, n_old ),
  OnChainInstantProduce( $B, n_old )
  ]->
   [
   OnChainDelayed( $A, n_old, oldCommitA ),
   OnChainInstant( $B, n_old, oldCommitA )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Publish_Old_Grace_Period_B:
   [
   PendingB( $A, $B, ptr, n_old, sBold, oldCommitB, n_new, sBnew,
             newCommitB, sigBnew, fA_new, fB_new
   ),
   !ValidOnChain( ptr ), FundingUnspent( ptr )
   ]
  --[
  FundingSpent( ptr ), PublishOldBeforeRevocation( $B, n_old ),
  PublishState( $B, n_old ), OnChainDelayedProduce( $B, n_old ),
  OnChainInstantProduce( $A, n_old )
  ]->
   [
   OnChainDelayed( $B, n_old, oldCommitB ),
   OnChainInstant( $A, n_old, oldCommitB )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Publish_Current_A:
   [
   StateA( $A, $B, ptr, n, sA, <'commit', ptr, $A, $B, n, hA>, fA, fB ),
   !ValidOnChain( ptr ), FundingUnspent( ptr )
   ]
  --[
  FundingSpent( ptr ), Publish( $A, n, <'commit', ptr, $A, $B, n, hA> ),
  PublishState( $A, n ), OnChainDelayedProduce( $A, n ),
  OnChainInstantProduce( $B, n )
  ]->
   [
   OnChainDelayed( $A, n, <'commit', ptr, $A, $B, n, hA> ),
   OnChainInstant( $B, n, <'commit', ptr, $A, $B, n, hA> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Publish_Current_B:
   [
   StateB( $A, $B, ptr, n, sB, <'commit', ptr, $B, $A, n, hB>, fA, fB ),
   !ValidOnChain( ptr ), FundingUnspent( ptr )
   ]
  --[
  FundingSpent( ptr ), Publish( $B, n, <'commit', ptr, $B, $A, n, hB> ),
  PublishState( $B, n ), OnChainDelayedProduce( $B, n ),
  OnChainInstantProduce( $A, n )
  ]->
   [
   OnChainDelayed( $B, n, <'commit', ptr, $B, $A, n, hB> ),
   OnChainInstant( $A, n, <'commit', ptr, $B, $A, n, hB> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Publish_Pending_A:
   [
   PendingA( $A, $B, ptr, n_old, sAold, oldCommitA, n_new, sAnew,
             <'commit', ptr, $A, $B, n_new, hA>, sigAnew, fA_new, fB_new
   ),
   !ValidOnChain( ptr ), FundingUnspent( ptr )
   ]
  --[
  FundingSpent( ptr ),
  Publish( $A, n_new, <'commit', ptr, $A, $B, n_new, hA> ),
  PublishFromPending( $A, n_old, n_new ),
  OnChainDelayedProduce( $A, n_new ), OnChainInstantProduce( $B, n_new )
  ]->
   [
   OnChainDelayed( $A, n_new, <'commit', ptr, $A, $B, n_new, hA> ),
   OnChainInstant( $B, n_new, <'commit', ptr, $A, $B, n_new, hA> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Publish_Pending_B:
   [
   PendingB( $A, $B, ptr, n_old, sBold, oldCommitB, n_new, sBnew,
             <'commit', ptr, $B, $A, n_new, hB>, sigBnew, fA_new, fB_new
   ),
   !ValidOnChain( ptr ), FundingUnspent( ptr )
   ]
  --[
  FundingSpent( ptr ),
  Publish( $B, n_new, <'commit', ptr, $B, $A, n_new, hB> ),
  PublishFromPending( $B, n_old, n_new ),
  OnChainDelayedProduce( $B, n_new ), OnChainInstantProduce( $A, n_new )
  ]->
   [
   OnChainDelayed( $B, n_new, <'commit', ptr, $B, $A, n_new, hB> ),
   OnChainInstant( $A, n_new, <'commit', ptr, $B, $A, n_new, hB> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Honest_Close:
   [
   StateA( $A, $B, ptr, n, sA, commitA, fA, fB ),
   StateB( $A, $B, ptr, n, sB, commitB, fA, fB ), !ValidOnChain( ptr ),
   FundingUnspent( ptr ), !Ltk( $A, ltkA ), !Ltk( $B, ltkB ),
   !Pk( $A, pkA ), !Pk( $B, pkB )
   ]
  --[
  FundingSpent( ptr ), Close( $A, $B, ptr, n ),
  OnChainInstantProduce( $A, n ), OnChainInstantProduce( $B, n ),
  Eq( verify(sign(<'commit', ptr, $A, $B, n, fA, fB>, ltkA),
             <'commit', ptr, $A, $B, n, fA, fB>, pkA),
      true
  ),
  Eq( verify(sign(<'commit', ptr, $A, $B, n, fA, fB>, ltkB),
             <'commit', ptr, $A, $B, n, fA, fB>, pkB),
      true
  )
  ]->
   [
   OnChainInstant( $A, n, <'commit', ptr, $A, $B, n, fA, fB> ),
   OnChainInstant( $B, n, <'commit', ptr, $A, $B, n, fA, fB> )
   ]

  /*
  rule (modulo AC) Honest_Close:
     [
     StateA( $A, $B, ptr, n, sA, commitA, fA, fB ),
     StateB( $A, $B, ptr, n, sB, commitB, fA, fB ), !ValidOnChain( ptr ),
     FundingUnspent( ptr ), !Ltk( $A, ltkA ), !Ltk( $B, ltkB ),
     !Pk( $A, pkA ), !Pk( $B, pkB )
     ]
    --[
    FundingSpent( ptr ), Close( $A, $B, ptr, n ),
    OnChainInstantProduce( $A, n ), OnChainInstantProduce( $B, n ),
    Eq( z, true ), Eq( z.1, true )
    ]->
     [
     OnChainInstant( $A, n, <'commit', ptr, $A, $B, n, fA, fB> ),
     OnChainInstant( $B, n, <'commit', ptr, $A, $B, n, fA, fB> )
     ]
    variants (modulo AC)
    1. $A    = $A.19
       $B    = $B.20
       fA    = fA.23
       fB    = fB.24
       ltkA  = ltkA.25
       ltkB  = ltkB.26
       n     = n.27
       pkA   = pkA.28
       pkB   = pkB.29
       ptr   = ptr.30
       z     = verify(sign(<'commit', ptr.30, $A.19, $B.20, n.27, fA.23, fB.24>,
                           ltkA.25),
                      <'commit', ptr.30, $A.19, $B.20, n.27, fA.23, fB.24>, pkA.28)
       z.1   = verify(sign(<'commit', ptr.30, $A.19, $B.20, n.27, fA.23, fB.24>,
                           ltkB.26),
                      <'commit', ptr.30, $A.19, $B.20, n.27, fA.23, fB.24>, pkB.29)
    
    2. $A    = $A.20
       $B    = $B.21
       fA    = fA.24
       fB    = fB.25
       ltkA  = ltkA.26
       ltkB  = ltkB.27
       n     = n.28
       pkA   = pkA.29
       pkB   = pk(ltkB.27)
       ptr   = ptr.31
       z     = verify(sign(<'commit', ptr.31, $A.20, $B.21, n.28, fA.24, fB.25>,
                           ltkA.26),
                      <'commit', ptr.31, $A.20, $B.21, n.28, fA.24, fB.25>, pkA.29)
       z.1   = true
    
    3. $A    = $A.20
       $B    = $B.21
       fA    = fA.24
       fB    = fB.25
       ltkA  = ltkA.26
       ltkB  = ltkB.27
       n     = n.28
       pkA   = pk(ltkA.26)
       pkB   = pkB.30
       ptr   = ptr.31
       z     = true
       z.1   = verify(sign(<'commit', ptr.31, $A.20, $B.21, n.28, fA.24, fB.25>,
                           ltkB.27),
                      <'commit', ptr.31, $A.20, $B.21, n.28, fA.24, fB.25>, pkB.30)
    
    4. ltkA  = ltkA.20
       ltkB  = ltkB.21
       pkA   = pk(ltkA.20)
       pkB   = pk(ltkB.21)
       z     = true
       z.1   = true
  */

rule (modulo E) Publish_Revoked_A:
   [
   !ChannelRecord( ptr, $A, $B ), !ValidOnChain( ptr ),
   FundingUnspent( ptr ),
   !RevokedSecret( $A, n_old, sAold, oldCommitA )[no_precomp],
   RevokedCommitmentUnspent( ptr, $A, $B, n_old, oldCommitA )[no_precomp],
   Fr( ~tx ), In( %m )
   ]
  --[
  FundingSpent( ptr ), PublishRevoked( $A, n_old, oldCommitA ),
  Cheat( $A, n_old ), CheatMaturity( $A, $B, ~tx, %m ),
  OnChainDelayedProduce( $A, n_old )
  ]->
   [
   OnChainCheat( $A, $B, n_old, oldCommitA, ~tx ),
   RevealedSecret( $A, n_old, sAold, oldCommitA, ~tx ),
   RevokedDelayed( $A, n_old, oldCommitA, ~tx, %m )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Publish_Revoked_B:
   [
   !ChannelRecord( ptr, $A, $B ), !ValidOnChain( ptr ),
   FundingUnspent( ptr ),
   !RevokedSecret( $B, n_old, sBold, oldCommitB )[no_precomp],
   RevokedCommitmentUnspent( ptr, $B, $A, n_old, oldCommitB )[no_precomp],
   Fr( ~tx ), In( %m )
   ]
  --[
  FundingSpent( ptr ), PublishRevoked( $B, n_old, oldCommitB ),
  Cheat( $B, n_old ), CheatMaturity( $B, $A, ~tx, %m ),
  OnChainDelayedProduce( $B, n_old )
  ]->
   [
   OnChainCheat( $B, $A, n_old, oldCommitB, ~tx ),
   RevealedSecret( $B, n_old, sBold, oldCommitB, ~tx ),
   RevokedDelayed( $B, n_old, oldCommitB, ~tx, %m )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Punish_A:
   [
   OnChainCheat( $A, $B, n_old, oldCommitA, tx ),
   RevealedSecret( $A, n_old, sAold, oldCommitA, tx ),
   RevokedDelayed( $A, n_old, oldCommitA, tx, %m )[no_precomp]
   ]
  --[ Punish( $B, $A, n_old ), PunishRevoked( $B, $A, tx ) ]->
   [ AllFundsTo( $B ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Punish_B:
   [
   OnChainCheat( $B, $A, n_old, oldCommitB, tx ),
   RevealedSecret( $B, n_old, sBold, oldCommitB, tx ),
   RevokedDelayed( $B, n_old, oldCommitB, tx, %m )[no_precomp]
   ]
  --[ Punish( $A, $B, n_old ), PunishRevoked( $A, $B, tx ) ]->
   [ AllFundsTo( $A ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Claim_Revoked:
   [ RevokedDelayed( P, n, c, tx, %m )[no_precomp], !Block( %b ) ]
  --[
  RevokedClaimed( P, tx ), ClaimFunds( P, n ), CSVPassed( P, n ),
  SettledTx( P, c ), Lt( %m, %b )
  ]->
   [ FundsTo( P, n ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Instant_Funds_A:
   [ OnChainInstant( $A, n, txContent ) ]
  --[ FundsSettled( $A, n ), SettledTx( $A, txContent ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Instant_Funds_B:
   [ OnChainInstant( $B, n, txContent ) ]
  --[ FundsSettled( $B, n ), SettledTx( $B, txContent ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Claim_Funds_A:
   [ OnChainDelayed( $A, n, txContent ) ]
  --[ ClaimFunds( $A, n ), CSVPassed( $A, n ), SettledTx( $A, txContent )
  ]->
   [ FundsTo( $A, n ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Claim_Funds_B:
   [ OnChainDelayed( $B, n, txContent ) ]
  --[ ClaimFunds( $B, n ), CSVPassed( $B, n ), SettledTx( $B, txContent )
  ]->
   [ FundsTo( $B, n ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Receiver_Create_Invoice:
   [ Fr( ~x ), !Ltk( $Receiver, ltkR ), In( %amt ) ]
  --[
  InvoiceCreated( $Receiver, $Sender, h(~x) ),
  InvoiceAmount( $Receiver, h(~x), %amt ), SecretPreimage( $Receiver, ~x )
  ]->
   [
   ReceiverInv( $Receiver, $Sender, ~x, %amt ),
   Out( <'SecretRS', <'invoice', $Receiver, $Sender, h(~x), %amt>, 
         sign(<'invoice', $Receiver, $Sender, h(~x), %amt>, ltkR)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sender_Offer_HTLC:
   [
   In( <'SecretRS', <'invoice', $Receiver, $Sender, y, %amt>, sigR> ),
   In( %v1 ), In( %t ), !Pk( $Receiver, pkR ), !Ltk( $Sender, ltkS ),
   !ChannelConnect( ptrSF, $Sender, $Forward1 ), Mutex( ptrSF )
   ]
  --[
  HTLCOffered( $Sender, $Forward1, ptrSF, y ),
  OfferFor( $Sender, $Receiver, ptrSF, y ), HTLCAdded( ptrSF, y ),
  HTLCAmount( ptrSF, y, %v1 ), Lt( %amt, %v1 ), HTLCExpiry( ptrSF, y, %t ),
  Neq( $Sender, $Forward1 ), Neq( $Sender, $Receiver ),
  Neq( $Forward1, $Receiver ),
  Eq( verify(sigR, <'invoice', $Receiver, $Sender, y, %amt>, pkR), true )
  ]->
   [
   SenderPending( $Sender, $Forward1, $Receiver, ptrSF, y, %t ),
   AwaitRoute( $Sender, $Forward1, ptrSF, y, %v1, %t ),
   UpdateFor( ptrSF, <'add', y> ),
   !RouteInfo( $Sender, $Forward1, ptrSF, y )
   ]

  /*
  rule (modulo AC) Sender_Offer_HTLC:
     [
     In( <'SecretRS', <'invoice', $Receiver, $Sender, y, %amt>, sigR> ),
     In( %v1 ), In( %t ), !Pk( $Receiver, pkR ), !Ltk( $Sender, ltkS ),
     !ChannelConnect( ptrSF, $Sender, $Forward1 ), Mutex( ptrSF )
     ]
    --[
    HTLCOffered( $Sender, $Forward1, ptrSF, y ),
    OfferFor( $Sender, $Receiver, ptrSF, y ), HTLCAdded( ptrSF, y ),
    HTLCAmount( ptrSF, y, %v1 ), Lt( %amt, %v1 ), HTLCExpiry( ptrSF, y, %t ),
    Neq( $Sender, $Forward1 ), Neq( $Sender, $Receiver ),
    Neq( $Forward1, $Receiver ), Eq( z, true )
    ]->
     [
     SenderPending( $Sender, $Forward1, $Receiver, ptrSF, y, %t ),
     AwaitRoute( $Sender, $Forward1, ptrSF, y, %v1, %t ),
     UpdateFor( ptrSF, <'add', y> ),
     !RouteInfo( $Sender, $Forward1, ptrSF, y )
     ]
    variants (modulo AC)
    1. $Receiver
             = $Receiver.24
       $Sender
             = $Sender.25
       pkR   = pkR.27
       sigR  = sigR.29
       y     = y.30
       z     = verify(sigR.29,
                      <'invoice', $Receiver.24, $Sender.25, y.30, %amt.31>, pkR.27)
       %amt  = %amt.31
    
    2. $Receiver
             = $Receiver.48
       $Sender
             = $Sender.49
       pkR   = pk(x.93)
       sigR  = sign(<'invoice', $Receiver.48, $Sender.49, y.54, %amt.55>, x.93)
       y     = y.54
       z     = true
       %amt  = %amt.55
  */

rule (modulo E) Forward_HTLC:
   [
   Route( $Prev, $Me, ptrIn, y, %vIn, %tIn ),
   !ChannelConnect( ptrOut, $Me, $Next ), Mutex( ptrOut ), In( %vOut ),
   In( %tOut )
   ]
  --[
  HTLCForwarded( $Me, $Prev, $Next, ptrIn, ptrOut, y ),
  HTLCAdded( ptrOut, y ), HTLCAmount( ptrOut, y, %vOut ),
  ForwardAmounts( ptrIn, ptrOut, y, %vIn, %vOut ),
  HTLCExpiry( ptrOut, y, %tOut ),
  ForwardExpiries( ptrIn, ptrOut, y, %tIn, %tOut ), Lt( %tOut, %tIn ),
  FeeCharged( $Me, y, %vIn, %vOut ), Lt( %vOut, %vIn ),
  Neq( ptrIn, ptrOut ), Neq( $Prev, $Me ), Neq( $Me, $Next )
  ]->
   [
   IntermediaryPending( $Me, $Prev, $Next, ptrIn, ptrOut, y, %vIn, %vOut,
                        %tOut
   ),
   AwaitRoute( $Me, $Next, ptrOut, y, %vOut, %tOut ),
   UpdateFor( ptrOut, <'add', y> ), !RouteInfo( $Me, $Next, ptrOut, y )
   ]

  // loop breaker: [2]
  /* has exactly the trivial AC variant */

rule (modulo E) Receiver_Fulfill_HTLC:
   [
   Route( $Prev, $Receiver, ptrIn, y, %v, %t ),
   ReceiverInv( $Receiver, $Sender, x, %amt )
   ]
  --[
  HTLCFulfilled( $Receiver, $Prev, ptrIn, y ),
  ReceiverPaid( $Receiver, y, %v ), Eq( %v, %amt ),
  PreimageReleased( $Receiver, x ), Redeemed( ptrIn, y ), Old( ptrIn, y ),
  Eq( h(x), y ), FulfilledMade( ptrIn, x )
  ]->
   [ AwaitFulfilled( ptrIn, x ), UpdateFor( ptrIn, <'settle', h(x)> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Intermediary_Settle:
   [
   IntermediaryPending( $Me, $Prev, $Next, ptrIn, ptrOut, y, %vIn, %vOut,
                        %tOut
   ),
   Fulfilled( ptrOut, x )
   ]
  --[
  IntermediaryClaimed( $Me, $Prev, ptrIn, x ),
  FeeEarned( $Me, ptrIn, ptrOut, y, %vIn, %vOut ), Redeemed( ptrIn, y ),
  Old( ptrIn, y ), FulfilledProduced( ptrIn, x ), Eq( h(x), y ),
  PendingUsed( $Me, ptrIn, ptrOut, y ), FulfilledUsed( ptrOut, x ),
  FulfilledMade( ptrIn, x )
  ]->
   [ AwaitFulfilled( ptrIn, x ), UpdateFor( ptrIn, <'settle', h(x)> ) ]

  // loop breaker: [1]
  /* has exactly the trivial AC variant */

rule (modulo E) Sender_Settle:
   [
   SenderPending( $Sender, $Forward1, $Receiver, ptrSF, y, %t ),
   Fulfilled( ptrSF, x )
   ]
  --[
  SenderSettled( $Sender, $Forward1, $Receiver, ptrSF, x ), Eq( h(x), y ),
  FulfilledUsed( ptrSF, x )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Commit_HTLC_Update:
   [ InFlight( ptr, n, op ), !UpdateDone( ptr, n ) ]
  --[ HTLCCommitted( ptr, op, n ) ]->
   [ Committed( ptr, op ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Add_Committed:
   [ AwaitRoute( P, N, ptr, y, %v, %t ), Committed( ptr, <'add', y> ) ]
  -->
   [ Route( P, N, ptr, y, %v, %t ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Settle_Committed:
   [ AwaitFulfilled( ptr, x ), Committed( ptr, <'settle', h(x)> ) ]
  --[ MutexReleased( ptr ) ]->
   [ Fulfilled( ptr, x ), Mutex( ptr ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Fail_Committed:
   [ Committed( ptr, <'fail', y> ) ]
  --[ MutexReleased( ptr ) ]->
   [ Mutex( ptr ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Clock_Tick:
   [ In( %t ) ] --[ Tick( %t ) ]-> [ !Block( %t ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sender_Timeout_Refund:
   [
   SenderPending( $Sender, $Forward1, $Receiver, ptrSF, y, %t ),
   !Block( %b )
   ]
  --[ Refunded( $Sender, ptrSF, y ), Lt( %t, %b ), Old( ptrSF, y ) ]->
   [ UpdateFor( ptrSF, <'fail', y> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Intermediary_Timeout_Refund:
   [
   IntermediaryPending( $Me, $Prev, $Next, ptrIn, ptrOut, y, %vIn, %vOut,
                        %tOut
   ),
   !Block( %b )
   ]
  --[
  Refunded( $Me, ptrOut, y ), Lt( %tOut, %b ), Old( ptrOut, y ),
  PendingUsed( $Me, ptrIn, ptrOut, y )
  ]->
   [ UpdateFor( ptrOut, <'fail', y> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) AttackerSkip:
   [
   Fulfilled( ptrExit, x ),
   !RouteInfo( ExitAtt, Next, ptrExit, y )[-, no_precomp],
   !RouteInfo( EntryAtt, Skipped, ptrSkip, y )[-, no_precomp],
   !Compromised( ExitAtt ), !Compromised( EntryAtt )
   ]
  --[
  FulfilledProduced( ptrSkip, x ), Eq( h(x), y ),
  FulfilledUsed( ptrExit, x ), FulfilledMade( ptrSkip, x )
  ]->
   [ Fulfilled( ptrSkip, x ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

restriction OneResolutionPerHTLC:
  "∀ ptr y #i #j.
    ((Old( ptr, y ) @ #i) ∧ (Old( ptr, y ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction OneHTLCPerHashPerChannel:
  "∀ ptr y #m #n.
    ((HTLCAdded( ptr, y ) @ #m) ∧ (HTLCAdded( ptr, y ) @ #n)) ⇒ (#m = #n)"
  // safety formula

restriction Inequality:
  "∀ x y #i. (Neq( x, y ) @ #i) ⇒ (¬(x = y))"
  // safety formula

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction TickOnce:
  "∀ %t #i #j. ((Tick( %t ) @ #i) ∧ (Tick( %t ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction TicksInOrder:
  "∀ %s %t #i #j.
    (((Tick( %s ) @ #i) ∧ (Tick( %t ) @ #j)) ∧ (%s ⊏ %t)) ⇒ (#i < #j)"
  // safety formula

restriction ExpiryBlockReached:
  "∀ ptr y %s %b #a #k.
    (((HTLCExpiry( ptr, y, %s ) @ #a) ∧ (Tick( %b ) @ #k)) ∧ (%s ⊏ %b)) ⇒
    (∃ #i. (Tick( %s ) @ #i) ∧ (#i < #k))"

restriction LessThan:
  "∀ a b #i. (Lt( a, b ) @ #i) ⇒ (a ⊏ b)"
  // safety formula

restriction OneChannelPerPtr:
  "∀ A B C D ptr #i #j.
    ((ChannelOpen( A, B, ptr ) @ #i) ∧ (ChannelOpen( C, D, ptr ) @ #j)) ⇒
    (#i = #j)"
  // safety formula

restriction HonestForwardBeforeExpiry:
  "∀ P Prev Next pin pout y %tIn %tOut %b #f #e #k.
    (((((HTLCForwarded( P, Prev, Next, pin, pout, y ) @ #f) ∧
        (ForwardExpiries( pin, pout, y, %tIn, %tOut ) @ #e)) ∧
       (Tick( %b ) @ #k)) ∧
      (%tIn ⊏ %b)) ∧
     (#k < #f)) ⇒
    (∃ #c. (LtkCompromised( P ) @ #c) ∧ (#c < #f))"

restriction CheatMaturityInFuture:
  "∀ P Q tx %m %b #c #k.
    (((CheatMaturity( P, Q, tx, %m ) @ #c) ∧ (Tick( %b ) @ #k)) ∧
     ((%b = %m) ∨ (%m ⊏ %b))) ⇒
    (#c < #k)"
  // safety formula

lemma Settle_Is_Channel_Update [heuristic={upd}]:
  all-traces
  "∀ S F R ptr x #s.
    (SenderSettled( S, F, R, ptr, x ) @ #s) ⇒
    ((∃ n #c. (HTLCCommitted( ptr, <'settle', h(x)>, n ) @ #c) ∧ (#c < #s)) ∨
     (∃ X #k. LtkCompromised( X ) @ #k))"
/*
guarded formula characterizing all counter-examples:
"∃ S F R ptr x #s.
  (SenderSettled( S, F, R, ptr, x ) @ #s)
 ∧
  (∀ n #c. (HTLCCommitted( ptr, <'settle', h(x)>, n ) @ #c) ⇒ ¬(#c < #s)) ∧
  (∀ X #k. (LtkCompromised( X ) @ #k) ⇒ ⊥)"
*/
simplify
solve( Fulfilled( ptr, x ) ▶₁ #s )
  case AttackerSkip
  by contradiction /* from formulas */
next
  case Settle_Committed_case_01
  by contradiction /* from formulas */
next
