  rule (modulo AC) Both_States_Committed:
     [
     CommittedStateA( $A, $B, ptr, '0', sA0, commitA0, sigA0 ),
     CommittedStateB( $A, $B, ptr, '0', sB0, commitB0, sigB0 ),
     !Pk( $A, pkA ), !Pk( $B, pkB )
     ]
    --[ Stage1Complete( $A, $B, ptr ), Eq( z, true ), Eq( z.1, true ) ]->
     [ ReadyToLock( $A, $B, ptr, sA0, sB0, commitA0, commitB0 ) ]
    variants (modulo AC)
    1. commitA0
             = commitA0.16
       commitB0
             = commitB0.17
       pkA   = pkA.18
       pkB   = pkB.19
       sigA0 = sigA0.23
       sigB0 = sigB0.24
       z     = verify(sigA0.23, commitA0.16, pkA.18)
       z.1   = verify(sigB0.24, commitB0.17, pkB.19)
    
