theory CheckFix3b
begin

#include "modelfixb.spthy"

lemma Funding_Spent_Once [reuse]:
  "All ptr #i #j. FundingSpent(ptr) @ #i & FundingSpent(ptr) @ #j ==> #i = #j"

// All-traces form: at most one commitment of a channel ever reaches the chain.
lemma No_Double_Publish:
  "All A B C D ptr n1 n2 s1 s2 #i #j.
      Publish(A, n1, <'commit', ptr, A, B, n1, s1>) @ #i
    & Publish(C, n2, <'commit', ptr, C, D, n2, s2>) @ #j
    ==> #i = #j"

// Sanity: both publishes still reachable after pattern-matching.
lemma Publish_Current_Reachable:
  exists-trace "Ex A n c #i. Publish(A, n, c) @ #i & not (Ex X #c. LtkCompromised(X) @ #c)"
lemma Publish_Pending_Reachable:
  exists-trace "Ex A o n #i. PublishFromPending(A, o, n) @ #i & not (Ex X #c. LtkCompromised(X) @ #c)"

end
