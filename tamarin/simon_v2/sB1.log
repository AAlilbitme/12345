rule (modulo E) Create_State_A:
   [ Fr( ~sA0 ), !Ltk( $A, ltkA ), !A_HandshakeDone( $A, $B, ptr ) ]
  --[ StateCreated( $A, '0', <'commit', ptr, $A, $B, '0', h(~sA0)> ) ]->
   [
   CommittedStateA( $A, $B, ptr, '0', ~sA0,
                    <'commit', ptr, $A, $B, '0', h(~sA0)>,
                    sign(<'commit', ptr, $A, $B, '0', h(~sA0)>, ltkA)
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Create_State_B:
   [ Fr( ~sB0 ), !Ltk( $B, ltkB ), !ProposalCommitted( $A, $B, ptr ) ]
