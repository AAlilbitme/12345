// The Lightning model: channel layer, multi-hop HTLC routing, block clock,
// wormhole attacker, and the restrictions (assumptions).  Included by
// Lightning.spthy; facts and events are explained in Lightning.md.
// (Copied from Simon's model as pasted.  Only change: two annotation events,
//  OfferFor in Sender_Offer_HTLC, marked ADDED.)

builtins: hashing, signing, natural-numbers

rule Register_key:
    [ Fr(~ltk) ]
    --[ KeyGen($A, ~ltk) ]->
    [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)), Out(pk(~ltk)) ]

rule Compromise_Ltk:
    [ !Ltk($A, ltk) ]
    --[ LtkCompromised($A) ]->
    [ Out(ltk), !Compromised($A) ]

rule Acquire_funds:
    [ Fr(~f) ]
    --[ FundsAcquired($A, ~f) ]->
    [ Wallet($A, ~f) ]

rule A_Send_Proposal:
    let proposal = <'proposal', $A, $B, ~ptr>
        sigA     = sign(proposal, ltkA)
    in
    [ Fr(~ptr), !Ltk($A, ltkA) ]
    --[ A_ProposalSent($A, $B, ~ptr) ]->
    [ A_WaitAck($A, $B, ~ptr),
      Out(<'proposal', $A, $B, ~ptr, sigA>) ]

rule B_Recv_Proposal:
    let proposal = <'proposal', $A, $B, ptr>
        sigB     = sign(proposal, ltkB)
    in
    [ !Ltk($B, ltkB), !Pk($A, pkA),
      In(<'proposal', $A, $B, ptr, sigA>) ]
    --[ ProposalExchange($A, $B, ptr),
        Eq(verify(sigA, proposal, pkA), true) ]->
    [ !ProposalCommitted($A, $B, ptr),
      Out(<'proposal_ack', $A, $B, ptr, sigB>) ]

rule A_Recv_From_B:
    let proposal = <'proposal', $A, $B, ptr>
    in
    [ A_WaitAck($A, $B, ptr),
      !Pk($B, pkB),
      In(<'proposal_ack', $A, $B, ptr, sigB>) ]
    --[ A_Received($A, $B, ptr),
        Eq(verify(sigB, proposal, pkB), true) ]->
    [ !A_HandshakeDone($A, $B, ptr) ]

rule Create_State_A:
    let commitA0 = <'commit', ptr, $A, $B, '0', h(~sA0)>
        sigA0    = sign(commitA0, ltkA)
    in
    [ Fr(~sA0), !Ltk($A, ltkA),
      !A_HandshakeDone($A, $B, ptr) ]
    --[ StateCreated($A, '0', commitA0) ]->
    [ CommittedStateA($A, $B, ptr, '0', ~sA0, commitA0, sigA0) ]

rule Create_State_B:
    let commitB0 = <'commit', ptr, $B, $A, '0', h(~sB0)>
        sigB0    = sign(commitB0, ltkB)
    in
    [ Fr(~sB0), !Ltk($B, ltkB),
      !ProposalCommitted($A, $B, ptr) ]
    --[ StateCreated($B, '0', commitB0) ]->
    [ CommittedStateB($A, $B, ptr, '0', ~sB0, commitB0, sigB0) ]

rule Both_States_Committed:
    [ CommittedStateA($A, $B, ptr, '0', sA0, commitA0, sigA0),
      CommittedStateB($A, $B, ptr, '0', sB0, commitB0, sigB0),
      !Pk($A, pkA), !Pk($B, pkB) ]
    --[ Stage1Complete($A, $B, ptr),
        Eq(verify(sigA0, commitA0, pkA), true),
        Eq(verify(sigB0, commitB0, pkB), true) ]->
    [ ReadyToLock($A, $B, ptr, sA0, sB0, commitA0, commitB0) ]

rule Lock_Funds_And_Open:
    [ ReadyToLock($A, $B, ptr, sA0, sB0, commitA0, commitB0),
      Wallet($A, ~fA), Wallet($B, ~fB) ]
    --[ ChannelOpen($A, $B, ptr), FundsLocked($A, $B, ptr),
        NewStateBuilt($A, $B, ptr, '0', ~fA, ~fB) ]->
    [ StateA($A, $B, ptr, '0', sA0, commitA0, ~fA, ~fB),
      StateB($A, $B, ptr, '0', sB0, commitB0, ~fA, ~fB),
      !ValidOnChain(ptr),
      !ChannelRecord(ptr, $A, $B),
      !ChannelConnect(ptr, $A, $B),
      !ChannelConnect(ptr, $B, $A),
      Mutex(ptr),
      FundingUnspent(ptr) ]   // ADDED: the funding output, spent once

rule Update_State:
    let newCommitA = <'commit', ptr, $A, $B, ~n_new, h(~sAnew)>
        newCommitB = <'commit', ptr, $B, $A, ~n_new, h(~sBnew)>
        sigAnew    = sign(newCommitA, ltkA)
        sigBnew    = sign(newCommitB, ltkB)
    in
    [ Fr(~n_new), Fr(~sAnew), Fr(~sBnew),
      !Ltk($A, ltkA), !Ltk($B, ltkB),
      StateA($A, $B, ptr, n_old, sAold, oldCommitA, fA, fB),
      StateB($A, $B, ptr, n_old, sBold, oldCommitB, fA, fB),
      In(<fA_new, fB_new>) ]
    --[ NewStateBuilt($A, $B, ptr, ~n_new, fA_new, fB_new) ]->
    [ PendingA($A, $B, ptr, n_old, sAold, oldCommitA,
               ~n_new, ~sAnew, newCommitA, sigAnew, fA_new, fB_new),
      PendingB($A, $B, ptr, n_old, sBold, oldCommitB,
               ~n_new, ~sBnew, newCommitB, sigBnew, fA_new, fB_new) ]

rule Update_State_HTLC:   // ADDED: channel update for an HTLC operation
    let newCommitA = <'commit', ptr, $A, $B, ~n_new, h(~sAnew)>
        newCommitB = <'commit', ptr, $B, $A, ~n_new, h(~sBnew)>
        sigAnew    = sign(newCommitA, ltkA)
        sigBnew    = sign(newCommitB, ltkB)
    in
    [ Fr(~n_new), Fr(~sAnew), Fr(~sBnew),
      !Ltk($A, ltkA), !Ltk($B, ltkB),
      StateA($A, $B, ptr, n_old, sAold, oldCommitA, fA, fB),
      StateB($A, $B, ptr, n_old, sBold, oldCommitB, fA, fB),
      In(<fA_new, fB_new>), UpdateFor(ptr, op) ]
    --[ NewStateBuilt($A, $B, ptr, ~n_new, fA_new, fB_new),
        ChannelUpdateFor(ptr, op, ~n_new) ]->
    [ PendingA($A, $B, ptr, n_old, sAold, oldCommitA,
               ~n_new, ~sAnew, newCommitA, sigAnew, fA_new, fB_new),
      PendingB($A, $B, ptr, n_old, sBold, oldCommitB,
               ~n_new, ~sBnew, newCommitB, sigBnew, fA_new, fB_new),
      InFlight(ptr, ~n_new, op) ]

rule Revoke_Old_Secret:
    [ PendingA($A, $B, ptr, n_old, sAold, oldCommitA,
               n_new, sAnew, newCommitA, sigAnew, fA_new, fB_new),
      PendingB($A, $B, ptr, n_old, sBold, oldCommitB,
               n_new, sBnew, newCommitB, sigBnew, fA_new, fB_new),
      !Pk($A, pkA), !Pk($B, pkB) ]
    --[ StateUpdate($A, $B, ptr, n_new),
        Revoke($A, n_old, sAold),
        Revoke($B, n_old, sBold),
        Eq(verify(sigAnew, newCommitA, pkA), true),
        Eq(verify(sigBnew, newCommitB, pkB), true) ]->
    [ StateA($A, $B, ptr, n_new, sAnew, newCommitA, fA_new, fB_new),
      StateB($A, $B, ptr, n_new, sBnew, newCommitB, fA_new, fB_new),
      !RevokedSecret($A, n_old, sAold, oldCommitA),
      !RevokedSecret($B, n_old, sBold, oldCommitB),
      RevokedCommitmentUnspent(ptr, $A, $B, n_old, oldCommitA),
      RevokedCommitmentUnspent(ptr, $B, $A, n_old, oldCommitB),
      !UpdateDone(ptr, n_new) ]   // ADDED

rule Publish_Old_Grace_Period_A:
    [ PendingA($A, $B, ptr, n_old, sAold, oldCommitA,
               n_new, sAnew, newCommitA, sigAnew, fA_new, fB_new),
      !ValidOnChain(ptr), FundingUnspent(ptr) ]
    --[ FundingSpent(ptr),   // ADDED
        PublishOldBeforeRevocation($A, n_old),
        PublishState($A, n_old),
        OnChainDelayedProduce($A, n_old),
        OnChainInstantProduce($B, n_old) ]->
    [ OnChainDelayed($A, n_old, oldCommitA),
      OnChainInstant($B, n_old, oldCommitA) ]

rule Publish_Old_Grace_Period_B:
    [ PendingB($A, $B, ptr, n_old, sBold, oldCommitB,
               n_new, sBnew, newCommitB, sigBnew, fA_new, fB_new),
      !ValidOnChain(ptr), FundingUnspent(ptr) ]
    --[ FundingSpent(ptr),   // ADDED
        PublishOldBeforeRevocation($B, n_old),
        PublishState($B, n_old),
        OnChainDelayedProduce($B, n_old),
        OnChainInstantProduce($A, n_old) ]->
    [ OnChainDelayed($B, n_old, oldCommitB),
      OnChainInstant($A, n_old, oldCommitB) ]

rule Publish_Current_A:
    [ StateA($A, $B, ptr, n, sA, <'commit', ptr, $A, $B, n, hA>, fA, fB), !ValidOnChain(ptr), FundingUnspent(ptr) ]
    --[ FundingSpent(ptr),   // ADDED
        Publish($A, n, <'commit', ptr, $A, $B, n, hA>),
        PublishState($A, n),
        OnChainDelayedProduce($A, n),
        OnChainInstantProduce($B, n) ]->
    [ OnChainDelayed($A, n, <'commit', ptr, $A, $B, n, hA>),
      OnChainInstant($B, n, <'commit', ptr, $A, $B, n, hA>) ]

rule Publish_Current_B:
    [ StateB($A, $B, ptr, n, sB, <'commit', ptr, $B, $A, n, hB>, fA, fB), !ValidOnChain(ptr), FundingUnspent(ptr) ]
    --[ FundingSpent(ptr),   // ADDED
        Publish($B, n, <'commit', ptr, $B, $A, n, hB>),
        PublishState($B, n),
        OnChainDelayedProduce($B, n),
        OnChainInstantProduce($A, n) ]->
    [ OnChainDelayed($B, n, <'commit', ptr, $B, $A, n, hB>),
      OnChainInstant($A, n, <'commit', ptr, $B, $A, n, hB>) ]

rule Publish_Pending_A:
    [ PendingA($A, $B, ptr, n_old, sAold, oldCommitA,
               n_new, sAnew, <'commit', ptr, $A, $B, n_new, hA>, sigAnew, fA_new, fB_new),
      !ValidOnChain(ptr), FundingUnspent(ptr) ]
    --[ FundingSpent(ptr),   // ADDED
        Publish($A, n_new, <'commit', ptr, $A, $B, n_new, hA>),
        PublishFromPending($A, n_old, n_new),
        OnChainDelayedProduce($A, n_new),
        OnChainInstantProduce($B, n_new) ]->
    [ OnChainDelayed($A, n_new, <'commit', ptr, $A, $B, n_new, hA>),
      OnChainInstant($B, n_new, <'commit', ptr, $A, $B, n_new, hA>) ]

rule Publish_Pending_B:
    [ PendingB($A, $B, ptr, n_old, sBold, oldCommitB,
               n_new, sBnew, <'commit', ptr, $B, $A, n_new, hB>, sigBnew, fA_new, fB_new),
      !ValidOnChain(ptr), FundingUnspent(ptr) ]
    --[ FundingSpent(ptr),   // ADDED
        Publish($B, n_new, <'commit', ptr, $B, $A, n_new, hB>),
        PublishFromPending($B, n_old, n_new),
        OnChainDelayedProduce($B, n_new),
        OnChainInstantProduce($A, n_new) ]->
    [ OnChainDelayed($B, n_new, <'commit', ptr, $B, $A, n_new, hB>),
      OnChainInstant($A, n_new, <'commit', ptr, $B, $A, n_new, hB>) ]

rule Honest_Close:
    let closetx = <'commit', ptr, $A, $B, n, fA, fB>
        signA   = sign(closetx, ltkA)
        signB   = sign(closetx, ltkB)
    in
    [ StateA($A, $B, ptr, n, sA, commitA, fA, fB),
      StateB($A, $B, ptr, n, sB, commitB, fA, fB),
      !ValidOnChain(ptr), FundingUnspent(ptr),
      !Ltk($A, ltkA), !Ltk($B, ltkB),
      !Pk($A, pkA),   !Pk($B, pkB) ]
    --[ FundingSpent(ptr),   // ADDED
        Close($A, $B, ptr, n),
        OnChainInstantProduce($A, n),
        OnChainInstantProduce($B, n),
        Eq(verify(signA, closetx, pkA), true),
        Eq(verify(signB, closetx, pkB), true) ]->
    [ OnChainInstant($A, n, closetx),
      OnChainInstant($B, n, closetx) ]

rule Publish_Revoked_A:
    [ !ChannelRecord(ptr, $A, $B),
      !ValidOnChain(ptr), FundingUnspent(ptr),
      !RevokedSecret($A, n_old, sAold, oldCommitA)[no_precomp],
      RevokedCommitmentUnspent(ptr, $A, $B, n_old, oldCommitA)[no_precomp],
      Fr(~tx), In(%m) ]
    --[ FundingSpent(ptr),   // ADDED
        PublishRevoked($A, n_old, oldCommitA),
        Cheat($A, n_old),
        CheatMaturity($A, $B, ~tx, %m),
        OnChainDelayedProduce($A, n_old) ]->
    [ OnChainCheat($A, $B, n_old, oldCommitA, ~tx),
      RevealedSecret($A, n_old, sAold, oldCommitA, ~tx),
      RevokedDelayed($A, n_old, oldCommitA, ~tx, %m) ]

rule Publish_Revoked_B:
    [ !ChannelRecord(ptr, $A, $B),
      !ValidOnChain(ptr), FundingUnspent(ptr),
      !RevokedSecret($B, n_old, sBold, oldCommitB)[no_precomp],
      RevokedCommitmentUnspent(ptr, $B, $A, n_old, oldCommitB)[no_precomp],
      Fr(~tx), In(%m) ]
    --[ FundingSpent(ptr),   // ADDED
        PublishRevoked($B, n_old, oldCommitB),
        Cheat($B, n_old),
        CheatMaturity($B, $A, ~tx, %m),
        OnChainDelayedProduce($B, n_old) ]->
    [ OnChainCheat($B, $A, n_old, oldCommitB, ~tx),
      RevealedSecret($B, n_old, sBold, oldCommitB, ~tx),
      RevokedDelayed($B, n_old, oldCommitB, ~tx, %m) ]

rule Punish_A:
    [ OnChainCheat($A, $B, n_old, oldCommitA, tx),
      RevealedSecret($A, n_old, sAold, oldCommitA, tx),
      RevokedDelayed($A, n_old, oldCommitA, tx, %m)[no_precomp] ]
    --[ Punish($B, $A, n_old),
        PunishRevoked($B, $A, tx) ]->
    [ AllFundsTo($B) ]

rule Punish_B:
    [ OnChainCheat($B, $A, n_old, oldCommitB, tx),
      RevealedSecret($B, n_old, sBold, oldCommitB, tx),
      RevokedDelayed($B, n_old, oldCommitB, tx, %m)[no_precomp] ]
    --[ Punish($A, $B, n_old),
        PunishRevoked($A, $B, tx) ]->
    [ AllFundsTo($A) ]

rule Claim_Revoked:
    [ RevokedDelayed(P, n, c, tx, %m)[no_precomp], !Block(%b) ]
    --[ RevokedClaimed(P, tx),
        ClaimFunds(P, n), CSVPassed(P, n), SettledTx(P, c),
        Lt(%m, %b) ]->
    [ FundsTo(P, n) ]

rule Instant_Funds_A:
    [ OnChainInstant($A, n, txContent) ]
    --[ FundsSettled($A, n), SettledTx($A, txContent) ]->
    [ ]

rule Instant_Funds_B:
    [ OnChainInstant($B, n, txContent) ]
    --[ FundsSettled($B, n), SettledTx($B, txContent) ]->
    [ ]

rule Claim_Funds_A:
    [ OnChainDelayed($A, n, txContent) ]
    --[ ClaimFunds($A, n), CSVPassed($A, n), SettledTx($A, txContent) ]->
    [ FundsTo($A, n) ]

rule Claim_Funds_B:
    [ OnChainDelayed($B, n, txContent) ]
    --[ ClaimFunds($B, n), CSVPassed($B, n), SettledTx($B, txContent) ]->
    [ FundsTo($B, n) ]

rule Receiver_Create_Invoice:
    let y = h(~x)
        invoice = <'invoice', $Receiver, $Sender, y, %amt>
        sigR    = sign(invoice, ltkR)
    in
    [ Fr(~x), !Ltk($Receiver, ltkR), In(%amt) ]
    --[ InvoiceCreated($Receiver, $Sender, y),
        InvoiceAmount($Receiver, y, %amt),
        SecretPreimage($Receiver, ~x) ]->
    [ ReceiverInv($Receiver, $Sender, ~x, %amt),
      Out(<'SecretRS', invoice, sigR>) ]

rule Sender_Offer_HTLC:
    let invoice = <'invoice', $Receiver, $Sender, y, %amt>
    in
    [ In(<'SecretRS', invoice, sigR>),
      In(%v1), In(%t),
      !Pk($Receiver, pkR),
      !Ltk($Sender, ltkS),
      !ChannelConnect(ptrSF, $Sender, $Forward1),
      Mutex(ptrSF) ]
    --[ HTLCOffered($Sender, $Forward1, ptrSF, y),
        OfferFor($Sender, $Receiver, ptrSF, y),   // ADDED annotation
        HTLCAdded(ptrSF, y),
        HTLCAmount(ptrSF, y, %v1),
        Lt(%amt, %v1),
        HTLCExpiry(ptrSF, y, %t),
        Neq($Sender, $Forward1),
        Neq($Sender, $Receiver),
        Neq($Forward1, $Receiver),
        Eq(verify(sigR, invoice, pkR), true) ]->
    [ SenderPending($Sender, $Forward1, $Receiver, ptrSF, y, %t),
      AwaitRoute($Sender, $Forward1, ptrSF, y, %v1, %t), UpdateFor(ptrSF, <'add', y>),   // CHANGED
      !RouteInfo($Sender, $Forward1, ptrSF, y) ]

rule Forward_HTLC:
    [ Route($Prev, $Me, ptrIn, y, %vIn, %tIn),
      !ChannelConnect(ptrOut, $Me, $Next),
      Mutex(ptrOut),
      In(%vOut), In(%tOut) ]
    --[ HTLCForwarded($Me, $Prev, $Next, ptrIn, ptrOut, y),
        HTLCAdded(ptrOut, y),
        HTLCAmount(ptrOut, y, %vOut),
        ForwardAmounts(ptrIn, ptrOut, y, %vIn, %vOut),
        HTLCExpiry(ptrOut, y, %tOut),
        ForwardExpiries(ptrIn, ptrOut, y, %tIn, %tOut),
        Lt(%tOut, %tIn),
        FeeCharged($Me, y, %vIn, %vOut),
        Lt(%vOut, %vIn),
        Neq(ptrIn, ptrOut), Neq($Prev, $Me), Neq($Me, $Next) ]->
    [ IntermediaryPending($Me, $Prev, $Next, ptrIn, ptrOut, y, %vIn, %vOut, %tOut),
      AwaitRoute($Me, $Next, ptrOut, y, %vOut, %tOut), UpdateFor(ptrOut, <'add', y>),   // CHANGED
      !RouteInfo($Me, $Next, ptrOut, y) ]

rule Receiver_Fulfill_HTLC:
    [ Route($Prev, $Receiver, ptrIn, y, %v, %t),
      ReceiverInv($Receiver, $Sender, x, %amt) ]
    --[ HTLCFulfilled($Receiver, $Prev, ptrIn, y),
        ReceiverPaid($Receiver, y, %v),
        Eq(%v, %amt),
        PreimageReleased($Receiver, x),
        Redeemed(ptrIn, y),
        Old(ptrIn, y),
        Eq(h(x), y),
        FulfilledMade(ptrIn, x) ]->
    [ AwaitFulfilled(ptrIn, x), UpdateFor(ptrIn, <'settle', h(x)>) ]   // CHANGED

rule Intermediary_Settle:
    [ IntermediaryPending($Me, $Prev, $Next, ptrIn, ptrOut, y, %vIn, %vOut, %tOut),
      Fulfilled(ptrOut, x) ]
    --[ IntermediaryClaimed($Me, $Prev, ptrIn, x),
        FeeEarned($Me, ptrIn, ptrOut, y, %vIn, %vOut),
        Redeemed(ptrIn, y),
        Old(ptrIn, y),
        FulfilledProduced(ptrIn, x),
        Eq(h(x), y),
        PendingUsed($Me, ptrIn, ptrOut, y),
        FulfilledUsed(ptrOut, x), FulfilledMade(ptrIn, x) ]->
    [ AwaitFulfilled(ptrIn, x), UpdateFor(ptrIn, <'settle', h(x)>) ]   // CHANGED

rule Sender_Settle:
    [ SenderPending($Sender, $Forward1, $Receiver, ptrSF, y, %t),
      Fulfilled(ptrSF, x) ]
    --[ SenderSettled($Sender, $Forward1, $Receiver, ptrSF, x),
        Eq(h(x), y),
        FulfilledUsed(ptrSF, x) ]->
    [ ]

// ADDED: an HTLC operation takes effect only once its channel update is
// complete (new state signed, old state revoked).
rule Commit_HTLC_Update:
    [ InFlight(ptr, n, op), !UpdateDone(ptr, n) ]
    --[ HTLCCommitted(ptr, op, n) ]->
    [ Committed(ptr, op) ]

rule Add_Committed:
    [ AwaitRoute(P, N, ptr, y, %v, %t), Committed(ptr, <'add', y>) ]
    --> [ Route(P, N, ptr, y, %v, %t) ]

rule Settle_Committed:
    [ AwaitFulfilled(ptr, x), Committed(ptr, <'settle', h(x)>) ]
    --> [ Fulfilled(ptr, x), Mutex(ptr) ]

rule Fail_Committed:
    [ Committed(ptr, <'fail', y>) ]
    --> [ Mutex(ptr) ]

rule Clock_Tick:
    [ In(%t) ] --[ Tick(%t) ]-> [ !Block(%t) ]

rule Sender_Timeout_Refund:
    [ SenderPending($Sender, $Forward1, $Receiver, ptrSF, y, %t), !Block(%b) ]
    --[ Refunded($Sender, ptrSF, y),
        Lt(%t, %b),
        Old(ptrSF, y) ]->
    [ UpdateFor(ptrSF, <'fail', y>) ]   // CHANGED

rule Intermediary_Timeout_Refund:
    [ IntermediaryPending($Me, $Prev, $Next, ptrIn, ptrOut, y, %vIn, %vOut, %tOut),
      !Block(%b) ]
    --[ Refunded($Me, ptrOut, y),
        Lt(%tOut, %b),
        Old(ptrOut, y),
        PendingUsed($Me, ptrIn, ptrOut, y) ]->
    [ UpdateFor(ptrOut, <'fail', y>) ]   // CHANGED

rule AttackerSkip:
    [ Fulfilled(ptrExit, x),
      !RouteInfo(ExitAtt, Next, ptrExit, y)[-,no_precomp],
      !RouteInfo(EntryAtt, Skipped, ptrSkip, y)[-,no_precomp],
      !Compromised(ExitAtt),
      !Compromised(EntryAtt) ]
    --[ FulfilledProduced(ptrSkip, x),
        Eq(h(x), y),
        FulfilledUsed(ptrExit, x), FulfilledMade(ptrSkip, x) ]->
    [ Fulfilled(ptrSkip, x) ]

restriction OneResolutionPerHTLC:
    "All ptr y #i #j. Old(ptr, y) @ #i & Old(ptr, y) @ #j ==> #i = #j"

restriction OneHTLCPerHashPerChannel:
    "All ptr y #m #n. HTLCAdded(ptr, y) @ #m & HTLCAdded(ptr, y) @ #n ==> #m = #n"

restriction Inequality:
    "All x y #i. Neq(x, y) @ #i ==> not(x = y)"

restriction Equality:
    "All x y #i. Eq(x, y) @ #i ==> x = y"

restriction TickOnce:
    "All %t #i #j. Tick(%t) @ #i & Tick(%t) @ #j ==> #i = #j"

restriction TicksInOrder:
    "All %s %t #i #j. Tick(%s) @ #i & Tick(%t) @ #j & %s << %t ==> #i < #j"

restriction ExpiryBlockReached:
    "All ptr y %s %b #a #k.
        HTLCExpiry(ptr, y, %s) @ #a & Tick(%b) @ #k & %s << %b
     ==> Ex #i. Tick(%s) @ #i & #i < #k"

restriction LessThan:
    "All a b #i. Lt(a, b) @ #i ==> a << b"

restriction OneChannelPerPtr:
    "All A B C D ptr #i #j.
       ChannelOpen(A, B, ptr) @ #i
     & ChannelOpen(C, D, ptr) @ #j
     ==> #i = #j"

restriction HonestForwardBeforeExpiry:
    "All P Prev Next pin pout y %tIn %tOut %b #f #e #k.
        HTLCForwarded(P, Prev, Next, pin, pout, y) @ #f
      & ForwardExpiries(pin, pout, y, %tIn, %tOut) @ #e
      & Tick(%b) @ #k & %tIn << %b & #k < #f
     ==> Ex #c. LtkCompromised(P) @ #c & #c < #f"

restriction CheatMaturityInFuture:
    "All P Q tx %m %b #c #k.
        CheatMaturity(P, Q, tx, %m) @ #c & Tick(%b) @ #k & (%b = %m | %m << %b)
     ==> #c < #k"

#ifdef LIVENESS

restriction PunishmentLiveness:
    "All P Q tx %m %b #c #k.
        CheatMaturity(P, Q, tx, %m) @ #c
      & Tick(%b) @ #k & %m << %b
      & not (Ex #x. LtkCompromised(Q) @ #x & #x < #k)
     ==> Ex #l. PunishRevoked(Q, P, tx) @ #l & #l < #k"

restriction ForwarderCollectsInTime:
    "All P Prev Next pin pout y %tIn %tOut %b #f #e #i #k.
        HTLCForwarded(P, Prev, Next, pin, pout, y) @ #f
      & ForwardExpiries(pin, pout, y, %tIn, %tOut) @ #e
      & Redeemed(pout, y) @ #i & #i < #k
      & Tick(%b) @ #k & %tIn << %b & #f < #k
      & not (Ex #c. LtkCompromised(P) @ #c & #c < #k)
     ==> Ex #l. Redeemed(pin, y) @ #l & #l < #k"

restriction ForwarderRefundsInTime:
    "All P Prev Next pin pout y %tIn %tOut %b #f #e #k.
        HTLCForwarded(P, Prev, Next, pin, pout, y) @ #f
      & ForwardExpiries(pin, pout, y, %tIn, %tOut) @ #e
      & Tick(%b) @ #k & %tIn << %b & #f < #k
      & not (Ex #c. LtkCompromised(P) @ #c & #c < #k)
      & not (Ex #i. Redeemed(pout, y) @ #i & #i < #k)
     ==> Ex #r. Refunded(P, pout, y) @ #r & #r < #k"

#endif
