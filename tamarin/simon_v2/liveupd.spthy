theory LiveUpd
begin

#include "modelupd.spthy"

// What follows from the two fairness assumptions: by the time the incoming
// HTLC of an honest forwarder has expired, either both its settles are
// committed (downstream and upstream) or its outgoing HTLC has been failed.
lemma Forwarder_Outcome_Committed:
  "All P Prev Next pin pout y %tIn %tOut %b #f #e #k.
      HTLCForwarded(P, Prev, Next, pin, pout, y) @ #f
    & ForwardExpiries(pin, pout, y, %tIn, %tOut) @ #e
    & Tick(%b) @ #k & %tIn << %b & #f < #k
    & not (Ex #c. LtkCompromised(P) @ #c & #c < #k)
   ==> (Ex nOut nIn #i #l. HTLCCommitted(pout, <'settle', y>, nOut) @ #i & #i < #k
                         & HTLCCommitted(pin, <'settle', y>, nIn) @ #l & #l < #k)
     | (Ex nF #r. HTLCCommitted(pout, <'fail', y>, nF) @ #r & #r < #k)"

// Witness: assumptions and timing jointly satisfiable. A full payment where
// every operation is committed before any tick, then the clock passes the
// incoming expiry.
lemma Liveness_Witness:
  exists-trace
  "Ex S F R p0 p1 x n0 n1 n2 n3 a0 b0 a1 b1 s0 t0 s1 t1 s2 t2 s3 t3
      %tIn %tOut %b #e #k #o0 #o1 #o #u0 #r0 #c0 #f #u1 #r1 #c1 #fu #u2 #r2 #c2 #cl #u3 #r3 #c3 #s.
      ChannelOpen(a0, b0, p0) @ #o0
    & ChannelOpen(a1, b1, p1) @ #o1
    & HTLCOffered(S, F, p0, h(x)) @ #o
    & ChannelUpdateFor(p0, <'add', h(x)>, n0) @ #u0
    & StateUpdate(s0, t0, p0, n0) @ #r0
    & HTLCCommitted(p0, <'add', h(x)>, n0) @ #c0
    & HTLCForwarded(F, S, R, p0, p1, h(x)) @ #f
    & ChannelUpdateFor(p1, <'add', h(x)>, n1) @ #u1
    & StateUpdate(s1, t1, p1, n1) @ #r1
    & HTLCCommitted(p1, <'add', h(x)>, n1) @ #c1
    & HTLCFulfilled(R, F, p1, h(x)) @ #fu
    & ChannelUpdateFor(p1, <'settle', h(x)>, n2) @ #u2
    & StateUpdate(s2, t2, p1, n2) @ #r2
    & HTLCCommitted(p1, <'settle', h(x)>, n2) @ #c2
    & IntermediaryClaimed(F, S, p0, x) @ #cl
    & ChannelUpdateFor(p0, <'settle', h(x)>, n3) @ #u3
    & StateUpdate(s3, t3, p0, n3) @ #r3
    & HTLCCommitted(p0, <'settle', h(x)>, n3) @ #c3
    & SenderSettled(S, F, R, p0, x) @ #s
    & ForwardExpiries(p0, p1, h(x), %tIn, %tOut) @ #e
    & Tick(%b) @ #k & %tIn << %b & #s < #k
    & #o0 < #o & #o1 < #o & #o < #u0 & #u0 < #r0 & #r0 < #c0 & #c0 < #f
    & #f < #u1 & #u1 < #r1 & #r1 < #c1 & #c1 < #fu
    & #fu < #u2 & #u2 < #r2 & #r2 < #c2 & #c2 < #cl
    & #cl < #u3 & #u3 < #r3 & #r3 < #c3 & #c3 < #s
    & (All a b p #i. ChannelOpen(a, b, p) @ #i ==> (#i = #o0 | #i = #o1))
    & (All a b p m #i. StateUpdate(a, b, p, m) @ #i ==> (#i = #r0 | #i = #r1 | #i = #r2 | #i = #r3))
    & (All p op m #i. ChannelUpdateFor(p, op, m) @ #i ==> (#i = #u0 | #i = #u1 | #i = #u2 | #i = #u3))
    & (All p op m #i. HTLCCommitted(p, op, m) @ #i ==> (#i = #c0 | #i = #c1 | #i = #c2 | #i = #c3))
    & (All p #i. MutexReleased(p) @ #i ==> #c2 < #i)
    & (All p z #i. Old(p, z) @ #i ==> z = h(x))
    & not (Ex X #k. LtkCompromised(X) @ #k)
    & not (Ex P p z #i. Refunded(P, p, z) @ #i)
    & (All t #i. Tick(t) @ #i ==> #c3 < #i)"

end
