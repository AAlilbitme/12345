  --[
  ProposalExchange( $A, $B, ptr ),
  Eq( verify(sigA, <'proposal', $A, $B, ptr>, pkA), true )
  ]->
   [
   !ProposalCommitted( $A, $B, ptr ),
   Out( <'proposal_ack', $A, $B, ptr, sign(<'proposal', $A, $B, ptr>, ltkB)>
   )
   ]

