// All-traces lemmas (copied from Simon's lemmas.spthy).  At the end: two ADDED
// lemmas for the tagged invoice.

lemma ForwardTimeGap [reuse]:
    "All pin pout y %tin %tout #f.
        ForwardExpiries(pin, pout, y, %tin, %tout) @ #f
     ==> %tout << %tin"

lemma state_update [use_induction]:
    "All A B ptr n #i.
       StateUpdate(A, B, ptr, n) @ #i
     ==> Ex #j. ChannelOpen(A, B, ptr) @ #j & #j < #i"

lemma delayed_funds:
    "All A n #i.
       ClaimFunds(A, n) @ #i
     ==> Ex #j. OnChainDelayedProduce(A, n) @ #j & #j < #i"

lemma instant_funds:
    "All A n #i.
       FundsSettled(A, n) @ #i
     ==> Ex #j. OnChainInstantProduce(A, n) @ #j & #j < #i"

lemma settlement_is_traceable:
    "All A n #i.
       FundsSettled(A, n) @ #i
     ==> Ex tx #j. SettledTx(A, tx) @ #j & #j = #i"

lemma No_Punishment_Without_Cheating:
    "All A B n #i.
        Punish(B, A, n) @ #i
     ==> (Ex #k. Cheat(A, n) @ #k & #k < #i)
       | (Ex #j. LtkCompromised(A) @ #j & #j < #i)"

#ifdef LIVENESS
lemma Cheating_Never_Pays [heuristic={cheat_race}]:
    "All P Q tx %m #c #j.
        CheatMaturity(P, Q, tx, %m) @ #c
      & RevokedClaimed(P, tx) @ #j
     ==> Ex #x. LtkCompromised(Q) @ #x & #x < #j"
#endif

lemma Funds_Locked_Before_Update [use_induction]:
    "All A B ptr n #i.
       StateUpdate(A, B, ptr, n) @ #i
     ==> Ex #j. FundsLocked(A, B, ptr) @ #j & #j < #i"

lemma Update_Requires_Negotiation [use_induction]:
    "All A B ptr n #i.
         StateUpdate(A, B, ptr, n) @ #i
     ==> Ex fA fB #j. NewStateBuilt(A, B, ptr, n, fA, fB) @ #j & #j < #i"

lemma OneOutcomePerHTLC [reuse]:
    "All Up ptr y #i #j.
       Redeemed(ptr, y) @ #i & Refunded(Up, ptr, y) @ #j ==> F"

lemma Ltk_Known_Implies_Compromised [reuse]:
    "All A ltk #i #j.
        KeyGen(A, ltk) @ #i
      & !KU(ltk) @ #j
     ==> Ex #k. LtkCompromised(A) @ #k"

lemma Invoice_Released_Once [reuse]:
    "All R x #i #j.
        PreimageReleased(R, x) @ #i
      & PreimageReleased(R, x) @ #j
     ==> #i = #j"

lemma Preimage_Secret_Until_Released:
    "All R x #i #j.
        SecretPreimage(R, x) @ #i
      & K(x) @ #j
      & #i < #j
     ==> Ex #k. PreimageReleased(R, x) @ #k & #k < #j"

lemma Invoice_Has_Secret_Preimage [reuse]:
    "All R S x #i.
        InvoiceCreated(R, S, h(x)) @ #i
     ==> SecretPreimage(R, x) @ #i"

lemma HTLC_On_Opened_Channel [reuse, use_induction]:
    "All ptr y #i.
        HTLCAdded(ptr, y) @ #i
     ==> Ex X Y #j. ChannelOpen(X, Y, ptr) @ #j & #j < #i"

lemma Fulfilled_Requires_Release [reuse, use_induction, heuristic={fulfilled_back}]: // add: was heuristic=S
    "All ptr x #i.
        FulfilledProduced(ptr, x) @ #i
     ==> Ex R #k. PreimageReleased(R, x) @ #k & #k < #i"

lemma Settle_Requires_Receiver_Release [heuristic={upd_preimage}]: // add: was sender_preimage
    "All S F1 R ptr x #i #j.
        SenderSettled(S, F1, R, ptr, x) @ #i
      & InvoiceCreated(R, S, h(x)) @ #j
     ==> Ex #k. PreimageReleased(R, x) @ #k & #k < #i"

lemma Claim_Requires_Release [use_induction]:
    "All MidP InP ptrIn R x #i #j.
        IntermediaryClaimed(MidP, InP, ptrIn, x) @ #i
      & SecretPreimage(R, x) @ #j
     ==> Ex #k. PreimageReleased(R, x) @ #k & #k < #i"

lemma Forward_Requires_Incoming [use_induction, heuristic={upd_route}]: // add: heuristic
    "All Me Prev Next ptrIn ptrOut y #i.
        HTLCForwarded(Me, Prev, Next, ptrIn, ptrOut, y) @ #i
     ==> (Ex S #j. HTLCOffered(S, Me, ptrIn, y) @ #j & #j < #i)
       | (Ex P0 pin0 #j. HTLCForwarded(Prev, P0, Me, pin0, ptrIn, y) @ #j & #j < #i)"

lemma Redeem_Requires_Receiver_Release [use_induction]:
    "All ptr y #i.
        Redeemed(ptr, y) @ #i
     ==> Ex R x #k. PreimageReleased(R, x) @ #k & h(x) = y"

lemma Settle_Excludes_Sender_Refund [heuristic={sender_pending}]:
    "All S F1 R ptr x #i.
        SenderSettled(S, F1, R, ptr, x) @ #i
     ==> not (Ex #j. Refunded(S, ptr, h(x)) @ #j)"

lemma Invoice_Authenticates_Settlement [heuristic={invoice_signature}]:
    "All S F1 R ptr x #i.
        SenderSettled(S, F1, R, ptr, x) @ #i
     ==> (Ex #j. InvoiceCreated(R, S, h(x)) @ #j & #j < #i)
       | (Ex #r. LtkCompromised(R) @ #r & #r < #i)"

lemma Loss_Requires_Inaction:
    "All P Prev Next Up ptrIn ptrOut y #i #j #k.
        HTLCForwarded(P, Prev, Next, ptrIn, ptrOut, y) @ #i
      & Redeemed(ptrOut, y) @ #j
      & Refunded(Up, ptrIn, y) @ #k
     ==> not (Ex #l. Redeemed(ptrIn, y) @ #l)"

lemma Refund_Requires_Timeout [reuse]:
    "All Up ptr y #i.
        Refunded(Up, ptr, y) @ #i
     ==> Ex %t %b #a #k. HTLCExpiry(ptr, y, %t) @ #a & Tick(%b) @ #k & %t << %b & #k < #i"

lemma Expiry_Unique [reuse, heuristic={expiry_first}]:
    "All ptr y %t1 %t2 #i #j.
        HTLCExpiry(ptr, y, %t1) @ #i & HTLCExpiry(ptr, y, %t2) @ #j
     ==> %t1 = %t2"

lemma Forward_Expiry_From_Upstream [reuse, heuristic={route_first}]:
    "All pin pout y %tin %tout #f.
        ForwardExpiries(pin, pout, y, %tin, %tout) @ #f
     ==> Ex #a. HTLCExpiry(pin, y, %tin)[-] @ #a & #a < #f"

#ifdef LIVENESS
lemma Intermediary_Never_Loses_Under_Liveness:
    "All P Prev Next Up ptrIn ptrOut y #i #j #k.
        HTLCForwarded(P, Prev, Next, ptrIn, ptrOut, y) @ #i
      & Redeemed(ptrOut, y) @ #j
      & Refunded(Up, ptrIn, y) @ #k
     ==> Ex #l. LtkCompromised(P) @ #l"

lemma Payment_Atomicity_Under_Liveness:
    "All F1 F2 Prev1 Next1 Prev2 Next2 ptrSF1 ptrF1F2 ptrF2R y #i #j #k.
        HTLCForwarded(F1, Prev1, Next1, ptrSF1, ptrF1F2, y) @ #i
      & HTLCForwarded(F2, Prev2, Next2, ptrF1F2, ptrF2R, y) @ #j
      & Redeemed(ptrF2R, y) @ #k
      & (not Ex P #l. LtkCompromised(P) @ #l)
     ==> not (Ex Up #m. Refunded(Up, ptrSF1, y) @ #m)"

lemma Timeout_Race_Blocked:
    "not (Ex P Prev Next Up ptrIn ptrOut y %tIn %tOut %b #l #e #i #j #k.
        HTLCForwarded(P, Prev, Next, ptrIn, ptrOut, y) @ #l
      & ForwardExpiries(ptrIn, ptrOut, y, %tIn, %tOut) @ #e
      & Tick(%b) @ #k & %tIn << %b & #l < #k
      & Refunded(Up, ptrIn, y)  @ #j
      & Redeemed(ptrOut, y) @ #i
      & #k < #i
      & not (Ex #c. LtkCompromised(P) @ #c & #c < #k))"
#endif

lemma Hop_Forwarded_Once [reuse, heuristic={upd_route}]: // add: was route_first
    "All D Pv Nx D2 Pv2 Nx2 pin pout pout2 y #f #g.
        HTLCForwarded(D, Pv, Nx, pin, pout, y) @ #f
      & HTLCForwarded(D2, Pv2, Nx2, pin, pout2, y) @ #g
     ==> #f = #g"

lemma Forward_Excludes_Fulfill [reuse, heuristic={upd_route}]: // add: was route_first
    "All D Pv Nx pin pout y R PrevR #f #r.
        HTLCForwarded(D, Pv, Nx, pin, pout, y) @ #f
      & HTLCFulfilled(R, PrevR, pin, y) @ #r
     ==> F"

lemma Fee_Requires_Forward [reuse]:
    "All Me pin pout y %vin %vout #i.
        FeeEarned(Me, pin, pout, y, %vin, %vout) @ #i
     ==> Ex Prev Next #f. HTLCForwarded(Me, Prev, Next, pin, pout, y) @ #f & #f < #i"

lemma Settle_Requires_Outgoing_Redeemed [reuse, heuristic={settle_honest}]:
    "All Me pin pout y %vin %vout #i.
        FeeEarned(Me, pin, pout, y, %vin, %vout) @ #i
      & not (Ex #c. LtkCompromised(Me) @ #c & #c < #i)
     ==> Ex #j. Redeemed(pout, y) @ #j & #j < #i"

lemma Fee_Only_On_Successful_Forward:
    "All Me ptrIn ptrOut y %vin %vout #i.
        FeeEarned(Me, ptrIn, ptrOut, y, %vin, %vout) @ #i
      & not (Ex #c. LtkCompromised(Me) @ #c)
     ==> (Ex #j. Redeemed(ptrOut, y) @ #j & #j < #i)
       & (Ex Prev Next #f. HTLCForwarded(Me, Prev, Next, ptrIn, ptrOut, y) @ #f & #f < #i)"

lemma Claim_Excludes_Refund [reuse, heuristic={pending_once}]:
    "All P Prev Next pin pout y #f #r #u.
        HTLCForwarded(P, Prev, Next, pin, pout, y) @ #f
      & Redeemed(pin, y) @ #r
      & Refunded(P, pout, y) @ #u
     ==> F"

#ifdef LIVENESS
lemma Forwarder_Claims_In_Time:
    "All P Prev Next pin pout y %tIn %tOut %b #f #e #i #k.
        HTLCForwarded(P, Prev, Next, pin, pout, y) @ #f
      & ForwardExpiries(pin, pout, y, %tIn, %tOut) @ #e
      & Redeemed(pout, y) @ #i
      & Tick(%b) @ #k & %tIn << %b & #f < #k
      & not (Ex #c. LtkCompromised(P) @ #c & #c < #k)
     ==> Ex #l. Redeemed(pin, y) @ #l & #l < #k"

lemma Forwarder_Refunds_In_Time [heuristic={forwarder_resolution}]:
    "All P Prev Next pin pout y %tIn %tOut %b #f #e #k.
        HTLCForwarded(P, Prev, Next, pin, pout, y) @ #f
      & ForwardExpiries(pin, pout, y, %tIn, %tOut) @ #e
      & Tick(%b) @ #k & %tIn << %b & #f < #k
      & not (Ex #c. LtkCompromised(P) @ #c & #c < #k)
      & not (Ex #i. Redeemed(pout, y) @ #i & #i < #k)
     ==> Ex #r. Refunded(P, pout, y) @ #r & #r < #k"

lemma Intermediary_Recovers_Funds [heuristic={forwarder_resolution}]:
    "All P Prev Next pin pout y %vin %vout %tin %tout %b #f #a #e #k.
        HTLCForwarded(P, Prev, Next, pin, pout, y) @ #f
      & ForwardAmounts(pin, pout, y, %vin, %vout) @ #a
      & ForwardExpiries(pin, pout, y, %tin, %tout) @ #e
      & Tick(%b) @ #k & %tin << %b & #f < #k
      & not (Ex #c. LtkCompromised(P) @ #c & #c < #k)
     ==> (Ex #l #j. FeeEarned(P, pin, pout, y, %vin, %vout) @ #l & #l < #k
            & Redeemed(pout, y) @ #j)
       | (Ex #r. Refunded(P, pout, y) @ #r & #r < #k
            & not (Ex #l. Redeemed(pin, y) @ #l))"
#endif

lemma Redeem_Excludes_Refund:
    "All P Prev Next pin pout y #f #r #u.
        HTLCForwarded(P, Prev, Next, pin, pout, y) @ #f
      & Redeemed(pin, y) @ #r
      & Refunded(P, pout, y) @ #u
      & not (Ex #c. LtkCompromised(P) @ #c)
     ==> F"

lemma Receiver_Paid_Invoice_Amount:
    "All R y %v #i.
        ReceiverPaid(R, y, %v) @ #i
     ==> Ex #j. InvoiceAmount(R, y, %v) @ #j & #j < #i"

lemma Forward_Amount_From_Upstream [reuse, heuristic={route_first}]:
    "All pin pout y %vin %vout #f.
        ForwardAmounts(pin, pout, y, %vin, %vout) @ #f
     ==> Ex #a. HTLCAmount(pin, y, %vin) @ #a & #a < #f"

lemma Amount_Decreases_Along_Route [reuse, use_induction]:
    "All b y %vb #i.
        HTLCAmount(b, y, %vb) @ #i
     ==> (Ex S F1 #o. HTLCOffered(S, F1, b, y) @ #o & #o = #i)
       | (Ex S F1 p1 %v1 #o. HTLCOffered(S, F1, p1, y) @ #o
            & HTLCAmount(p1, y, %v1) @ #o & %vb << %v1 & #o < #i)"

lemma Receiver_Paid_At_Most_Offered: // add: uses Paid_Has_Amount
    "All R y %vR #r.
        ReceiverPaid(R, y, %vR) @ #r
     ==> Ex S F1 p1 %v1 #o. HTLCOffered(S, F1, p1, y) @ #o
           & HTLCAmount(p1, y, %v1) @ #o & (%vR << %v1 | %vR = %v1) & #o < #r"

lemma Fee_Is_Amount_Difference [heuristic={fee_source}]:
    "All Me pin pout y %vin %vout #i.
        FeeEarned(Me, pin, pout, y, %vin, %vout) @ #i
     ==> Ex #f #a. ForwardAmounts(pin, pout, y, %vin, %vout) @ #f
           & HTLCAmount(pin, y, %vin) @ #a & %vout << %vin"

lemma Sender_Pays_Invoice_Plus_Fees [heuristic={sender_amount}]:
    "All S F1 R p1 x %v1 #s #o.
        SenderSettled(S, F1, R, p1, x) @ #s
      & HTLCAmount(p1, h(x), %v1) @ #o
      & not (Ex #c. LtkCompromised(R) @ #c)
     ==> Ex %amt #r #j. ReceiverPaid(R, h(x), %amt) @ #r
           & InvoiceAmount(R, h(x), %amt) @ #j & %amt << %v1"

lemma Offer_Precedes_Forwards [reuse, use_induction, heuristic={chain_walk}]:
    "All D Pv Nx pin pout y #f.
        HTLCForwarded(D, Pv, Nx, pin, pout, y) @ #f
     ==> Ex S F1 p1 #o. HTLCOffered(S, F1, p1, y) @ #o & #o < #f"

lemma Expiry_Below_First_Hop [use_induction, heuristic={chain_walk}]:
    "All S F1 p1 y %t1 pin pout %tin %tout #o #e #f.
        HTLCOffered(S, F1, p1, y) @ #o & HTLCExpiry(p1, y, %t1) @ #e
      & ForwardExpiries(pin, pout, y, %tin, %tout) @ #f
      & not (Ex S2 F2 p2 #o2. HTLCOffered(S2, F2, p2, y) @ #o2 & not (#o2 = #o))
     ==> %tout << %t1"

#ifdef LIVENESS
#else

lemma Redeem_Reveals [reuse]:
    "All ptr y #i.
        Redeemed(ptr, y) @ #i
     ==> Ex x. FulfilledMade(ptr, x) @ #i & h(x) = y"

lemma Outgoing_Preimage_Kept [reuse, heuristic={preimage_user}]:
    "All P Prev Next pin pout y x #f #u.
        HTLCForwarded(P, Prev, Next, pin, pout, y) @ #f
      & FulfilledUsed(pout, x) @ #u & h(x) = y
     ==> (Ex #l. Redeemed(pin, y) @ #l & #l = #u)
       | (Ex #c. LtkCompromised(P) @ #c & #c < #u)"

lemma Incoming_Resolved_By_Claim_Or_Timeout [reuse, heuristic={incoming_resolution}]:
    "All P Prev Next pin pout y %tIn %tOut #f #e #o.
        HTLCForwarded(P, Prev, Next, pin, pout, y) @ #f
      & ForwardExpiries(pin, pout, y, %tIn, %tOut) @ #e
      & Old(pin, y) @ #o
     ==> (Ex #l. Redeemed(pin, y) @ #l & #l = #o)
       | (Ex %b #k. Tick(%b) @ #k & %tIn << %b & #k < #o)"

lemma Refund_Enabled [heuristic={enabledness}]:
    "All P Prev Next pin pout y %tIn %tOut %b #f #e #k.
        HTLCForwarded(P, Prev, Next, pin, pout, y) @ #f
      & ForwardExpiries(pin, pout, y, %tIn, %tOut) @ #e
      & Tick(%b) @ #k & %tIn << %b & #f < #k
      & not (Ex #c. LtkCompromised(P) @ #c & #c < #k)
      & not (Ex #i. Redeemed(pout, y) @ #i & #i < #k)
      & not (Ex #r. Refunded(P, pout, y) @ #r & #r < #k)
     ==> not (Ex #u. PendingUsed(P, pin, pout, y) @ #u & #u < #k)
       & (Ex %b2 #t. Tick(%b2) @ #t & #t < #k & %tOut << %b2)
       & not (Ex #o. Old(pout, y) @ #o & #o < #k)"

lemma Collect_Enabled [heuristic={collect_enabled}]:
    "All P Prev Next pin pout y %tIn %tOut %b #f #e #i #k.
        HTLCForwarded(P, Prev, Next, pin, pout, y) @ #f
      & ForwardExpiries(pin, pout, y, %tIn, %tOut) @ #e
      & Redeemed(pout, y) @ #i & #i < #k
      & Tick(%b) @ #k & %tIn << %b & #f < #k
      & not (Ex %b0 #k0. Tick(%b0) @ #k0 & %tIn << %b0 & #k0 < #k)
      & not (Ex #c. LtkCompromised(P) @ #c & #c < #k)
      & not (Ex #l. Redeemed(pin, y) @ #l & #l < #k)
     ==> not (Ex #u. PendingUsed(P, pin, pout, y) @ #u & #u < #k)
       & (Ex x #m. FulfilledMade(pout, x) @ #m & #m < #k & h(x) = y
            & not (Ex #u. FulfilledUsed(pout, x) @ #u & #u < #k))
       & not (Ex #o. Old(pin, y) @ #o & #o < #k)"

lemma Punish_Enabled [heuristic={enabledness}]:
    "All P Q tx %m %b #c #k.
        CheatMaturity(P, Q, tx, %m) @ #c
      & Tick(%b) @ #k & %m << %b
      & not (Ex %b0 #k0. Tick(%b0) @ #k0 & %m << %b0 & #k0 < #k)
      & not (Ex #x. LtkCompromised(Q) @ #x & #x < #k)
      & not (Ex #l. PunishRevoked(Q, P, tx) @ #l & #l < #k)
     ==> #c < #k
       & not (Ex #j. RevokedClaimed(P, tx) @ #j & #j < #k)"

#endif

// ---------------------------------------------------------------------------
// ADDED (tagged invoice): offers are authenticated by the receiver's invoice.
// In the untagged model Offer_Requires_Invoice is falsified (a channel-proposal
// signature is accepted as an invoice).
// ---------------------------------------------------------------------------

lemma Invoice_Signature_Origin [reuse, heuristic={offer_invoice}]:
    "All R S y a ltk #i #k.
        !KU(sign(<'invoice', R, S, y, a>, ltk)) @ #i
      & KeyGen(R, ltk) @ #k
     ==> (Ex #j. InvoiceCreated(R, S, y) @ #j & #j < #i)
       | (Ex #r. LtkCompromised(R) @ #r)"

lemma Offer_Requires_Invoice [heuristic={offer_invoice}]:
    "All S R ptr y #o.
        OfferFor(S, R, ptr, y) @ #o
     ==> (Ex #j. InvoiceCreated(R, S, y) @ #j & #j < #o)
       | (Ex #r. LtkCompromised(R) @ #r)"

// ADDED: the funding output of a channel is spent at most once (linear FundingUnspent).
lemma Funding_Spent_Once [reuse]:
    "All ptr #i #j. FundingSpent(ptr) @ #i & FundingSpent(ptr) @ #j ==> #i = #j"

// ADDED: at most one commitment of a channel ever reaches the chain (needs modelfixb).
lemma No_Double_Publish:
    "All A B C D ptr n1 n2 s1 s2 #i #j.
        Publish(A, n1, <'commit', ptr, A, B, n1, s1>) @ #i
      & Publish(C, n2, <'commit', ptr, C, D, n2, s2>) @ #j
      ==> #i = #j"
