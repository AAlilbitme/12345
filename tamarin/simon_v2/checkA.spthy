theory CheckA
begin
#include "modelA.spthy"
lemma Request_Without_Commit_A:
  exists-trace
  "Ex S F R p0 p1 x rid rid2 n0 n1 n2 a0 b0 a1 b1 s0 t0 s1 t1 s2 t2
      #o0 #o1 #o #u0 #r0 #c0 #f #u1 #r1 #c1 #q #u2 #r2 #c2 #q2.
      ChannelOpen(a0, b0, p0) @ #o0
    & ChannelOpen(a1, b1, p1) @ #o1
    & HTLCOffered(S, F, p0, h(x)) @ #o
    & ChannelUpdateFor(p0, <'add', h(x)>, n0) @ #u0
    & StateUpdate(s0, t0, p0, n0) @ #r0
    & HTLCCommitted(p0, <'add', h(x)>, n0) @ #c0
    & HTLCForwarded(F, S, R, p0, p1, h(x)) @ #f
    & ChannelUpdateFor(p1, <'add', h(x)>, n1) @ #u1
    & StateUpdate(s1, t1, p1, n1) @ #r1
    & HTLCCommitted(p1, <'add', h(x)>, n1) @ #c1
    & SettleRequested(R, p1, h(x), rid) @ #q
    & ChannelUpdateFor(p1, <'settle', h(x), rid>, n2) @ #u2
    & StateUpdate(s2, t2, p1, n2) @ #r2
    & HTLCCommitted(p1, <'settle', h(x), rid>, n2) @ #c2
    & SettleRequested(F, p0, h(x), rid2) @ #q2
    & #o0 < #o & #o1 < #o & #o < #u0 & #u0 < #r0 & #r0 < #c0 & #c0 < #f
    & #f < #u1 & #u1 < #r1 & #r1 < #c1 & #c1 < #q
    & #q < #u2 & #u2 < #r2 & #r2 < #c2 & #c2 < #q2
    & (All a b p #i. ChannelOpen(a, b, p) @ #i ==> (#i = #o0 | #i = #o1))
    & (All p op m #i. ChannelUpdateFor(p, op, m) @ #i ==> (#i = #u0 | #i = #u1 | #i = #u2))
    & (All a b p m #i. StateUpdate(a, b, p, m) @ #i ==> (#i = #r0 | #i = #r1 | #i = #r2))
    & (All p z #i. Old(p, z) @ #i ==> z = h(x))
    & not (Ex t #i. Tick(t) @ #i)
    & not (Ex p #i. MutexReleased(p) @ #i & #i < #c2)
    & not (Ex X #k2. LtkCompromised(X) @ #k2)
    & not (Ex P p z #i. Refunded(P, p, z) @ #i)
    & not (Ex n #l. HTLCCommitted(p0, <'settle', h(x), rid2>, n) @ #l)"
end
