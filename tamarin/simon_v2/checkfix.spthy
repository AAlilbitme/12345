theory CheckFix
begin

#include "modelfix.spthy"

// Was reachable before the fix (10 steps); must now be impossible.
lemma Double_Publish_Same_Channel:
  exists-trace
  "Ex A B ptr n1 n2 s1 s2 #i #j.
      Publish(A, n1, <'commit', ptr, A, B, n1, s1>) @ #i
    & Publish(B, n2, <'commit', ptr, B, A, n2, s2>) @ #j
    & not (Ex X #c. LtkCompromised(X) @ #c)
    & not (Ex ptr2 y #m. HTLCAdded(ptr2, y) @ #m)"

// Sanity: publishing a commitment is still possible.
lemma Publish_Still_Possible:
  exists-trace
  "Ex A n c #i. Publish(A, n, c) @ #i
    & not (Ex X #c. LtkCompromised(X) @ #c)
    & not (Ex ptr2 y #m. HTLCAdded(ptr2, y) @ #m)"

end
