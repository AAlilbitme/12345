theory ptlc
begin

/*
  Fixed route  S -> H1 -> H2 -> H3 -> R  over channels c0, c1, c2, c3.
  PTLC / multi-hop-lock model: every channel has its OWN secret.
  Channel secrets (sender-generated, as in anonymous multi-hop locks):
      s3 = x,  s2 = H(x,t3),  s1 = H(s2,t2),  s0 = H(s1,t1)
  An honest hop that learns its OUTGOING secret combines it with its own
  private tweak to obtain its INCOMING secret.  Locks are h(secret).
  The hash chain abstracts the additive PTLC tweak (s_in = s_out + t): in both,
  deriving a hop's incoming secret requires that hop's tweak.  (An XOR encoding
  exhausted memory in Tamarin.)

  Attacker (same in both models): Dolev-Yao + compromise.  A compromised hop
  leaks its tweak; every secret used to claim a channel becomes public
  (on-chain); a compromised payee may claim its channel with ANY value the
  adversary knows.  There is no special "skip" rule: a wormhole must be built
  from adversary knowledge.  Timing is abstracted: an open HTLC may be refunded.
  Generated by gen.py -- edit the template, not this file.
*/

builtins: hashing

rule Compromise:
    [ ] --[ Compromised($A) ]-> [ !Comp($A) ]

// Sender sets up the payment: fresh channels, secret and per-hop tweaks.
rule Sender_Setup:
    let s3 = ~x
        s2 = h(<s3, ~t3>)
        s1 = h(<s2, ~t2>)
        s0 = h(<s1, ~t1>)
    in
    [ Fr(~x), Fr(~c0), Fr(~c1), Fr(~c2), Fr(~c3), Fr(~t1), Fr(~t2), Fr(~t3) ]
    --[ Pay($S, $H1, $H2, $H3, $R, ~c0, ~c1, ~c2, ~c3),
        Neq($S, $H1), Neq($S, $H2), Neq($S, $H3), Neq($S, $R),
        Neq($H1, $H2), Neq($H2, $H3), Neq($H1, $H3),
        Neq($H1, $R), Neq($H2, $R), Neq($H3, $R) ]->
    [ !Lock(~c0, $S, $H1, h(s0)), Open(~c0), SenderWait($S, ~c0),
      !Hop($H1, ~c0, ~c1, $H2, h(s1), ~t1),
      !Hop($H2, ~c1, ~c2, $H3, h(s2), ~t2),
      !Hop($H3, ~c2, ~c3, $R,  h(s3), ~t3),
      !RecvSecret($R, ~c3, ~x),
      Out(h(s0)), Out(h(s1)), Out(h(s2)), Out(h(s3)) ]

// A compromised hop leaks its tweak.
rule Leak_Tweak:
    [ !Hop($H, cIn, cOut, N, Lout, t), !Comp($H) ]
    --[ Leaked($H) ]->
    [ Out(t) ]

// Hop forwards: once its incoming HTLC exists it opens the outgoing one.
rule Forward:
    [ !Lock(cIn, P, $H, Lin), !Hop($H, cIn, cOut, N, Lout, t) ]
    --[ Forwarded($H, cIn, cOut), Once(cOut) ]->
    [ !Lock(cOut, $H, N, Lout), Open(cOut), Pend($H, cIn, cOut, t) ]

// Receiver claims the last channel.
rule Receiver_Claim:
    [ !Lock(c, P, $R, L), Open(c), !RecvSecret($R, c, x) ]
    --[ Redeemed(c), Eq(h(x), L) ]->
    [ ClaimInfo(c, x), Out(x) ]

// Honest hop: outgoing secret -> incoming secret.
rule Hop_Settle:
    [ Pend($H, cIn, cOut, t), ClaimInfo(cOut, sec), !Lock(cIn, P, $H, Lin), Open(cIn) ]
    --[ Redeemed(cIn), HopSettled($H, cIn, cOut), Eq(h(h(<sec, t>)), Lin) ]->
    [ ClaimInfo(cIn, h(<sec, t>)), Out(h(<sec, t>)) ]

// A compromised payee claims with any value the adversary knows.
rule Adversary_Claim:
    [ !Lock(c, P, B, L), Open(c), !Comp(B), In(sec) ]
    --[ Redeemed(c), AdvClaim(c), Eq(h(sec), L) ]->
    [ ClaimInfo(c, sec), Out(sec) ]

rule Refund:
    [ !Lock(c, P, B, L), Open(c) ]
    --[ Refunded(c) ]->
    [ ]

rule Sender_Settle:
    [ SenderWait($S, c0), ClaimInfo(c0, sec) ]
    --[ SenderSettled($S, c0) ]->
    [ ]

restriction Equality:    "All a b #i. Eq(a, b) @ #i ==> a = b"
restriction Inequality:  "All a b #i. Neq(a, b) @ #i ==> not (a = b)"
restriction OnceForward: "All c #i #j. Once(c) @ #i & Once(c) @ #j ==> #i = #j"

// Sanity: an honest payment completes end to end.
lemma Honest_Payment_Completes:
  exists-trace
  "Ex S H1 H2 H3 R c0 c1 c2 c3 #p #s.
      Pay(S, H1, H2, H3, R, c0, c1, c2, c3) @ #p
    & SenderSettled(S, c0) @ #s
    & not (Ex A #k. Compromised(A) @ #k)"

// Sanity: with both neighbours of H2 compromised the payment still completes.
lemma Colluders_Present_Payment_Completes:
  exists-trace
  "Ex S H1 H2 H3 R c0 c1 c2 c3 #p #s #k1 #k3.
      Pay(S, H1, H2, H3, R, c0, c1, c2, c3) @ #p
    & SenderSettled(S, c0) @ #s
    & Compromised(H1) @ #k1 & Compromised(H3) @ #k3"

// Wormhole around an honest H2: the sender's c0 is redeemed while H2's
// outgoing c2 is refunded.
lemma No_Wormhole_Around_Honest_Hop:
  all-traces
  "not (
Ex S H1 H2 H3 R c0 c1 c2 c3 #p #a #b.
      Pay(S, H1, H2, H3, R, c0, c1, c2, c3) @ #p
    & Redeemed(c0) @ #a
    & Refunded(c2) @ #b
    & not (Ex #k. Compromised(H2) @ #k)
    & not (Ex #k. Compromised(S) @ #k))"

// Control 1: H2's outgoing HTLC CAN be refunded while the payment is set up
// (so the premise of the lemma above is not unsatisfiable on its own).
lemma Control_Refund_Of_H2_Outgoing:
  exists-trace
  "Ex S H1 H2 H3 R c0 c1 c2 c3 #p #b.
      Pay(S, H1, H2, H3, R, c0, c1, c2, c3) @ #p
    & Refunded(c2) @ #b
    & not (Ex #k. Compromised(H2) @ #k)"

// Control 2: if H2 itself is compromised (its tweak leaks), the wormhole IS
// reachable -- the proof above depends on H2's tweak staying secret.
lemma Control_Wormhole_If_H2_Compromised:
  exists-trace
  "Ex S H1 H2 H3 R c0 c1 c2 c3 #p #a #b #k.
      Pay(S, H1, H2, H3, R, c0, c1, c2, c3) @ #p
    & Redeemed(c0) @ #a
    & Refunded(c2) @ #b
    & Compromised(H2) @ #k
    & not (Ex #j. Compromised(S) @ #j)"

end
