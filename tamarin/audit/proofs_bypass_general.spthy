  case Sender_Offer_HTLC_case_19
  by contradiction /* from formulas */
next
  case Sender_Offer_HTLC_case_20
  by contradiction /* from formulas */
qed

lemma Hop_Redeem_Propagates [reuse, heuristic={lemmas_first}]:
  all-traces
  "∀ M P N pin0 pIn y #f #r.
    (((HTLCForwarded( M, P, N, pin0, pIn, y ) @ #f) ∧
      (Redeemed( pin0, y ) @ #r)) ∧
     (¬(∃ Q #c. LtkCompromised( Q ) @ #c))) ⇒
    (∃ #l. Redeemed( pIn, y ) @ #l)"
/*
guarded formula characterizing all counter-examples:
"∃ M P N pin0 pIn y #f #r.
  (HTLCForwarded( M, P, N, pin0, pIn, y ) @ #f) ∧
  (Redeemed( pin0, y ) @ #r)
 ∧
  (∀ Q #c. (LtkCompromised( Q ) @ #c) ⇒ ⊥) ∧
  (∀ #l. (Redeemed( pIn, y ) @ #l) ⇒ ⊥)"
*/
simplify
solve( (∃ S #j. (HTLCOffered( S, $Me, pin0, y ) @ #j) ∧ #j < #f)  ∥
       (∃ P0 pin0.1 #j.
         (HTLCForwarded( $Prev, P0, $Me, pin0.1, pin0, y ) @ #j) ∧ #j < #f) )
  case case_1
  solve( (∃ o. (SettledHop( pin0, o, y ) @ #r))  ∥
         (∃ R Q. (HTLCFulfilled( R, Q, pin0, y ) @ #r)) )
    case case_1
    solve( (∃ #j. (Redeemed( pIn, h(x) ) @ #j) ∧ #j < #r)  ∥
           (∃ #j. (Skipped( pIn, x ) @ #j) ∧ #j < #r) )
      case case_1
      by contradiction /* from formulas */
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case case_2
    by contradiction /* from formulas */
  qed
next
  case case_2
  solve( (∃ o. (SettledHop( pin0, o, y ) @ #r))  ∥
         (∃ R Q. (HTLCFulfilled( R, Q, pin0, y ) @ #r)) )
    case case_1
    solve( (∃ S #j.2.
             (HTLCOffered( S, $Prev, pin0.1, h(x) ) @ #j.2) ∧ #j.2 < #j.1)  ∥
           (∃ P0 pin0.2 #j.2.
             (HTLCForwarded( $Prev.2, P0, $Prev, pin0.2, pin0.1, h(x) ) @ #j.2)
            ∧
             #j.2 < #j.1) )
      case case_1
      solve( (∃ #j. (Redeemed( pIn, h(x) ) @ #j) ∧ #j < #r)  ∥
             (∃ #j. (Skipped( pIn, x ) @ #j) ∧ #j < #r) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        by contradiction /* from formulas */
      qed
    next
      case case_2
      solve( (∃ #j. (Redeemed( pIn, h(x) ) @ #j) ∧ #j < #r)  ∥
             (∃ #j. (Skipped( pIn, x ) @ #j) ∧ #j < #r) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        by contradiction /* from formulas */
      qed
    qed
  next
    case case_2
    by contradiction /* from formulas */
  qed
qed

lemma Sender_Channel_Redeemed [reuse, heuristic={lemmas_first}]:
  all-traces
  "∀ S F1 R pSF x #s.
    ((SenderSettled( S, F1, R, pSF, x ) @ #s) ∧
     (¬(∃ Q #c. LtkCompromised( Q ) @ #c))) ⇒
    (∃ #l. Redeemed( pSF, h(x) ) @ #l)"
/*
guarded formula characterizing all counter-examples:
"∃ S F1 R pSF x #s.
  (SenderSettled( S, F1, R, pSF, x ) @ #s)
 ∧
  (∀ Q #c. (LtkCompromised( Q ) @ #c) ⇒ ⊥) ∧
  (∀ #l. (Redeemed( pSF, h(x) ) @ #l) ⇒ ⊥)"
*/
simplify
solve( (∃ #j. (Redeemed( pSF, h(x) ) @ #j) ∧ #j < #s)  ∥
       (∃ #j. (Skipped( pSF, x ) @ #j) ∧ #j < #s) )
  case case_1
  by contradiction /* from formulas */
next
  case case_2
  by contradiction /* from formulas */
qed

lemma Root_First [reuse, use_induction, heuristic={lemmas_first},
                  hide_lemma=Redeemed_Source, hide_lemma=SettledHop_From_Forward,
                  hide_lemma=SettledHop_Uses_Outgoing, hide_lemma=Fulfilled_Source,
                  hide_lemma=No_Settle_And_Refund_Same_Hop,
                  hide_lemma=No_Fulfill_On_Forwarded_Incoming,
                  hide_lemma=SenderSettled_Uses_Fulfilled,
                  hide_lemma=Fulfilled_Requires_Release, hide_lemma=HTLC_On_Opened_Channel,
                  hide_lemma=Skipped_Requires_Compromise, hide_lemma=Hop_Redeem_Propagates,
                  hide_lemma=Sender_Channel_Redeemed]:
  all-traces
  "∀ Me Prev Next pIn pOut y #f.
    (HTLCForwarded( Me, Prev, Next, pIn, pOut, y ) @ #f) ⇒
    ((∃ S #o. HTLCOffered( S, Me, pIn, y ) @ #o) ∨
     (∃ S M P N pS p1 #o #k.
       ((HTLCOffered( S, M, pS, y ) @ #o) ∧
        (HTLCForwarded( M, P, N, pS, p1, y ) @ #k)) ∧
       (#k < #f)))"
/*
guarded formula characterizing all counter-examples:
"∃ Me Prev Next pIn pOut y #f.
  (HTLCForwarded( Me, Prev, Next, pIn, pOut, y ) @ #f)
 ∧
  (∀ S #o. (HTLCOffered( S, Me, pIn, y ) @ #o) ⇒ ⊥) ∧
  (∀ S M P N pS p1 #o #k.
    (HTLCOffered( S, M, pS, y ) @ #o) ∧
    (HTLCForwarded( M, P, N, pS, p1, y ) @ #k)
   ⇒
    ¬(#k < #f))"
*/
induction
  case empty_trace
  by contradiction
next
  case non_empty_trace
  simplify
  solve( (∃ S #j. (HTLCOffered( S, $Me, pIn, y ) @ #j) ∧ #j < #f)  ∥
         (∃ P0 pin0 #j.
           (HTLCForwarded( $Prev, P0, $Me, pin0, pIn, y ) @ #j) ∧ #j < #f) )
    case case_1
    by contradiction
  next
    case case_2
    solve( (∃ S #o. (HTLCOffered( S, $Prev, pin0, y ) @ #o) ∧ ¬(last(#o)))  ∥
           (∃ S M P N pS p1 #o #k.
             (HTLCOffered( S, M, pS, y ) @ #o) ∧
             (HTLCForwarded( M, P, N, pS, p1, y ) @ #k)
            ∧
             (¬(last(#k))) ∧ (¬(last(#o))) ∧ (#k < #j)) )
      case case_1
      by contradiction
    next
      case case_2
      by contradiction
    qed
  qed
qed

lemma Next_Is_Child [reuse, use_induction, heuristic={lemmas_first},
                     hide_lemma=Redeemed_Source, hide_lemma=SettledHop_From_Forward,
                     hide_lemma=SettledHop_Uses_Outgoing, hide_lemma=Fulfilled_Source,
                     hide_lemma=No_Settle_And_Refund_Same_Hop,
                     hide_lemma=No_Fulfill_On_Forwarded_Incoming,
                     hide_lemma=SenderSettled_Uses_Fulfilled,
                     hide_lemma=Fulfilled_Requires_Release, hide_lemma=HTLC_On_Opened_Channel,
                     hide_lemma=Skipped_Requires_Compromise, hide_lemma=Hop_Redeem_Propagates,
                     hide_lemma=Sender_Channel_Redeemed]:
  all-traces
  "∀ Prev P0 Me pin0 pIn M P N a b y #j #g.
    ((((HTLCForwarded( Prev, P0, Me, pin0, pIn, y ) @ #j) ∧
       (HTLCForwarded( M, P, N, a, b, y ) @ #g)) ∧
      (#j < #g)) ∧
     (∀ A B C D p q #o1 #o2.
       ((HTLCOffered( A, B, p, y ) @ #o1) ∧ (HTLCOffered( C, D, q, y ) @ #o2)) ⇒
       (p = q))) ⇒
    ((∃ Nx pOut. HTLCForwarded( Me, Prev, Nx, pIn, pOut, y ) @ #g) ∨
     (∃ Nx pOut #f.
       (HTLCForwarded( Me, Prev, Nx, pIn, pOut, y ) @ #f) ∧ (#f < #g)))"
/*
guarded formula characterizing all counter-examples:
"∃ Prev P0 Me pin0 pIn M P N a b y #j #g.
  (HTLCForwarded( Prev, P0, Me, pin0, pIn, y ) @ #j) ∧
  (HTLCForwarded( M, P, N, a, b, y ) @ #g)
 ∧
  (#j < #g) ∧
  (∀ A B C D p q #o1 #o2.
    (HTLCOffered( A, B, p, y ) @ #o1) ∧ (HTLCOffered( C, D, q, y ) @ #o2)
   ⇒
    p = q) ∧
  (∀ Nx pOut. (HTLCForwarded( Me, Prev, Nx, pIn, pOut, y ) @ #g) ⇒ ⊥) ∧
  (∀ Nx pOut #f.
    (HTLCForwarded( Me, Prev, Nx, pIn, pOut, y ) @ #f) ⇒ ¬(#f < #g))"
*/
induction
  case empty_trace
  by contradiction
next
  case non_empty_trace
  simplify
  solve( (last(#g))  ∥
         (∃ A B C D p q #o1 #o2.
           (HTLCOffered( A, B, p, y ) @ #o1) ∧ (HTLCOffered( C, D, q, y ) @ #o2)
          ∧
           (¬(last(#o2))) ∧ (¬(last(#o1))) ∧ (¬(p = q)))  ∥
         (∃ Nx pOut. (HTLCForwarded( $Next, $Me, Nx, pIn, pOut, y ) @ #g))  ∥
         (∃ Nx pOut #f.
           (HTLCForwarded( $Next, $Me, Nx, pIn, pOut, y ) @ #f)
          ∧
           (¬(last(#f))) ∧ (#f < #g)) )
    case case_1
    solve( (∃ S #j. (HTLCOffered( S, $Me, a, y ) @ #j) ∧ #j < #g)  ∥
           (∃ P0 pin0 #j.
             (HTLCForwarded( $Prev, P0, $Me, pin0, a, y ) @ #j) ∧ #j < #g) )
      case case_1
      solve( (∃ S #o. (HTLCOffered( S, $Me.1, pin0, y ) @ #o))  ∥
             (∃ S M P N pS p1 #o #k.
               (HTLCOffered( S, M, pS, y ) @ #o) ∧
               (HTLCForwarded( M, P, N, pS, p1, y ) @ #k)
              ∧
               #k < #j) )
        case case_1
        by contradiction
      next
        case case_2
        by contradiction
      qed
    next
      case case_2
      solve( (#j = #j.1)  ∥ (#j.1 < #j)  ∥
             (∃ A B C D p q #o1 #o2.
               (HTLCOffered( A, B, p, y ) @ #o1) ∧ (HTLCOffered( C, D, q, y ) @ #o2)
              ∧
               (¬(last(#o2))) ∧ (¬(last(#o1))) ∧ (¬(p = q)))  ∥
             (∃ Nx pOut.
               (HTLCForwarded( $Next.1, $Me.1, Nx, pIn, pOut, y ) @ #j.1))  ∥
             (∃ Nx pOut #f.
               (HTLCForwarded( $Next.1, $Me.1, Nx, pIn, pOut, y ) @ #f)
              ∧
               (¬(last(#f))) ∧ (#f < #j.1)) )
        case case_1
        by contradiction
      next
        case case_2
        solve( (∃ A B C D p q #o1 #o2.
                 (HTLCOffered( A, B, p, y ) @ #o1) ∧ (HTLCOffered( C, D, q, y ) @ #o2)
                ∧
                 (¬(last(#o2))) ∧ (¬(last(#o1))) ∧ (¬(p = q)))  ∥
               (∃ Nx pOut. (HTLCForwarded( $Me, $Prev, Nx, a, pOut, y ) @ #j))  ∥
               (∃ Nx pOut #f.
                 (HTLCForwarded( $Me, $Prev, Nx, a, pOut, y ) @ #f)
                ∧
                 (¬(last(#f))) ∧ (#f < #j)) )
          case case_1
          by contradiction
        next
          case case_2
          by contradiction
        next
          case case_3
          by contradiction
        qed
      next
        case case_3
        by contradiction
      next
        case case_4
        by contradiction
      next
        case case_5
        by contradiction
      qed
    qed
  next
    case case_2
    by contradiction
  next
    case case_3
    by contradiction
  next
    case case_4
    by contradiction
  qed
qed

lemma Route_Redeemed_Gen [reuse, use_induction, heuristic={lemmas_first},
                          hide_lemma=Redeemed_Source, hide_lemma=SettledHop_From_Forward,
                          hide_lemma=SettledHop_Uses_Outgoing, hide_lemma=Fulfilled_Source,
                          hide_lemma=No_Settle_And_Refund_Same_Hop,
                          hide_lemma=No_Fulfill_On_Forwarded_Incoming,
                          hide_lemma=SenderSettled_Uses_Fulfilled,
                          hide_lemma=Fulfilled_Requires_Release, hide_lemma=HTLC_On_Opened_Channel,
                          hide_lemma=Skipped_Requires_Compromise,
                          hide_lemma=Sender_Channel_Redeemed]:
  all-traces
  "∀ Me Prev Next pIn pOut M P N pT pT2 y #f #g #r.
    ((((((HTLCForwarded( Me, Prev, Next, pIn, pOut, y ) @ #f) ∧
         (HTLCForwarded( M, P, N, pT, pT2, y ) @ #g)) ∧
        ((#g < #f) ∨ (#g = #f))) ∧
       (Redeemed( pT, y ) @ #r)) ∧
      (∀ A B C D p q #o1 #o2.
        ((HTLCOffered( A, B, p, y ) @ #o1) ∧ (HTLCOffered( C, D, q, y ) @ #o2)) ⇒
        (p = q))) ∧
     (¬(∃ Q #c. LtkCompromised( Q ) @ #c))) ⇒
    (∃ #l. Redeemed( pIn, y ) @ #l)"
/*
guarded formula characterizing all counter-examples:
"∃ Me Prev Next pIn pOut M P N pT pT2 y #f #g #r.
  (HTLCForwarded( Me, Prev, Next, pIn, pOut, y ) @ #f) ∧
  (HTLCForwarded( M, P, N, pT, pT2, y ) @ #g) ∧
  (Redeemed( pT, y ) @ #r)
 ∧
  (((#g < #f) ∨ (#g = #f))) ∧
  (∀ A B C D p q #o1 #o2.
    (HTLCOffered( A, B, p, y ) @ #o1) ∧ (HTLCOffered( C, D, q, y ) @ #o2)
   ⇒
    p = q) ∧
  (∀ Q #c. (LtkCompromised( Q ) @ #c) ⇒ ⊥) ∧
  (∀ #l. (Redeemed( pIn, y ) @ #l) ⇒ ⊥)"
*/
induction
  case empty_trace
  by contradiction
next
  case non_empty_trace
  simplify
  solve( (#g < #f)  ∥ (#g = #f) )
    case case_1
    solve( (last(#r))  ∥ (last(#f))  ∥
           (∃ A B C D p q #o1 #o2.
             (HTLCOffered( A, B, p, y ) @ #o1) ∧ (HTLCOffered( C, D, q, y ) @ #o2)
            ∧
             (¬(last(#o2))) ∧ (¬(last(#o1))) ∧ (¬(p = q)))  ∥
           (∃ Q #c. (LtkCompromised( Q ) @ #c) ∧ ¬(last(#c)))  ∥
           (∃ #l. (Redeemed( pIn, y ) @ #l) ∧ ¬(last(#l))) )
      case case_1
      solve( (∃ Q #c. (LtkCompromised( Q ) @ #c))  ∥
             (∃ #l. (Redeemed( pT2, y ) @ #l)) )
        case case_1
        by contradiction
      next
        case case_2
        solve( (∃ A B C D p q #o1 #o2.
                 (HTLCOffered( A, B, p, y ) @ #o1) ∧ (HTLCOffered( C, D, q, y ) @ #o2)
                ∧
                 ¬(p = q))  ∥
               (∃ Nx pOut. (HTLCForwarded( $Next.1, $Me.1, Nx, pT2, pOut, y ) @ #f))  ∥
               (∃ Nx pOut #f.1.
                 (HTLCForwarded( $Next.1, $Me.1, Nx, pT2, pOut, y ) @ #f.1) ∧ #f.1 < #f) )
          case case_1
          by contradiction
        next
          case case_2
          by contradiction
        next
          case case_3
          solve( (last(#l))  ∥ (last(#f))  ∥
                 (∃ A B C D p q #o1 #o2.
                   (HTLCOffered( A, B, p, y ) @ #o1) ∧ (HTLCOffered( C, D, q, y ) @ #o2)
                  ∧
                   (¬(last(#o2))) ∧ (¬(last(#o1))) ∧ (¬(p = q)))  ∥
                 (∃ Q #c. (LtkCompromised( Q ) @ #c) ∧ ¬(last(#c)))  ∥
                 (∃ #l. (Redeemed( pIn, y ) @ #l) ∧ ¬(last(#l))) )
            case case_1
            solve( Redeemed( pT, y ) @ #l )
              case Intermediary_Settle
              solve( Redeemed( pT2, h(x) ) @ #l )
                case Intermediary_Settle
                by contradiction
              qed
            next
              case Receiver_Fulfill_HTLC
              solve( Redeemed( pT2, h(x) ) @ #l )
                case Receiver_Fulfill_HTLC
                by contradiction
              qed
            qed
          next
            case case_2
            by solve( Redeemed( pT, y ) @ #f )
          next
            case case_3
            by contradiction
          next
            case case_4
            by contradiction
          next
            case case_5
            by contradiction
          qed
        qed
      qed
    next
      case case_2
      solve( (∃ S #j. (HTLCOffered( S, $Me, pIn, y ) @ #j) ∧ #j < #f)  ∥
             (∃ P0 pin0 #j.
               (HTLCForwarded( $Prev, P0, $Me, pin0, pIn, y ) @ #j) ∧ #j < #f) )
        case case_1
        solve( (∃ S #o. (HTLCOffered( S, $Me.1, pT, y ) @ #o))  ∥
               (∃ S M P N pS p1 #o #k.
                 (HTLCOffered( S, M, pS, y ) @ #o) ∧
                 (HTLCForwarded( M, P, N, pS, p1, y ) @ #k)
                ∧
                 #k < #g) )
          case case_1
          by contradiction
        next
          case case_2
          by contradiction
        qed
      next
        case case_2
        solve( (last(#r))  ∥ ((((#g = #j) ∨ (#j < #g))) ∧ (¬(#g = #j)))  ∥
               (∃ A B C D p q #o1 #o2.
                 (HTLCOffered( A, B, p, y ) @ #o1) ∧ (HTLCOffered( C, D, q, y ) @ #o2)
                ∧
                 (¬(last(#o2))) ∧ (¬(last(#o1))) ∧ (¬(p = q)))  ∥
               (∃ Q #c. (LtkCompromised( Q ) @ #c) ∧ ¬(last(#c)))  ∥
               (∃ #l. (Redeemed( pin0, y ) @ #l) ∧ ¬(last(#l))) )
          case case_1
          by solve( Redeemed( pT, y ) @ #f )
        next
          case case_2
          solve( (¬(#j < #g))  ∥
                 (∃ A B C D p q #o1 #o2.
                   (HTLCOffered( A, B, p, y ) @ #o1) ∧ (HTLCOffered( C, D, q, y ) @ #o2)
                  ∧
                   ¬(p = q))  ∥
                 (∃ Nx pOut. (HTLCForwarded( $Me, $Prev, Nx, pIn, pOut, y ) @ #g))  ∥
                 (∃ Nx pOut #f.
                   (HTLCForwarded( $Me, $Prev, Nx, pIn, pOut, y ) @ #f) ∧ #f < #g) )
            case case_1
            solve( (#g = #j)  ∥ (#j < #g) )
              case case_1
              by contradiction
            next
              case case_2
              by contradiction
            qed
          next
            case case_2
            by contradiction
          next
            case case_3
            by contradiction
          next
            case case_4
            by contradiction
          qed
        next
          case case_3
          by contradiction
        next
          case case_4
          by contradiction
        next
          case case_5
          solve( (∃ Q #c. (LtkCompromised( Q ) @ #c))  ∥
                 (∃ #l. (Redeemed( pIn, y ) @ #l)) )
            case case_1
            by contradiction
          next
            case case_2
            by contradiction
          qed
        qed
      qed
    next
      case case_3
      by contradiction
    next
      case case_4
      by contradiction
    next
      case case_5
      by contradiction
    qed
  next
    case case_2
    by contradiction
  qed
qed

lemma Route_Redeemed_No_Compromise [reuse, use_induction,
                                    heuristic={lemmas_first}, hide_lemma=Redeemed_Source,
                                    hide_lemma=SettledHop_From_Forward, hide_lemma=SettledHop_Uses_Outgoing,
                                    hide_lemma=Fulfilled_Source, hide_lemma=No_Settle_And_Refund_Same_Hop,
                                    hide_lemma=No_Fulfill_On_Forwarded_Incoming,
                                    hide_lemma=Forward_Unique_Per_Incoming,
                                    hide_lemma=SenderSettled_Uses_Fulfilled,
                                    hide_lemma=Fulfilled_Requires_Release, hide_lemma=HTLC_On_Opened_Channel,
                                    hide_lemma=Skipped_Requires_Compromise]:
  all-traces
  "∀ Me Prev Next pIn pOut S F1 R pSF x #f #s.
    ((((HTLCForwarded( Me, Prev, Next, pIn, pOut, h(x) ) @ #f) ∧
       (SenderSettled( S, F1, R, pSF, x ) @ #s)) ∧
      (∀ A B p #o. (HTLCOffered( A, B, p, h(x) ) @ #o) ⇒ (p = pSF))) ∧
     (¬(∃ Q #c. LtkCompromised( Q ) @ #c))) ⇒
    (∃ #l. Redeemed( pIn, h(x) ) @ #l)"
/*
guarded formula characterizing all counter-examples:
"∃ Me Prev Next pIn pOut S F1 R pSF x #f #s.
  (HTLCForwarded( Me, Prev, Next, pIn, pOut, h(x) ) @ #f) ∧
  (SenderSettled( S, F1, R, pSF, x ) @ #s)
 ∧
  (∀ A B p #o. (HTLCOffered( A, B, p, h(x) ) @ #o) ⇒ p = pSF) ∧
  (∀ Q #c. (LtkCompromised( Q ) @ #c) ⇒ ⊥) ∧
  (∀ #l. (Redeemed( pIn, h(x) ) @ #l) ⇒ ⊥)"
*/
simplify
solve( (∃ Q #c. (LtkCompromised( Q ) @ #c))  ∥
       (∃ #l. (Redeemed( pSF, h(x) ) @ #l)) )
  case case_1
  by contradiction
next
  case case_2
  solve( (∃ S #o. (HTLCOffered( S, $Me, pIn, h(x) ) @ #o))  ∥
         (∃ S M P N pS p1 #o #k.
           (HTLCOffered( S, M, pS, h(x) ) @ #o) ∧
           (HTLCForwarded( M, P, N, pS, p1, h(x) ) @ #k)
          ∧
           #k < #f) )
    case case_1
    by contradiction
  next
    case case_2
    solve( (∃ A B C D p q #o1 #o2.
             (HTLCOffered( A, B, p, h(x) ) @ #o1) ∧
             (HTLCOffered( C, D, q, h(x) ) @ #o2)
            ∧
             ¬(p = q))  ∥
           (∃ Q #c. (LtkCompromised( Q ) @ #c))  ∥
           (∃ #l. (Redeemed( pSF, h(x) ) @ #l)) )
      case case_1
      by contradiction
    next
      case case_2
      by contradiction
    next
      case case_3
      solve( (∃ A B C D p q #o1 #o2.
               (HTLCOffered( A, B, p, h(x) ) @ #o1) ∧
               (HTLCOffered( C, D, q, h(x) ) @ #o2)
              ∧
               ¬(p = q))  ∥
             (∃ Q #c. (LtkCompromised( Q ) @ #c))  ∥
             (∃ #l. (Redeemed( pIn, h(x) ) @ #l)) )
        case case_1
        by contradiction
      next
        case case_2
        by contradiction
      next
        case case_3
        by contradiction
      qed
    qed
  qed
qed

lemma Any_Hop_Skip_Requires_Compromise [heuristic={lemmas_first}]:
  all-traces
  "∀ S F1 R pSF x Me Prev Next pIn pOut #s #f #r.
    ((((SenderSettled( S, F1, R, pSF, x ) @ #s) ∧
       (HTLCForwarded( Me, Prev, Next, pIn, pOut, h(x) ) @ #f)) ∧
      (RefundHop( pIn, pOut, h(x) ) @ #r)) ∧
     (∀ A B p #o. (HTLCOffered( A, B, p, h(x) ) @ #o) ⇒ (p = pSF))) ⇒
    (∃ P #c. LtkCompromised( P ) @ #c)"
/*
guarded formula characterizing all counter-examples:
"∃ S F1 R pSF x Me Prev Next pIn pOut #s #f #r.
  (SenderSettled( S, F1, R, pSF, x ) @ #s) ∧
  (HTLCForwarded( Me, Prev, Next, pIn, pOut, h(x) ) @ #f) ∧
  (RefundHop( pIn, pOut, h(x) ) @ #r)
 ∧
  (∀ A B p #o. (HTLCOffered( A, B, p, h(x) ) @ #o) ⇒ p = pSF) ∧
  (∀ P #c. (LtkCompromised( P ) @ #c) ⇒ ⊥)"
*/
simplify
solve( (∃ A B p #o. (HTLCOffered( A, B, p, h(x) ) @ #o) ∧ ¬(p = pSF))  ∥
       (∃ Q #c. (LtkCompromised( Q ) @ #c))  ∥
       (∃ #l. (Redeemed( pIn, h(x) ) @ #l)) )
  case case_1
  by contradiction
next
  case case_2
  by contradiction
next
  case case_3
  solve( (∃ o. (SettledHop( pIn, o, h(x) ) @ #l))  ∥
         (∃ R Q. (HTLCFulfilled( R, Q, pIn, h(x) ) @ #l)) )
    case case_1
    by contradiction
  next
    case case_2
    by contradiction
  qed
qed

lemma Necessity_IMC_Honest_Intermediary_Loses:
  exists-trace
  "∃ S F1 R p0 p1 x #o #a #r #u.
    (((((((HTLCOffered( S, F1, p0, h(x) ) @ #o) ∧
          (HTLCForwarded( F1, S, R, p0, p1, h(x) ) @ #a)) ∧
         (HTLCFulfilled( R, F1, p1, h(x) ) @ #r)) ∧
        (Refunded( S, p0, h(x) ) @ #u)) ∧
       (¬(∃ P #k. LtkCompromised( P ) @ #k))) ∧
      (¬(∃ ptr y1 y2 #m #n.
          ((HTLCAdded( ptr, y1 ) @ #m) ∧ (HTLCAdded( ptr, y2 ) @ #n)) ∧
          (¬(#m = #n))))) ∧
     (¬(∃ Me P q z #e. IntermediaryClaimed( Me, P, q, z ) @ #e))) ∧
    (¬(∃ A B C q z #e. SenderSettled( A, B, C, q, z ) @ #e))"
