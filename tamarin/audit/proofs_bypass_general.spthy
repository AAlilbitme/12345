                case Lock_Funds_And_Open_case_1
                sorry /* invalid proof step encountered */
                solve( (∃ #c. (LtkCompromised( $B.1 ) @ #c) ∧ #c < #j)  ∥
                       (∃ #l. (Redeemed( ~ptr, h(~x) ) @ #l)) )
                /* unannotated */
                  case case_1
                  solve( (∃ #c. (LtkCompromised( $B.1 ) @ #c) ∧ #c < #j)  ∥
                         (∃ #m. (TimedOut( ptrAtt2Bob ) @ #m) ∧ #m < #j) )
                  /* unannotated */
                    case case_1
