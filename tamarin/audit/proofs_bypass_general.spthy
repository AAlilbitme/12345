lemma Skipped_Requires_Compromise [reuse]:
  all-traces
  "∀ p x #i.
    (Skipped( p, x ) @ #i) ⇒
    (∃ P #c. (LtkCompromised( P ) @ #c) ∧ (#c < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ p x #i.
  (Skipped( p, x ) @ #i) ∧ ∀ P #c. (LtkCompromised( P ) @ #c) ⇒ ¬(#c < #i)"
*/
simplify
solve( !Compromised( ExitAtt ) ▶₃ #i )
  case Compromise_Ltk
  by contradiction /* from formulas */
qed

lemma Forward_Unique_Per_Incoming [reuse, heuristic={route_first}]:
  all-traces
  "∀ M1 P1 N1 M2 P2 N2 pIn o1 o2 y #i #j.
    ((HTLCForwarded( M1, P1, N1, pIn, o1, y ) @ #i) ∧
     (HTLCForwarded( M2, P2, N2, pIn, o2, y ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ M1 P1 N1 M2 P2 N2 pIn o1 o2 y #i #j.
  (HTLCForwarded( M1, P1, N1, pIn, o1, y ) @ #i) ∧
  (HTLCForwarded( M2, P2, N2, pIn, o2, y ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
solve( Route( $Prev, $Me, pIn, y ) ▶₀ #i )
  case Forward_HTLC_case_1
  solve( Route( $Prev.1, $Me.1, ~ptr, y ) ▶₀ #j )
    case Forward_HTLC
    by contradiction /* from formulas */
  qed
next
  case Forward_HTLC_case_2
  solve( Route( $Prev.1, $Me.1, ~ptr, y ) ▶₀ #j )
    case Forward_HTLC
    by contradiction /* from formulas */
  qed
next
  case Sender_Offer_HTLC_case_01
