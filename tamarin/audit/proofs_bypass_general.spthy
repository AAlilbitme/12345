lemma Fee_Only_On_Successful_Forward [heuristic={route_info_first}]:
  all-traces
  "∀ Me ptrIn ptrOut y %fee #i.
    ((FeeEarned( Me, ptrIn, ptrOut, y, %fee ) @ #i) ∧
     (¬(∃ #c. LtkCompromised( Me ) @ #c))) ⇒
    ((∃ #j. (Redeemed( ptrOut, y ) @ #j) ∧ (#j < #i)) ∧
     (∃ Prev Next #f.
       (HTLCForwarded( Me, Prev, Next, ptrIn, ptrOut, y ) @ #f) ∧ (#f < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ Me ptrIn ptrOut y %fee #i.
  (FeeEarned( Me, ptrIn, ptrOut, y, %fee ) @ #i)
 ∧
  (∀ #c. (LtkCompromised( Me ) @ #c) ⇒ ⊥) ∧
  (((∀ #j. (Redeemed( ptrOut, y ) @ #j) ⇒ ¬(#j < #i)) ∨
    (∀ Prev Next #f.
      (HTLCForwarded( Me, Prev, Next, ptrIn, ptrOut, y ) @ #f) ⇒ ¬(#f < #i))))"
*/
by sorry

lemma Sanity_Honest_Payment_Completes:
  exists-trace
  "∃ S F1 R p0 p1 x #o #a #r #c #s.
    (((((((((HTLCOffered( S, F1, p0, h(x) ) @ #o) ∧
            (HTLCForwarded( F1, S, R, p0, p1, h(x) ) @ #a)) ∧
           (HTLCFulfilled( R, F1, p1, h(x) ) @ #r)) ∧
          (IntermediaryClaimed( F1, S, p0, x ) @ #c)) ∧
         (SenderSettled( S, F1, R, p0, x ) @ #s)) ∧
        (¬(∃ P #k. LtkCompromised( P ) @ #k))) ∧
       (¬(∃ ptr y1 y2 #m #n.
           ((HTLCAdded( ptr, y1 ) @ #m) ∧ (HTLCAdded( ptr, y2 ) @ #n)) ∧
           (¬(#m = #n))))) ∧
      (∀ Me P q z #e. (IntermediaryClaimed( Me, P, q, z ) @ #e) ⇒ (#e = #c))) ∧
     (∀ A B C q z #e. (SenderSettled( A, B, C, q, z ) @ #e) ⇒ (#e = #s))) ∧
    (¬(∃ U q z #e. Refunded( U, q, z ) @ #e))"
/*
guarded formula characterizing all satisfying traces:
"∃ S F1 R p0 p1 x #o #a #r #c #s.
  (HTLCOffered( S, F1, p0, h(x) ) @ #o) ∧
  (HTLCForwarded( F1, S, R, p0, p1, h(x) ) @ #a) ∧
  (HTLCFulfilled( R, F1, p1, h(x) ) @ #r) ∧
  (IntermediaryClaimed( F1, S, p0, x ) @ #c) ∧
  (SenderSettled( S, F1, R, p0, x ) @ #s)
 ∧
  (∀ P #k. (LtkCompromised( P ) @ #k) ⇒ ⊥) ∧
  (∀ ptr y1 y2 #m #n.
    (HTLCAdded( ptr, y1 ) @ #m) ∧ (HTLCAdded( ptr, y2 ) @ #n) ⇒ #m = #n) ∧
  (∀ Me P q z #e. (IntermediaryClaimed( Me, P, q, z ) @ #e) ⇒ #e = #c) ∧
  (∀ A B C q z #e. (SenderSettled( A, B, C, q, z ) @ #e) ⇒ #e = #s) ∧
  (∀ U q z #e. (Refunded( U, q, z ) @ #e) ⇒ ⊥)"
*/
by sorry

lemma Sanity_Compromised_Intermediary_Can_Lose:
  exists-trace
  "∃ S F1 R p0 p1 x #o #a #r #u #k.
    (((((((HTLCOffered( S, F1, p0, h(x) ) @ #o) ∧
          (HTLCForwarded( F1, S, R, p0, p1, h(x) ) @ #a)) ∧
         (HTLCFulfilled( R, F1, p1, h(x) ) @ #r)) ∧
        (Refunded( S, p0, h(x) ) @ #u)) ∧
       (LtkCompromised( F1 ) @ #k)) ∧
      (¬(∃ ptr y1 y2 #m #n.
          ((HTLCAdded( ptr, y1 ) @ #m) ∧ (HTLCAdded( ptr, y2 ) @ #n)) ∧
          (¬(#m = #n))))) ∧
     (¬(∃ Me P q z #e. IntermediaryClaimed( Me, P, q, z ) @ #e))) ∧
    (¬(∃ A B C q z #e. SenderSettled( A, B, C, q, z ) @ #e))"
/*
guarded formula characterizing all satisfying traces:
"∃ S F1 R p0 p1 x #o #a #r #u #k.
  (HTLCOffered( S, F1, p0, h(x) ) @ #o) ∧
  (HTLCForwarded( F1, S, R, p0, p1, h(x) ) @ #a) ∧
  (HTLCFulfilled( R, F1, p1, h(x) ) @ #r) ∧
  (Refunded( S, p0, h(x) ) @ #u) ∧
  (LtkCompromised( F1 ) @ #k)
 ∧
  (∀ ptr y1 y2 #m #n.
    (HTLCAdded( ptr, y1 ) @ #m) ∧ (HTLCAdded( ptr, y2 ) @ #n) ⇒ #m = #n) ∧
  (∀ Me P q z #e. (IntermediaryClaimed( Me, P, q, z ) @ #e) ⇒ ⊥) ∧
  (∀ A B C q z #e. (SenderSettled( A, B, C, q, z ) @ #e) ⇒ ⊥)"
*/
by sorry

lemma Intermediary_Never_Loses_Strong:
  all-traces
  "∀ P Prev Next Up ptrIn ptrOut y #i #j #k.
    (((HTLCForwarded( P, Prev, Next, ptrIn, ptrOut, y ) @ #i) ∧
      (Redeemed( ptrOut, y ) @ #j)) ∧
     (Refunded( Up, ptrIn, y ) @ #k)) ⇒
    (∃ #l #t.
      ((LtkCompromised( P ) @ #l) ∧ (TimedOut( ptrIn ) @ #t)) ∧ (#l < #t))"
/*
guarded formula characterizing all counter-examples:
"∃ P Prev Next Up ptrIn ptrOut y #i #j #k.
  (HTLCForwarded( P, Prev, Next, ptrIn, ptrOut, y ) @ #i) ∧
  (Redeemed( ptrOut, y ) @ #j) ∧
  (Refunded( Up, ptrIn, y ) @ #k)
 ∧
  ∀ #l #t.
   (LtkCompromised( P ) @ #l) ∧ (TimedOut( ptrIn ) @ #t) ⇒ ¬(#l < #t)"
*/
by sorry

lemma Offer_Requires_Invoice:
  all-traces
  "∀ S R ptr y #o.
    (OfferFor( S, R, ptr, y ) @ #o) ⇒
    ((∃ #j. (InvoiceCreated( R, S, y ) @ #j) ∧ (#j < #o)) ∨
     (∃ #r. LtkCompromised( R ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ S R ptr y #o.
  (OfferFor( S, R, ptr, y ) @ #o)
 ∧
  (∀ #j. (InvoiceCreated( R, S, y ) @ #j) ⇒ ¬(#j < #o)) ∧
  (∀ #r. (LtkCompromised( R ) @ #r) ⇒ ⊥)"
*/
by sorry

lemma Sanity_Atomic_Payment_Completes:
  exists-trace
  "∃ S F1 F2 R p0 p1 p2 x #o #a #b #r #c1 #c2 #s.
    (((((((((((HTLCOffered( S, F1, p0, h(x) ) @ #o) ∧
              (HTLCForwarded( F1, S, F2, p0, p1, h(x) ) @ #a)) ∧
             (HTLCForwarded( F2, F1, R, p1, p2, h(x) ) @ #b)) ∧
            (HTLCFulfilled( R, F2, p2, h(x) ) @ #r)) ∧
           (IntermediaryClaimed( F2, F1, p1, x ) @ #c2)) ∧
          (IntermediaryClaimed( F1, S, p0, x ) @ #c1)) ∧
         (SenderSettled( S, F1, R, p0, x ) @ #s)) ∧
        (¬(∃ P #k. LtkCompromised( P ) @ #k))) ∧
       (¬(∃ ptr y1 y2 #m #n.
           ((HTLCAdded( ptr, y1 ) @ #m) ∧ (HTLCAdded( ptr, y2 ) @ #n)) ∧
           (¬(#m = #n))))) ∧
      (∀ Me P q z #e.
        (IntermediaryClaimed( Me, P, q, z ) @ #e) ⇒ ((#e = #c1) ∨ (#e = #c2)))) ∧
     (∀ A B C q z #e. (SenderSettled( A, B, C, q, z ) @ #e) ⇒ (#e = #s))) ∧
    (¬(∃ U q z #e. Refunded( U, q, z ) @ #e))"
/*
guarded formula characterizing all satisfying traces:
"∃ S F1 F2 R p0 p1 p2 x #o #a #b #r #c1 #c2 #s.
  (HTLCOffered( S, F1, p0, h(x) ) @ #o) ∧
  (HTLCForwarded( F1, S, F2, p0, p1, h(x) ) @ #a) ∧
  (HTLCForwarded( F2, F1, R, p1, p2, h(x) ) @ #b) ∧
  (HTLCFulfilled( R, F2, p2, h(x) ) @ #r) ∧
  (IntermediaryClaimed( F2, F1, p1, x ) @ #c2) ∧
  (IntermediaryClaimed( F1, S, p0, x ) @ #c1) ∧
  (SenderSettled( S, F1, R, p0, x ) @ #s)
 ∧
  (∀ P #k. (LtkCompromised( P ) @ #k) ⇒ ⊥) ∧
  (∀ ptr y1 y2 #m #n.
    (HTLCAdded( ptr, y1 ) @ #m) ∧ (HTLCAdded( ptr, y2 ) @ #n) ⇒ #m = #n) ∧
  (∀ Me P q z #e.
    (IntermediaryClaimed( Me, P, q, z ) @ #e) ⇒ ((#e = #c1) ∨ (#e = #c2))) ∧
  (∀ A B C q z #e. (SenderSettled( A, B, C, q, z ) @ #e) ⇒ #e = #s) ∧
  (∀ U q z #e. (Refunded( U, q, z ) @ #e) ⇒ ⊥)"
*/
by sorry

lemma Preimage_Never_Known:
  all-traces
  "∀ R x #i. (SecretPreimage( R, x ) @ #i) ⇒ (¬(∃ #j. K( x ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ R x #i. (SecretPreimage( R, x ) @ #i) ∧ ∃ #j. (K( x ) @ #j)"
*/
by sorry

