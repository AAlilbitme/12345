lemma SettledHop_From_Forward [reuse, heuristic={route_first}]:
  all-traces
  "∀ pIn pOut y #i.
    (SettledHop( pIn, pOut, y ) @ #i) ⇒
    (∃ M P N #j. (HTLCForwarded( M, P, N, pIn, pOut, y ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ pIn pOut y #i.
  (SettledHop( pIn, pOut, y ) @ #i)
 ∧
  ∀ M P N #j. (HTLCForwarded( M, P, N, pIn, pOut, y ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( IntermediaryPending( $Me, $Prev, $Next, pIn, pOut, h(x), %vIn,
                            %vOut, %fee
       ) ▶₀ #i )
  case Forward_HTLC_case_1
  by contradiction /* from formulas */
next
  case Forward_HTLC_case_2
  by contradiction /* from formulas */
qed

lemma No_Settle_And_Refund_Same_Hop [reuse, heuristic={route_first}]:
  all-traces
  "∀ pIn pOut y #i #j.
    ((SettledHop( pIn, pOut, y ) @ #i) ∧ (RefundHop( pIn, pOut, y ) @ #j)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ pIn pOut y #i #j.
  (SettledHop( pIn, pOut, y ) @ #i) ∧ (RefundHop( pIn, pOut, y ) @ #j)"
*/
simplify
solve( IntermediaryPending( $Me, $Prev, $Next, pIn, pOut, h(x), %vIn,
                            %vOut, %fee
       ) ▶₀ #i )
  case Forward_HTLC_case_1
  by solve( IntermediaryPending( $Me.1, $Prev.1, $Next.1, pIn, ~ptr, h(x),
                                 %vIn, %vOut.1, %fee.1
            ) ▶₀ #j )
next
  case Forward_HTLC_case_2
  by solve( IntermediaryPending( $Me.1, $Prev.1, $Next.1, pIn, ~ptr, h(x),
                                 %vIn, %vOut.1, %fee.1
            ) ▶₀ #j )
qed

lemma No_Fulfill_On_Forwarded_Incoming [reuse, heuristic={route_first}]:
  all-traces
  "∀ R Q M P N p o y #i #j.
    ((HTLCFulfilled( R, Q, p, y ) @ #i) ∧
     (HTLCForwarded( M, P, N, p, o, y ) @ #j)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ R Q M P N p o y #i #j.
  (HTLCFulfilled( R, Q, p, y ) @ #i) ∧
