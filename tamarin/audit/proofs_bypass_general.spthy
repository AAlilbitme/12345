theory multihop_nhop begin

// Function signature and definition of the equational theory E

builtins: natural-numbers
functions: fst/1, h/1, pair/2, pk/1, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

tactic: route_info_first
presort: s
prio: {id}
  regex"RouteInfo" | regex"Compromised"


tactic: sender_pending
presort: s
prio: {id}
  regex"Refunded" | regex"SenderPending" | regex"IntermediaryPending"


tactic: route_first
presort: s
prio: {id}
  regex"Route\(" | regex"IntermediaryPending\(" | regex"SenderPending\("
prio: {id}
  regex"∥" | regex"Fulfilled\("
deprio: {id}
  regex"KU\(" | regex"Ltk" | regex"ChannelConnect" | regex"ReadyToLock" | regex"Wallet" | regex"Mutex" | regex"ReceiverInv"


tactic: lemmas_first
presort: s
prio: {id}
  regex"∥"
prio: {id}
  regex"@"
deprio: {id}
  regex"▶"











rule (modulo E) Register_key:
   [ Fr( ~ltk ) ]
  --[ KeyGen( $A, ~ltk ) ]->
   [ !Ltk( $A, ~ltk ), !Pk( $A, pk(~ltk) ), Out( pk(~ltk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Compromise_Ltk:
   [ !Ltk( $A, ltk ) ]
  --[ LtkCompromised( $A ) ]->
   [ Out( ltk ), !Compromised( $A ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Acquire_funds:
   [ Fr( ~f ) ] --[ FundsAcquired( $A, ~f ) ]-> [ Wallet( $A, ~f ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) A_Send_Proposal:
   [ Fr( ~ptr ), !Ltk( $A, ltkA ) ]
  --[ A_ProposalSent( $A, $B, ~ptr ) ]->
   [
   A_WaitAck( $A, $B, ~ptr ),
   Out( <'proposal', $A, $B, ~ptr, sign(<'proposal', $A, $B, ~ptr>, ltkA)> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) B_Recv_Proposal:
   [ !Ltk( $B, ltkB ), !Pk( $A, pkA ), In( <'proposal', $A, $B, ptr, sigA> )
   ]
  --[
  ProposalExchange( $A, $B, ptr ),
  Eq( verify(sigA, <'proposal', $A, $B, ptr>, pkA), true )
  ]->
   [
   !ProposalCommitted( $A, $B, ptr ),
   Out( <'proposal_ack', $A, $B, ptr, sign(<'proposal', $A, $B, ptr>, ltkB)>
   )
   ]

  /*
  rule (modulo AC) B_Recv_Proposal:
     [ !Ltk( $B, ltkB ), !Pk( $A, pkA ), In( <'proposal', $A, $B, ptr, sigA> )
     ]
    --[ ProposalExchange( $A, $B, ptr ), Eq( z, true ) ]->
     [
     !ProposalCommitted( $A, $B, ptr ),
     Out( <'proposal_ack', $A, $B, ptr, sign(<'proposal', $A, $B, ptr>, ltkB)>
     )
     ]
    variants (modulo AC)
    1. $A    = $A.16
       $B    = $B.17
       pkA   = pkA.19
       ptr   = ptr.20
       sigA  = sigA.21
       z     = verify(sigA.21, <'proposal', $A.16, $B.17, ptr.20>, pkA.19)
    
    2. $A    = $A.23
       $B    = $B.24
       pkA   = pk(x.44)
       ptr   = ptr.27
       sigA  = sign(<'proposal', $A.23, $B.24, ptr.27>, x.44)
       z     = true
  */

rule (modulo E) A_Recv_From_B:
   [
   A_WaitAck( $A, $B, ptr ), !Pk( $B, pkB ),
   In( <'proposal_ack', $A, $B, ptr, sigB> )
   ]
  --[
  A_Received( $A, $B, ptr ),
  Eq( verify(sigB, <'proposal', $A, $B, ptr>, pkB), true )
  ]->
   [ !A_HandshakeDone( $A, $B, ptr ) ]

  /*
  rule (modulo AC) A_Recv_From_B:
     [
     A_WaitAck( $A, $B, ptr ), !Pk( $B, pkB ),
     In( <'proposal_ack', $A, $B, ptr, sigB> )
     ]
    --[ A_Received( $A, $B, ptr ), Eq( z, true ) ]->
     [ !A_HandshakeDone( $A, $B, ptr ) ]
    variants (modulo AC)
    1. $A    = $A.9
       $B    = $B.10
       pkB   = pkB.11
       ptr   = ptr.12
       sigB  = sigB.13
       z     = verify(sigB.13, <'proposal', $A.9, $B.10, ptr.12>, pkB.11)
    
    2. $A    = $A.12
       $B    = $B.13
       pkB   = pk(x.21)
       ptr   = ptr.15
       sigB  = sign(<'proposal', $A.12, $B.13, ptr.15>, x.21)
       z     = true
  */

rule (modulo E) Create_State_A:
   [ Fr( ~sA0 ), !Ltk( $A, ltkA ), !A_HandshakeDone( $A, $B, ptr ) ]
  --[ StateCreated( $A, '0', <'commit', ptr, $A, $B, '0', h(~sA0)> ) ]->
   [
   CommittedStateA( $A, $B, ptr, '0', ~sA0,
                    <'commit', ptr, $A, $B, '0', h(~sA0)>,
                    sign(<'commit', ptr, $A, $B, '0', h(~sA0)>, ltkA)
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Create_State_B:
   [ Fr( ~sB0 ), !Ltk( $B, ltkB ), !ProposalCommitted( $A, $B, ptr ) ]
  --[ StateCreated( $B, '0', <'commit', ptr, $B, $A, '0', h(~sB0)> ) ]->
   [
   CommittedStateB( $A, $B, ptr, '0', ~sB0,
                    <'commit', ptr, $B, $A, '0', h(~sB0)>,
                    sign(<'commit', ptr, $B, $A, '0', h(~sB0)>, ltkB)
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Both_States_Committed:
   [
   CommittedStateA( $A, $B, ptr, '0', sA0, commitA0, sigA0 ),
   CommittedStateB( $A, $B, ptr, '0', sB0, commitB0, sigB0 ),
   !Pk( $A, pkA ), !Pk( $B, pkB )
   ]
  --[
  Stage1Complete( $A, $B, ptr ), Eq( verify(sigA0, commitA0, pkA), true ),
  Eq( verify(sigB0, commitB0, pkB), true )
  ]->
   [ ReadyToLock( $A, $B, ptr, sA0, sB0, commitA0, commitB0 ) ]

  /*
  rule (modulo AC) Both_States_Committed:
     [
     CommittedStateA( $A, $B, ptr, '0', sA0, commitA0, sigA0 ),
     CommittedStateB( $A, $B, ptr, '0', sB0, commitB0, sigB0 ),
     !Pk( $A, pkA ), !Pk( $B, pkB )
     ]
    --[ Stage1Complete( $A, $B, ptr ), Eq( z, true ), Eq( z.1, true ) ]->
     [ ReadyToLock( $A, $B, ptr, sA0, sB0, commitA0, commitB0 ) ]
    variants (modulo AC)
    1. commitA0
             = commitA0.16
       commitB0
             = commitB0.17
       pkA   = pkA.18
       pkB   = pkB.19
       sigA0 = sigA0.23
       sigB0 = sigB0.24
       z     = verify(sigA0.23, commitA0.16, pkA.18)
       z.1   = verify(sigB0.24, commitB0.17, pkB.19)
    
    2. commitA0
             = commitA0.19
       commitB0
             = commitB0.20
       pkA   = pkA.21
       pkB   = pk(x.33)
       sigA0 = sigA0.26
       sigB0 = sign(commitB0.20, x.33)
       z     = verify(sigA0.26, commitA0.19, pkA.21)
       z.1   = true
    
    3. commitA0
             = commitA0.19
       commitB0
             = commitB0.20
       pkA   = pk(x.33)
       pkB   = pkB.22
       sigA0 = sign(commitA0.19, x.33)
       sigB0 = sigB0.27
       z     = true
       z.1   = verify(sigB0.27, commitB0.20, pkB.22)
    
    4. commitA0
             = commitA0.19
       commitB0
             = commitB0.20
       pkA   = pk(x.33)
       pkB   = pk(x.34)
       sigA0 = sign(commitA0.19, x.33)
       sigB0 = sign(commitB0.20, x.34)
       z     = true
       z.1   = true
  */

rule (modulo E) Lock_Funds_And_Open:
   [
   ReadyToLock( $A, $B, ptr, sA0, sB0, commitA0, commitB0 ),
   Wallet( $A, ~fA ), Wallet( $B, ~fB )
   ]
  --[
  ChannelOpen( $A, $B, ptr ), FundsLocked( $A, $B, ptr ),
  NewStateBuilt( $A, $B, ptr, '0', ~fA, ~fB )
  ]->
   [
   StateA( $A, $B, ptr, '0', sA0, commitA0, ~fA, ~fB ),
   StateB( $A, $B, ptr, '0', sB0, commitB0, ~fA, ~fB ),
   !ValidOnChain( ptr ), !ChannelRecord( ptr, $A, $B ),
   !ChannelConnect( ptr, $A, $B ), !ChannelConnect( ptr, $B, $A ),
   Mutex( ptr )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Update_State:
   [
   Fr( ~n_new ), Fr( ~sAnew ), Fr( ~sBnew ), !Ltk( $A, ltkA ),
   !Ltk( $B, ltkB ),
   StateA( $A, $B, ptr, n_old, sAold, oldCommitA, fA, fB ),
   StateB( $A, $B, ptr, n_old, sBold, oldCommitB, fA, fB ),
   In( <fA_new, fB_new> )
   ]
  --[ NewStateBuilt( $A, $B, ptr, ~n_new, fA_new, fB_new ) ]->
   [
   PendingA( $A, $B, ptr, n_old, sAold, oldCommitA, ~n_new, ~sAnew,
             <'commit', ptr, $A, $B, ~n_new, h(~sAnew)>,
             sign(<'commit', ptr, $A, $B, ~n_new, h(~sAnew)>, ltkA), fA_new, fB_new
   ),
   PendingB( $A, $B, ptr, n_old, sBold, oldCommitB, ~n_new, ~sBnew,
             <'commit', ptr, $B, $A, ~n_new, h(~sBnew)>,
             sign(<'commit', ptr, $B, $A, ~n_new, h(~sBnew)>, ltkB), fA_new, fB_new
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Revoke_Old_Secret:
   [
   PendingA( $A, $B, ptr, n_old, sAold, oldCommitA, n_new, sAnew,
             newCommitA, sigAnew, fA_new, fB_new
   ),
   PendingB( $A, $B, ptr, n_old, sBold, oldCommitB, n_new, sBnew,
             newCommitB, sigBnew, fA_new, fB_new
   ),
   !Pk( $A, pkA ), !Pk( $B, pkB )
   ]
  --[
  StateUpdate( $A, $B, ptr, n_new ), Revoke( $A, n_old, sAold ),
  Revoke( $B, n_old, sBold ), Eq( verify(sigAnew, newCommitA, pkA), true ),
  Eq( verify(sigBnew, newCommitB, pkB), true )
  ]->
   [
   StateA( $A, $B, ptr, n_new, sAnew, newCommitA, fA_new, fB_new ),
   StateB( $A, $B, ptr, n_new, sBnew, newCommitB, fA_new, fB_new ),
   !RevokedSecret( $A, n_old, sAold, oldCommitA ),
   !RevokedSecret( $B, n_old, sBold, oldCommitB ),
   RevokedCommitmentUnspent( ptr, $A, $B, n_old, oldCommitA ),
   RevokedCommitmentUnspent( ptr, $B, $A, n_old, oldCommitB )
   ]

  // loop breakers: [0,1]
  /*
  rule (modulo AC) Revoke_Old_Secret:
     [
     PendingA( $A, $B, ptr, n_old, sAold, oldCommitA, n_new, sAnew,
               newCommitA, sigAnew, fA_new, fB_new
     ),
     PendingB( $A, $B, ptr, n_old, sBold, oldCommitB, n_new, sBnew,
               newCommitB, sigBnew, fA_new, fB_new
     ),
     !Pk( $A, pkA ), !Pk( $B, pkB )
     ]
    --[
    StateUpdate( $A, $B, ptr, n_new ), Revoke( $A, n_old, sAold ),
    Revoke( $B, n_old, sBold ), Eq( z, true ), Eq( z.1, true )
    ]->
     [
     StateA( $A, $B, ptr, n_new, sAnew, newCommitA, fA_new, fB_new ),
     StateB( $A, $B, ptr, n_new, sBnew, newCommitB, fA_new, fB_new ),
     !RevokedSecret( $A, n_old, sAold, oldCommitA ),
     !RevokedSecret( $B, n_old, sBold, oldCommitB ),
     RevokedCommitmentUnspent( ptr, $A, $B, n_old, oldCommitA ),
     RevokedCommitmentUnspent( ptr, $B, $A, n_old, oldCommitB )
     ]
    variants (modulo AC)
    1. newCommitA
             = newCommitA.22
       newCommitB
             = newCommitB.22
       pkA   = pkA.22
       pkB   = pkB.22
       sigAnew
             = sigAnew.22
       sigBnew
             = sigBnew.22
       z     = verify(sigAnew.22, newCommitA.22, pkA.22)
       z.1   = verify(sigBnew.22, newCommitB.22, pkB.22)
    
    2. newCommitA
             = x.22
       newCommitB
             = x.23
       pkA   = pk(x.26)
       pkB   = pk(x.27)
       sigAnew
             = sign(x.22, x.26)
       sigBnew
             = sign(x.23, x.27)
       z     = true
       z.1   = true
    
    3. newCommitA
             = x.22
       newCommitB
             = newCommitB.27
       pkA   = pk(x.26)
       pkB   = pkB.27
       sigAnew
             = sign(x.22, x.26)
       sigBnew
             = sigBnew.27
       z     = true
       z.1   = verify(sigBnew.27, newCommitB.27, pkB.27)
    
    4. newCommitA
             = newCommitA.27
       newCommitB
             = x.22
       pkA   = pkA.27
       pkB   = pk(x.26)
       sigAnew
             = sigAnew.27
       sigBnew
             = sign(x.22, x.26)
       z     = verify(sigAnew.27, newCommitA.27, pkA.27)
       z.1   = true
    // loop breakers: [0,1]
  */

rule (modulo E) Publish_Old_Grace_Period_A:
   [
   PendingA( $A, $B, ptr, n_old, sAold, oldCommitA, n_new, sAnew,
             newCommitA, sigAnew, fA_new, fB_new
   ),
   !ValidOnChain( ptr )
   ]
  --[
  PublishOldBeforeRevocation( $A, n_old ), PublishState( $A, n_old ),
  OnChainDelayedProduce( $A, n_old ), OnChainInstantProduce( $B, n_old )
  ]->
   [
   OnChainDelayed( $A, n_old, oldCommitA ),
   OnChainInstant( $B, n_old, oldCommitA )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Publish_Old_Grace_Period_B:
   [
   PendingB( $A, $B, ptr, n_old, sBold, oldCommitB, n_new, sBnew,
             newCommitB, sigBnew, fA_new, fB_new
   ),
   !ValidOnChain( ptr )
   ]
  --[
  PublishOldBeforeRevocation( $B, n_old ), PublishState( $B, n_old ),
  OnChainDelayedProduce( $B, n_old ), OnChainInstantProduce( $A, n_old )
  ]->
   [
   OnChainDelayed( $B, n_old, oldCommitB ),
   OnChainInstant( $A, n_old, oldCommitB )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Publish_Current_A:
   [ StateA( $A, $B, ptr, n, sA, commitA, fA, fB ), !ValidOnChain( ptr ) ]
  --[
  Publish( $A, n, commitA ), PublishState( $A, n ),
  OnChainDelayedProduce( $A, n ), OnChainInstantProduce( $B, n )
  ]->
   [ OnChainDelayed( $A, n, commitA ), OnChainInstant( $B, n, commitA ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Publish_Current_B:
   [ StateB( $A, $B, ptr, n, sB, commitB, fA, fB ), !ValidOnChain( ptr ) ]
  --[
  Publish( $B, n, commitB ), PublishState( $B, n ),
  OnChainDelayedProduce( $B, n ), OnChainInstantProduce( $A, n )
  ]->
   [ OnChainDelayed( $B, n, commitB ), OnChainInstant( $A, n, commitB ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Publish_Pending_A:
   [
   PendingA( $A, $B, ptr, n_old, sAold, oldCommitA, n_new, sAnew,
             newCommitA, sigAnew, fA_new, fB_new
   ),
   !ValidOnChain( ptr )
   ]
  --[
  Publish( $A, n_new, newCommitA ), PublishFromPending( $A, n_old, n_new ),
  OnChainDelayedProduce( $A, n_new ), OnChainInstantProduce( $B, n_new )
  ]->
   [
   OnChainDelayed( $A, n_new, newCommitA ),
   OnChainInstant( $B, n_new, newCommitA )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Publish_Pending_B:
   [
   PendingB( $A, $B, ptr, n_old, sBold, oldCommitB, n_new, sBnew,
             newCommitB, sigBnew, fA_new, fB_new
   ),
   !ValidOnChain( ptr )
   ]
  --[
  Publish( $B, n_new, newCommitB ), PublishFromPending( $B, n_old, n_new ),
  OnChainDelayedProduce( $B, n_new ), OnChainInstantProduce( $A, n_new )
  ]->
   [
   OnChainDelayed( $B, n_new, newCommitB ),
   OnChainInstant( $A, n_new, newCommitB )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Honest_Close:
   [
   StateA( $A, $B, ptr, n, sA, commitA, fA, fB ),
   StateB( $A, $B, ptr, n, sB, commitB, fA, fB ), !ValidOnChain( ptr ),
   !Ltk( $A, ltkA ), !Ltk( $B, ltkB ), !Pk( $A, pkA ), !Pk( $B, pkB )
   ]
  --[
  Close( $A, $B, ptr, n ), OnChainInstantProduce( $A, n ),
  OnChainInstantProduce( $B, n ),
  Eq( verify(sign(<'commit', ptr, $A, $B, n, fA, fB>, ltkA),
             <'commit', ptr, $A, $B, n, fA, fB>, pkA),
      true
  ),
  Eq( verify(sign(<'commit', ptr, $A, $B, n, fA, fB>, ltkB),
             <'commit', ptr, $A, $B, n, fA, fB>, pkB),
      true
  )
  ]->
   [
   OnChainInstant( $A, n, <'commit', ptr, $A, $B, n, fA, fB> ),
   OnChainInstant( $B, n, <'commit', ptr, $A, $B, n, fA, fB> )
   ]

  /*
  rule (modulo AC) Honest_Close:
     [
     StateA( $A, $B, ptr, n, sA, commitA, fA, fB ),
     StateB( $A, $B, ptr, n, sB, commitB, fA, fB ), !ValidOnChain( ptr ),
     !Ltk( $A, ltkA ), !Ltk( $B, ltkB ), !Pk( $A, pkA ), !Pk( $B, pkB )
     ]
    --[
    Close( $A, $B, ptr, n ), OnChainInstantProduce( $A, n ),
    OnChainInstantProduce( $B, n ), Eq( z, true ), Eq( z.1, true )
    ]->
     [
     OnChainInstant( $A, n, <'commit', ptr, $A, $B, n, fA, fB> ),
     OnChainInstant( $B, n, <'commit', ptr, $A, $B, n, fA, fB> )
     ]
    variants (modulo AC)
    1. $A    = $A.19
       $B    = $B.20
       fA    = fA.23
       fB    = fB.24
       ltkA  = ltkA.25
       ltkB  = ltkB.26
       n     = n.27
       pkA   = pkA.28
       pkB   = pkB.29
       ptr   = ptr.30
       z     = verify(sign(<'commit', ptr.30, $A.19, $B.20, n.27, fA.23, fB.24>,
                           ltkA.25),
                      <'commit', ptr.30, $A.19, $B.20, n.27, fA.23, fB.24>, pkA.28)
       z.1   = verify(sign(<'commit', ptr.30, $A.19, $B.20, n.27, fA.23, fB.24>,
                           ltkB.26),
                      <'commit', ptr.30, $A.19, $B.20, n.27, fA.23, fB.24>, pkB.29)
    
    2. $A    = $A.20
       $B    = $B.21
       fA    = fA.24
       fB    = fB.25
       ltkA  = ltkA.26
       ltkB  = ltkB.27
       n     = n.28
       pkA   = pkA.29
       pkB   = pk(ltkB.27)
       ptr   = ptr.31
       z     = verify(sign(<'commit', ptr.31, $A.20, $B.21, n.28, fA.24, fB.25>,
                           ltkA.26),
                      <'commit', ptr.31, $A.20, $B.21, n.28, fA.24, fB.25>, pkA.29)
       z.1   = true
    
    3. $A    = $A.20
       $B    = $B.21
       fA    = fA.24
       fB    = fB.25
       ltkA  = ltkA.26
       ltkB  = ltkB.27
       n     = n.28
       pkA   = pk(ltkA.26)
       pkB   = pkB.30
       ptr   = ptr.31
       z     = true
       z.1   = verify(sign(<'commit', ptr.31, $A.20, $B.21, n.28, fA.24, fB.25>,
                           ltkB.27),
                      <'commit', ptr.31, $A.20, $B.21, n.28, fA.24, fB.25>, pkB.30)
    
    4. ltkA  = ltkA.20
       ltkB  = ltkB.21
       pkA   = pk(ltkA.20)
       pkB   = pk(ltkB.21)
       z     = true
       z.1   = true
  */

rule (modulo E) Publish_Revoked_A:
   [
   !ChannelRecord( ptr, $A, $B ), !ValidOnChain( ptr ),
   !RevokedSecret( $A, n_old, sAold, oldCommitA ),
   RevokedCommitmentUnspent( ptr, $A, $B, n_old, oldCommitA )
   ]
  --[ PublishRevoked( $A, n_old, oldCommitA ), Cheat( $A, n_old ) ]->
   [
   OnChainCheat( $A, $B, n_old, oldCommitA ),
   RevealedSecret( $A, n_old, sAold, oldCommitA )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Publish_Revoked_B:
   [
   !ChannelRecord( ptr, $A, $B ), !ValidOnChain( ptr ),
   !RevokedSecret( $B, n_old, sBold, oldCommitB ),
   RevokedCommitmentUnspent( ptr, $B, $A, n_old, oldCommitB )
   ]
  --[ PublishRevoked( $B, n_old, oldCommitB ), Cheat( $B, n_old ) ]->
   [
   OnChainCheat( $B, $A, n_old, oldCommitB ),
   RevealedSecret( $B, n_old, sBold, oldCommitB )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Punish_A:
   [
   OnChainCheat( $A, $B, n_old, oldCommitA ),
   RevealedSecret( $A, n_old, sAold, oldCommitA )
   ]
  --[ Punish( $B, $A, n_old ) ]->
   [ AllFundsTo( $B ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Punish_B:
   [
   OnChainCheat( $B, $A, n_old, oldCommitB ),
   RevealedSecret( $B, n_old, sBold, oldCommitB )
   ]
  --[ Punish( $A, $B, n_old ) ]->
   [ AllFundsTo( $A ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Instant_Funds_A:
   [ OnChainInstant( $A, n, txContent ) ]
  --[ FundsSettled( $A, n ), SettledTx( $A, txContent ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Instant_Funds_B:
   [ OnChainInstant( $B, n, txContent ) ]
  --[ FundsSettled( $B, n ), SettledTx( $B, txContent ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Claim_Funds_A:
   [ OnChainDelayed( $A, n, txContent ) ]
  --[ ClaimFunds( $A, n ), CSVPassed( $A, n ), SettledTx( $A, txContent )
  ]->
   [ FundsTo( $A, n ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Claim_Funds_B:
   [ OnChainDelayed( $B, n, txContent ) ]
  --[ ClaimFunds( $B, n ), CSVPassed( $B, n ), SettledTx( $B, txContent )
  ]->
   [ FundsTo( $B, n ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Receiver_Create_Invoice:
   [ Fr( ~x ), !Ltk( $Receiver, ltkR ) ]
  --[
  InvoiceCreated( $Receiver, $Sender, h(~x) ),
  SecretPreimage( $Receiver, ~x )
  ]->
   [
   ReceiverInv( $Receiver, $Sender, ~x ),
   Out( <'SecretRS', <'invoice', $Receiver, $Sender, h(~x)>, 
         sign(<'invoice', $Receiver, $Sender, h(~x)>, ltkR)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sender_Offer_HTLC:
   [
   In( <'SecretRS', <'invoice', $Receiver, $Sender, y>, sigR> ),
   !Pk( $Receiver, pkR ), !Ltk( $Sender, ltkS ),
   !ChannelConnect( ptrSF, $Sender, $Forward1 ), Mutex( ptrSF )
   ]
  --[
  HTLCOffered( $Sender, $Forward1, ptrSF, y ),
  OfferFor( $Sender, $Receiver, ptrSF, y ), HTLCAdded( ptrSF, y ),
  Neq( $Sender, $Forward1 ), Neq( $Sender, $Receiver ),
  Neq( $Forward1, $Receiver ),
  Eq( verify(sigR, <'invoice', $Receiver, $Sender, y>, pkR), true )
  ]->
   [
   SenderPending( $Sender, $Forward1, $Receiver, ptrSF, y ),
   Route( $Sender, $Forward1, ptrSF, y ),
   !RouteInfo( $Sender, $Forward1, ptrSF, y )
   ]

  /*
  rule (modulo AC) Sender_Offer_HTLC:
     [
     In( <'SecretRS', <'invoice', $Receiver, $Sender, y>, sigR> ),
     !Pk( $Receiver, pkR ), !Ltk( $Sender, ltkS ),
     !ChannelConnect( ptrSF, $Sender, $Forward1 ), Mutex( ptrSF )
     ]
    --[
    HTLCOffered( $Sender, $Forward1, ptrSF, y ),
    OfferFor( $Sender, $Receiver, ptrSF, y ), HTLCAdded( ptrSF, y ),
    Neq( $Sender, $Forward1 ), Neq( $Sender, $Receiver ),
    Neq( $Forward1, $Receiver ), Eq( z, true )
    ]->
     [
     SenderPending( $Sender, $Forward1, $Receiver, ptrSF, y ),
     Route( $Sender, $Forward1, ptrSF, y ),
     !RouteInfo( $Sender, $Forward1, ptrSF, y )
     ]
    variants (modulo AC)
    1. $Receiver
             = $Receiver.19
       $Sender
             = $Sender.20
       pkR   = pkR.22
       sigR  = sigR.24
       y     = y.25
       z     = verify(sigR.24, <'invoice', $Receiver.19, $Sender.20, y.25>,
                      pkR.22)
    
    2. $Receiver
             = $Receiver.26
       $Sender
             = $Sender.27
       pkR   = pk(x.49)
       sigR  = sign(<'invoice', $Receiver.26, $Sender.27, y.32>, x.49)
       y     = y.32
       z     = true
  */

rule (modulo E) Forward_HTLC:
   [
   Route( $Prev, $Me, ptrIn, y ), !ChannelConnect( ptrOut, $Me, $Next ),
   Mutex( ptrOut ), In( %vIn ), In( %fee ), In( %vOut )
   ]
  --[
  HTLCForwarded( $Me, $Prev, $Next, ptrIn, ptrOut, y ),
  HTLCAdded( ptrOut, y ), FeeCharged( $Me, y, %fee ),
  Eq( %vIn, (%fee%+%vOut) ), Neq( ptrIn, ptrOut ), Neq( $Prev, $Me ),
  Neq( $Me, $Next )
  ]->
   [
   IntermediaryPending( $Me, $Prev, $Next, ptrIn, ptrOut, y, %vIn, %vOut,
                        %fee
   ),
   Route( $Me, $Next, ptrOut, y ), !RouteInfo( $Me, $Next, ptrOut, y )
   ]

  // loop breakers: [0,2]
  /* has exactly the trivial AC variant */

rule (modulo E) Receiver_Fulfill_HTLC:
   [
   Route( $Prev, $Receiver, ptrIn, y ), ReceiverInv( $Receiver, $Sender, x )
   ]
  --[
  HTLCFulfilled( $Receiver, $Prev, ptrIn, y ),
  PreimageReleased( $Receiver, x ), Redeemed( ptrIn, y ), Old( ptrIn, y ),
  Eq( h(x), y )
  ]->
   [ Fulfilled( ptrIn, x ), Mutex( ptrIn ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Intermediary_Settle:
   [
   IntermediaryPending( $Me, $Prev, $Next, ptrIn, ptrOut, y, %vIn, %vOut,
                        %fee
   ),
   Fulfilled( ptrOut, x )
   ]
  --[
  IntermediaryClaimed( $Me, $Prev, ptrIn, x ), UsedFulfilled( ptrOut, x ),
  SettledHop( ptrIn, ptrOut, y ), FeeEarned( $Me, ptrIn, ptrOut, y, %fee ),
  Redeemed( ptrIn, y ), Old( ptrIn, y ), FulfilledProduced( ptrIn, x ),
  Eq( h(x), y )
  ]->
   [ Fulfilled( ptrIn, x ), Mutex( ptrIn ) ]

  // loop breaker: [1]
  /* has exactly the trivial AC variant */

rule (modulo E) Sender_Settle:
   [
   SenderPending( $Sender, $Forward1, $Receiver, ptrSF, y ),
   Fulfilled( ptrSF, x )
   ]
  --[
  SenderSettled( $Sender, $Forward1, $Receiver, ptrSF, x ),
  UsedFulfilled( ptrSF, x ), Eq( h(x), y )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Open_Timeout:
   [ !ChannelConnect( ptr, A, B ) ]
  --[ TimedOut( ptr ) ]->
   [ !Timeout( ptr ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sender_Timeout_Refund:
   [
   SenderPending( $Sender, $Forward1, $Receiver, ptrSF, y ),
   !Timeout( ptrSF )
   ]
  --[ Refunded( $Sender, ptrSF, y ), Old( ptrSF, y ) ]->
   [ Mutex( ptrSF ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Intermediary_Timeout_Refund:
   [
   IntermediaryPending( $Me, $Prev, $Next, ptrIn, ptrOut, y, %vIn, %vOut,
                        %fee
   ),
   !Timeout( ptrOut )
   ]
  --[
  Refunded( $Me, ptrOut, y ), RefundHop( ptrIn, ptrOut, y ),
  Old( ptrOut, y )
  ]->
   [ Mutex( ptrOut ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) AttackerSkip:
   [
   Fulfilled( ptrExit, x ),
   !RouteInfo( ExitAtt, Next, ptrExit, y )[-, no_precomp],
   !RouteInfo( EntryAtt, Skipped, ptrSkip, y )[-, no_precomp],
   !Compromised( ExitAtt ), !Compromised( EntryAtt )
   ]
  --[ FulfilledProduced( ptrSkip, x ), Skipped( ptrSkip, x ), Eq( h(x), y )
  ]->
   [ Fulfilled( ptrSkip, x ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

restriction OneResolutionPerHTLC:
  "∀ ptr y #i #j.
    ((Old( ptr, y ) @ #i) ∧ (Old( ptr, y ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction OneHTLCPerHashPerChannel:
  "∀ ptr y #m #n.
    ((HTLCAdded( ptr, y ) @ #m) ∧ (HTLCAdded( ptr, y ) @ #n)) ⇒ (#m = #n)"
  // safety formula

restriction Inequality:
  "∀ x y #i. (Neq( x, y ) @ #i) ⇒ (¬(x = y))"
  // safety formula

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction OneTimeoutPerPtr:
  "∀ ptr #i #j.
    ((TimedOut( ptr ) @ #i) ∧ (TimedOut( ptr ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction OneChannelPerPtr:
  "∀ A B C D ptr #i #j.
    ((ChannelOpen( A, B, ptr ) @ #i) ∧ (ChannelOpen( C, D, ptr ) @ #j)) ⇒
    (#i = #j)"
  // safety formula

lemma ForwardTimeGap:
  all-traces
  "∀ P Prev Next ptrIn ptrOut y #f #j #k.
    ((((HTLCForwarded( P, Prev, Next, ptrIn, ptrOut, y ) @ #f) ∧
       (TimedOut( ptrOut ) @ #j)) ∧
      (TimedOut( ptrIn ) @ #k)) ∧
     (¬(∃ #c. (LtkCompromised( P ) @ #c) ∧ (#c < #k)))) ⇒
    (#j < #k)"
/*
guarded formula characterizing all counter-examples:
"∃ P Prev Next ptrIn ptrOut y #f #j #k.
  (HTLCForwarded( P, Prev, Next, ptrIn, ptrOut, y ) @ #f) ∧
  (TimedOut( ptrOut ) @ #j) ∧
  (TimedOut( ptrIn ) @ #k)
 ∧
  (∀ #c. (LtkCompromised( P ) @ #c) ⇒ ¬(#c < #k)) ∧ (¬(#j < #k))"
*/
by sorry

lemma state_update [use_induction]:
  all-traces
  "∀ A B ptr n #i.
    (StateUpdate( A, B, ptr, n ) @ #i) ⇒
    (∃ #j. (ChannelOpen( A, B, ptr ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ A B ptr n #i.
  (StateUpdate( A, B, ptr, n ) @ #i)
 ∧
  ∀ #j. (ChannelOpen( A, B, ptr ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

lemma delayed_funds:
  all-traces
  "∀ A n #i.
    (ClaimFunds( A, n ) @ #i) ⇒
    (∃ #j. (OnChainDelayedProduce( A, n ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ A n #i.
  (ClaimFunds( A, n ) @ #i)
 ∧
  ∀ #j. (OnChainDelayedProduce( A, n ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

lemma instant_funds:
  all-traces
  "∀ A n #i.
    (FundsSettled( A, n ) @ #i) ⇒
    (∃ #j. (OnChainInstantProduce( A, n ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ A n #i.
  (FundsSettled( A, n ) @ #i)
 ∧
  ∀ #j. (OnChainInstantProduce( A, n ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

lemma settlement_is_traceable:
  all-traces
  "∀ A n #i.
    (FundsSettled( A, n ) @ #i) ⇒
    (∃ tx #j. (SettledTx( A, tx ) @ #j) ∧ (#j = #i))"
/*
guarded formula characterizing all counter-examples:
"∃ A n #i.
  (FundsSettled( A, n ) @ #i)
 ∧
  ∀ tx #j. (SettledTx( A, tx ) @ #j) ∧ (#j = #i) ⇒ ⊥"
*/
by sorry

lemma Protocol_execution:
  exists-trace
  "∃ A B ptr n fA fB #i #j #k #l.
    (((((((ChannelOpen( A, B, ptr ) @ #i) ∧
          (NewStateBuilt( A, B, ptr, n, fA, fB ) @ #j)) ∧
         (StateUpdate( A, B, ptr, n ) @ #k)) ∧
        (Close( A, B, ptr, n ) @ #l)) ∧
       (#i < #j)) ∧
      (#j < #k)) ∧
     (#k < #l)) ∧
    (¬(∃ ptr.1 y1 y2 #m #n.1.
        ((HTLCAdded( ptr.1, y1 ) @ #m) ∧ (HTLCAdded( ptr.1, y2 ) @ #n.1)) ∧
        (¬(#m = #n.1))))"
/*
guarded formula characterizing all satisfying traces:
"∃ A B ptr n fA fB #i #j #k #l.
  (ChannelOpen( A, B, ptr ) @ #i) ∧
  (NewStateBuilt( A, B, ptr, n, fA, fB ) @ #j) ∧
  (StateUpdate( A, B, ptr, n ) @ #k) ∧
  (Close( A, B, ptr, n ) @ #l)
 ∧
  (#i < #j) ∧
  (#j < #k) ∧
  (#k < #l) ∧
  (∀ ptr.1 y1 y2 #m #n.1.
    (HTLCAdded( ptr.1, y1 ) @ #m) ∧ (HTLCAdded( ptr.1, y2 ) @ #n.1)
   ⇒
    #m = #n.1)"
*/
by sorry

lemma No_Punishment_Without_Cheating:
  all-traces
  "∀ A B n #i.
    (Punish( B, A, n ) @ #i) ⇒
    ((∃ #k. (Cheat( A, n ) @ #k) ∧ (#k < #i)) ∨
     (∃ #j. (LtkCompromised( A ) @ #j) ∧ (#j < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ A B n #i.
  (Punish( B, A, n ) @ #i)
 ∧
  (∀ #k. (Cheat( A, n ) @ #k) ⇒ ¬(#k < #i)) ∧
  (∀ #j. (LtkCompromised( A ) @ #j) ⇒ ¬(#j < #i))"
*/
by sorry

lemma Cooperative_Close_Execution:
  exists-trace
  "∃ A B ptr n #k #i.
    ((((ChannelOpen( A, B, ptr ) @ #k) ∧ (Close( A, B, ptr, n ) @ #i)) ∧
      (#k < #i)) ∧
     (¬(∃ A2 B2 ptr2 n2 #j. StateUpdate( A2, B2, ptr2, n2 ) @ #j))) ∧
    (¬(∃ ptr.1 y1 y2 #m #n.1.
        ((HTLCAdded( ptr.1, y1 ) @ #m) ∧ (HTLCAdded( ptr.1, y2 ) @ #n.1)) ∧
        (¬(#m = #n.1))))"
/*
guarded formula characterizing all satisfying traces:
"∃ A B ptr n #k #i.
  (ChannelOpen( A, B, ptr ) @ #k) ∧ (Close( A, B, ptr, n ) @ #i)
 ∧
  (#k < #i) ∧
  (∀ A2 B2 ptr2 n2 #j. (StateUpdate( A2, B2, ptr2, n2 ) @ #j) ⇒ ⊥) ∧
  (∀ ptr.1 y1 y2 #m #n.1.
    (HTLCAdded( ptr.1, y1 ) @ #m) ∧ (HTLCAdded( ptr.1, y2 ) @ #n.1)
   ⇒
    #m = #n.1)"
*/
by sorry

lemma Funds_Locked_Before_Update [use_induction]:
  all-traces
  "∀ A B ptr n #i.
    (StateUpdate( A, B, ptr, n ) @ #i) ⇒
    (∃ #j. (FundsLocked( A, B, ptr ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ A B ptr n #i.
  (StateUpdate( A, B, ptr, n ) @ #i)
 ∧
  ∀ #j. (FundsLocked( A, B, ptr ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

lemma Update_Requires_Negotiation [use_induction]:
  all-traces
  "∀ A B ptr n #i.
    (StateUpdate( A, B, ptr, n ) @ #i) ⇒
    (∃ fA fB #j. (NewStateBuilt( A, B, ptr, n, fA, fB ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ A B ptr n #i.
  (StateUpdate( A, B, ptr, n ) @ #i)
 ∧
  ∀ fA fB #j. (NewStateBuilt( A, B, ptr, n, fA, fB ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

lemma OneOutcomePerHTLC [reuse]:
  all-traces
  "∀ Up ptr y #i #j.
    ((Redeemed( ptr, y ) @ #i) ∧ (Refunded( Up, ptr, y ) @ #j)) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ Up ptr y #i #j.
  (Redeemed( ptr, y ) @ #i) ∧ (Refunded( Up, ptr, y ) @ #j)"
*/
simplify
solve( Redeemed( ptr, y ) @ #i )
  case Intermediary_Settle
  solve( IntermediaryPending( $Me, $Prev, $Next, ptr, ptrOut, h(x), %vIn,
                              %vOut, %fee
         ) ▶₀ #i )
    case Forward_HTLC_case_1
    by solve( Refunded( Up, ptr, h(x) ) @ #j )
  next
    case Forward_HTLC_case_2
    by solve( Refunded( Up, ptr, h(x) ) @ #j )
  qed
next
  case Receiver_Fulfill_HTLC
  solve( ReceiverInv( $Receiver, $Sender, x ) ▶₁ #i )
    case Receiver_Create_Invoice
    by solve( Refunded( Up, ptr, h(~x) ) @ #j )
  qed
qed

lemma Ltk_Known_Implies_Compromised [reuse]:
  all-traces
  "∀ A ltk #i #j.
    ((KeyGen( A, ltk ) @ #i) ∧ (!KU( ltk ) @ #j)) ⇒
    (∃ #k. LtkCompromised( A ) @ #k)"
/*
guarded formula characterizing all counter-examples:
"∃ A ltk #i #j.
  (KeyGen( A, ltk ) @ #i) ∧ (!KU( ltk ) @ #j)
 ∧
  ∀ #k. (LtkCompromised( A ) @ #k) ⇒ ⊥"
*/
simplify
solve( !KU( ~ltk ) @ #j )
  case Compromise_Ltk
  by contradiction /* from formulas */
qed

lemma Invoice_Released_Once [reuse]:
  all-traces
  "∀ R x #i #j.
    ((PreimageReleased( R, x ) @ #i) ∧ (PreimageReleased( R, x ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ R x #i #j.
  (PreimageReleased( R, x ) @ #i) ∧ (PreimageReleased( R, x ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( ReceiverInv( $Receiver, $Sender, x ) ▶₁ #i )
    case Receiver_Create_Invoice
    solve( ReceiverInv( $Receiver, $Sender.1, ~x ) ▶₁ #j )
      case Receiver_Create_Invoice
      by contradiction /* cyclic */
    qed
  qed
next
  case case_2
  solve( ReceiverInv( $Receiver, $Sender, x ) ▶₁ #i )
    case Receiver_Create_Invoice
    solve( ReceiverInv( $Receiver, $Sender.1, ~x ) ▶₁ #j )
      case Receiver_Create_Invoice
      by contradiction /* cyclic */
    qed
  qed
qed

lemma Distinct_Parties_Configuration:
  exists-trace
  "∃ S F1 F2 R ptrSF1 ptrF1F2 ptrF2R #t1 #t2 #t3.
    (((((((((((((((ChannelOpen( S, F1, ptrSF1 ) @ #t1) ∧
                  (ChannelOpen( F1, F2, ptrF1F2 ) @ #t2)) ∧
                 (ChannelOpen( F2, R, ptrF2R ) @ #t3)) ∧
                (¬(S = F1))) ∧
               (¬(S = F2))) ∧
              (¬(S = R))) ∧
             (¬(F1 = F2))) ∧
            (¬(F1 = R))) ∧
           (¬(F2 = R))) ∧
          (¬(∃ P #i. LtkCompromised( P ) @ #i))) ∧
         (¬(∃ P Q p n #j. StateUpdate( P, Q, p, n ) @ #j))) ∧
        (¬(∃ P n #k. PublishState( P, n ) @ #k))) ∧
       (¬(∃ P Q p n #l. Close( P, Q, p, n ) @ #l))) ∧
      (¬(∃ P n #m. Cheat( P, n ) @ #m))) ∧
     (¬(∃ Me Prev Next pi po y #n.
         HTLCForwarded( Me, Prev, Next, pi, po, y ) @ #n))) ∧
    (¬(∃ ptr y1 y2 #m #n.
        ((HTLCAdded( ptr, y1 ) @ #m) ∧ (HTLCAdded( ptr, y2 ) @ #n)) ∧
        (¬(#m = #n))))"
/*
guarded formula characterizing all satisfying traces:
"∃ S F1 F2 R ptrSF1 ptrF1F2 ptrF2R #t1 #t2 #t3.
  (ChannelOpen( S, F1, ptrSF1 ) @ #t1) ∧
  (ChannelOpen( F1, F2, ptrF1F2 ) @ #t2) ∧
  (ChannelOpen( F2, R, ptrF2R ) @ #t3)
 ∧
  (¬(S = F1)) ∧
  (¬(S = F2)) ∧
  (¬(S = R)) ∧
  (¬(F1 = F2)) ∧
  (¬(F1 = R)) ∧
  (¬(F2 = R)) ∧
  (∀ P #i. (LtkCompromised( P ) @ #i) ⇒ ⊥) ∧
  (∀ P Q p n #j. (StateUpdate( P, Q, p, n ) @ #j) ⇒ ⊥) ∧
  (∀ P n #k. (PublishState( P, n ) @ #k) ⇒ ⊥) ∧
  (∀ P Q p n #l. (Close( P, Q, p, n ) @ #l) ⇒ ⊥) ∧
  (∀ P n #m. (Cheat( P, n ) @ #m) ⇒ ⊥) ∧
  (∀ Me Prev Next pi po y #n.
    (HTLCForwarded( Me, Prev, Next, pi, po, y ) @ #n) ⇒ ⊥) ∧
  (∀ ptr y1 y2 #m #n.
    (HTLCAdded( ptr, y1 ) @ #m) ∧ (HTLCAdded( ptr, y2 ) @ #n) ⇒ #m = #n)"
*/
by sorry

lemma Refund_Possible:
  exists-trace
  "∃ S F1 R p y #i #j #k.
    ((((((((InvoiceCreated( R, S, y ) @ #j) ∧
           (HTLCOffered( S, F1, p, y ) @ #k)) ∧
          (Refunded( S, p, y ) @ #i)) ∧
         (#j < #k)) ∧
        (#k < #i)) ∧
       (¬(∃ A MidP B p2 x #l. SenderSettled( A, MidP, B, p2, x ) @ #l))) ∧
      (¬(∃ P #r. LtkCompromised( P ) @ #r))) ∧
     (¬(∃ Me Prev Next pi po y2 #t1.
         HTLCForwarded( Me, Prev, Next, pi, po, y2 ) @ #t1))) ∧
    (¬(∃ ptr y1 y2 #m #n.
        ((HTLCAdded( ptr, y1 ) @ #m) ∧ (HTLCAdded( ptr, y2 ) @ #n)) ∧
        (¬(#m = #n))))"
/*
guarded formula characterizing all satisfying traces:
"∃ S F1 R p y #i #j #k.
  (InvoiceCreated( R, S, y ) @ #j) ∧
  (HTLCOffered( S, F1, p, y ) @ #k) ∧
  (Refunded( S, p, y ) @ #i)
 ∧
  (#j < #k) ∧
  (#k < #i) ∧
  (∀ A MidP B p2 x #l. (SenderSettled( A, MidP, B, p2, x ) @ #l) ⇒ ⊥) ∧
  (∀ P #r. (LtkCompromised( P ) @ #r) ⇒ ⊥) ∧
  (∀ Me Prev Next pi po y2 #t1.
    (HTLCForwarded( Me, Prev, Next, pi, po, y2 ) @ #t1) ⇒ ⊥) ∧
  (∀ ptr y1 y2 #m #n.
    (HTLCAdded( ptr, y1 ) @ #m) ∧ (HTLCAdded( ptr, y2 ) @ #n) ⇒ #m = #n)"
*/
by sorry

lemma Preimage_Secret_Until_Released:
  all-traces
  "∀ R x #i #j.
    (((SecretPreimage( R, x ) @ #i) ∧ (K( x ) @ #j)) ∧ (#i < #j)) ⇒
    (∃ #k. (PreimageReleased( R, x ) @ #k) ∧ (#k < #j))"
/*
guarded formula characterizing all counter-examples:
"∃ R x #i #j.
  (SecretPreimage( R, x ) @ #i) ∧ (K( x ) @ #j)
 ∧
  (#i < #j) ∧ (∀ #k. (PreimageReleased( R, x ) @ #k) ⇒ ¬(#k < #j))"
*/
by sorry

lemma Invoice_Has_Secret_Preimage [reuse]:
  all-traces
  "∀ R S x #i.
    (InvoiceCreated( R, S, h(x) ) @ #i) ⇒ (SecretPreimage( R, x ) @ #i)"
/*
guarded formula characterizing all counter-examples:
"∃ R S x #i.
  (InvoiceCreated( R, S, h(x) ) @ #i) ∧ ¬(SecretPreimage( R, x ) @ #i)"
*/
simplify
by contradiction /* from formulas */

lemma HTLC_On_Opened_Channel [reuse, use_induction]:
  all-traces
  "∀ ptr y #i.
    (HTLCAdded( ptr, y ) @ #i) ⇒
    (∃ X Y #j. (ChannelOpen( X, Y, ptr ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ ptr y #i.
  (HTLCAdded( ptr, y ) @ #i)
 ∧
  ∀ X Y #j. (ChannelOpen( X, Y, ptr ) @ #j) ⇒ ¬(#j < #i)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (last(#i))  ∥
         (∃ X Y #j. (ChannelOpen( X, Y, ptr ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) )
    case case_1
    solve( HTLCAdded( ptr, y ) @ #i )
      case Forward_HTLC
      solve( !ChannelConnect( ptr, $Me, $Next ) ▶₁ #i )
        case Lock_Funds_And_Open_case_1
        by contradiction /* from formulas */
      next
        case Lock_Funds_And_Open_case_2
        by contradiction /* from formulas */
      qed
    next
      case Sender_Offer_HTLC
      solve( !Pk( $Receiver, pk(x) ) ▶₁ #i )
        case Register_key
        solve( !Ltk( $Sender, ltkS ) ▶₂ #i )
          case Register_key
          solve( !ChannelConnect( ptr, $Sender, $Forward1 ) ▶₃ #i )
            case Lock_Funds_And_Open_case_1
            by contradiction /* from formulas */
          next
            case Lock_Funds_And_Open_case_2
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  next
    case case_2
    by contradiction /* from formulas */
  qed
qed

lemma Fulfilled_Requires_Release [reuse, use_induction, heuristic=S]:
  all-traces
  "∀ ptr x #i.
    (FulfilledProduced( ptr, x ) @ #i) ⇒
    (∃ R #k. (PreimageReleased( R, x ) @ #k) ∧ (#k < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ ptr x #i.
  (FulfilledProduced( ptr, x ) @ #i)
 ∧
  ∀ R #k. (PreimageReleased( R, x ) @ #k) ⇒ ¬(#k < #i)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (last(#i))  ∥
         (∃ R #k. (PreimageReleased( R, x ) @ #k) ∧ (¬(last(#k))) ∧ (#k < #i)) )
    case case_1
    solve( FulfilledProduced( ptr, x ) @ #i )
      case AttackerSkip
      solve( !Compromised( ExitAtt ) ▶₃ #i )
        case Compromise_Ltk
        solve( !Compromised( EntryAtt ) ▶₄ #i )
          case Compromise_Ltk
          solve( Fulfilled( ptrExit, x ) ▶₀ #i )
            case AttackerSkip
            by contradiction /* from formulas */
          next
            case Intermediary_Settle_case_1
            by contradiction /* from formulas */
          next
            case Intermediary_Settle_case_2
            by contradiction /* from formulas */
          next
            case Receiver_Fulfill_HTLC
            by contradiction /* from formulas */
          qed
        qed
      qed
    next
      case Intermediary_Settle
      solve( IntermediaryPending( $Me, $Prev, $Next, ptr, ptrOut, h(x), %vIn,
                                  %vOut, %fee
             ) ▶₀ #i )
        case Forward_HTLC_case_1
        solve( Fulfilled( ~ptr.1, x ) ▶₁ #i )
          case AttackerSkip
          by contradiction /* from formulas */
        next
          case Intermediary_Settle_case_1
          by contradiction /* from formulas */
        next
          case Intermediary_Settle_case_2
          by contradiction /* from formulas */
        next
          case Receiver_Fulfill_HTLC
          by contradiction /* from formulas */
        qed
      next
        case Forward_HTLC_case_2
        solve( Fulfilled( ~ptr.1, x ) ▶₁ #i )
          case AttackerSkip
          by contradiction /* from formulas */
        next
          case Intermediary_Settle_case_1
          by contradiction /* from formulas */
        next
          case Intermediary_Settle_case_2
          by contradiction /* from formulas */
        next
          case Receiver_Fulfill_HTLC
          by contradiction /* from formulas */
        qed
      qed
    qed
  next
    case case_2
    by contradiction /* from formulas */
  qed
qed

lemma Settle_Requires_Receiver_Release:
  all-traces
  "∀ S F1 R ptr x #i #j.
    ((SenderSettled( S, F1, R, ptr, x ) @ #i) ∧
     (InvoiceCreated( R, S, h(x) ) @ #j)) ⇒
    (∃ #k. (PreimageReleased( R, x ) @ #k) ∧ (#k < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ S F1 R ptr x #i #j.
  (SenderSettled( S, F1, R, ptr, x ) @ #i) ∧
  (InvoiceCreated( R, S, h(x) ) @ #j)
 ∧
  ∀ #k. (PreimageReleased( R, x ) @ #k) ⇒ ¬(#k < #i)"
*/
by sorry

lemma Claim_Requires_Release [use_induction]:
  all-traces
  "∀ MidP InP ptrIn R x #i #j.
    ((IntermediaryClaimed( MidP, InP, ptrIn, x ) @ #i) ∧
     (SecretPreimage( R, x ) @ #j)) ⇒
    (∃ #k. (PreimageReleased( R, x ) @ #k) ∧ (#k < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ MidP InP ptrIn R x #i #j.
  (IntermediaryClaimed( MidP, InP, ptrIn, x ) @ #i) ∧
  (SecretPreimage( R, x ) @ #j)
 ∧
  ∀ #k. (PreimageReleased( R, x ) @ #k) ⇒ ¬(#k < #i)"
*/
by sorry

lemma Forward_Requires_Incoming [use_induction]:
  all-traces
  "∀ Me Prev Next ptrIn ptrOut y #i.
    (HTLCForwarded( Me, Prev, Next, ptrIn, ptrOut, y ) @ #i) ⇒
    ((∃ S #j. (HTLCOffered( S, Me, ptrIn, y ) @ #j) ∧ (#j < #i)) ∨
     (∃ P0 pin0 #j.
       (HTLCForwarded( Prev, P0, Me, pin0, ptrIn, y ) @ #j) ∧ (#j < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ Me Prev Next ptrIn ptrOut y #i.
  (HTLCForwarded( Me, Prev, Next, ptrIn, ptrOut, y ) @ #i)
 ∧
  (∀ S #j. (HTLCOffered( S, Me, ptrIn, y ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ P0 pin0 #j.
    (HTLCForwarded( Prev, P0, Me, pin0, ptrIn, y ) @ #j) ⇒ ¬(#j < #i))"
*/
by sorry

lemma Redeem_Requires_Receiver_Release [use_induction]:
  all-traces
  "∀ ptr y #i.
    (Redeemed( ptr, y ) @ #i) ⇒
    (∃ R x #k. (PreimageReleased( R, x ) @ #k) ∧ (h(x) = y))"
/*
guarded formula characterizing all counter-examples:
"∃ ptr y #i.
  (Redeemed( ptr, y ) @ #i)
 ∧
  ∀ R x #k. (PreimageReleased( R, x ) @ #k) ∧ (h(x) = y) ⇒ ⊥"
*/
by sorry

lemma Settle_Excludes_Sender_Refund [heuristic={sender_pending}]:
  all-traces
  "∀ S F1 R ptr x #i.
    (SenderSettled( S, F1, R, ptr, x ) @ #i) ⇒
    (¬(∃ #j. Refunded( S, ptr, h(x) ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ S F1 R ptr x #i.
  (SenderSettled( S, F1, R, ptr, x ) @ #i)
 ∧
  ∃ #j. (Refunded( S, ptr, h(x) ) @ #j)"
*/
by sorry

lemma Invoice_Authenticates_Settlement:
  all-traces
  "∀ S F1 R ptr x #i.
    (SenderSettled( S, F1, R, ptr, x ) @ #i) ⇒
    ((∃ #j. (InvoiceCreated( R, S, h(x) ) @ #j) ∧ (#j < #i)) ∨
     (∃ #r. (LtkCompromised( R ) @ #r) ∧ (#r < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ S F1 R ptr x #i.
  (SenderSettled( S, F1, R, ptr, x ) @ #i)
 ∧
  (∀ #j. (InvoiceCreated( R, S, h(x) ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #r. (LtkCompromised( R ) @ #r) ⇒ ¬(#r < #i))"
*/
by sorry

lemma Forged_Invoice_Requires_Key_Compromise:
  exists-trace
  "∃ S F1 R ptr x #i #r.
    (((SenderSettled( S, F1, R, ptr, x ) @ #i) ∧
      (LtkCompromised( R ) @ #r)) ∧
     (¬(∃ #j. InvoiceCreated( R, S, h(x) ) @ #j))) ∧
    (¬(∃ Me Prev Next pi po y #u.
        HTLCForwarded( Me, Prev, Next, pi, po, y ) @ #u))"
/*
guarded formula characterizing all satisfying traces:
"∃ S F1 R ptr x #i #r.
  (SenderSettled( S, F1, R, ptr, x ) @ #i) ∧ (LtkCompromised( R ) @ #r)
 ∧
  (∀ #j. (InvoiceCreated( R, S, h(x) ) @ #j) ⇒ ⊥) ∧
  (∀ Me Prev Next pi po y #u.
    (HTLCForwarded( Me, Prev, Next, pi, po, y ) @ #u) ⇒ ⊥)"
*/
by sorry

lemma Loss_Requires_Inaction:
  all-traces
  "∀ P Prev Next Up ptrIn ptrOut y #i #j #k.
    (((HTLCForwarded( P, Prev, Next, ptrIn, ptrOut, y ) @ #i) ∧
      (Redeemed( ptrOut, y ) @ #j)) ∧
     (Refunded( Up, ptrIn, y ) @ #k)) ⇒
    (¬(∃ #l. Redeemed( ptrIn, y ) @ #l))"
/*
guarded formula characterizing all counter-examples:
"∃ P Prev Next Up ptrIn ptrOut y #i #j #k.
  (HTLCForwarded( P, Prev, Next, ptrIn, ptrOut, y ) @ #i) ∧
  (Redeemed( ptrOut, y ) @ #j) ∧
  (Refunded( Up, ptrIn, y ) @ #k)
 ∧
  ∃ #l. (Redeemed( ptrIn, y ) @ #l)"
*/
by sorry

lemma Refund_Requires_Timeout [reuse]:
  all-traces
  "∀ Up ptr y #i.
    (Refunded( Up, ptr, y ) @ #i) ⇒
    (∃ #j. (TimedOut( ptr ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ Up ptr y #i.
  (Refunded( Up, ptr, y ) @ #i)
 ∧
  ∀ #j. (TimedOut( ptr ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( Refunded( Up, ptr, y ) @ #i )
  case Intermediary_Timeout_Refund
  solve( IntermediaryPending( $Me, $Prev, $Next, ptrIn, ptr, y, %vIn,
                              %vOut, %fee
         ) ▶₀ #i )
    case Forward_HTLC_case_1
    solve( !Timeout( ~ptr ) ▶₁ #i )
      case Open_Timeout_case_1
      by contradiction /* from formulas */
    next
      case Open_Timeout_case_2
      by contradiction /* from formulas */
    qed
  next
    case Forward_HTLC_case_2
    solve( !Timeout( ~ptr ) ▶₁ #i )
      case Open_Timeout_case_1
      by contradiction /* from formulas */
    next
      case Open_Timeout_case_2
      by contradiction /* from formulas */
    qed
  qed
next
  case Sender_Timeout_Refund
  solve( !Timeout( ptr ) ▶₁ #i )
    case Open_Timeout_case_1
    by contradiction /* from formulas */
  next
    case Open_Timeout_case_2
    by contradiction /* from formulas */
  qed
qed

lemma Intermediary_Never_Loses_Under_Liveness:
  all-traces
  "∀ P Prev Next Up ptrIn ptrOut y #i #j #k.
    (((HTLCForwarded( P, Prev, Next, ptrIn, ptrOut, y ) @ #i) ∧
      (Redeemed( ptrOut, y ) @ #j)) ∧
     (Refunded( Up, ptrIn, y ) @ #k)) ⇒
    (∃ #l. LtkCompromised( P ) @ #l)"
/*
guarded formula characterizing all counter-examples:
"∃ P Prev Next Up ptrIn ptrOut y #i #j #k.
  (HTLCForwarded( P, Prev, Next, ptrIn, ptrOut, y ) @ #i) ∧
  (Redeemed( ptrOut, y ) @ #j) ∧
  (Refunded( Up, ptrIn, y ) @ #k)
 ∧
  ∀ #l. (LtkCompromised( P ) @ #l) ⇒ ⊥"
*/
by sorry

lemma Payment_Atomicity_Under_Liveness:
  all-traces
  "∀ F1 F2 Prev1 Next1 Prev2 Next2 ptrSF1 ptrF1F2 ptrF2R y #i #j #k.
    ((((HTLCForwarded( F1, Prev1, Next1, ptrSF1, ptrF1F2, y ) @ #i) ∧
       (HTLCForwarded( F2, Prev2, Next2, ptrF1F2, ptrF2R, y ) @ #j)) ∧
      (Redeemed( ptrF2R, y ) @ #k)) ∧
     (¬(∃ P #l. LtkCompromised( P ) @ #l))) ⇒
    (¬(∃ Up #m. Refunded( Up, ptrSF1, y ) @ #m))"
/*
guarded formula characterizing all counter-examples:
"∃ F1 F2 Prev1 Next1 Prev2 Next2 ptrSF1 ptrF1F2 ptrF2R y #i #j #k.
  (HTLCForwarded( F1, Prev1, Next1, ptrSF1, ptrF1F2, y ) @ #i) ∧
  (HTLCForwarded( F2, Prev2, Next2, ptrF1F2, ptrF2R, y ) @ #j) ∧
  (Redeemed( ptrF2R, y ) @ #k)
 ∧
  (∀ P #l. (LtkCompromised( P ) @ #l) ⇒ ⊥) ∧
  (∃ Up #m. (Refunded( Up, ptrSF1, y ) @ #m))"
*/
by sorry

lemma Timeout_Race_Blocked:
  all-traces
  "¬(∃ P Prev Next Up ptrIn ptrOut y #l #i #j #k.
      (((((HTLCForwarded( P, Prev, Next, ptrIn, ptrOut, y ) @ #l) ∧
          (TimedOut( ptrIn ) @ #k)) ∧
         (Refunded( Up, ptrIn, y ) @ #j)) ∧
        (Redeemed( ptrOut, y ) @ #i)) ∧
       (#k < #i)) ∧
      (¬(∃ #c. (LtkCompromised( P ) @ #c) ∧ (#c < #k))))"
/*
guarded formula characterizing all counter-examples:
"∃ P Prev Next Up ptrIn ptrOut y #l #i #j #k.
  (HTLCForwarded( P, Prev, Next, ptrIn, ptrOut, y ) @ #l) ∧
  (TimedOut( ptrIn ) @ #k) ∧
  (Refunded( Up, ptrIn, y ) @ #j) ∧
  (Redeemed( ptrOut, y ) @ #i)
 ∧
  (#k < #i) ∧ (∀ #c. (LtkCompromised( P ) @ #c) ⇒ ¬(#c < #k))"
*/
by sorry

lemma Multihop_Routing_Reachable:
  exists-trace
  "∃ S F1 F2 R p0 p1 p2 x #t2 #t3 #t4 #t5.
    (((((((((((HTLCOffered( S, F1, p0, h(x) ) @ #t2) ∧
              (HTLCForwarded( F1, S, F2, p0, p1, h(x) ) @ #t3)) ∧
             (HTLCForwarded( F2, F1, R, p1, p2, h(x) ) @ #t4)) ∧
            (HTLCFulfilled( R, F2, p2, h(x) ) @ #t5)) ∧
           (#t2 < #t3)) ∧
          (#t3 < #t4)) ∧
         (#t4 < #t5)) ∧
        (¬(∃ A B p y #u.
            (HTLCOffered( A, B, p, y ) @ #u) ∧ (¬((A = S) ∧ (B = F1)))))) ∧
       (¬(∃ Me Prev Next pi po y #u.
           ((HTLCForwarded( Me, Prev, Next, pi, po, y ) @ #u) ∧
            (¬(((Me = F1) ∧ (Prev = S)) ∧ (Next = F2)))) ∧
           (¬(((Me = F2) ∧ (Prev = F1)) ∧ (Next = R)))))) ∧
      (¬(∃ ptr y1 y2 #m #n.
          ((HTLCAdded( ptr, y1 ) @ #m) ∧ (HTLCAdded( ptr, y2 ) @ #n)) ∧
          (¬(#m = #n))))) ∧
     (¬(∃ Me P q z #e. IntermediaryClaimed( Me, P, q, z ) @ #e))) ∧
    (¬(∃ A B C q z #e. SenderSettled( A, B, C, q, z ) @ #e))"
/*
guarded formula characterizing all satisfying traces:
"∃ S F1 F2 R p0 p1 p2 x #t2 #t3 #t4 #t5.
  (HTLCOffered( S, F1, p0, h(x) ) @ #t2) ∧
  (HTLCForwarded( F1, S, F2, p0, p1, h(x) ) @ #t3) ∧
  (HTLCForwarded( F2, F1, R, p1, p2, h(x) ) @ #t4) ∧
  (HTLCFulfilled( R, F2, p2, h(x) ) @ #t5)
 ∧
  (#t2 < #t3) ∧
  (#t3 < #t4) ∧
  (#t4 < #t5) ∧
  (∀ A B p y #u. (HTLCOffered( A, B, p, y ) @ #u) ⇒ (A = S) ∧ (B = F1)) ∧
  (∀ Me Prev Next pi po y #u.
    (HTLCForwarded( Me, Prev, Next, pi, po, y ) @ #u)
   ⇒
    (((Me = F1) ∧ (Prev = S) ∧ (Next = F2)) ∨
     ((Me = F2) ∧ (Prev = F1) ∧ (Next = R)))) ∧
  (∀ ptr y1 y2 #m #n.
    (HTLCAdded( ptr, y1 ) @ #m) ∧ (HTLCAdded( ptr, y2 ) @ #n) ⇒ #m = #n) ∧
  (∀ Me P q z #e. (IntermediaryClaimed( Me, P, q, z ) @ #e) ⇒ ⊥) ∧
  (∀ A B C q z #e. (SenderSettled( A, B, C, q, z ) @ #e) ⇒ ⊥)"
*/
by sorry

lemma Wormhole_Fee_Theft_Reachable:
  exists-trace
  "∃ Alice Bob Att1 Att2 Indiana ptrAliceAtt1 ptrAtt1Indiana ptrIndianaAtt2
     ptrAtt2Bob x #t1 #t2 #t3 #t4 #t5 #t6 #t7 #t8.
    (((((((((((((((InvoiceCreated( Bob, Alice, h(x) ) @ #t1) ∧
                  (HTLCOffered( Alice, Att1, ptrAliceAtt1, h(x) ) @ #t2)) ∧
                 (HTLCForwarded( Att1, Alice, Indiana, ptrAliceAtt1, ptrAtt1Indiana, h(x)
                  ) @ #t3)) ∧
                (HTLCForwarded( Indiana, Att1, Att2, ptrAtt1Indiana, ptrIndianaAtt2, h(x)
                 ) @ #t4)) ∧
               (HTLCForwarded( Att2, Indiana, Bob, ptrIndianaAtt2, ptrAtt2Bob, h(x)
                ) @ #t5)) ∧
              (HTLCFulfilled( Bob, Att2, ptrAtt2Bob, h(x) ) @ #t6)) ∧
             (SenderSettled( Alice, Att1, Bob, ptrAliceAtt1, x ) @ #t7)) ∧
            (Refunded( Indiana, ptrIndianaAtt2, h(x) ) @ #t8)) ∧
           (¬(Indiana = Alice))) ∧
          (¬(Indiana = Bob))) ∧
         (¬(Att1 = Att2))) ∧
        (¬(∃ #c. LtkCompromised( Alice ) @ #c))) ∧
       (¬(∃ #c. LtkCompromised( Bob ) @ #c))) ∧
      (¬(∃ #c. LtkCompromised( Indiana ) @ #c))) ∧
     (¬(∃ ptr1 ptr2 yy %fee #k.
         FeeEarned( Indiana, ptr1, ptr2, yy, %fee ) @ #k))) ∧
    (¬(∃ ptr y1 y2 #m #n.
        ((HTLCAdded( ptr, y1 ) @ #m) ∧ (HTLCAdded( ptr, y2 ) @ #n)) ∧
        (¬(#m = #n))))"
/*
guarded formula characterizing all satisfying traces:
"∃ Alice Bob Att1 Att2 Indiana ptrAliceAtt1 ptrAtt1Indiana ptrIndianaAtt2
   ptrAtt2Bob x #t1 #t2 #t3 #t4 #t5 #t6 #t7 #t8.
  (InvoiceCreated( Bob, Alice, h(x) ) @ #t1) ∧
  (HTLCOffered( Alice, Att1, ptrAliceAtt1, h(x) ) @ #t2) ∧
  (HTLCForwarded( Att1, Alice, Indiana, ptrAliceAtt1, ptrAtt1Indiana, h(x)
   ) @ #t3) ∧
  (HTLCForwarded( Indiana, Att1, Att2, ptrAtt1Indiana, ptrIndianaAtt2, h(x)
   ) @ #t4) ∧
  (HTLCForwarded( Att2, Indiana, Bob, ptrIndianaAtt2, ptrAtt2Bob, h(x)
   ) @ #t5) ∧
  (HTLCFulfilled( Bob, Att2, ptrAtt2Bob, h(x) ) @ #t6) ∧
  (SenderSettled( Alice, Att1, Bob, ptrAliceAtt1, x ) @ #t7) ∧
  (Refunded( Indiana, ptrIndianaAtt2, h(x) ) @ #t8)
 ∧
  (¬(Indiana = Alice)) ∧
  (¬(Indiana = Bob)) ∧
  (¬(Att1 = Att2)) ∧
  (∀ #c. (LtkCompromised( Alice ) @ #c) ⇒ ⊥) ∧
  (∀ #c. (LtkCompromised( Bob ) @ #c) ⇒ ⊥) ∧
  (∀ #c. (LtkCompromised( Indiana ) @ #c) ⇒ ⊥) ∧
  (∀ ptr1 ptr2 yy %fee #k.
    (FeeEarned( Indiana, ptr1, ptr2, yy, %fee ) @ #k) ⇒ ⊥) ∧
  (∀ ptr y1 y2 #m #n.
    (HTLCAdded( ptr, y1 ) @ #m) ∧ (HTLCAdded( ptr, y2 ) @ #n) ⇒ #m = #n)"
*/
simplify
solve( !Ltk( $Receiver, ltkR ) ▶₁ #t1 )
  case Register_key
  solve( !Pk( $Receiver.1, pk(x.1) ) ▶₁ #t2 )
    case Register_key
    solve( !Ltk( $Sender, ltkS ) ▶₂ #t2 )
      case Register_key
      solve( !ChannelConnect( ptrAliceAtt1, $Sender, $Forward1 ) ▶₃ #t2 )
        case Lock_Funds_And_Open_case_1
        solve( Mutex( ~ptr ) ▶₄ #t2 )
          case Intermediary_Settle_case_1
          by sorry
        next
          case Intermediary_Settle_case_2
          by sorry
        next
          case Lock_Funds_And_Open
          solve( !ChannelConnect( ptrAtt1Indiana, $Forward1, $Next ) ▶₁ #t3 )
            case Lock_Funds_And_Open_case_1
            solve( Mutex( ~ptr.1 ) ▶₂ #t3 )
              case Intermediary_Settle_case_1
