lemma Redeemed_Source [reuse]:
  all-traces
  "∀ p y #i.
    (Redeemed( p, y ) @ #i) ⇒
    ((∃ o. SettledHop( p, o, y ) @ #i) ∨
     (∃ R Q. HTLCFulfilled( R, Q, p, y ) @ #i))"
/*
guarded formula characterizing all counter-examples:
"∃ p y #i.
  (Redeemed( p, y ) @ #i)
 ∧
  (∀ o. (SettledHop( p, o, y ) @ #i) ⇒ ⊥) ∧
  (∀ R Q. (HTLCFulfilled( R, Q, p, y ) @ #i) ⇒ ⊥)"
*/
simplify
solve( Redeemed( p, y ) @ #i )
  case Intermediary_Settle
  by contradiction /* from formulas */
next
  case Receiver_Fulfill_HTLC
  by contradiction /* from formulas */
qed

lemma SenderSettled_Uses_Fulfilled [reuse]:
  all-traces
  "∀ S F1 R p x #i.
    (SenderSettled( S, F1, R, p, x ) @ #i) ⇒ (UsedFulfilled( p, x ) @ #i)"
/*
guarded formula characterizing all counter-examples:
"∃ S F1 R p x #i.
  (SenderSettled( S, F1, R, p, x ) @ #i) ∧ ¬(UsedFulfilled( p, x ) @ #i)"
*/
simplify
by contradiction /* from formulas */

lemma First_Hop_Skip_Requires_Compromise [heuristic={lemmas_first}]:
  all-traces
  "∀ S F1 R pSF Next pOut x #s #f #r.
    (((SenderSettled( S, F1, R, pSF, x ) @ #s) ∧
      (HTLCForwarded( F1, S, Next, pSF, pOut, h(x) ) @ #f)) ∧
     (RefundHop( pSF, pOut, h(x) ) @ #r)) ⇒
    (∃ P #c. LtkCompromised( P ) @ #c)"
/*
guarded formula characterizing all counter-examples:
"∃ S F1 R pSF Next pOut x #s #f #r.
  (SenderSettled( S, F1, R, pSF, x ) @ #s) ∧
  (HTLCForwarded( F1, S, Next, pSF, pOut, h(x) ) @ #f) ∧
  (RefundHop( pSF, pOut, h(x) ) @ #r)
 ∧
  ∀ P #c. (LtkCompromised( P ) @ #c) ⇒ ⊥"
*/
by sorry

lemma SettledHop_Uses_Outgoing [reuse]:
  all-traces
  "∀ pIn pOut y #i.
    (SettledHop( pIn, pOut, y ) @ #i) ⇒
    (∃ x. (UsedFulfilled( pOut, x ) @ #i) ∧ (h(x) = y))"
