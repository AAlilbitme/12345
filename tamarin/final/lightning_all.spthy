                          hide_lemma=SenderSettled_Uses_Fulfilled,
                          hide_lemma=Fulfilled_Requires_Release,
                          hide_lemma=HTLC_On_Opened_Channel,
                          hide_lemma=Skipped_Requires_Compromise,
                          hide_lemma=Sender_Channel_Redeemed]:
  all-traces
  "∀ Me Prev Next pIn pOut M P N pT pT2 y #f #g #r.
    ((((((HTLCForwarded( Me, Prev, Next, pIn, pOut, y ) @ #f) ∧
         (HTLCForwarded( M, P, N, pT, pT2, y ) @ #g)) ∧
        ((#g < #f) ∨ (#g = #f))) ∧
       (Redeemed( pT, y ) @ #r)) ∧
      (∀ A B C D p q #o1 #o2.
        ((HTLCOffered( A, B, p, y ) @ #o1) ∧
         (HTLCOffered( C, D, q, y ) @ #o2)) ⇒
        (p = q))) ∧
     (¬(∃ Q #c. LtkCompromised( Q ) @ #c))) ⇒
    (∃ #l. Redeemed( pIn, y ) @ #l)"
/*
guarded formula characterizing all counter-examples:
"∃ Me Prev Next pIn pOut M P N pT pT2 y #f #g #r.
  (HTLCForwarded( Me, Prev, Next, pIn, pOut, y ) @ #f) ∧
  (HTLCForwarded( M, P, N, pT, pT2, y ) @ #g) ∧
  (Redeemed( pT, y ) @ #r)
 ∧
  (((#g < #f) ∨ (#g = #f))) ∧
  (∀ A B C D p q #o1 #o2.
    (HTLCOffered( A, B, p, y ) @ #o1) ∧
    (HTLCOffered( C, D, q, y ) @ #o2)
   ⇒
    p = q) ∧
  (∀ Q #c. (LtkCompromised( Q ) @ #c) ⇒ ⊥) ∧
  (∀ #l. (Redeemed( pIn, y ) @ #l) ⇒ ⊥)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (#g < #f)  ∥ (#g = #f) )
    case case_1
    solve( (last(#r))  ∥ (last(#f))  ∥
           (∃ A B C D p q #o1 #o2.
             (HTLCOffered( A, B, p, y ) @ #o1) ∧
             (HTLCOffered( C, D, q, y ) @ #o2)
            ∧
             (¬(last(#o2))) ∧ (¬(last(#o1))) ∧ (¬(p = q)))  ∥
           (∃ Q #c. (LtkCompromised( Q ) @ #c) ∧ ¬(last(#c)))  ∥
           (∃ #l. (Redeemed( pIn, y ) @ #l) ∧ ¬(last(#l))) )
      case case_1
      solve( (∃ Q #c. (LtkCompromised( Q ) @ #c))  ∥
             (∃ #l. (Redeemed( pT2, y ) @ #l)) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        solve( (∃ A B C D p q #o1 #o2.
                 (HTLCOffered( A, B, p, y ) @ #o1) ∧
                 (HTLCOffered( C, D, q, y ) @ #o2)
                ∧
                 ¬(p = q))  ∥
               (∃ Nx pOut.
                 (HTLCForwarded( $Next.1, $Me.1, Nx, pT2, pOut, y ) @ #f))  ∥
               (∃ Nx pOut #f.1.
                 (HTLCForwarded( $Next.1, $Me.1, Nx, pT2, pOut, y ) @ #f.1)
                ∧
                 #f.1 < #f) )
          case case_1
          by contradiction /* from formulas */
        next
          case case_2
          by contradiction /* from formulas */
        next
          case case_3
          solve( (last(#l))  ∥ (last(#f))  ∥
                 (∃ A B C D p q #o1 #o2.
                   (HTLCOffered( A, B, p, y ) @ #o1) ∧
                   (HTLCOffered( C, D, q, y ) @ #o2)
                  ∧
                   (¬(last(#o2))) ∧ (¬(last(#o1))) ∧ (¬(p = q)))  ∥
                 (∃ Q #c. (LtkCompromised( Q ) @ #c) ∧ ¬(last(#c)))  ∥
                 (∃ #l. (Redeemed( pIn, y ) @ #l) ∧ ¬(last(#l))) )
            case case_1
            solve( Redeemed( pT, y ) @ #l )
              case Intermediary_Settle
