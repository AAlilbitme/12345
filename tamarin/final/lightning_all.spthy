            case case_1
            solve( (#g = #j)  ∥ (#j < #g) )
              case case_1
              by contradiction /* from formulas */
            next
              case case_2
              by contradiction /* from formulas */
            qed
          next
            case case_2
            by contradiction /* from formulas */
          next
            case case_3
            by contradiction /* cyclic */
          next
            case case_4
            by contradiction /* cyclic */
          qed
        next
          case case_3
          by contradiction /* from formulas */
        next
          case case_4
          by contradiction /* from formulas */
        next
