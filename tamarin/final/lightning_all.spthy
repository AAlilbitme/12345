                case Intermediary_Settle
                by contradiction /* from formulas */
              qed
            next
              case Receiver_Fulfill_HTLC
              solve( Redeemed( pT2, h(x) ) @ #l )
                case Receiver_Fulfill_HTLC
                by contradiction /* from formulas */
              qed
            qed
          next
            case case_2
            by solve( Redeemed( pT, y ) @ #f )
          next
            case case_3
            by contradiction /* from formulas */
          next
            case case_4
            by contradiction /* from formulas */
          next
            case case_5
            by contradiction /* from formulas */
          qed
        qed
      qed
    next
      case case_2
