theory lightning_aux
begin

/*
  Auxiliary models of the Lightning analysis; choose ONE with a flag:
    -D=PTLC      PTLC countermeasure (per-hop secrets): wormhole impossible
    -D=HTLC      HTLC baseline (shared hash lock): wormhole reachable
    -D=CLOCK     block-clock model of CLTV deadlines
    -D=CLTV      CLTV-delta model
    -D=TIMEOUT   timeout race without ordering
                 (run with --heuristic=c --stop-on-trace=seqdfs)
  Example:  tamarin-prover --prove lightning_aux.spthy -D=PTLC
*/

builtins: hashing, natural-numbers

#ifdef PTLC
/*
  Fixed route  S -> H1 -> H2 -> H3 -> R  over channels c0, c1, c2, c3.
  PTLC / multi-hop-lock model: every channel has its OWN secret.
  Channel secrets (sender-generated, as in anonymous multi-hop locks):
      s3 = x,  s2 = H(x,t3),  s1 = H(s2,t2),  s0 = H(s1,t1)
  An honest hop that learns its OUTGOING secret combines it with its own
  private tweak to obtain its INCOMING secret.  Locks are h(secret).
  The hash chain abstracts the additive PTLC tweak (s_in = s_out + t): in both,
  deriving a hop's incoming secret requires that hop's tweak.  (An XOR encoding
  exhausted memory in Tamarin.)

  Attacker (same in both models): Dolev-Yao + compromise.  A compromised hop
  leaks its tweak; every secret used to claim a channel becomes public
  (on-chain); a compromised payee may claim its channel with ANY value the
  adversary knows.  There is no special "skip" rule: a wormhole must be built
  from adversary knowledge.  Timing is abstracted: an open HTLC may be refunded.
  Generated by gen.py -- edit the template, not this file.
*/


rule Compromise:
    [ ] --[ Compromised($A) ]-> [ !Comp($A) ]

// Sender sets up the payment: fresh channels, secret and per-hop tweaks.
rule Sender_Setup:
    let s3 = ~x
        s2 = h(<s3, ~t3>)
        s1 = h(<s2, ~t2>)
        s0 = h(<s1, ~t1>)
    in
    [ Fr(~x), Fr(~c0), Fr(~c1), Fr(~c2), Fr(~c3), Fr(~t1), Fr(~t2), Fr(~t3) ]
    --[ Pay($S, $H1, $H2, $H3, $R, ~c0, ~c1, ~c2, ~c3),
        Neq($S, $H1), Neq($S, $H2), Neq($S, $H3), Neq($S, $R),
        Neq($H1, $H2), Neq($H2, $H3), Neq($H1, $H3),
        Neq($H1, $R), Neq($H2, $R), Neq($H3, $R) ]->
    [ !Lock(~c0, $S, $H1, h(s0)), Open(~c0), SenderWait($S, ~c0),
      !Hop($H1, ~c0, ~c1, $H2, h(s1), ~t1),
      !Hop($H2, ~c1, ~c2, $H3, h(s2), ~t2),
      !Hop($H3, ~c2, ~c3, $R,  h(s3), ~t3),
      !RecvSecret($R, ~c3, ~x),
      Out(h(s0)), Out(h(s1)), Out(h(s2)), Out(h(s3)) ]

// A compromised hop leaks its tweak.
rule Leak_Tweak:
    [ !Hop($H, cIn, cOut, N, Lout, t), !Comp($H) ]
    --[ Leaked($H) ]->
    [ Out(t) ]

// Hop forwards: once its incoming HTLC exists it opens the outgoing one.
rule Forward:
    [ !Lock(cIn, P, $H, Lin), !Hop($H, cIn, cOut, N, Lout, t) ]
    --[ Forwarded($H, cIn, cOut), Once(cOut) ]->
    [ !Lock(cOut, $H, N, Lout), Open(cOut), Pend($H, cIn, cOut, t) ]

// Receiver claims the last channel.
rule Receiver_Claim:
    [ !Lock(c, P, $R, L), Open(c), !RecvSecret($R, c, x) ]
    --[ Redeemed(c), Eq(h(x), L) ]->
    [ ClaimInfo(c, x), Out(x) ]

// Honest hop: outgoing secret -> incoming secret.
rule Hop_Settle:
    [ Pend($H, cIn, cOut, t), ClaimInfo(cOut, sec), !Lock(cIn, P, $H, Lin), Open(cIn) ]
    --[ Redeemed(cIn), HopSettled($H, cIn, cOut), Eq(h(h(<sec, t>)), Lin) ]->
    [ ClaimInfo(cIn, h(<sec, t>)), Out(h(<sec, t>)) ]

// A compromised payee claims with any value the adversary knows.
rule Adversary_Claim:
    [ !Lock(c, P, B, L), Open(c), !Comp(B), In(sec) ]
    --[ Redeemed(c), AdvClaim(c), Eq(h(sec), L) ]->
    [ ClaimInfo(c, sec), Out(sec) ]

rule Refund:
    [ !Lock(c, P, B, L), Open(c) ]
    --[ Refunded(c) ]->
    [ ]

rule Sender_Settle:
    [ SenderWait($S, c0), ClaimInfo(c0, sec) ]
    --[ SenderSettled($S, c0) ]->
    [ ]

restriction Equality:    "All a b #i. Eq(a, b) @ #i ==> a = b"
restriction Inequality:  "All a b #i. Neq(a, b) @ #i ==> not (a = b)"
restriction OnceForward: "All c #i #j. Once(c) @ #i & Once(c) @ #j ==> #i = #j"

// Sanity: an honest payment completes end to end.
lemma Honest_Payment_Completes:
  exists-trace
  "Ex S H1 H2 H3 R c0 c1 c2 c3 #p #s.
      Pay(S, H1, H2, H3, R, c0, c1, c2, c3) @ #p
    & SenderSettled(S, c0) @ #s
    & not (Ex A #k. Compromised(A) @ #k)"

// Sanity: with both neighbours of H2 compromised the payment still completes.
lemma Colluders_Present_Payment_Completes:
  exists-trace
  "Ex S H1 H2 H3 R c0 c1 c2 c3 #p #s #k1 #k3.
      Pay(S, H1, H2, H3, R, c0, c1, c2, c3) @ #p
    & SenderSettled(S, c0) @ #s
    & Compromised(H1) @ #k1 & Compromised(H3) @ #k3"

// Wormhole around an honest H2: the sender's c0 is redeemed while H2's
// outgoing c2 is refunded.
lemma No_Wormhole_Around_Honest_Hop:
  all-traces
  "not (
Ex S H1 H2 H3 R c0 c1 c2 c3 #p #a #b.
      Pay(S, H1, H2, H3, R, c0, c1, c2, c3) @ #p
    & Redeemed(c0) @ #a
    & Refunded(c2) @ #b
    & not (Ex #k. Compromised(H2) @ #k)
    & not (Ex #k. Compromised(S) @ #k))"

// Control 1: H2's outgoing HTLC CAN be refunded while the payment is set up
// (so the premise of the lemma above is not unsatisfiable on its own).
lemma Control_Refund_Of_H2_Outgoing:
  exists-trace
  "Ex S H1 H2 H3 R c0 c1 c2 c3 #p #b.
      Pay(S, H1, H2, H3, R, c0, c1, c2, c3) @ #p
    & Refunded(c2) @ #b
    & not (Ex #k. Compromised(H2) @ #k)"

// Control 2: if H2 itself is compromised (its tweak leaks), the wormhole IS
// reachable -- the proof above depends on H2's tweak staying secret.
lemma Control_Wormhole_If_H2_Compromised:
  exists-trace
  "Ex S H1 H2 H3 R c0 c1 c2 c3 #p #a #b #k.
      Pay(S, H1, H2, H3, R, c0, c1, c2, c3) @ #p
    & Redeemed(c0) @ #a
    & Refunded(c2) @ #b
    & Compromised(H2) @ #k
    & not (Ex #j. Compromised(S) @ #j)"
#endif

#ifdef HTLC
/*
  Fixed route  S -> H1 -> H2 -> H3 -> R  over channels c0, c1, c2, c3.
  HTLC BASELINE: identical to ptlc.spthy except that every channel uses the
  SAME secret x (hash lock h(x)), i.e. standard HTLC routing.

  Attacker (same in both models): Dolev-Yao + compromise.  A compromised hop
  leaks its tweak; every secret used to claim a channel becomes public
  (on-chain); a compromised payee may claim its channel with ANY value the
  adversary knows.  There is no special "skip" rule: a wormhole must be built
  from adversary knowledge.  Timing is abstracted: an open HTLC may be refunded.
  Generated by gen.py -- edit the template, not this file.
*/


rule Compromise:
    [ ] --[ Compromised($A) ]-> [ !Comp($A) ]

// Sender sets up the payment: fresh channels, secret and per-hop tweaks.
rule Sender_Setup:
    let s3 = ~x
        s2 = ~x
        s1 = ~x
        s0 = ~x
    in
    [ Fr(~x), Fr(~c0), Fr(~c1), Fr(~c2), Fr(~c3), Fr(~t1), Fr(~t2), Fr(~t3) ]
    --[ Pay($S, $H1, $H2, $H3, $R, ~c0, ~c1, ~c2, ~c3),
        Neq($S, $H1), Neq($S, $H2), Neq($S, $H3), Neq($S, $R),
        Neq($H1, $H2), Neq($H2, $H3), Neq($H1, $H3),
        Neq($H1, $R), Neq($H2, $R), Neq($H3, $R) ]->
    [ !Lock(~c0, $S, $H1, h(s0)), Open(~c0), SenderWait($S, ~c0),
      !Hop($H1, ~c0, ~c1, $H2, h(s1), ~t1),
      !Hop($H2, ~c1, ~c2, $H3, h(s2), ~t2),
      !Hop($H3, ~c2, ~c3, $R,  h(s3), ~t3),
      !RecvSecret($R, ~c3, ~x),
      Out(h(s0)), Out(h(s1)), Out(h(s2)), Out(h(s3)) ]

// A compromised hop leaks its tweak.
rule Leak_Tweak:
    [ !Hop($H, cIn, cOut, N, Lout, t), !Comp($H) ]
    --[ Leaked($H) ]->
    [ Out(t) ]

// Hop forwards: once its incoming HTLC exists it opens the outgoing one.
rule Forward:
    [ !Lock(cIn, P, $H, Lin), !Hop($H, cIn, cOut, N, Lout, t) ]
    --[ Forwarded($H, cIn, cOut), Once(cOut) ]->
    [ !Lock(cOut, $H, N, Lout), Open(cOut), Pend($H, cIn, cOut, t) ]

// Receiver claims the last channel.
rule Receiver_Claim:
    [ !Lock(c, P, $R, L), Open(c), !RecvSecret($R, c, x) ]
    --[ Redeemed(c), Eq(h(x), L) ]->
    [ ClaimInfo(c, x), Out(x) ]

// Honest hop: outgoing secret -> incoming secret.
rule Hop_Settle:
    [ Pend($H, cIn, cOut, t), ClaimInfo(cOut, sec), !Lock(cIn, P, $H, Lin), Open(cIn) ]
    --[ Redeemed(cIn), HopSettled($H, cIn, cOut), Eq(h(sec), Lin) ]->
    [ ClaimInfo(cIn, sec), Out(sec) ]

// A compromised payee claims with any value the adversary knows.
rule Adversary_Claim:
    [ !Lock(c, P, B, L), Open(c), !Comp(B), In(sec) ]
    --[ Redeemed(c), AdvClaim(c), Eq(h(sec), L) ]->
    [ ClaimInfo(c, sec), Out(sec) ]

rule Refund:
    [ !Lock(c, P, B, L), Open(c) ]
    --[ Refunded(c) ]->
    [ ]

rule Sender_Settle:
    [ SenderWait($S, c0), ClaimInfo(c0, sec) ]
    --[ SenderSettled($S, c0) ]->
    [ ]

restriction Equality:    "All a b #i. Eq(a, b) @ #i ==> a = b"
restriction Inequality:  "All a b #i. Neq(a, b) @ #i ==> not (a = b)"
restriction OnceForward: "All c #i #j. Once(c) @ #i & Once(c) @ #j ==> #i = #j"

// Sanity: an honest payment completes end to end.
lemma Honest_Payment_Completes:
  exists-trace
  "Ex S H1 H2 H3 R c0 c1 c2 c3 #p #s.
      Pay(S, H1, H2, H3, R, c0, c1, c2, c3) @ #p
    & SenderSettled(S, c0) @ #s
    & not (Ex A #k. Compromised(A) @ #k)"

// Sanity: with both neighbours of H2 compromised the payment still completes.
lemma Colluders_Present_Payment_Completes:
  exists-trace
  "Ex S H1 H2 H3 R c0 c1 c2 c3 #p #s #k1 #k3.
      Pay(S, H1, H2, H3, R, c0, c1, c2, c3) @ #p
    & SenderSettled(S, c0) @ #s
    & Compromised(H1) @ #k1 & Compromised(H3) @ #k3"

// Wormhole around an honest H2: the sender's c0 is redeemed while H2's
// outgoing c2 is refunded.
lemma Wormhole_Around_Honest_Hop:
  exists-trace
  "Ex S H1 H2 H3 R c0 c1 c2 c3 #p #a #b.
      Pay(S, H1, H2, H3, R, c0, c1, c2, c3) @ #p
    & Redeemed(c0) @ #a
    & Refunded(c2) @ #b
    & not (Ex #k. Compromised(H2) @ #k)
    & not (Ex #k. Compromised(S) @ #k)"
#endif

#ifdef CLOCK
rule Clock_Start:
    [ Fr(~init) ]
    --[ ClockStart() ]->
    [ Clock(%1), !BlockReached(%1) ]

rule Clock_Tick:
    [ Clock(%b) ]
    --[ ]->
    [ Clock(%b %+ %1), !BlockReached(%b %+ %1) ]

// Channels carry a concrete CLTV deadline drawn from the clock.
rule Open_Channel:
    [ Fr(~ptr), !BlockReached(%d) ]
    --[ ChannelOpen($A, $B, ~ptr, %d) ]->
    [ Channel(~ptr, $A, $B, %d), Free(~ptr) ]

// Close CONSUMES the channel token 
rule Close_Channel:
    [ Channel(ptr, A, B, d) ]
    --[ ChannelClosed(ptr) ]->
    [ ]

// Sender locks hash ~y on the incoming (S->F) channel.
rule Sender_Offer:
    [ Channel(ptrIn, $Sender, $F, %dIn), Free(ptrIn), Fr(~y) ]
    --[ HTLCAdded(ptrIn, ~y),
        ValueOffered(ptrIn, ~y) ]->
    [ Channel(ptrIn, $Sender, $F, %dIn),
      PendingIn($Sender, $F, ptrIn, ~y, %dIn) ]

// F forwards: consumes PendingIn to get authentic %dIn, reads %dOut from
// its own outgoing channel (authentic), enforces CLTV-delta dOut < dIn.
rule Forward_HTLC:
    [ PendingIn($Sender, $F, ptrIn, y, %dIn),
      Channel(ptrOut, $F, $Receiver, %dOut), Free(ptrOut) ]
    --[ Forwarded($F, ptrIn, ptrOut, %dIn, %dOut, y),
        HTLCAdded(ptrOut, y),
        Lt(%dOut, %dIn) ]->
    [ Channel(ptrOut, $F, $Receiver, %dOut),
      IntermediaryPending($F, ptrIn, ptrOut, %dIn, %dOut, y) ]

// Receiver accepts at block bOut <= dOut 
rule Receiver_Accept:
    [ IntermediaryPending($F, ptrIn, ptrOut, %dIn, %dOut, y),
      !BlockReached(%bOut) ]
    --[ RedeemedAt(ptrOut, y, %bOut),
        Redeemed(ptrOut, y),
        WithinDeadline(%dOut, %bOut) ]->
    [ Claimable($F, ptrIn, ptrOut, %dIn, %dOut, y) ]

// Intermediary claims upstream before incoming deadline 
rule Intermediary_Claim:
    [ Claimable($F, ptrIn, ptrOut, %dIn, %dOut, y),
      !BlockReached(%bClaim) ]
    --[ ClaimedAt(ptrIn, y, %bClaim),
        Redeemed(ptrIn, y),
        WithinDeadline(%dIn, %bClaim) ]->
    [ ]

// Upstream refund after incoming deadline 
rule Timeout_Refund:
    [ Claimable($F, ptrIn, ptrOut, %dIn, %dOut, y),
      !BlockReached(%bRef) ]
    --[ RefundedAt(ptrIn, y, %bRef),
        Refunded(ptrIn, y),
        PastDeadline(%dIn, %bRef) ]->
    [ ]

// F1 (first hop): consumes PendingIn from Sender, locks the HTLC on ptrMid,
// and produces Hop1State (for F1's eventual upstream claim) + PendingHop2 (for F2).
rule Forward_Hop1:
    [ PendingIn($Prev, $F1, ptrIn, y, %dIn),
      Channel(ptrMid, $F1, $Next, %dMid), Free(ptrMid) ]
    --[ Forwarded($F1, ptrIn, ptrMid, %dIn, %dMid, y),
        HTLCAdded(ptrMid, y),
        Lt(%dMid, %dIn) ]->
    [ Channel(ptrMid, $F1, $Next, %dMid),
      Hop1State($F1, ptrIn, ptrMid, %dIn, %dMid, y),
      PendingHop2($F1, $Next, ptrMid, y, %dMid) ]

// F2 (second hop): consumes PendingHop2, produces IntermediaryPending for Receiver_Accept.
// Receiver_Accept then handles F2's redemption path normally.
rule Forward_Hop2:
    [ PendingHop2($F1, $F2, ptrMid, y, %dMid),
      Channel(ptrOut, $F2, $Receiver, %dOut), Free(ptrOut) ]
    --[ Forwarded($F2, ptrMid, ptrOut, %dMid, %dOut, y),
        HTLCAdded(ptrOut, y),
        Lt(%dOut, %dMid) ]->
    [ Channel(ptrOut, $F2, $Receiver, %dOut),
      IntermediaryPending($F2, ptrMid, ptrOut, %dMid, %dOut, y) ]

// F1 claims upstream once F2's downstream HTLC is claimable (preimage propagated).
// Peeks at Claimable(F2) (consume + reproduce) to allow F2 to also claim/refund.
rule Hop1_Claim:
    [ Hop1State($F1, ptrIn, ptrMid, %dIn, %dMid, y),
      Claimable($F2, ptrMid, ptrOut, %dMid, %dOut, y),
      !BlockReached(%bClaim) ]
    --[ ClaimedAt(ptrIn, y, %bClaim),
        Redeemed(ptrIn, y),
        WithinDeadline(%dIn, %bClaim) ]->
    [ Claimable($F2, ptrMid, ptrOut, %dMid, %dOut, y) ]

// On-chain claim -- short dispute path for Redeem_Reachable.
rule OnChain_Claim:
    [ IntermediaryPending($F, ptrIn, ptrOut, %dIn, %dOut, y) ]
    --[ Resolved(ptrOut, y), Redeemed(ptrOut, y) ]->
    [ ]

// On-chain timeout -- short dispute path for Refund_Reachable.
rule OnChain_Timeout:
    [ IntermediaryPending($F, ptrIn, ptrOut, %dIn, %dOut, y) ]
    --[ Resolved(ptrOut, y), Refunded(ptrOut, y) ]->
    [ ]

// ---------------------------------------------------------------------------
// Restrictions
// ---------------------------------------------------------------------------

// Lt action forces strict natural number ordering
// exactly one clock: without this, Clock_Start (empty premise) spawns
// unboundedly many independent block chains and nothing terminates.
restriction OneClock:
    "All #i #j. ClockStart() @ #i & ClockStart() @ #j ==> #i = #j"

restriction Lt_means_less:
    "All a b #i. Lt(a, b) @ #i ==> a << b"
// deadline not yet passed at the moment of the action
restriction WithinDeadline_means_not_past:
    "All d b #i. WithinDeadline(d, b) @ #i ==> not(d << b)"
// deadline has already passed at the moment of the action(opposite of WithinDeadline)
restriction PastDeadline_means_past:
    "All d b #i. PastDeadline(d, b) @ #i ==> d << b"
// each HTLC resolves exactly one way: redeem and refund are mutually exclusive
restriction OneOutcomePerHTLC:
    "All ptr y #i #j. Redeemed(ptr, y) @ #i & Refunded(ptr, y) @ #j ==> F"
// the same HTLC cannot be resolved twice
restriction OneResolution:
    "All ptr y #i #j. Resolved(ptr, y) @ #i & Resolved(ptr, y) @ #j ==> #i = #j"

// ---------------------------------------------------------------------------
// Lemmas
// ---------------------------------------------------------------------------

// Helper: every HTLCAdded requires a prior Open_Channel.
lemma HTLC_Needs_Open_Channel [use_induction]:
    "All ptr y #h.
        HTLCAdded(ptr, y) @ #h
     ==> Ex A B d #o. ChannelOpen(A, B, ptr, d) @ #o & #o < #h"

// No HTLC can be added after the channel is closed.
// It was looping when i added to multihop.spthy.
lemma No_HTLC_After_Close [use_induction]:
    "All ptr y #h #c.
        HTLCAdded(ptr, y) @ #h
      & ChannelClosed(ptr) @ #c
     ==> #h < #c"

// bOut <= dOut  (WithinDeadline in Receiver_Accept)
// dOut < dIn   (Lt in Forward_HTLC, both from honest channel state)
// dIn < bRef   (PastDeadline in Timeout_Refund)
// => bOut < bRef
lemma Claim_Window_Exists:
    "All F pIn pOut dIn dOut y bOut bRef #f #r #u.
        Forwarded(F, pIn, pOut, dIn, dOut, y) @ #f
      & RedeemedAt(pOut, y, bOut) @ #r
      & RefundedAt(pIn,  y, bRef) @ #u
     ==> bOut << bRef"

// block height of the upstream claim is strictly less than the block height of the downstream redemption
lemma Transitive_Preimage_Before_Upstream_Deadline:
    "All F1 F2 pIn pMid pOut dIn dMid dOut y bOut #f1 #f2 #r.
        Forwarded(F1, pIn,  pMid, dIn,  dMid, y) @ #f1
      & Forwarded(F2, pMid, pOut, dMid, dOut, y) @ #f2
      & RedeemedAt(pOut, y, bOut) @ #r
     ==> bOut << dIn"


// loss = skipped claim; residual is pure liveness.
lemma Loss_Implies_Skipped_Claim:
    "All F pIn pOut dIn dOut y #f #r #u.
        Forwarded(F, pIn, pOut, dIn, dOut, y) @ #f
      & Redeemed(pOut, y) @ #r
      & Refunded(pIn,  y) @ #u
     ==> not (Ex b #c. ClaimedAt(pIn, y, b) @ #c)"

// Mutually exclusive outcomes.
lemma Outcome_Exclusive:
    "All ptr y #i #j.
        Redeemed(ptr, y) @ #i
      & Refunded(ptr, y) @ #j
     ==> F"

// Claim path reachable (via OnChain_Claim).
lemma Redeem_Reachable:
    exists-trace
    "Ex ptr y #i. Redeemed(ptr, y) @ #i"

// refund path reachable (via OnChain_Timeout).
lemma Refund_Reachable:
    exists-trace
    "Ex ptr y #i. Refunded(ptr, y) @ #i"

// Proves the timing flow is actually reachable: a forward that is redeemed downstream AND claimed
// upstream.
lemma Honest_Flow_Possible:
    exists-trace
    "Ex P pIn pOut dIn dOut y bOut bClaim #f #r #c.
        Forwarded(P, pIn, pOut, dIn, dOut, y) @ #f
      & RedeemedAt(pOut, y, bOut)             @ #r
      & ClaimedAt(pIn, y, bClaim)             @ #c"
#endif

#ifdef CLTV
// ---------------------------------------------------------------------------
// Block clock
// ---------------------------------------------------------------------------

rule Clock_Init:
    [] --[ ClockStart() ]-> [ BlockHeight(%1) ]


//// advance clock by one block and record the height as a persistent witness
rule Clock_Tick:
    [ BlockHeight(%b) ]
    --[ Block(%b) ]->
    [ BlockHeight(%b %+ %1), !BlockReached(%b) ]

// ---------------------------------------------------------------------------
// CLTV hop setup
// ---------------------------------------------------------------------------
// A hop is defined by (ptrOut, ptrIn, d_out, d_in) where d_out < d_in.
// The forwarder picks a positive delta and sets d_in = d_out %+ delta.
// ---------------------------------------------------------------------------
// Outgoing = Bob → Carol (d_out)
// Incoming = Alice → Bob (d_in)
// the initial outgoing deadline from the clock.
rule Int_Deadline:
    [ Fr(~ptr), BlockHeight(%b), In(%extra) ]   // b is the current block height, extra is some extra time to add to the deadline
    --[ IntDeadline(~ptr, %b %+ %extra) ]->   // the initial deadline is set to the current block height plus some extra time
    [ !Deadline(~ptr, %b %+ %extra), BlockHeight(%b) ]   // give the clock back

// Outgoing pointer has deadline d_out, incoming pointer has
// deadline d_in = d_out %+ delta. 
rule Register_Hop:
    [ !Deadline(~ptrOut, %d_out), In(%delta), Fr(~ptrIn) ]   // d is the outgoing deadline, delta is the extra time for the incoming deadline
    --[ HopRegistered(~ptrOut, ~ptrIn, %d_out, %d_out %+ %delta) ]->   // register the hop with the outgoing and incoming deadlines
    [ !Deadline(~ptrIn, %d_out %+ %delta) ]

// witness a preimage reveal at some block height already reached
rule Reveal_Preimage:
    [ !Deadline(~ptrOut, %d_out), !BlockReached(%b) ]
    --[ Revealed(%b, ~ptrOut, %d_out) ]->
    []

// ---------------------------------------------------------------------------
// Restrictions
// ---------------------------------------------------------------------------

// Exactly one clock (Clock_Init has no premise).
restriction OneClock:
    "All #i #j. ClockStart() @ #i & ClockStart() @ #j ==> #i = #j"

// Delta must be strictly positive: d_out < d_in = d_out %+ delta.
restriction DeltaPositive:
    "All ptrOut ptrIn d_out d_in #i.
       HopRegistered(ptrOut, ptrIn, d_out, d_in) @ #i
     ==> d_out << d_in"   //deadline of outgoing pointer must be strictly less than the deadline of the incoming

// Preimage is revealed strictly before the outgoing deadline (b < d_out).
restriction FulfillInTime:
    "All b ptrOut d_out #i.
       Revealed(b, ptrOut, d_out) @ #i
     ==> b << d_out"

// Lemma 1: CLTV_Gap_Is_Positive (restates restriction DeltaPositive; kept as a sanity check)
lemma CLTV_Gap_Is_Positive [reuse]:
    "All ptrOut ptrIn d_out d_in #i.
       HopRegistered(ptrOut, ptrIn, d_out, d_in) @ #i
     ==> d_out << d_in"

// Claim_Window_Nonempty
lemma Claim_Window_Nonempty [reuse]:
    "All ptrOut ptrIn d_out d_in b #i #j.
       HopRegistered(ptrOut, ptrIn, d_out, d_in) @ #i
     & Revealed(b, ptrOut, d_out) @ #j
     ==> b << d_in"

// If preimage is revealed at block b <= d1 (the tightest deadline),
// then b < d2 and b < d3 — both intermediaries have non-empty claim windows.
lemma Staggered_Path_Safe:
    "All ptr1 ptr2 ptr2b ptr3 d1 d2 d3 b #i #j #k.
       HopRegistered(ptr1, ptr2, d1, d2) @ #i
     & HopRegistered(ptr2b, ptr3, d2, d3) @ #j
     & Revealed(b, ptr1, d1) @ #k
     ==> b << d2 & b << d3"
#endif

#ifdef TIMEOUT
// An intermediary registers a forwarding relationship between two channels.
rule Register_Forward:
    [ Fr(~ptrIn), Fr(~ptrOut) ]
    --[ ForwardHTLC($P, ~ptrIn, ~ptrOut, $y) ]->
    [ !Chan(~ptrIn), !Chan(~ptrOut), !Link(~ptrIn, ~ptrOut, $y) ]

// Either channel can time out at any point 
rule Timeout:
    [ !Chan(~ptr) ]
    --[ TimedOut(~ptr) ]->
    [ !Timed(~ptr) ]

// After ptrIn times out, the incoming HTLC can be refunded.
rule Refund:
    [ !Timed(~ptrIn), !Link(~ptrIn, ~ptrOut, $y) ]
    --[ Refunded(~ptrIn, $y) ]->
    []

// The outgoing HTLC can be redeemed at any time — independently of ptrIn.
rule Redeem:
    [ !Link(~ptrIn, ~ptrOut, $y) ]
    --[ Redeemed(~ptrOut, $y) ]->
    []

lemma Early_Timeout_Race:
    exists-trace
    "Ex P ptrIn ptrOut y #f #k #j #i.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #f
      & TimedOut(ptrIn)     @ #k
      & Refunded(ptrIn, y)  @ #j
      & Redeemed(ptrOut, y) @ #i
      & #k < #i"
#endif

end
