theory multihop_nhop_hardened
begin

// Multi_Nhop.spthy (multiset, amounts chained through Route) PLUS the two
// linear single-spend tokens: Free(ptr) for the HTLC output and
// RevokedCommitmentUnspent for the revoked commitment output.
// The base file verifies 31/31 in 265s; the open question is whether the
// extra linear facts remain tractable under multiset AC unification.

builtins: hashing, signing, multiset

// ---------------------------------------------------------------------------
// Key management
// ---------------------------------------------------------------------------

rule Register_key:
    [ Fr(~ltk) ]
    --[ KeyGen($A, ~ltk) ]->
    [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)), Out(pk(~ltk)) ]

rule Compromise_Ltk:
    [ !Ltk($A, ltk) ]
    --[ LtkCompromised($A) ]->
    [ Out(ltk) ]

// ---------------------------------------------------------------------------
// Wallet / funds
// ---------------------------------------------------------------------------

rule Acquire_funds:
    [ Fr(~f) ]
    --[ FundsAcquired($A, ~f) ]->
    [ Wallet($A, ~f) ]

// ---------------------------------------------------------------------------
// Channel handshake
// ---------------------------------------------------------------------------

rule A_Send_Proposal:
    let proposal = <'proposal', $A, $B, ~ptr>
        sigA     = sign(proposal, ltkA)
    in
    [ Fr(~ptr), !Ltk($A, ltkA) ]
    --[ A_ProposalSent($A, $B, ~ptr) ]->
    [ A_WaitAck($A, $B, ~ptr),
      Out(<'proposal', $A, $B, ~ptr, sigA>) ]

rule B_Recv_Proposal:
    let proposal = <'proposal', $A, $B, ptr>
        sigB     = sign(proposal, ltkB)
    in
    [ !Ltk($B, ltkB), !Pk($A, pkA),
      In(<'proposal', $A, $B, ptr, sigA>) ]
    --[ ProposalExchange($A, $B, ptr),
        Eq(verify(sigA, proposal, pkA), true) ]->
    [ !ProposalCommitted($A, $B, ptr),
      Out(<'proposal_ack', $A, $B, ptr, sigB>) ]

rule A_Recv_From_B:
    let proposal = <'proposal', $A, $B, ptr>
    in
    [ A_WaitAck($A, $B, ptr),
      !Pk($B, pkB),
      In(<'proposal_ack', $A, $B, ptr, sigB>) ]
    --[ A_Received($A, $B, ptr),
        Eq(verify(sigB, proposal, pkB), true) ]->
    [ !A_HandshakeDone($A, $B, ptr) ]

// ---------------------------------------------------------------------------
// Initial channel state commitment
// ---------------------------------------------------------------------------

rule Create_State_A:
    let commitA0 = <'commit', ptr, $A, $B, '0', h(~sA0)>
        sigA0    = sign(commitA0, ltkA)
    in
    [ Fr(~sA0), !Ltk($A, ltkA),
      !A_HandshakeDone($A, $B, ptr) ]
    --[ StateCreated($A, '0', commitA0) ]->
    [ CommittedStateA($A, $B, ptr, '0', ~sA0, commitA0, sigA0) ]

rule Create_State_B:
    let commitB0 = <'commit', ptr, $B, $A, '0', h(~sB0)>
        sigB0    = sign(commitB0, ltkB)
    in
    [ Fr(~sB0), !Ltk($B, ltkB),
      !ProposalCommitted($A, $B, ptr) ]
    --[ StateCreated($B, '0', commitB0) ]->
    [ CommittedStateB($A, $B, ptr, '0', ~sB0, commitB0, sigB0) ]

rule Both_States_Committed:
    [ CommittedStateA($A, $B, ptr, '0', sA0, commitA0, sigA0),
      CommittedStateB($A, $B, ptr, '0', sB0, commitB0, sigB0),
      !Pk($A, pkA), !Pk($B, pkB) ]
    --[ Stage1Complete($A, $B, ptr),
        Eq(verify(sigA0, commitA0, pkA), true),
        Eq(verify(sigB0, commitB0, pkB), true) ]->
    [ ReadyToLock($A, $B, ptr, sA0, sB0, commitA0, commitB0) ]

rule Lock_Funds_And_Open:
    [ ReadyToLock($A, $B, ptr, sA0, sB0, commitA0, commitB0),
      Wallet($A, ~fA), Wallet($B, ~fB) ]
    --[ ChannelOpen($A, $B, ptr), FundsLocked($A, $B, ptr),
        NewStateBuilt($A, $B, ptr, '0', ~fA, ~fB) ]->
    [ StateA($A, $B, ptr, '0', sA0, commitA0, ~fA, ~fB),
      StateB($A, $B, ptr, '0', sB0, commitB0, ~fA, ~fB),
      !ValidOnChain(ptr),
      !ChannelRecord(ptr, $A, $B),
      !ChannelConnect(ptr, $A, $B),   // permits HTLC from A to B
      !ChannelConnect(ptr, $B, $A),   // permits HTLC from B to A
      Free(ptr) ]                     // one-shot HTLC slot per channel

// ---------------------------------------------------------------------------
// State update & revocation
// ---------------------------------------------------------------------------

rule Update_State:
    let newCommitA = <'commit', ptr, $A, $B, ~n_new, h(~sAnew)>
        newCommitB = <'commit', ptr, $B, $A, ~n_new, h(~sBnew)>
        sigAnew    = sign(newCommitA, ltkA)
        sigBnew    = sign(newCommitB, ltkB)
    in
    [ Fr(~n_new), Fr(~sAnew), Fr(~sBnew),
      !Ltk($A, ltkA), !Ltk($B, ltkB),
      StateA($A, $B, ptr, n_old, sAold, oldCommitA, fA, fB),
      StateB($A, $B, ptr, n_old, sBold, oldCommitB, fA, fB),
      In(<fA_new, fB_new>) ]
    --[ NewStateBuilt($A, $B, ptr, ~n_new, fA_new, fB_new) ]->
    [ PendingA($A, $B, ptr, n_old, sAold, oldCommitA,
               ~n_new, ~sAnew, newCommitA, sigAnew, fA_new, fB_new),
      PendingB($A, $B, ptr, n_old, sBold, oldCommitB,
               ~n_new, ~sBnew, newCommitB, sigBnew, fA_new, fB_new) ]

rule Revoke_Old_Secret:
    [ PendingA($A, $B, ptr, n_old, sAold, oldCommitA,
               n_new, sAnew, newCommitA, sigAnew, fA_new, fB_new),
      PendingB($A, $B, ptr, n_old, sBold, oldCommitB,
               n_new, sBnew, newCommitB, sigBnew, fA_new, fB_new),
      !Pk($A, pkA), !Pk($B, pkB) ]
    --[ StateUpdate($A, $B, ptr, n_new),
        Revoke($A, n_old, sAold),
        Revoke($B, n_old, sBold),
        Eq(verify(sigAnew, newCommitA, pkA), true),
        Eq(verify(sigBnew, newCommitB, pkB), true) ]->
    [ StateA($A, $B, ptr, n_new, sAnew, newCommitA, fA_new, fB_new),
      StateB($A, $B, ptr, n_new, sBnew, newCommitB, fA_new, fB_new),
      !RevokedSecret($A, n_old, sAold, oldCommitA),
      !RevokedSecret($B, n_old, sBold, oldCommitB),
      // linear one-shot spend of the revoked commitment output
      RevokedCommitmentUnspent(ptr, $A, $B, n_old, oldCommitA),
      RevokedCommitmentUnspent(ptr, $B, $A, n_old, oldCommitB) ]

// ---------------------------------------------------------------------------
// On-chain publish paths
// ---------------------------------------------------------------------------

rule Publish_Old_Grace_Period_A:
    [ PendingA($A, $B, ptr, n_old, sAold, oldCommitA,
               n_new, sAnew, newCommitA, sigAnew, fA_new, fB_new),
      !ValidOnChain(ptr) ]
    --[ PublishOldBeforeRevocation($A, n_old),
        PublishState($A, n_old),
        OnChainDelayedProduce($A, n_old),
        OnChainInstantProduce($B, n_old) ]->
    [ OnChainDelayed($A, n_old, oldCommitA),
      OnChainInstant($B, n_old, oldCommitA) ]

rule Publish_Old_Grace_Period_B:
    [ PendingB($A, $B, ptr, n_old, sBold, oldCommitB,
               n_new, sBnew, newCommitB, sigBnew, fA_new, fB_new),
      !ValidOnChain(ptr) ]
    --[ PublishOldBeforeRevocation($B, n_old),
        PublishState($B, n_old),
        OnChainDelayedProduce($B, n_old),
        OnChainInstantProduce($A, n_old) ]->
    [ OnChainDelayed($B, n_old, oldCommitB),
      OnChainInstant($A, n_old, oldCommitB) ]

rule Publish_Current_A:
    [ StateA($A, $B, ptr, n, sA, commitA, fA, fB), !ValidOnChain(ptr) ]
    --[ Publish($A, n, commitA),
        PublishState($A, n),
        OnChainDelayedProduce($A, n),
        OnChainInstantProduce($B, n) ]->
    [ OnChainDelayed($A, n, commitA),
      OnChainInstant($B, n, commitA) ]

rule Publish_Current_B:
    [ StateB($A, $B, ptr, n, sB, commitB, fA, fB), !ValidOnChain(ptr) ]
    --[ Publish($B, n, commitB),
        PublishState($B, n),
        OnChainDelayedProduce($B, n),
        OnChainInstantProduce($A, n) ]->
    [ OnChainDelayed($B, n, commitB),
      OnChainInstant($A, n, commitB) ]

rule Publish_Pending_A:
    [ PendingA($A, $B, ptr, n_old, sAold, oldCommitA,
               n_new, sAnew, newCommitA, sigAnew, fA_new, fB_new),
      !ValidOnChain(ptr) ]
    --[ Publish($A, n_new, newCommitA),
        PublishFromPending($A, n_old, n_new),
        OnChainDelayedProduce($A, n_new),
        OnChainInstantProduce($B, n_new) ]->
    [ OnChainDelayed($A, n_new, newCommitA),
      OnChainInstant($B, n_new, newCommitA) ]

rule Publish_Pending_B:
    [ PendingB($A, $B, ptr, n_old, sBold, oldCommitB,
               n_new, sBnew, newCommitB, sigBnew, fA_new, fB_new),
      !ValidOnChain(ptr) ]
    --[ Publish($B, n_new, newCommitB),
        PublishFromPending($B, n_old, n_new),
        OnChainDelayedProduce($B, n_new),
        OnChainInstantProduce($A, n_new) ]->
    [ OnChainDelayed($B, n_new, newCommitB),
      OnChainInstant($A, n_new, newCommitB) ]

// ---------------------------------------------------------------------------
// Cooperative close
// ---------------------------------------------------------------------------

rule Honest_Close:
    let closetx = <'commit', ptr, $A, $B, n, fA, fB>
        signA   = sign(closetx, ltkA)
        signB   = sign(closetx, ltkB)
    in
    [ StateA($A, $B, ptr, n, sA, commitA, fA, fB),
      StateB($A, $B, ptr, n, sB, commitB, fA, fB),
      !ValidOnChain(ptr),
      !Ltk($A, ltkA), !Ltk($B, ltkB),
      !Pk($A, pkA),   !Pk($B, pkB) ]
    --[ Close($A, $B, ptr, n),
        OnChainInstantProduce($A, n),
        OnChainInstantProduce($B, n),
        Eq(verify(signA, closetx, pkA), true),
        Eq(verify(signB, closetx, pkB), true) ]->
    [ OnChainInstant($A, n, closetx),
      OnChainInstant($B, n, closetx) ]

// ---------------------------------------------------------------------------
// Cheat / punishment
// ---------------------------------------------------------------------------
rule Publish_Revoked_A:
    [ !ChannelRecord(ptr, $A, $B),
      !ValidOnChain(ptr),
      !RevokedSecret($A, n_old, sAold, oldCommitA),
      RevokedCommitmentUnspent(ptr, $A, $B, n_old, oldCommitA) ]
    --[ PublishRevoked($A, n_old, oldCommitA),
        Cheat($A, n_old) ]->
    [ OnChainCheat($A, $B, n_old, oldCommitA),
      RevealedSecret($A, n_old, sAold, oldCommitA) ]

rule Publish_Revoked_B:
    [ !ChannelRecord(ptr, $A, $B),
      !ValidOnChain(ptr),
      !RevokedSecret($B, n_old, sBold, oldCommitB),
      RevokedCommitmentUnspent(ptr, $B, $A, n_old, oldCommitB) ]
    --[ PublishRevoked($B, n_old, oldCommitB),
        Cheat($B, n_old) ]->
    [ OnChainCheat($B, $A, n_old, oldCommitB),
      RevealedSecret($B, n_old, sBold, oldCommitB) ]

rule Punish_A:
    [ OnChainCheat($A, $B, n_old, oldCommitA),
      RevealedSecret($A, n_old, sAold, oldCommitA) ]
    --[ Punish($B, $A, n_old) ]->
    [ AllFundsTo($B) ]

rule Punish_B:
    [ OnChainCheat($B, $A, n_old, oldCommitB),
      RevealedSecret($B, n_old, sBold, oldCommitB) ]
    --[ Punish($A, $B, n_old) ]->
    [ AllFundsTo($A) ]

// ---------------------------------------------------------------------------
// Settlement rules
// ---------------------------------------------------------------------------

rule Instant_Funds_A:
    [ OnChainInstant($A, n, txContent) ]
    --[ FundsSettled($A, n), SettledTx($A, txContent) ]->
    [ ]

rule Instant_Funds_B:
    [ OnChainInstant($B, n, txContent) ]
    --[ FundsSettled($B, n), SettledTx($B, txContent) ]->
    [ ]

rule Claim_Funds_A:
    [ OnChainDelayed($A, n, txContent) ]
    --[ ClaimFunds($A, n), CSVPassed($A, n), SettledTx($A, txContent) ]->
    [ FundsTo($A, n) ]

rule Claim_Funds_B:
    [ OnChainDelayed($B, n, txContent) ]
    --[ ClaimFunds($B, n), CSVPassed($B, n), SettledTx($B, txContent) ]->
    [ FundsTo($B, n) ]


// ---------------------------------------------------------------------------
// HTLC layer -- GENERALIZED to N hops via a linear Route fact,
// now carrying AMOUNTS and deducting per-hop FEES
//
// the sender locks  amt + fees  and every
// intermediary splits its incoming amount as  amtOut + fee, keeping fee.
// every hop's fee is strictly positive,
// ---------------------------------------------------------------------------

rule Receiver_Create_Invoice:
    let y = h(~x)
        invoice = <$Receiver, $Sender, y, amt>
        sigR    = sign(invoice, ltkR)
    in
    [ Fr(~x), In(amt), !Ltk($Receiver, ltkR) ]
    --[ InvoiceCreated($Receiver, $Sender, y, amt),
        SecretPreimage($Receiver, ~x) ]->
    [ ReceiverInv($Receiver, $Sender, ~x, amt),
      Out(<'SecretRS', invoice, sigR>) ]

// Sender verifies the signed invoice, locks amt + fee budget in the first
// HTLC, and STARTS the route chain (HTLC(Alice, Bob, 5+fees, y, 3t)).
rule Sender_Offer_HTLC:
    let invoice  = <$Receiver, $Sender, y, amt>
        amtTotal = amt + fees
    in
    [ In(<'SecretRS', invoice, sigR>),
      In(fees),
      !Pk($Receiver, pkR),
      !Ltk($Sender, ltkS),
      !ChannelConnect(ptrSF, $Sender, $Forward1),
      Free(ptrSF) ]
    --[ HTLCOffered($Sender, $Forward1, ptrSF, y, amtTotal),
        HTLCAdded(ptrSF, y),
        FeeBudget($Sender, y, fees),
        Neq($Sender, $Forward1),
        Neq($Sender, $Receiver),
        Neq($Forward1, $Receiver),
        Eq(verify(sigR, invoice, pkR), true) ]->
    [ SenderPending($Sender, $Forward1, $Receiver, ptrSF, y, amtTotal),
      Route($Sender, $Forward1, ptrSF, y, amtTotal) ]

// GENERIC FORWARD i.e one rule, any number of hops.
// The AC pattern (amtOut + fee) nondeterministically splits the incoming
// amount; $Me keeps fee and locks amtOut on the outgoing channel.
rule Forward_HTLC:
    [ Route($Prev, $Me, ptrIn, y, amtOut + fee),
      !ChannelConnect(ptrOut, $Me, $Next),
      Free(ptrOut) ]
    --[ HTLCForwarded($Me, $Prev, $Next, ptrIn, ptrOut, y, amtOut + fee, amtOut),
        HTLCAdded(ptrOut, y),
        ForwardHTLC($Me, ptrIn, ptrOut, y),
        FeeExpected($Me, ptrIn, ptrOut, y, fee),
        Neq(ptrIn, ptrOut), Neq($Prev, $Me), Neq($Me, $Next) ]->
    [ IntermediaryPending($Me, $Prev, $Next, ptrIn, ptrOut, y,
                          amtOut + fee, amtOut, fee),
      Route($Me, $Next, ptrOut, y, amtOut) ]

// Receiver fulfils the final route hop, revealing the preimage backward
rule Receiver_Fulfill_HTLC:
    [ Route($Prev, $Receiver, ptrIn, y, amtIn),
      ReceiverInv($Receiver, $Sender, x, amt) ]
    --[ HTLCFulfilled($Receiver, $Prev, ptrIn, y, amtIn),
        ReceiverPaid($Receiver, y, amt),
        PreimageReleased($Receiver, x),
        Redeemed(ptrIn, y),
        Eq(h(x), y),
        Eq(amtIn, amt) ]->
    [ Fulfill(ptrIn, x) ]

// The intermediary claims amtIn on ptrIn having paid amtOut on ptrOut.
rule Intermediary_Settle:
    [ IntermediaryPending($Me, $Prev, $Next, ptrIn, ptrOut, y,
                          amtIn, amtOut, fee),
      Fulfill(ptrOut, x) ]
    --[ IntermediaryClaimed($Me, $Prev, ptrIn, x),
        FeeEarned($Me, ptrIn, ptrOut, y, fee),
        Redeemed(ptrIn, y),
        Eq(h(x), y) ]->
    [ Fulfill(ptrIn, x) ]

rule Sender_Settle:
    [ SenderPending($Sender, $Forward1, $Receiver, ptrSF, y, amtTotal),
      Fulfill(ptrSF, x) ]
    --[ SenderSettled($Sender, $Forward1, $Receiver, ptrSF, x),
        PaymentComplete($Sender, $Receiver, h(x), amtTotal),
        Redeemed(ptrSF, y),
        Eq(h(x), y) ]->
    [ ]

rule Open_Timeout:
    [ !ChannelConnect(ptr, A, B) ] --[ TimedOut(ptr) ]-> [ !Timeout(ptr) ]

rule Sender_Timeout_Refund:
    [ SenderPending($Sender, $Forward1, $Receiver, ptrSF, y, amtTotal),
      !Timeout(ptrSF) ]
    --[ HTLCRefunded($Sender, ptrSF, y), Refunded(ptrSF, y) ]->
    [ ]

rule Intermediary_Timeout_Refund:
    [ IntermediaryPending($Me, $Prev, $Next, ptrIn, ptrOut, y,
                          amtIn, amtOut, fee),
      !Timeout(ptrOut) ]
    --[ HTLCRefunded($Me, ptrOut, y), Refunded(ptrOut, y) ]->
    [ ]


restriction OneOutcomePerHTLC:
    "All ptr y #i #j.
       Redeemed(ptr, y) @ #i & Refunded(ptr, y) @ #j ==> F"

restriction Inequality:
    "All x y #i. Neq(x, y) @ #i ==> not(x = y)"

restriction Equality:
    "All x y #i. Eq(x, y) @ #i ==> x = y"

restriction OneTimeoutPerPtr:
    "All ptr #i #j. TimedOut(ptr) @ #i & TimedOut(ptr) @ #j ==> #i = #j"

restriction OneChannelPerPtr:
    "All A B C D ptr #i #j.
       ChannelOpen(A, B, ptr) @ #i
     & ChannelOpen(C, D, ptr) @ #j
     ==> #i = #j"


// redemption is valid only before a channel times out.
restriction RedeemBeforeTimeout:
    "All ptr y #i #j.
        Redeemed(ptr, y) @ #i & TimedOut(ptr) @ #j ==> #i < #j"

// each hop sets the outgoing timeout strictly shorter than the incoming timeout.
// like the out going CLTV is 3 blocks shorter than the incoming CLTV, so that the
// intermediary has time to redeem the incoming HTLC before it times out.
restriction ForwardTimeGap:
    "All P ptrIn ptrOut y #f #j #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #f
      & TimedOut(ptrOut) @ #j
      & TimedOut(ptrIn)  @ #k
     ==> #j < #k"

// honest parties claim within their CLTV window.
// If ForwardHTLC connects two channels and the incoming channel times out,
// then the outgoing channel must have already timed out.  This encodes the
// assumption that every honest intermediary acts before their incoming deadline
restriction HonestPartiesActBeforeIncomingTimeout:
    "All P ptrIn ptrOut y #f #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #f
      & TimedOut(ptrIn) @ #k
     ==> Ex #m. TimedOut(ptrOut) @ #m & #m < #k"

// if an honest intermediary's outgoing HTLC is redeemed before the
// incoming timeout, the node sweeps the incoming HTLC.
restriction IntermediaryMustClaim:
    "All P ptrIn ptrOut y #f #i #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #f
      & Redeemed(ptrOut, y) @ #i
      & TimedOut(ptrIn)  @ #k
      & #i < #k
     ==> Ex #l. Redeemed(ptrIn, y) @ #l"

// ---------------------------------------------------------------------------
// Lemmas -- payment channel layer
// ---------------------------------------------------------------------------

lemma state_update [use_induction]:
    "All A B ptr n #i.
       StateUpdate(A, B, ptr, n) @ #i
     ==> Ex #j. ChannelOpen(A, B, ptr) @ #j & #j < #i"

lemma delayed_funds:
    "All A n #i.
       ClaimFunds(A, n) @ #i
     ==> Ex #j. OnChainDelayedProduce(A, n) @ #j & #j < #i"

lemma instant_funds:
    "All A n #i.
       FundsSettled(A, n) @ #i
     ==> Ex #j. OnChainInstantProduce(A, n) @ #j & #j < #i"

lemma settlement_is_traceable:
    "All A n #i.
       FundsSettled(A, n) @ #i
     ==> Ex tx #j. SettledTx(A, tx) @ #j & #j = #i"

lemma Protocol_execution:
    exists-trace
    "Ex A B ptr n fA fB #i #j #k #l.
        ChannelOpen(A, B, ptr) @ #i
      & NewStateBuilt(A, B, ptr, n, fA, fB) @ #j
      & StateUpdate(A, B, ptr, n) @ #k
      & Close(A, B, ptr, n) @ #l
      & #i < #j & #j < #k & #k < #l"

lemma No_Punishment_Without_Cheating:
    "All A B n #i.
        Punish(B, A, n) @ #i
     ==> (Ex #k. Cheat(A, n) @ #k & #k < #i)
       | (Ex #j. LtkCompromised(A) @ #j & #j < #i)"

lemma Cooperative_Close_Execution:
    exists-trace
    "Ex A B ptr n #k #i.
        ChannelOpen(A, B, ptr) @ #k
      & Close(A, B, ptr, n) @ #i
      & #k < #i
      & not (Ex A2 B2 ptr2 n2 #j. StateUpdate(A2, B2, ptr2, n2) @ #j)"

lemma Funds_Locked_Before_Update [use_induction]:
    "All A B ptr n #i.
       StateUpdate(A, B, ptr, n) @ #i
     ==> Ex #j. FundsLocked(A, B, ptr) @ #j & #j < #i"

lemma Update_Requires_Negotiation [use_induction]:
    "All A B ptr n #i.
         StateUpdate(A, B, ptr, n) @ #i
     ==> Ex fA fB #j. NewStateBuilt(A, B, ptr, n, fA, fB) @ #j & #j < #i"

// ---------------------------------------------------------------------------
// Lemmas -- HTLC / payment layer
// ---------------------------------------------------------------------------

lemma Ltk_Known_Implies_Compromised [reuse]:
    "All A ltk #i #j.
        KeyGen(A, ltk) @ #i
      & !KU(ltk) @ #j
     ==> Ex #r. LtkCompromised(A) @ #r"

// ReceiverInv is linear and consumed on fulfillment; ~x is fresh per invoice.
// Therefore a given preimage is released by the receiver at most once.
// Even if the adversary replays the public 'fulfill' message, it cannot force
// a second release from the receiver, the linear fact is gone.
lemma Invoice_Released_Once [reuse]:
    "All R x #i #j.
        PreimageReleased(R, x) @ #i
      & PreimageReleased(R, x) @ #j
     ==> #i = #j"

lemma Distinct_Parties_Configuration:
    exists-trace
    "Ex S F1 F2 R ptrSF1 ptrF1F2 ptrF2R #c1 #c2 #c3.
        ChannelOpen(S, F1, ptrSF1)   @ #c1
      & ChannelOpen(F1, F2, ptrF1F2) @ #c2
      & ChannelOpen(F2, R, ptrF2R)   @ #c3
      & not (S = F1) & not (S = F2) & not (S = R)
      & not (F1 = F2) & not (F1 = R) & not (F2 = R)
      & not (Ex P #r. LtkCompromised(P) @ #r)
      & not (Ex P Q p n #u. StateUpdate(P, Q, p, n) @ #u)
      & not (Ex P n #u. PublishState(P, n) @ #u)
      & not (Ex P Q p n #u. Close(P, Q, p, n) @ #u)
      & not (Ex P n #u. Cheat(P, n) @ #u)"

lemma Refund_Possible:
    exists-trace
    "Ex S F1 R p y amt amtT #i #j #k.
        InvoiceCreated(R, S, y, amt) @ #j
      & HTLCOffered(S, F1, p, y, amtT) @ #k
      & HTLCRefunded(S, p, y) @ #i
      & #j < #k & #k < #i
      & not (Ex A MidP B p2 x #u. SenderSettled(A, MidP, B, p2, x) @ #u)
      & not (Ex P #r. LtkCompromised(P) @ #r)
      & not (Ex Me Prev Next pi po y2 ai ao #u.
               HTLCForwarded(Me, Prev, Next, pi, po, y2, ai, ao) @ #u)"

lemma Preimage_Secret_Until_Released:
    "All R x #i #j.
        SecretPreimage(R, x) @ #i
      & K(x) @ #j
      & #i < #j
     ==> Ex #k. PreimageReleased(R, x) @ #k & #k < #j"

lemma Invoice_Has_Secret_Preimage [reuse]:
    "All R S x amt #i.
        InvoiceCreated(R, S, h(x), amt) @ #i
     ==> SecretPreimage(R, x) @ #i"

lemma HTLC_On_Opened_Channel [reuse, use_induction]:
    "All ptr y #i.
        HTLCAdded(ptr, y) @ #i
     ==> Ex X Y #j. ChannelOpen(X, Y, ptr) @ #j & #j < #i"

// NOTE: verifies in the fixed-hop multihop.spthy; in this generic model it
// does not terminate.  Left as the single open lemma of the N-hop variant.
// lemma Settle_Requires_Receiver_Release:
//     "All S F1 R ptr x #i #j amt.
//         SenderSettled(S, F1, R, ptr, x) @ #i
//       & InvoiceCreated(R, S, h(x), amt) @ #j
//      ==> Ex #k. PreimageReleased(R, x) @ #k & #k < #i"

lemma Claim_Requires_Release [use_induction]:
    "All MidP InP ptrIn R x #i #j.
        IntermediaryClaimed(MidP, InP, ptrIn, x) @ #i
      & SecretPreimage(R, x) @ #j
     ==> Ex #k. PreimageReleased(R, x) @ #k & #k < #i"

lemma Settle_Excludes_Sender_Refund:
    "All S F1 R ptr x #i.
        SenderSettled(S, F1, R, ptr, x) @ #i
     ==> not (Ex #j. HTLCRefunded(S, ptr, h(x)) @ #j)"

lemma Invoice_Authenticates_Settlement:
    "All S F1 R ptr x #i.
        SenderSettled(S, F1, R, ptr, x) @ #i
     ==> (Ex amt #j. InvoiceCreated(R, S, h(x), amt) @ #j & #j < #i)
       | (Ex #r. LtkCompromised(R) @ #r & #r < #i)"

lemma Forged_Invoice_Requires_Key_Compromise:
    exists-trace
    "Ex S F1 R ptr x #i #r.
        SenderSettled(S, F1, R, ptr, x) @ #i
      & LtkCompromised(R) @ #r
      & not (Ex amt #j. InvoiceCreated(R, S, h(x), amt) @ #j)
      & not (Ex Me Prev Next pi po y ai ao #u.
               HTLCForwarded(Me, Prev, Next, pi, po, y, ai, ao) @ #u)"

lemma Loss_Requires_Inaction:
    "All P ptrIn ptrOut y #i #j #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #i
      & Redeemed(ptrOut, y) @ #j
      & Refunded(ptrIn, y) @ #k
     ==> not (Ex #l. Redeemed(ptrIn, y) @ #l)"

// Helper for Intermediary_Never_Loses: pre-computes Refunded -> TimedOut chain.
lemma Refund_Requires_Timeout [reuse]:
    "All ptr y #i.
        Refunded(ptr, y) @ #i
     ==> Ex #j. TimedOut(ptr) @ #j & #j < #i"

lemma Intermediary_Never_Loses_Under_Liveness:
    "All P ptrIn ptrOut y #f #i #j.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #f
      & Redeemed(ptrOut, y) @ #i
      & Refunded(ptrIn, y) @ #j
     ==> Ex #r. LtkCompromised(P) @ #r"

// This proves that once the receiver fulfills the final HTLC, the sender's
// HTLC on the same payment hash cannot be refunded in the honest model.
lemma Payment_Atomicity_Under_Liveness:
    "All F1 F2 ptrSF1 ptrF1F2 ptrF2R y #f1 #f2 #i.
        ForwardHTLC(F1, ptrSF1, ptrF1F2, y) @ #f1
      & ForwardHTLC(F2, ptrF1F2, ptrF2R, y) @ #f2
      & Redeemed(ptrF2R, y) @ #i
      & (not Ex P #r. LtkCompromised(P) @ #r)
     ==> not (Ex #u. Refunded(ptrSF1, y) @ #u)"


// This lemma only proves the race is blocked WITH the liveness restriction active.
// The timeout.spthy is needed to show the race is reachable WITHOUT it.
lemma Timeout_Race_Blocked:
    "not (Ex P ptrIn ptrOut y #f #i #j #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #f
      & TimedOut(ptrIn)     @ #k
      & Refunded(ptrIn, y)  @ #j
      & Redeemed(ptrOut, y) @ #i
      & #k < #i)"
      // why i didnot include refund not possible because it is enforce by rules

lemma Multihop_Payment_With_Fees_Possible:
    exists-trace
    "Ex S F1 F2 R p0 p1 p2 x amt f1 f2 #t2 #t3 #t4 #t5.
        HTLCOffered(S, F1, p0, h(x), amt + f1 + f2)                   @ #t2
      & HTLCForwarded(F1, S, F2, p0, p1, h(x), amt + f1 + f2, amt + f2) @ #t3
      & HTLCForwarded(F2, F1, R, p1, p2, h(x), amt + f2, amt)          @ #t4
      & HTLCFulfilled(R, F2, p2, h(x), amt)                            @ #t5
      & #t2 < #t3 & #t3 < #t4 & #t4 < #t5
      & not (Ex A B p y a #u. HTLCOffered(A, B, p, y, a) @ #u & not(A=S & B=F1))
      & not (Ex F3 F4 F5 p3 p4 y ai ao #u.
               HTLCForwarded(F3, F4, F5, p3, p4, y, ai, ao) @ #u
             & not(F3=F1 & F4=S & F5=F2)
             & not(F3=F2 & F4=F1 & F5=R))"

// A forward is preceded by the offer or the previous forward, and the
// incoming amount agrees with the previous hop's outgoing amount,
// amount consistency along the route.
lemma Forward_Requires_Incoming [use_induction]:
    "All Me Prev Next ptrIn ptrOut y amtIn amtOut #i.
        HTLCForwarded(Me, Prev, Next, ptrIn, ptrOut, y, amtIn, amtOut) @ #i
     ==> (Ex S #j. HTLCOffered(S, Me, ptrIn, y, amtIn) @ #j & #j < #i)
       | (Ex P0 pin0 amt0 #j.
            HTLCForwarded(Prev, P0, Me, pin0, ptrIn, y, amt0, amtIn) @ #j
          & #j < #i)"

// Every hop strictly decreases the locked amount, 
// so that the receiver gets the amount named in its invoice, and every intermediary get a strictly positive fee.
lemma Amount_Strictly_Decreases_Per_Hop:
    "All Me Prev Next ptrIn ptrOut y amtIn amtOut #i.
        HTLCForwarded(Me, Prev, Next, ptrIn, ptrOut, y, amtIn, amtOut) @ #i
     ==> Ex fee. amtIn = amtOut + fee"

// The receiver is only ever paid the amount named in one of its invoices
lemma Receiver_Paid_Invoice_Amount:
    "All R y amt #i.
        ReceiverPaid(R, y, amt) @ #i
     ==> Ex S #j. InvoiceCreated(R, S, y, amt) @ #j & #j < #i"

// Fees are earned only on successful forwards,
// and the fee is the difference between the incoming and outgoing amounts.
lemma Fee_Only_On_Successful_Forward:
    "All Me ptrIn ptrOut y fee #i.
        FeeEarned(Me, ptrIn, ptrOut, y, fee) @ #i
     ==> (Ex #j. Redeemed(ptrOut, y) @ #j & #j < #i)
       & (Ex Prev Next amtIn amtOut #f.
            HTLCForwarded(Me, Prev, Next, ptrIn, ptrOut, y, amtIn, amtOut) @ #f
          & amtIn = amtOut + fee
          & #f < #i)"

// Authentication:
lemma Redeem_Requires_Receiver_Release [use_induction]:
    "All ptr y #i.
        Redeemed(ptr, y) @ #i
     ==> Ex R x #k. PreimageReleased(R, x) @ #k & h(x) = y"

end
