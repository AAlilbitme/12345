// Auto-generated 4-hop Lightning Network theory.
// Hops: Sender -> F1 -> F2 -> Receiver
// Generated by generate_multihop.py
theory multihop_4hop
begin

#include "3.splib"

rule Receiver_Create_Invoice:
    let y = h(~x)
        invoice = <$Receiver, $Sender, y>
        sigR    = sign(invoice, ltkReceiver)
    in
    [ Fr(~x), !Ltk($Receiver, ltkReceiver) ]
    --[ InvoiceCreated($Receiver, $Sender, y),
        SecretPreimage($Receiver, ~x) ]->
    [ ReceiverInv($Receiver, $Sender, ~x),
      Out(<'SecretRS', invoice, sigR>) ]

rule Sender_Offer_HTLC:
    let invoice = <$Receiver, $Sender, y>
        offer   = <'htlc1', ptrSenderF1, $Sender, $F1, y>
        sigSender  = sign(offer, ltkSender)
    in
    [ In(<'SecretRS', invoice, sigR>),
      !Pk($Receiver, pkReceiver),
      !Ltk($Sender, ltkSender),
      !ChannelConnect(ptrSenderF1, $Sender, $F1) ]
    --[ HTLCOffered($Sender, $F1, ptrSenderF1, y),
        HTLCAdded(ptrSenderF1, y),
        Eq(verify(sigR, invoice, pkReceiver), true) ]->
    [ SenderPending($Sender, $F1, $Receiver, ptrSenderF1, y),
      Out(<'htlc1', ptrSenderF1, $Sender, $F1, y, sigSender>) ]

rule Forward_F1_HTLC:
    let offer    = <'htlc1',  ptrSenderF1,  $Sender, $F1, y>
        offerFwd = <'htlc2', ptrF1F2, $F1, $F2, y>
        sigF1 = sign(offerFwd, ltkF1)
    in
    [ In(<'htlc1', ptrSenderF1, $Sender, $F1, y, sigSender>),
      !Pk($Sender, pkSender), !Ltk($F1, ltkF1),
      !ChannelConnect(ptrSenderF1,  $Sender, $F1),
      !ChannelConnect(ptrF1F2, $F1, $F2) ]
    --[ HTLCForwarded($F1, $F2, $Sender, ptrF1F2, y),
        HTLCAdded(ptrF1F2, y),
        ForwardHTLC($F1, ptrSenderF1, ptrF1F2, y),
        Neq(ptrSenderF1, ptrF1F2),
        Eq(verify(sigSender, offer, pkSender), true) ]->
    [ IntermediaryPending($F1, $Sender, $F2, ptrSenderF1, ptrF1F2, y),
      Out(<'htlc2', ptrF1F2, $F1, $F2, y, sigF1>) ]

rule Forward_F2_HTLC:
    let offer    = <'htlc2',  ptrF1F2,  $F1, $F2, y>
        offerFwd = <'htlc3', ptrF2Receiver, $F2, $Receiver, y>
        sigF2 = sign(offerFwd, ltkF2)
    in
    [ In(<'htlc2', ptrF1F2, $F1, $F2, y, sigF1>),
      !Pk($F1, pkF1), !Ltk($F2, ltkF2),
      !ChannelConnect(ptrF1F2,  $F1, $F2),
      !ChannelConnect(ptrF2Receiver, $F2, $Receiver) ]
    --[ HTLCForwarded($F2, $Receiver, $F1, ptrF2Receiver, y),
        HTLCAdded(ptrF2Receiver, y),
        ForwardHTLC($F2, ptrF1F2, ptrF2Receiver, y),
        Neq(ptrF1F2, ptrF2Receiver),
        Eq(verify(sigF1, offer, pkF1), true) ]->
    [ IntermediaryPending($F2, $F1, $Receiver, ptrF1F2, ptrF2Receiver, y),
      Out(<'htlc3', ptrF2Receiver, $F2, $Receiver, y, sigF2>) ]

rule Receiver_Fulfill_HTLC:
    let y        = h(x)
        offerFwd = <'htlc3', ptrF2Receiver, $F2, $Receiver, y>
    in
    [ ReceiverInv($Receiver, $Sender, x),
      In(<'htlc3', ptrF2Receiver, $F2, $Receiver, y, sigF2>),
      !Pk($F2, pkF2),
      !ChannelConnect(ptrF2Receiver, $F2, $Receiver) ]
    --[ HTLCFulfilled($Receiver, $F2, ptrF2Receiver, y),
        PreimageReleased($Receiver, x),
        Redeemed(ptrF2Receiver, y),
        Eq(verify(sigF2, offerFwd, pkF2), true) ]->
    [ Out(<'fulfill', ptrF2Receiver, x>) ]

rule Intermediary_Settle:
    [ IntermediaryPending(MidP, InP, OutP, ptrIn, ptrOut, y),
      In(<'fulfill', ptrOut, x>) ]
    --[ IntermediaryClaimed(MidP, InP, ptrIn, x),
        Redeemed(ptrIn, y),
        Eq(h(x), y) ]->
    [ Out(<'fulfill', ptrIn, x>) ]

rule Sender_Settle:
    [ SenderPending($Sender, $F1, $Receiver, ptrSenderF1, y),
      In(<'fulfill', ptrSenderF1, x>) ]
    --[ SenderSettled($Sender, $F1, $Receiver, ptrSenderF1, x),
        PaymentComplete($Sender, $Receiver, h(x)),
        Redeemed(ptrSenderF1, y),
        Eq(h(x), y) ]->
    [ ]

rule Open_Timeout:
    [ !ChannelConnect(ptr, A, B) ]
    --[ TimedOut(ptr) ]->
    [ !Timeout(ptr) ]

rule Sender_Timeout_Refund:
    [ SenderPending($Sender, $F1, $Receiver, ptrSenderF1, y),
      !Timeout(ptrSenderF1) ]
    --[ HTLCRefunded($Sender, ptrSenderF1, y),
        Refunded(ptrSenderF1, y) ]->
    [ ]

rule Intermediary_Timeout_Refund:
    [ IntermediaryPending(MidP, InP, OutP, ptrIn, ptrOut, y),
      !Timeout(ptrOut) ]
    --[ HTLCRefunded(MidP, ptrOut, y),
        Refunded(ptrOut, y) ]->
    [ ]

restriction OneOutcomePerHTLC:
    "All ptr y #i #j.
       Redeemed(ptr, y) @ #i & Refunded(ptr, y) @ #j ==> F"

restriction Inequality:
    "All x y #i. Neq(x, y) @ #i ==> not(x = y)"

restriction Equality:
    "All x y #i. Eq(x, y) @ #i ==> x = y"

restriction OneTimeoutPerPtr:
    "All ptr #i #j. TimedOut(ptr) @ #i & TimedOut(ptr) @ #j ==> #i = #j"

// (T1) Redemption must happen before the channel's own timeout.
restriction RedeemBeforeTimeout:
    "All ptr y #i #j.
        Redeemed(ptr, y) @ #i & TimedOut(ptr) @ #j ==> #i < #j"

// (T2) CLTV-delta ordering: outgoing timeout fires strictly before
// incoming timeout.  Applies when both timeouts fire.
restriction ForwardTimeGap:
    "All P ptrIn ptrOut y #f #j #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #f
      & TimedOut(ptrOut) @ #j
      & TimedOut(ptrIn)  @ #k
     ==> #j < #k"

// (T3) Watcher obligation: if the outgoing HTLC is redeemed before the
// incoming timeout, the intermediary sweeps the incoming HTLC.
restriction IntermediaryMustClaim:
    "All P ptrIn ptrOut y #f #i #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #f
      & Redeemed(ptrOut, y) @ #i
      & TimedOut(ptrIn)  @ #k
      & #i < #k
     ==> Ex #l. Redeemed(ptrIn, y) @ #l"

lemma Ltk_Known_Implies_Compromised [reuse]:
    "All A ltk #i #j.
        KeyGen(A, ltk) @ #i
      & !KU(ltk) @ #j
     ==> Ex #r. LtkCompromised(A) @ #r"

lemma Invoice_Has_Secret_Preimage [reuse]:
    "All R S x #i.
        InvoiceCreated(R, S, h(x)) @ #i
     ==> SecretPreimage(R, x) @ #i"

lemma Preimage_Secret_Until_Released [reuse]:
    "All R x #i #j.
        SecretPreimage(R, x) @ #i
      & K(x) @ #j & #i = #j
     ==> Ex #k. PreimageReleased(R, x) @ #k & #k < #j"

lemma HTLC_On_Opened_Channel [reuse, use_induction]:
    "All ptr y #i.
        HTLCAdded(ptr, y) @ #i
     ==> Ex X Y #j. ChannelOpen(X, Y, ptr) @ #j & #j < #i"

lemma Refund_Requires_Timeout [reuse]:
    "All ptr y #i.
        Refunded(ptr, y) @ #i
     ==> Ex #j. TimedOut(ptr) @ #j & #j < #i"

lemma Settle_Requires_Receiver_Release:
    "All S F1 R ptr x #i #j.
        SenderSettled(S, F1, R, ptr, x) @ #i
      & InvoiceCreated(R, S, h(x)) @ #j
     ==> Ex #k. PreimageReleased(R, x) @ #k & #k < #i"

lemma Claim_Requires_Release:
    "All MidP InP ptrIn R x #i #j.
        IntermediaryClaimed(MidP, InP, ptrIn, x) @ #i
      & SecretPreimage(R, x) @ #j
     ==> Ex #k. PreimageReleased(R, x) @ #k & #k < #i"

lemma Settle_Excludes_Sender_Refund:
    "All S F1 R ptr x #i.
        SenderSettled(S, F1, R, ptr, x) @ #i
     ==> not (Ex #j. HTLCRefunded(S, ptr, h(x)) @ #j)"

lemma Invoice_Authenticates_Settlement:
    "All S F1 R ptr x #i.
        SenderSettled(S, F1, R, ptr, x) @ #i
     ==> (Ex #j. InvoiceCreated(R, S, h(x)) @ #j & #j < #i)
       | (Ex #r. LtkCompromised(R) @ #r & #r < #i)"

lemma Forged_Invoice_Requires_Key_Compromise:
    exists-trace
    "Ex S F1 R ptr x #i #r.
        SenderSettled(S, F1, R, ptr, x) @ #i
      & LtkCompromised(R) @ #r
      & not (Ex #j. InvoiceCreated(R, S, h(x)) @ #j)"

lemma Loss_Requires_Inaction:
    "All P ptrIn ptrOut y #i #j #k.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #i
      & Redeemed(ptrOut, y) @ #j
      & Refunded(ptrIn, y) @ #k
     ==> not (Ex #l. Redeemed(ptrIn, y) @ #l)"

// NOTE: Intermediary_Never_Loses requires a block-number-based CLTV model
// (decreasing deadlines assigned at channel open) to be provable without a
// circular restriction.  It is included as a property of interest; with the
// current T1-T3 timing model it will falsify because T2 is vacuous when
// TimedOut(ptrOut) does not fire.
lemma Intermediary_Never_Loses:
    "All P ptrIn ptrOut y #f #i #j.
        ForwardHTLC(P, ptrIn, ptrOut, y) @ #f
      & Redeemed(ptrOut, y) @ #i
      & Refunded(ptrIn, y) @ #j
     ==> Ex #r. LtkCompromised(P) @ #r"

lemma Multihop_Payment_Possible:
    exists-trace
    "Ex S F1 F2 R ptrSenderF1 ptrF1F2 ptrF2Receiver x #t1  #t2  #t3  #t4  #t5  #t6  #t7.
        InvoiceCreated(R, S, h(x)) @ #t1
      & HTLCOffered(S, F1, ptrSenderF1, h(x)) @ #t2
      & HTLCForwarded(F1, F2, S, ptrF1F2, h(x)) @ #t3
      & HTLCFulfilled(R, F2, ptrF2Receiver, h(x)) @ #t4
      & IntermediaryClaimed(F2, F1, ptrF1F2, x) @ #t5
      & IntermediaryClaimed(F1, S, ptrSenderF1, x) @ #t6
      & SenderSettled(S, F1, R, ptrSenderF1, x) @ #t7
      & #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #t5 & #t5 < #t6 & #t6 < #t7
      & not (Ex P #r. LtkCompromised(P) @ #r)
      & not (Ex P p y2 #u. HTLCRefunded(P, p, y2) @ #u)"

end
